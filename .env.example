# Adresse de l'API.
#   En local :            http://localhost:8000/api
#   Derrière nginx (serveur de test, production) : /api   (même domaine que le site)
VITE_API_URL=

# Jeton PUBLIC Mapbox (compte Mapbox > Access tokens) : les cartes du créateur
# et des fiches. Sans lui, les cartes ne s'affichent pas.
VITE_MAPBOX_TOKEN=
