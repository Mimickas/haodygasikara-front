# =============================================================================
#  Variables de l'API — modèle À COPIER, jamais à remplir dans le dépôt
# =============================================================================
#  Sur le serveur : /etc/haodygasikara/api.env  (chmod 640, propriétaire root,
#  groupe haodygasikara). Lu par le service systemd (EnvironmentFile).
#  Les variables sans valeur par défaut sont OBLIGATOIRES : si l'une manque,
#  l'API refuse de démarrer et nomme la variable dans le journal.
# =============================================================================

# Active application-prod.properties (tout y est lu depuis ce fichier)
SPRING_PROFILES_ACTIVE=prod
PORT=8000

# ── Base PostgreSQL + PostGIS ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/haodygasikara
DB_USER=haodygasikara
DB_PASSWORD=

# ── Jetons de session ────────────────────────────────────────────────────────
# Deux secrets DIFFÉRENTS, 64 caractères au moins : openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── E-mails (Gmail : un « mot de passe d'application », pas le mot de passe
#    du compte — compte Google > Sécurité > Mots de passe des applications)
MAIL_USERNAME=
MAIL_PASSWORD=
# Où arrivent les demandes de devis (par défaut : MAIL_USERNAME)
AGENCE_EMAIL=

# ── Images et vidéos (console Cloudinary > Dashboard) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Adresse publique du site (liens des e-mails : devis, mot de passe) ───────
APP_FRONT_URL=https://test.haodygasikara.com

# HTTPS en place (certbot) : laisser true. Uniquement pour un serveur de test
# servi en HTTP simple, false — sinon chaque rechargement déconnecte.
APP_COOKIE_SECURE=true

# ── Facultatif ───────────────────────────────────────────────────────────────
# « Continuer avec Google » : identifiant client OAuth « Application Web »,
# origine JavaScript autorisée = APP_FRONT_URL. Vide = bouton désactivé
# avec une explication.
GOOGLE_CLIENT_ID=
# Seulement si le site et l'API sont sur des domaines différents :
# APP_CORS_ORIGINS=https://test.haodygasikara.com
