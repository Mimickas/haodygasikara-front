+    const [fields, destinationRes] = await Promise.all([
+        chargerChampsDestination(),
+        getDestinationByIdApi(id),
+    ]);
+    return { fields, values: { ...destinationRes.data.data } };
+};
+
+export function useDestinationActionToolbar() {
