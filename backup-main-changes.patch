@@ -0,0 +1,225 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { FaMagnifyingGlass, FaChevronDown, FaXmark } from "react-icons/fa6";
+
+// ── Choisir dans une longue liste ──────────────────────────────────────────
+//
+// Un <select> tient tant qu'il y a dix options. À cent, on fait défiler en
+// aveugle ; à mille — mille circuits, un jour de programme par jour de chaque
+// circuit — il n'est plus utilisable du tout : on ne peut ni chercher, ni
+// comparer, ni savoir ce qu'on regarde.
+//
+// Ici : un champ qui dit ce qui est choisi, et qui s'ouvre sur une recherche.
+// On tape trois lettres, on voit les lignes qui correspondent avec leur
+// information secondaire (la région, la durée, la destination), et on choisit.
+// La recherche ignore la casse et les accents, comme celle des tableaux, et
+// accepte les mots dans n'importe quel ordre : « boby trek » trouve « Trek du
+// pic Boby ».
+//
+// Options : { value, label, sousTitre? } — `sousTitre` est la ligne grise qui
+// permet de distinguer deux homonymes.
+
+const sansAccent = (v) =>
+    String(v ?? "").normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
+
+export default function ChampRecherche({
+    id,
+    value,
+    onChange,
+    options = [],
+    placeholder = "Choisir…",
+    placeholderRecherche = "Rechercher…",
+    invalide = false,
+    desactive = false,
+}) {
+    const [ouvert, setOuvert] = useState(false);
+    const [terme, setTerme] = useState("");
+    const [survol, setSurvol] = useState(0);
+    // Le panneau se pose en repère fixe, mesuré sur le bouton : dans la liste
+    // d'étapes — qui a son propre défilement — un panneau en absolu serait
+    // rogné par le cadre, et on ne verrait qu'une bande de deux pixels.
+    const [ancre, setAncre] = useState(null);
+
+    const cadre = useRef(null);
+    const champRecherche = useRef(null);
+    const listeRef = useRef(null);
+
+    const choisi = useMemo(
+        () => options.find((o) => String(o.value) === String(value)) ?? null,
+        [options, value]);
+
+    const resultats = useMemo(() => {
+        const mots = sansAccent(terme).trim().split(/\s+/).filter(Boolean);
+        if (!mots.length) return options;
+        return options.filter((o) => {
+            const texte = sansAccent(`${o.label} ${o.sousTitre ?? ""}`);
+            return mots.every((m) => texte.includes(m));
+        });
+    }, [options, terme]);
+
+    // À l'ouverture : le curseur dans la recherche, et le survol sur l'option
+    // déjà choisie plutôt que sur la première de la liste.
+    useEffect(() => {
+        if (!ouvert) return;
+        setTerme("");
+        const i = options.findIndex((o) => String(o.value) === String(value));
+        setSurvol(i >= 0 ? i : 0);
+        champRecherche.current?.focus();
+    }, [ouvert, options, value]);
+
+    // Un clic ailleurs referme : on n'oblige pas à viser la petite croix.
+    useEffect(() => {
+        if (!ouvert) return undefined;
+        const dehors = (e) => { if (!cadre.current?.contains(e.target)) setOuvert(false); };
+        document.addEventListener("mousedown", dehors);
+        return () => document.removeEventListener("mousedown", dehors);
+    }, [ouvert]);
+
+    // La position du panneau : sous le bouton, ou au-dessus s'il n'y a pas la
+    // place en bas. Recalculée au défilement — `capture` attrape aussi celui
+    // des cadres intérieurs — et au redimensionnement.
+    useEffect(() => {
+        if (!ouvert) return undefined;
+        const poser = () => {
+            const r = cadre.current?.getBoundingClientRect();
+            if (!r) return;
+            const placeEnBas = window.innerHeight - r.bottom;
+            setAncre({
+                left: r.left,
+                largeur: r.width,
+                ...(placeEnBas < 280 && r.top > placeEnBas
+                    ? { bas: window.innerHeight - r.top + 4, hauteur: r.top - 16 }
+                    : { haut: r.bottom + 4, hauteur: placeEnBas - 16 }),
+            });
+        };
+        poser();
+        window.addEventListener("scroll", poser, true);
+        window.addEventListener("resize", poser);
+        return () => {
+            window.removeEventListener("scroll", poser, true);
+            window.removeEventListener("resize", poser);
+        };
+    }, [ouvert]);
+
+    // L'option survolée reste visible quand on descend au clavier.
+    useEffect(() => {
+        if (!ouvert) return;
+        listeRef.current?.children[survol]?.scrollIntoView({ block: "nearest" });
+    }, [survol, ouvert]);
+
+    const choisir = (option) => {
+        onChange(option ? String(option.value) : "");
+        setOuvert(false);
+    };
+
+    const auClavier = (e) => {
+        if (e.key === "ArrowDown") {
+            e.preventDefault();
+            setSurvol((i) => Math.min(i + 1, resultats.length - 1));
+        } else if (e.key === "ArrowUp") {
+            e.preventDefault();
+            setSurvol((i) => Math.max(i - 1, 0));
+        } else if (e.key === "Enter") {
+            e.preventDefault();                       // ← sinon le formulaire s'envoie
+            if (resultats[survol]) choisir(resultats[survol]);
+        } else if (e.key === "Escape") {
+            e.preventDefault();
+            setOuvert(false);
+        }
+    };
+
+    return (
+        <div className="ad-choix" ref={cadre}>
+            <button
+                id={id}
+                type="button"
+                disabled={desactive}
+                onClick={() => setOuvert((o) => !o)}
+                aria-haspopup="listbox"
+                aria-expanded={ouvert}
+                aria-invalid={invalide || undefined}
+                className={`ad-champ ad-choix__bouton font-body${invalide ? " ad-champ--faux" : ""}`}
+            >
+                <span className={choisi ? "ad-choix__valeur" : "ad-choix__vide"}>
+                    {choisi ? choisi.label : placeholder}
+                </span>
+                <span className="ad-choix__gestes">
+                    {choisi && !desactive && (
+                        // Revenir à « rien choisi » : un champ facultatif doit pouvoir se vider
+                        <span
+                            role="button"
+                            tabIndex={-1}
+                            aria-label="Effacer le choix"
+                            title="Effacer"
+                            onClick={(e) => { e.stopPropagation(); choisir(null); }}
+                            className="ad-choix__effacer"
+                        >
+                            <FaXmark className="text-xs" aria-hidden="true" />
+                        </span>
+                    )}
+                    <FaChevronDown className="text-[10px] shrink-0" aria-hidden="true" />
+                </span>
+            </button>
+
+            {ouvert && ancre && (
+                <div
+                    className="ad-choix__panneau"
+                    style={{
+                        left: ancre.left,
+                        width: ancre.largeur,
+                        top: ancre.haut,
+                        bottom: ancre.bas,
+                        maxHeight: Math.max(200, Math.min(360, ancre.hauteur)),
+                    }}
+                >
+                    <label className="ad-choix__recherche">
+                        <FaMagnifyingGlass className="text-xs shrink-0" style={{ color: "var(--text-muted)" }} aria-hidden="true" />
+                        <input
+                            ref={champRecherche}
+                            type="search"
+                            value={terme}
+                            onChange={(e) => { setTerme(e.target.value); setSurvol(0); }}
+                            onKeyDown={auClavier}
+                            placeholder={placeholderRecherche}
+                            aria-label={placeholderRecherche}
+                            aria-controls={`${id}-liste`}
+                            className="ad-choix__saisie font-body"
+                        />
+                    </label>
+
+                    {resultats.length === 0 ? (
+                        <p className="ad-choix__aucun font-body">
+                            Aucun résultat pour « {terme} ».
+                        </p>
+                    ) : (
+                        <>
+                            <ul id={`${id}-liste`} role="listbox" ref={listeRef} className="ad-choix__liste">
+                                {resultats.map((o, i) => {
+                                    const actif = String(o.value) === String(value);
+                                    return (
+                                        <li
+                                            key={o.value}
+                                            role="option"
+                                            aria-selected={actif}
+                                            onMouseEnter={() => setSurvol(i)}
+                                            onClick={() => choisir(o)}
+                                            className={`ad-choix__option${i === survol ? " ad-choix__option--survol" : ""}${actif ? " ad-choix__option--choisie" : ""}`}
+                                        >
+                                            <span className="ad-choix__option-titre font-body-strong">{o.label}</span>
+                                            {o.sousTitre && (
+                                                <span className="ad-choix__option-sous font-body">{o.sousTitre}</span>
+                                            )}
+                                        </li>
+                                    );
+                                })}
+                            </ul>
+                            {/* Combien de lignes sur combien : on sait si la recherche a mordu */}
+                            <p className="ad-choix__compte font-body">
+                                {resultats.length} sur {options.length}
+                            </p>
+                        </>
+                    )}
+                </div>
+            )}
+        </div>
+    );
+}
diff --git a/src/components/admin/crud/form/FormModal.jsx b/src/components/admin/crud/form/FormModal.jsx
new file mode 100644
index 0000000..ca02fe1
--- /dev/null
+++ b/src/components/admin/crud/form/FormModal.jsx
@@ -0,0 +1,120 @@
+import { useEffect, useState } from "react";
+import { uploadToCloudinary } from "../../../../api/admin/uploadApi";
+import ChampFormulaire from "./ChampFormulaire";
+import { useChampsFormulaire } from "../../../../hooks/admin/useChampsFormulaire";
+import { apiErrorMessage } from "../../../../utils/apiError";
+
+// ── Le formulaire en fenêtre de l'administration ──────────────────────────
+//
+// Même fenêtre que la confirmation (ad-modale), mêmes champs que la page de
+// création (ChampFormulaire), même validation (useChampsFormulaire) : ce qui
+// vaut ici vaut là-bas.
+//
+// Rien ne part au serveur avant que les bornes déclarées avec les champs
+// soient tenues, et chaque message se pose sous SON champ. Un refus du serveur
+// s'affiche ensuite avec sa propre phrase, et la fenêtre reste ouverte : ce qui
+// a été saisi n'est jamais perdu.
+//
+// `coherence` : la vérification qu'un champ seul ne peut pas faire — un âge
+// maximum plus petit que le minimum, par exemple.
+
+export default function FormModal({ open, onClose, onSubmit, fields, value, title, coherence }) {
+    const { formData, setChamp, erreurs, valider, optionsDe, attenteDe } =
+        useChampsFormulaire(fields, value, coherence);
+
+    const [submitting, setSubmitting] = useState(false);
+    const [etat, setEtat] = useState({ texte: "", erreur: false });
+
+    useEffect(() => { setEtat({ texte: "", erreur: false }); }, [value, open]);
+
+    useEffect(() => {
+        if (!open) return undefined;
+        const touche = (e) => { if (e.key === "Escape" && !submitting) onClose(); };
+        window.addEventListener("keydown", touche);
+        return () => window.removeEventListener("keydown", touche);
+    }, [open, submitting, onClose]);
+
+    if (!open) return null;
+
+    async function handleSubmit(e) {
+        e?.preventDefault();
+
+        if (!valider()) {
+            setEtat({ texte: "Quelques champs demandent une correction.", erreur: true });
+            return;
+        }
+
+        setSubmitting(true);
+        try {
+            const payload = { ...formData };
+            for (const field of fields.flat()) {
+                if (field.type === "image" && Array.isArray(payload[field.name])) {
+                    setEtat({ texte: "Envoi des images…", erreur: false });
+                    payload[field.name] = await Promise.all(
+                        payload[field.name].map(file => typeof file === "string"
+                            ? file                                        // ← déjà en ligne : pas de nouvel envoi
+                            : uploadToCloudinary(file, field.folder))
+                    );
+                }
+                if (field.type === "video" && payload[field.name] instanceof File) {
+                    setEtat({ texte: "Envoi de la vidéo…", erreur: false });
+                    payload[field.name] = await uploadToCloudinary(payload[field.name], field.folder);
+                }
+            }
+            setEtat({ texte: "Enregistrement…", erreur: false });
+            await onSubmit(payload);
+            onClose();
+        } catch (err) {
+            setEtat({ texte: apiErrorMessage(err, "L'enregistrement n'a pas abouti. Vérifiez les champs puis réessayez."), erreur: true });
+        } finally {
+            setSubmitting(false);
+        }
+    }
+
+    return (
+        <div className="ad-modale" onClick={() => !submitting && onClose()}>
+            <form className="ad-modale__cadre ad-modale__cadre--large" onClick={e => e.stopPropagation()} onSubmit={handleSubmit} noValidate
+                aria-labelledby="ad-formulaire-titre">
+                <header className="ad-modale__entete ad-modale__entete--filet">
+                    <div>
+                        <p className="ad-modale__surtitre font-body-strong">Haodygasikara</p>
+                        <h2 id="ad-formulaire-titre" className="ad-modale__titre font-title">{title}</h2>
+                    </div>
+                    <button type="button" onClick={onClose} className="ad-modale__fermer" aria-label="Fermer" disabled={submitting}>✕</button>
+                </header>
+
+                <div className="ad-modale__corps">
+                    {fields.map((group, i) => (
+                        <div key={i} className="ad-modale__rangee">
+                            {group.map(field => (
+                                <div key={field.name} className="ad-modale__champ">
+                                    <ChampFormulaire
+                                        field={field}
+                                        valeur={formData[field.name]}
+                                        onChange={val => setChamp(field.name, val)}
+                                        erreur={erreurs[field.name]}
+                                        options={optionsDe(field)}
+                                        attente={attenteDe(field)}
+                                    />
+                                </div>
+                            ))}
+                        </div>
+                    ))}
+                </div>
+
+                {etat.texte && (
+                    <p className={etat.erreur ? "ad-erreur ad-modale__message" : "ad-modale__etat font-body"} role={etat.erreur ? "alert" : "status"}>
+                        {etat.texte}
+                    </p>
+                )}
+
+                <footer className="ad-modale__pied ad-modale__pied--filet">
+                    <button type="button" onClick={onClose} disabled={submitting} className="ad-bouton font-body-strong">Annuler</button>
+                    <button type="submit" disabled={submitting} className="ad-bouton ad-bouton--plein font-body-strong">
+                        {submitting ? "Enregistrement…" : "Enregistrer"}
+                    </button>
+                </footer>
+            </form>
+        </div>
+    );
+}
