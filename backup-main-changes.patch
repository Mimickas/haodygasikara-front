@@ -0,0 +1,54 @@
+// ── Les visites d'une journee ─────────────────────────────────────────────
+// `VisiteDetaille { id, poi, inclus, note }` — ce qu'on fait dans la journee.
+//
+// Le bloc se pose entre le recit et la nuit, et un cran SOUS l'hebergement :
+// la nuitee est le point fixe de la journee (un nom, un lieu, des photos), les
+// visites sont une liste. L'ecart ne se joue pas sur le corps mais sur la
+// FAMILLE — la nuitee en Abhaya, la serif des titres ; les visites en Barlow.
+// Deux tailles voisines dans la meme fonte se seraient disputees le regard.
+//
+// Une visite comprise ne porte aucune marque : on ne decore pas ce qui est
+// acquis. Seule l'option se signale — c'est une ligne de devis en plus.
+export default function JourneeVisites({ visites = [] }) {
+    if (!visites.length) return null;
+
+    return (
+        <section className="cx-visites">
+            <div className="cx-visites__tete">
+                <span className="cx-label cx-label--legende font-body-strong">
+                    Visites et activit&eacute;s
+                </span>
+                {/* Le compte en exposant, comme l'entete de l'itineraire —
+                    meme motif, un niveau plus bas. */}
+                <span className="cx-visites__compte font-body-strong tabular-nums">
+                    {String(visites.length).padStart(2, "0")}
+                </span>
+            </div>
+
+            <ul className="cx-visites__liste">
+                {visites.map((visite, i) => (
+                    <li key={visite?.id ?? i} className="cx-visite">
+                        <h5 className="cx-visite__nom font-body-strong">
+                            {visite?.poi?.nom}
+                            {visite?.poi?.categorie?.nom && (
+                                <span className="cx-visite__type font-body-strong">
+                                    {visite.poi.categorie.nom}
+                                </span>
+                            )}
+                        </h5>
+
+                        {!visite?.inclus && (
+                            <span className="cx-visite__option font-body-strong">
+                                En option
+                            </span>
+                        )}
+
+                        {visite?.note && (
+                            <p className="cx-visite__note font-body">{visite.note}</p>
+                        )}
+                    </li>
+                ))}
+            </ul>
+        </section>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/itineraire/PlanchePhoto.jsx b/src/pages/client/circuitDetail/components/itineraire/PlanchePhoto.jsx
new file mode 100644
index 0000000..66215a4
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/itineraire/PlanchePhoto.jsx
@@ -0,0 +1,69 @@
+import { imageCloudinary } from "../../../../../utils/image";
+// ── La planche photo d'un lieu ────────────────────────────────────────────
+// Un grand cadre et deux vignettes qui se partagent exactement sa hauteur.
+// Angles vifs, gouttiere de 10 px, aucun rayon : la photographie se suffit.
+//
+// Le compte des visuels restants se pose EN LEGENDE sur la derniere vignette
+// plutot qu'en faux bouton : tant qu'aucune visionneuse n'existe, autant le
+// dire honnetement.
+//
+// `medias` arrive tout fait de mediasPoi() — couverture, film, reste.
+export default function PlanchePhoto({ medias = [], legende }) {
+    const [grand, ...suite] = medias;
+    if (!grand) return null;
+
+    const vignettes = suite.slice(0, 2);
+    const reste = suite.length - vignettes.length;
+
+    return (
+        <div className={`cx-jour__galerie${vignettes.length ? "" : " cx-jour__galerie--seule"}`}>
+            <Cadre media={grand} legende={legende} grand />
+
+            {vignettes.length > 0 && (
+                <div className={`cx-jour__colonne${vignettes.length === 1 ? " cx-jour__colonne--une" : ""}`}>
+                    {vignettes.map((media, i) => (
+                        <Cadre
+                            key={media.cle}
+                            media={media}
+                            legende={legende}
+                            reste={i === vignettes.length - 1 ? reste : 0}
+                        />
+                    ))}
+                </div>
+            )}
+        </div>
+    );
+}
+
+// Un cadre de la planche. Le fond tient la place tant que l'image n'est pas
+// la, sans quoi la grille sauterait au chargement.
+function Cadre({ media, legende, grand = false, reste = 0 }) {
+    return (
+        <figure className={`cx-jour__media${grand ? " cx-jour__media--grand" : ""}`}>
+            {media.type === "video" ? (
+                <video
+                    src={imageCloudinary(media.src, 1200)}
+                    poster={media.poster ?? undefined}
+                    muted
+                    loop
+                    autoPlay
+                    playsInline
+                    preload="metadata"
+                />
+            ) : (
+                <img
+                    src={media.src}
+                    alt={legende ?? ""}
+                    loading="lazy"
+                    decoding="async"
+                />
+            )}
+
+            {reste > 0 && (
+                <figcaption className="cx-jour__reste font-body-strong">
+                    +{reste} photo{reste > 1 ? "s" : ""}
+                </figcaption>
+            )}
+        </figure>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/recap/BoutonPersonnaliser.jsx b/src/pages/client/circuitDetail/components/recap/BoutonPersonnaliser.jsx
new file mode 100644
