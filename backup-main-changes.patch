+    .cx-cp {
+        --cp-gouttiere: 24px;
+        --cp-marge: 24px;
+        display: block;
+        height: auto;
+        min-height: 100vh;
+        overflow: visible;
+        padding-top: var(--entete-hauteur, 85px);
+    }
+    .cx-cp-onglets {
+        position: sticky;
+        top: var(--entete-hauteur, 85px);
+        z-index: 20;
+        display: grid;
+        grid-template-columns: repeat(3, 1fr);
+        padding: 0 var(--cp-marge);
+        background-color: var(--bg);
+        border-bottom: 1px solid var(--border);
+    }
+    .cx-cp-onglet {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        gap: 6px;
+        min-height: 52px;
+        margin-bottom: -1px;
+        border-bottom: 1px solid transparent;
+        font-family: var(--font-body-strong);
+        font-size: 11px;
+        text-transform: uppercase;
+        letter-spacing: 0.1em;
+        color: var(--text-muted);
+        cursor: pointer;
+        transition: color 0.3s ease, border-color 0.3s ease;
+    }
+    .cx-cp-onglet--actif { color: var(--text-primary); border-bottom-color: var(--text-primary); }
+    .cx-cp-onglet__compte { font-size: 11px; letter-spacing: 0.1em; color: var(--brand-terre); animation: cx-cp-roule 0.55s var(--cp-courbe); }
+
+    .cx-cp-voyage,
+    .cx-cp-atlas { display: none; }
+    .cx-cp[data-onglet="voyage"] .cx-cp-voyage,
+    .cx-cp[data-onglet="destinations"] .cx-cp-atlas,
+    .cx-cp[data-onglet="carte"] .cx-cp-atlas { display: flex; }
+
+    .cx-cp-voyage { min-height: calc(100vh - var(--entete-hauteur, 85px) - 53px); }
+    .cx-cp-voyage__defile { overflow: visible; padding: 44px var(--cp-marge) 120px; }
+    /* Le pied reste sous le pouce, quel que soit le défilement */
+    .cx-cp-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; padding: 14px var(--cp-marge) 16px; box-shadow: 0 -18px 40px rgba(43, 33, 26, 0.08); }
+    .cx-cp-actions__ligne { gap: 14px 26px; }
+
+    .cx-cp-atlas__tete { display: none; }
+    .cx-cp-atlas__corps { flex: none; margin-top: 0; }
+    .cx-cp-catalogue { position: static; overflow: visible; padding: 0 var(--cp-marge) 56px; }
+    .cx-cp[data-onglet="carte"] .cx-cp-catalogue { display: none; }
+    .cx-cp-outils { top: calc(var(--entete-hauteur, 85px) + 53px); flex-wrap: wrap; gap: 14px 22px; }
+    .cx-cp-recherche { flex: 1 1 100%; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
+    .cx-cp-filtres { justify-content: flex-start; }
+    .cx-cp-carte-parcours { position: relative; height: calc(100vh - var(--entete-hauteur, 85px) - 53px); }
+    .cx-cp[data-onglet="destinations"] .cx-cp-carte-parcours { display: none; }
+    .cx-cp-rideau { position: fixed; }
+}
+
+@media (max-width: 560px) {
+    .cx-cp-grille { gap: 18px 12px; margin-top: 22px; }
+    .cx-cp-carte__mention { top: 12px; left: 12px; font-size: 10px; letter-spacing: 0.1em; }
+    .cx-cp-carte__bas { left: 12px; right: 10px; bottom: 12px; gap: 8px; }
+    .cx-cp-carte__meta { margin-bottom: 6px; font-size: 10px; letter-spacing: 0.1em; }
+    .cx-cp-carte__nom { font-size: 1.2rem; }
+    .cx-cp-carte__ajout { width: 32px; height: 32px; }
+    .cx-cp-etape__rangee { grid-template-columns: 42px minmax(0, 1fr) auto; row-gap: 12px; }
+    .cx-cp-etape__numero,
+    .cx-cp-vide__numero { font-size: 1.7rem; }
+    .cx-cp-vide { grid-template-columns: 42px minmax(0, 1fr); }
+    .cx-cp-etape__retirer { position: absolute; top: 18px; right: 0; }
+    .cx-cp-etape__texte { padding-right: 20px; }
+    .cx-cp-etape__nuits { grid-column: 2 / -1; justify-self: start; margin-left: -8px; }
+    .cx-cp-etape__note { padding: 0 0 20px 52px; }
+    .cx-cp-cta { gap: 14px; padding: 16px 20px; letter-spacing: 0.1em; }
+    .cx-cp-actions__ligne { flex-wrap: nowrap; gap: 20px; }
+    .cx-cp-fiche__corps { padding: 32px 24px 24px; }
+    .cx-cp-fiche__pied { padding: 16px 24px 22px; }
+    .cx-cp-fiche__navigation { left: 24px; }
+    .cx-cp-fiche__tag-ligne { grid-template-columns: 1fr; gap: 6px; }
+    .cx-cp-bandeau { left: 16px; right: 16px; transform: none; justify-content: space-between; animation-name: cx-cp-bandeau-mobile; }
+}
+@keyframes cx-cp-bandeau-mobile { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
+
+
+/* ==========================================================================
+   MES CIRCUITS — /mes-circuits
+   ==========================================================================
+   Même langue que le créateur : la photographie en tête, le nom en serif,
+   une ligne en capitales, des liens soulignés.
+   -------------------------------------------------------------------------- */
+.cx-mc { padding: clamp(56px, 6vw, 96px) var(--cx-gutter, 64px) 0; }
+.cx-mc__nouveau { margin-top: 30px; }
+.cx-mc__attente { margin-top: 48px; }
+.cx-mc__erreur { margin-top: 28px; font-size: 14px; color: var(--brand-terre); }
+.cx-mc__grille { margin-top: clamp(44px, 5vw, 76px); display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 60px 32px; list-style: none; }
+.cx-mc-carte { display: flex; flex-direction: column; }
+.cx-mc-carte__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background-color: var(--bg-territoires); }
+.cx-mc-carte__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.6s cubic-bezier(0.16, 1, 0.3, 1); }
+.cx-mc-carte:hover .cx-mc-carte__media img { transform: scale(1.05); }
+.cx-mc-carte__vide { display: flex; align-items: center; justify-content: center; height: 100%; font-family: var(--font-title); font-size: 3.5rem; color: rgba(43, 33, 26, 0.26); }
+.cx-mc-carte__statut { position: absolute; top: 16px; left: 16px; }
+.cx-mc-carte__corps { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 22px 0 18px; }
+.cx-mc-carte__nom { font-family: var(--font-title); font-size: clamp(1.5rem, 1.9vw, 1.9rem); line-height: 1.05; color: var(--text-primary); transition: color 0.3s ease; }
+.cx-mc-carte__nom:hover { color: var(--brand-terre); }
+.cx-mc-carte__quand { font-family: var(--font-body-strong); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-secondary); }
+.cx-mc-carte__parcours { font-size: 13.5px; line-height: 1.65; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.cx-mc-carte__devis { align-self: flex-start; font-family: var(--font-body-strong); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--brand-terre); }
+.cx-mc-carte__maj { margin-top: auto; padding-top: 6px; font-size: 12px; color: var(--text-muted); }
+.cx-mc-carte__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; padding-top: 18px; border-top: 1px solid var(--border); }
+.cx-mc-carte__confirmer { font-size: 13px; color: var(--text-primary); }
+
+/* ---------- L'attente entre deux pages ------------------------------------
+   Un trait de 2 px sous le bord haut, qui va et vient tant que le module de
+   la page arrive. Il vit AU-DESSUS de tout (l'en-tête compris) et ne prend
+   jamais le clic : c'est une annonce, pas une interface.
+
+   L'opacité seule s'anime à l'apparition — jamais la hauteur, qui ferait
+   sauter la page d'un pixel à chaque navigation. Le va-et-vient est une
+   transformation, donc l'affaire du compositeur : il ne coûte rien, même
+   pendant que le navigateur décode la page qui arrive. */
+.cx-chargement {
+    position: fixed;
+    top: 0;
+    left: 0;
+    right: 0;
+    height: 2px;
+    z-index: 200;
+    pointer-events: none;
+    overflow: hidden;
+    opacity: 0;
+    transition: opacity 0.25s ease;
+}
+.cx-chargement--actif { opacity: 1; }
+.cx-chargement__trait {
+    display: block;
+    width: 40%;
+    height: 100%;
+    background-color: var(--brand-terre);
+    transform: translateX(-100%);
+}
+.cx-chargement--actif .cx-chargement__trait {
+    animation: cx-chargement-va-et-vient 1.15s cubic-bezier(0.65, 0, 0.35, 1) infinite;
+}
+@keyframes cx-chargement-va-et-vient {
+    0%   { transform: translateX(-100%); }
+    100% { transform: translateX(250%); }
+}
+/* Qui demande la sobriete garde l'annonce, sans le va-et-vient. */
+@media (prefers-reduced-motion: reduce) {
+    .cx-chargement--actif .cx-chargement__trait { animation: none; transform: translateX(0); width: 100%; }
+}
+
+.cx-visuellement-cache {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    margin: -1px;
+    padding: 0;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+    border: 0;
+}
