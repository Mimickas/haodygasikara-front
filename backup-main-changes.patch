+                <Link to="/mes-devis" className="cx-dv-recap__envoyer font-body-strong">
+                    Suivre ma demande <FaArrowRight size={11} />
+                </Link>
+                <Link to="/circuit" className="cx-dv-lien font-body-strong">Continuer la visite</Link>
