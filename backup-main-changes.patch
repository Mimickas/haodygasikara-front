+                                    onClick={() => setPostes((liste) => [...liste, posteVide()])}>
+                                    + Ajouter un poste
+                                </button>
+                                {d.hebergements?.some((h) => h.hotel) && (
+                                    <button type="button" className="ad-dv-ajout font-body-strong" disabled={envoi.enCours}
+                                        onClick={reprendreHebergements}>
+                                        + Reprendre les hébergements choisis
+                                    </button>
+                                )}
+                            </div>
+
+                            <div className="ad-dv-total">
+                                <span className="ad-dv-surtitre font-body-strong">Total du devis</span>
+                                <span className="font-title ad-dv-total__montant">{montantDevis(total, offre.devise)}</span>
+                                {parVoyageur != null && (
+                                    <span className="font-body ad-dv-muet">soit {montantDevis(parVoyageur, offre.devise)} par voyageur</span>
+                                )}
+                            </div>
+
+                            <div className="ad-dv-grille ad-dv-grille--deux">
+                                <label className="ad-dv-champ">
+                                    <span className="ad-dv-surtitre font-body-strong">Devise</span>
+                                    <input type="text" maxLength={3} value={offre.devise}
+                                        onChange={(e) => setOffre({ ...offre, devise: e.target.value.toUpperCase() })} className="ad-dv-saisie font-body" />
+                                </label>
+                                <label className="ad-dv-champ">
+                                    <span className="ad-dv-surtitre font-body-strong">Valable jusqu'au</span>
+                                    <input type="date" value={offre.validiteJusquau}
+                                        onChange={(e) => setOffre({ ...offre, validiteJusquau: e.target.value })} className="ad-dv-saisie font-body" />
+                                </label>
+                            </div>
+                            <label className="ad-dv-champ">
+                                <span className="ad-dv-surtitre font-body-strong">Message au voyageur</span>
+                                <textarea rows={4} value={offre.message} onChange={(e) => setOffre({ ...offre, message: e.target.value })}
+                                    placeholder="Ce qui est compris, ce qui a été adapté à sa demande…" className="ad-dv-saisie font-body" />
+                            </label>
+                            <div className="ad-dv-actions">
+                                <button type="button" className="ad-bouton ad-bouton--plein font-body-strong"
+                                    disabled={envoi.enCours || incomplet}
+                                    onClick={() => agir(() => proposerDevisApi(d.id, {
+                                        postes: postes.map((p) => ({
+                                            libelle: p.libelle.trim(),
+                                            quantite: Number(p.quantite),
+                                            prixUnitaire: Number(p.prixUnitaire),
+                                        })),
+                                        devise: offre.devise,
+                                        validiteJusquau: offre.validiteJusquau,
+                                        message: offre.message || null,
+                                    }))}>
+                                    {envoi.enCours ? "Envoi…" : "Envoyer le devis"}
+                                </button>
+                                <button type="button" className="ad-bouton font-body-strong" onClick={() => setMode(null)}>Annuler</button>
+                            </div>
+                            {incomplet && (
+                                <p className="font-body ad-dv-muet">Chaque poste doit avoir un libellé, une quantité et un prix.</p>
+                            )}
+                        </Bloc>
+                    )}
+
+                    {/* ── Décliner ─────────────────────────────────────── */}
+                    {mode === "decliner" && (
+                        <Bloc titre="Décliner la demande">
+                            <textarea rows={3} value={motif} onChange={(e) => setMotif(e.target.value)}
+                                placeholder="Le motif part au voyageur : complet à ces dates, circuit suspendu…" className="ad-dv-saisie font-body" />
+                            <div className="ad-dv-actions">
+                                <button type="button" className="ad-bouton ad-bouton--danger font-body-strong" disabled={envoi.enCours}
+                                    onClick={() => agir(() => declinerDevisApi(d.id, motif.trim() || null))}>
+                                    Décliner et prévenir le voyageur
+                                </button>
+                                <button type="button" className="ad-bouton font-body-strong" onClick={() => setMode(null)}>Annuler</button>
+                            </div>
+                        </Bloc>
+                    )}
+
+                    <Bloc titre="Historique">
+                        <ol className="ad-dv-historique">
+                            {d.historique.map((e, i) => (
+                                <li key={i} className="ad-dv-historique__etape">
+                                    <span className="font-body-strong">{e.libelle}</span>
+                                    <span className="font-body ad-dv-muet">
+                                        {formatDate(e.date)} · {e.auteur === "AGENCE" ? "agence" : "voyageur"}
+                                    </span>
+                                    {e.note && <span className="font-body ad-dv-texte">{e.note}</span>}
+                                </li>
+                            ))}
+                        </ol>
+                    </Bloc>
+
+                    <Bloc titre="Notes internes">
+                        <textarea rows={3} value={notes} onChange={(e) => setNotes(e.target.value)}
+                            placeholder="Visibles de l'agence seulement" className="ad-dv-saisie font-body" />
+                        <button type="button" className="ad-bouton font-body-strong"
+                            disabled={envoi.enCours || notes === (d.adminNotes ?? "")}
+                            onClick={() => agir(() => noterDevisApi(d.id, notes))}>
+                            Enregistrer les notes
+                        </button>
+                    </Bloc>
+
+                    {envoi.erreur && <p className="ad-erreur font-body" role="alert">{envoi.erreur}</p>}
+                </div>
+
+                {mode === null && (
+                    <footer className="ad-dv-dossier__pied">
+                        {statut === "ENVOYE" && (
+                            <button type="button" className="ad-bouton font-body-strong" disabled={envoi.enCours}
+                                onClick={() => agir(() => prendreEnChargeDevisApi(d.id))}>
+                                Prendre en charge
+                            </button>
+                        )}
+                        {peutProposer && (
+                            <button type="button" className="ad-bouton ad-bouton--plein font-body-strong" onClick={() => setMode("proposer")}>
+                                {statut === "EXPIRE" ? "Renouveler le devis" : "Rédiger le devis"}
+                            </button>
+                        )}
+                        {(statut === "ENVOYE" || statut === "EN_COURS") && (
+                            <button type="button" className="ad-bouton font-body-strong" onClick={() => setMode("decliner")}>
+                                Décliner
+                            </button>
+                        )}
+                        {statut === "PROPOSE" && (
+                            <p className="font-body ad-dv-muet">Devis envoyé : il attend la réponse du voyageur jusqu'au {formatDateCourte(d.validiteJusquau)}.</p>
+                        )}
+                        {statut === "ACCEPTE" && (
+                            <p className="font-body ad-dv-muet">Accepté : rappelez le voyageur pour finaliser.</p>
+                        )}
+                    </footer>
+                )}
+            </aside>
+        </div>
+    );
+}
+
+function Bloc({ titre, children }) {
+    return (
+        <section className="ad-dv-bloc">
+            <p className="ad-dv-surtitre font-body-strong">{titre}</p>
+            {children}
+        </section>
+    );
+}
+
+function Ligne({ g, d, fort = false }) {
+    return (
+        <div className={`ad-dv-ligne${fort ? " ad-dv-ligne--fort" : ""}`}>
+            <span className="font-body">{g}</span>
+            <span className="font-body-strong">{d}</span>
+        </div>
+    );
+}
diff --git a/src/pages/admin/login/LoginAdmin.jsx b/src/pages/admin/login/LoginAdmin.jsx
new file mode 100644
index 0000000..9fcf0f0
--- /dev/null
+++ b/src/pages/admin/login/LoginAdmin.jsx
@@ -0,0 +1,84 @@
+import { useState } from "react"
+import { useLocation, useNavigate } from "react-router-dom"
+import { useAuth } from "../../../hooks/useAuth"
+import CadreAccesAdmin, { ChampAcces } from "../../../components/admin/ui/acces/CadreAccesAdmin"
+import BandeauErreur from "../../../components/admin/ui/erreur/BandeauErreur"
+
+export default function LoginAdmin() {
+    const { login } = useAuth()
+    const navigate = useNavigate()
+    // « Votre email est vérifié », au retour de la page de vérification
+    const { state } = useLocation()
+    const [info] = useState(state?.message ?? "")
+    const [form, setForm] = useState({ email: "", password: "" })
+    const [error, setError] = useState("")
+    const [loading, setLoading] = useState(false)
+
+    async function handleSubmit(e) {
+        e.preventDefault()
+        setError("")
+
+        if (!form.email || !form.password) {
+            setError("Tous les champs sont requis.")
+            return
+        }
+
+        setLoading(true)
+        try {
+            await login(form, { adminOnly: true })
+        } catch (err) {
+            const data = err.response?.data
+            // Un administrateur tout juste créé n'a pas encore saisi son code :
+            // il le fait sur la page de vérification, puis se reconnecte.
+            if (data?.code === "EMAIL_NOT_VERIFIED") {
+                navigate("/verification", {
+                    state: {
+                        email: form.email,
+                        message: "Saisissez le code reçu par e-mail pour activer votre compte administrateur.",
+                        retour: "/admin/haodygasikara/login",
+                    },
+                })
+                return
+            }
+            if (data?.errors) {
+                setError(Object.values(data.errors)[0])
+            } else {
+                setError(data?.message || "Email ou mot de passe incorrect.")
+            }
+        } finally {
+            setLoading(false)
+        }
+    }
+
+    return (
+        <CadreAccesAdmin surtitre="Administration" titre="Connexion" texte="Accès réservé à l'équipe de l'agence.">
+            <form onSubmit={handleSubmit} className="ad-acces__formulaire" noValidate>
+                {info && !error && <p className="ad-note font-body">{info}</p>}
+                <BandeauErreur message={error} />
+
+                <ChampAcces
+                    id="admin-email"
+                    libelle="E-mail"
+                    type="email"
+                    autoComplete="username"
+                    value={form.email}
+                    setValue={val => setForm({ ...form, email: val })}
+                    placeholder="prenom@haodygasikara.com"
+                />
+                <ChampAcces
+                    id="admin-mot-de-passe"
+                    libelle="Mot de passe"
+                    type="password"
+                    autoComplete="current-password"
+                    value={form.password}
+                    setValue={val => setForm({ ...form, password: val })}
+                    placeholder="••••••••"
+                />
+
+                <button type="submit" disabled={loading} className="ad-bouton ad-bouton--plein ad-acces__envoi font-body-strong">
+                    {loading ? "Connexion…" : "Se connecter"}
+                </button>
+            </form>
+        </CadreAccesAdmin>
+    )
+}
diff --git a/src/pages/admin/poi/CategoryPois.jsx b/src/pages/admin/poi/CategoryPois.jsx
new file mode 100644
index 0000000..cbc890b
--- /dev/null
+++ b/src/pages/admin/poi/CategoryPois.jsx
@@ -0,0 +1,144 @@
+import { useEffect, useMemo, useState } from "react";
+import {
+    createCategoryPoiApi, findAllCategoryPoisApi,
+    updateCategoryPoiApi, deleteCategoryPoiApi,
+} from "../../../api/admin/categoryPoiApi";
+import { findAllPoisApi } from "../../../api/admin/poiApi";
+import FormModal from "../../../components/admin/crud/form/FormModal";
+import KpiCard from "../../../components/admin/shared/kpiCard/KpiCard";
+import DataTable from "../../../components/admin/ui/tableau/DataTable";
+import Toolbar from "../../../components/admin/ui/toolbar/Toolbar";
+import BandeauErreur from "../../../components/admin/ui/erreur/BandeauErreur";
+import dataTableConstant from "../../../constants/admin/dataTableConstant";
+import { useCategoryPoi } from "../../../hooks/admin/useCategoryPoi";
+import { parTexte, useListeAdmin } from "../../../hooks/admin/useListeAdmin";
+import { useSuppressionAdmin } from "../../../hooks/admin/useSuppressionAdmin";
+
+// ── Les catégories de points d'intérêt ─────────────────────────────────────
+// « Hébergement : oui » pour celles où l'on dort : elles seules se proposent
+// comme hébergement du soir dans les programmes.
+
+const FILTRES = [
+    { cle: "TOUTES", libelle: "Toutes", garde: () => true },
+    { cle: "HEBERGEMENTS", libelle: "Hébergements", garde: (c) => c.isHebergement },
+    { cle: "AUTRES", libelle: "Visites et activités", garde: (c) => !c.isHebergement },
+];
+
+export default function CategoryPois() {
+    const { open, setOpen, actions, fields } = useCategoryPoi();
+    const [categoryPois, setCategoryPois] = useState([]);
+    const [pois, setPois] = useState([]);   // ← sert uniquement aux indicateurs d'utilisation
+    const [value, setValue] = useState({});
+    const [loadingFetch, setLoadingFetch] = useState({ loadingCategoryPois: true, loadingPois: true });
+
+    const loadCategoryPois = async () => {
+        try {
+            const response = await findAllCategoryPoisApi();
+            setCategoryPois(response?.data ?? []);
+        } catch (error) {
+            console.error("Erreur lors de la récupération des catégories de POI :", error);
+        } finally {
+            setLoadingFetch(prev => ({ ...prev, loadingCategoryPois: false }));
+        }
+    };
+
+    const loadPois = async () => {
+        try {
+            const response = await findAllPoisApi();
+            setPois(response?.data ?? []);
+        } catch (error) {
+            console.error("Erreur lors de la récupération des points d'intérêt :", error);
+        } finally {
+            setLoadingFetch(prev => ({ ...prev, loadingPois: false }));
+        }
+    };
+
+    useEffect(() => {
+        loadCategoryPois();
+        loadPois();
+    }, []);
+
+    const recharger = async () => { await loadCategoryPois(); await loadPois(); };
+
+    const kpiItems = useMemo(() => {
+        const usedIds      = new Set(pois.map(p => p.categoryPoi?.id).filter(Boolean));
+        const utilisees    = categoryPois.filter(c => usedIds.has(c.id)).length;
+        const hebergements = categoryPois.filter(c => c.isHebergement).length;
+        const rattaches    = pois.filter(p => p.categoryPoi?.id).length;
+        return [
+            { label: "Total catégories", value: categoryPois.length, hint: categoryPois.length > 1 ? "catégories enregistrées" : "catégorie enregistrée", accent: "var(--brand-lagune)" },
+            { label: "Utilisées",        value: utilisees,           hint: `${categoryPois.length - utilisees} supprimable(s) sans impact`,                    accent: "var(--brand-nature)" },
+            { label: "Hébergements",     value: hebergements,        hint: "catégories où l'on passe la nuit",                                                 accent: "var(--brand-ocre)"   },
+            { label: "POI rattachés",    value: rattaches,           hint: "points d'intérêt classés par catégorie",                                          accent: "var(--brand-terre)"  },
+        ];
+    }, [categoryPois, pois]);
+
+    const liste = useListeAdmin(categoryPois, {
+        recherche: (c) => [c.name, c.code],
+        filtres: FILTRES,
+        tris: [{ cle: "NOM", libelle: "Nom, de A à Z", comparer: parTexte("name") }],
+        export: { nom: "categories-poi", colonnes: dataTableConstant.categoryPoiColumns },
+    });
+
+    const suppression = useSuppressionAdmin({
+        supprimer: deleteCategoryPoiApi,
+        apres: recharger,
+        titre: "Supprimer cette catégorie ?",
+        texte: "Une catégorie encore utilisée par un point d'intérêt ne peut pas être supprimée.",
+    });
+
+    const handleEdit = async (id) => {
+        const categoryPoi = categoryPois.find(c => c.id === id);
+        setValue({
+            id:            categoryPoi?.id,
+            name:          categoryPoi?.name,
+            code:          categoryPoi?.code,
+            isHebergement: String(categoryPoi?.isHebergement ?? false),
+        });
+        await actions.edit();
+    };
+
+    // Un refus du serveur (doublon, hébergement déjà utilisé) s'affiche dans la fenêtre
+    const handleSubmit = async (data) => {
+        const payload = {
+            name:          data.name,
+            code:          data.code,
+            isHebergement: data.isHebergement === "true",
+        };
+        if (value?.id) await updateCategoryPoiApi(value.id, payload);
+        else await createCategoryPoiApi(payload);
+        await recharger();
+        setValue({});
+    };
+
+    return <>
+        <Toolbar liste={liste} placeholder="Rechercher une catégorie…" actions={[
+            { libelle: "Exporter", onClick: liste.exporter },
+            { libelle: "Nouvelle catégorie", onClick: () => { setValue({}); actions.create(); }, primaire: true },
+        ]} />
+
+        <BandeauErreur message={suppression.erreur} onFermer={() => suppression.setErreur(null)} />
+        <KpiCard items={kpiItems} loading={loadingFetch.loadingCategoryPois || loadingFetch.loadingPois} />
+
+        <DataTable
+            columns={dataTableConstant.categoryPoiColumns}
+            data={liste.lignes}
+            loading={loadingFetch.loadingCategoryPois}
+            onRowClick={(c) => handleEdit(c.id)}
+            onEdit={handleEdit}
+            onDelete={suppression.demander}
+            aucunResultat={liste.aucunResultat}
+            vide={{ titre: "Aucune catégorie", texte: "Hôtel, lodge, visite, activité : les catégories classent les points d'intérêt." }}
+        />
+
+        <FormModal
+            open={open}
+            onClose={() => { setOpen(false); setValue({}); }}
+            onSubmit={handleSubmit}
+            fields={fields}
+            value={value}
+            title={value?.id ? "Modifier la catégorie" : "Nouvelle catégorie"}
+        />
+        {suppression.modale}
+    </>;
+}
diff --git a/src/pages/admin/poi/Pois.jsx b/src/pages/admin/poi/Pois.jsx
new file mode 100644
index 0000000..1878ce6
--- /dev/null
+++ b/src/pages/admin/poi/Pois.jsx
@@ -0,0 +1,192 @@
+import { useEffect, useMemo, useState } from "react";
+import {
+    createPoiApi, findAllPoisApi,
+    updatePoiApi, deletePoiApi, changerDisponibilitePoiApi,
+} from "../../../api/admin/poiApi";
+import FormModal from "../../../components/admin/crud/form/FormModal";
+import KpiCard from "../../../components/admin/shared/kpiCard/KpiCard";
+import DataTable from "../../../components/admin/ui/tableau/DataTable";
+import Toolbar from "../../../components/admin/ui/toolbar/Toolbar";
+import BandeauErreur from "../../../components/admin/ui/erreur/BandeauErreur";
+import dataTableConstant from "../../../constants/admin/dataTableConstant";
+import { usePoi } from "../../../hooks/admin/usePoi";
+import { parDate, parNombre, parTexte, useListeAdmin } from "../../../hooks/admin/useListeAdmin";
+import { useSuppressionAdmin } from "../../../hooks/admin/useSuppressionAdmin";
+import { apiErrorMessage } from "../../../utils/apiError";
+
+// ── Les points d'intérêt : visites, activités, hébergements ───────────────
+// Un hébergement se retire de la vente d'un clic : il disparaît de tous les
+// choix proposés aux voyageurs, sans toucher aux programmes.
+
+const FILTRES = [
+    { cle: "TOUS", libelle: "Tous", garde: () => true },
+    { cle: "HEBERGEMENTS", libelle: "Hébergements", garde: (p) => p.categoryPoi?.isHebergement },
+    { cle: "VISITES", libelle: "Visites et activités", garde: (p) => !p.categoryPoi?.isHebergement },
+    { cle: "RETIRES", libelle: "Retirés de la vente", garde: (p) => p.categoryPoi?.isHebergement && p.disponible === false },
+];
+
+const TRIS = [
+    { cle: "NOM", libelle: "Nom, de A à Z", comparer: parTexte("nom") },
+    { cle: "RECENTS", libelle: "Plus récents", comparer: parDate("createdAt") },
+    { cle: "ETOILES", libelle: "Mieux notés", comparer: parNombre("stars") },
+];
+
+export default function Pois() {
+    const { open, setOpen, actions, fields } = usePoi();
+    const [pois, setPois] = useState([]);
+    const [value, setValue] = useState({});
+    const [erreur, setErreur] = useState(null);
+    const [loadingFetch, setLoadingFetch] = useState({ loadingPois: true });
+
+    const loadPois = async () => {
+        try {
+            const response = await findAllPoisApi();
+            setPois(response?.data ?? []);
+        } catch (error) {
+            console.error("Erreur lors de la récupération des points d'intérêt :", error);
+        } finally {
+            setLoadingFetch(prev => ({ ...prev, loadingPois: false }));
+        }
+    };
+
+    useEffect(() => {
+        loadPois();
+    }, []);
+
+    const kpiItems = useMemo(() => {
+        const destinationIds = new Set(pois.map(p => p.destinationId).filter(Boolean));
+        const hebergements   = pois.filter(p => p.categoryPoi?.isHebergement).length;
+        const retires        = pois.filter(p => p.categoryPoi?.isHebergement && p.disponible === false).length;
+        const avecPhoto      = pois.filter(p => p.imageUrls?.length).length;
+        return [
+            { label: "Total POI",              value: pois.length,         hint: pois.length > 1 ? "points d'intérêt enregistrés" : "point d'intérêt enregistré", accent: "var(--brand-lagune)" },
+            { label: "Destinations couvertes", value: destinationIds.size, hint: "destinations ayant au moins un POI",                                           accent: "var(--brand-nature)" },
+            { label: "Hébergements",           value: hebergements,        hint: retires ? `${retires} retiré(s) de la vente` : "tous proposés aux voyageurs",   accent: "var(--brand-ocre)"   },
+            { label: "Avec photos",            value: avecPhoto,           hint: `${pois.length - avecPhoto} sans photo`,                                        accent: "var(--brand-terre)"  },
+        ];
+    }, [pois]);
+
+    const basculerDisponibilite = async (poi, disponible) => {
+        try {
+            const response = await changerDisponibilitePoiApi(poi.id, disponible);
+            setPois(list => list.map(p => (p.id === poi.id ? response?.data ?? p : p)));
+            setErreur(null);
+        } catch (error) {
+            setErreur(apiErrorMessage(error, "La disponibilité n'a pas pu être changée."));
+        }
+    };
+
+    const columns = useMemo(() => dataTableConstant.poiColumns.flatMap(col => col.key !== "stars" ? [col] : [col, {
+        key: "disponible",
+        label: "En vente",
+        render: (val, row) => row?.categoryPoi?.isHebergement
+            ? <BasculeDisponibilite disponible={val !== false} onBasculer={() => basculerDisponibilite(row, val === false)} />
+            : "—",
+        texte: (val, row) => row?.categoryPoi?.isHebergement ? (val !== false ? "Disponible" : "Indisponible") : "",
+    }]), []);   // eslint-disable-line react-hooks/exhaustive-deps
+
+    const liste = useListeAdmin(pois, {
+        recherche: (p) => [p.nom, p.destinationNom, p.categoryPoi?.name, p.description],
+        filtres: FILTRES,
+        tris: TRIS,
+        export: { nom: "points-d-interet", colonnes: columns },
+    });
+
+    const suppression = useSuppressionAdmin({
+        supprimer: deletePoiApi,
+        apres: loadPois,
+        titre: "Supprimer ce point d'intérêt ?",
+        texte: "Ses photos et sa vidéo partent avec lui. Un point d'intérêt encore au programme d'un circuit ne peut pas être supprimé.",
+    });
+
+    const handleEdit = async (id) => {
+        const poi = pois.find(p => p.id === id);
+        setValue({
+            id:            poi?.id,
+            destinationId: poi?.destinationId,
+            categoryPoiId: poi?.categoryPoi?.id,
+            nom:           poi?.nom,
+            stars:         poi?.stars,
+            description:   poi?.description,
+            lat:           poi?.lat,
+            lng:           poi?.lng,
+            imageUrls:     poi?.imageUrls ?? [],
+            videoUrl:      poi?.videoUrl ?? "",
+        });
+        await actions.edit();
+    };
+
+    // Un refus du serveur (POI au programme, champ invalide) s'affiche dans la fenêtre
+    const handleSubmit = async (data) => {
+        const payload = {
+            destinationId: data.destinationId ? Number(data.destinationId) : null,
+            categoryPoiId: data.categoryPoiId ? Number(data.categoryPoiId) : null,
+            nom:           data.nom,
+            stars:         data.stars === "" ? null : Number(data.stars),
+            description:   data.description || null,
+            lat:           data.lat === "" ? null : Number(data.lat),
+            lng:           data.lng === "" ? null : Number(data.lng),
+            imageUrls:     data.imageUrls ?? [],    // ← déjà envoyées par FormModal : la première est la couverture
+            videoUrl:      data.videoUrl || null,
+        };
+        if (value?.id) await updatePoiApi(value.id, payload);
+        else await createPoiApi(payload);
+        await loadPois();
+        setValue({});
+    };
+
+    return <>
+        <Toolbar liste={liste} placeholder="Rechercher un lieu, une destination…" actions={[
+            { libelle: "Exporter", onClick: liste.exporter },
+            { libelle: "Nouveau point d'intérêt", onClick: () => { setValue({}); actions.create(); }, primaire: true },
+        ]} />
+
+        <BandeauErreur message={suppression.erreur ?? erreur} onFermer={() => { suppression.setErreur(null); setErreur(null); }} />
+        <KpiCard items={kpiItems} loading={loadingFetch.loadingPois} />
+
+        <DataTable
+            columns={columns}
+            data={liste.lignes}
+            loading={loadingFetch.loadingPois}
+            onRowClick={(p) => handleEdit(p.id)}
+            onEdit={handleEdit}
+            onDelete={suppression.demander}
+            aucunResultat={liste.aucunResultat}
+            vide={{ titre: "Aucun point d'intérêt", texte: "Hôtels, lodges, visites, activités : ils composent le programme des circuits." }}
+        />
+
+        <FormModal
+            open={open}
+            onClose={() => { setOpen(false); setValue({}); }}
+            onSubmit={handleSubmit}
+            fields={fields}
+            value={value}
+            title={value?.id ? "Modifier le point d'intérêt" : "Nouveau point d'intérêt"}
+        />
+        {suppression.modale}
+    </>;
+}
+
+// Un hébergement indisponible n'est plus proposé aux voyageurs (fiches et
+// demandes de devis) mais reste au programme des circuits, prêt à revenir.
+function BasculeDisponibilite({ disponible, onBasculer }) {
+    const [enCours, setEnCours] = useState(false);
+    const couleur = disponible ? "var(--brand-nature)" : "var(--text-muted)";
+    return (
+        <button
+            type="button"
+            disabled={enCours}
+            title={disponible ? "Retirer de la vente" : "Remettre en vente"}
+            onClick={async (e) => {
+                e.stopPropagation();
+                setEnCours(true);
+                try { await onBasculer(); } finally { setEnCours(false); }
+            }}
+            className="inline-flex items-center gap-2 px-3 py-1.5 font-body-strong text-[10px] uppercase cursor-pointer transition-opacity"
+            style={{ letterSpacing: "0.1em", color: couleur, border: `1px solid ${disponible ? "var(--brand-nature)" : "var(--border-strong)"}`, opacity: enCours ? 0.5 : 1 }}
+        >
+            <span style={{ width: 6, height: 6, backgroundColor: couleur }} />
+            {disponible ? "Disponible" : "Indisponible"}
+        </button>
+    );
+}
diff --git a/src/pages/admin/register/RegisterAdmin.jsx b/src/pages/admin/register/RegisterAdmin.jsx
new file mode 100644
index 0000000..ae66707
--- /dev/null
+++ b/src/pages/admin/register/RegisterAdmin.jsx
@@ -0,0 +1,96 @@
+import { useState } from "react"
+import { Link } from "react-router-dom"
+import { registerAdminApi } from "../../../api/authApi"
+import CadreAccesAdmin, { ChampAcces } from "../../../components/admin/ui/acces/CadreAccesAdmin"
+import BandeauErreur from "../../../components/admin/ui/erreur/BandeauErreur"
+
+const VIDE = { nom: "", prenom: "", email: "", password: "", confirmPassword: "" }
+
+// Première installation : le tout premier administrateur. Le serveur refuse
+// cette route dès qu'un administrateur existe ; les suivants se créent depuis
+// Administration → Utilisateurs.
+export default function RegisterAdmin() {
+    const [form, setForm] = useState(VIDE)
+    const [error, setError] = useState("")
+    const [success, setSuccess] = useState("")
+    const [loading, setLoading] = useState(false)
+
+    const champ = (cle) => (val) => setForm({ ...form, [cle]: val })
+
+    async function handleSubmit(e) {
+        e.preventDefault()
+        setError("")
+        setSuccess("")
+
+        if (!form.nom || !form.prenom || !form.email || !form.password || !form.confirmPassword) {
+            setError("Tous les champs sont requis.")
+            return
+        }
+
+        if (form.password.length < 8) {
+            setError("Le mot de passe doit contenir au moins 8 caractères.")
+            return
+        }
+
+        if (form.password !== form.confirmPassword) {
+            setError("Les mots de passe ne correspondent pas.")
+            return
+        }
+
+        setLoading(true)
+        try {
+            // confirmPassword ne part pas au back
+            const response = await registerAdminApi({
+                nom: form.nom,
+                prenom: form.prenom,
+                email: form.email,
+                password: form.password,
+            })
+
+            setSuccess(response.message || "Administrateur créé : vérifiez votre adresse e-mail.")
+            setForm(VIDE)
+
+        } catch (err) {
+            // ApiResponse d'erreur → { message, errors, ... }
+            const data = err.response?.data
+            if (data?.errors) {
+                // Erreurs de validation @Valid → prend le premier message
+                setError(Object.values(data.errors)[0])
+            } else {
+                setError(data?.message || "Une erreur est survenue.")
+            }
+        } finally {
+            setLoading(false)
+        }
+    }
+
+    return (
+        <CadreAccesAdmin
+            surtitre="Installation"
+            titre="Premier administrateur"
+            texte="Le compte principal de l'agence. Les suivants se créent ensuite depuis Administration → Utilisateurs."
+        >
+            <form onSubmit={handleSubmit} className="ad-acces__formulaire" noValidate>
+                <BandeauErreur message={error} />
+                {success && (
+                    <p className="ad-note ad-note--succes font-body">
+                        {success}{" "}
+                        <Link to="/admin/haodygasikara/login" className="ad-acces__lien font-body-strong">Se connecter</Link>
+                    </p>
+                )}
+
+                <div className="ad-acces__rangee">
+                    <ChampAcces id="admin-nom" libelle="Nom" autoComplete="family-name" value={form.nom} setValue={champ("nom")} placeholder="Rakoto" />
+                    <ChampAcces id="admin-prenom" libelle="Prénom" autoComplete="given-name" value={form.prenom} setValue={champ("prenom")} placeholder="Jean" />
+                </div>
+                <ChampAcces id="admin-email" libelle="E-mail" type="email" autoComplete="email" value={form.email} setValue={champ("email")} placeholder="prenom@haodygasikara.com" />
+                <ChampAcces id="admin-mot-de-passe" libelle="Mot de passe" type="password" autoComplete="new-password" value={form.password} setValue={champ("password")} placeholder="8 caractères au moins" />
+                <ChampAcces id="admin-confirmation" libelle="Confirmer le mot de passe" type="password" autoComplete="new-password" value={form.confirmPassword} setValue={champ("confirmPassword")} placeholder="••••••••" />
+
+                <button type="submit" disabled={loading} className="ad-bouton ad-bouton--plein ad-acces__envoi font-body-strong">
+                    {loading ? "Création…" : "Créer le compte"}
+                </button>
+            </form>
+        </CadreAccesAdmin>
+    )
+}
diff --git a/src/pages/admin/tags/Tags.jsx b/src/pages/admin/tags/Tags.jsx
new file mode 100644
index 0000000..92e3218
--- /dev/null
+++ b/src/pages/admin/tags/Tags.jsx
@@ -0,0 +1,130 @@
+import { useEffect, useState } from "react";
+import { createTagsApi, deleteTagApi, findAllTags, getTagStatsApi, updateTagApi } from "../../../api/admin/tag";
+import FormModal from "../../../components/admin/crud/form/FormModal";
+import KpiCard from "../../../components/admin/shared/kpiCard/KpiCard";
+import DataTable from "../../../components/admin/ui/tableau/DataTable";
+import Toolbar from "../../../components/admin/ui/toolbar/Toolbar";
+import BandeauErreur from "../../../components/admin/ui/erreur/BandeauErreur";
+import dataTableConstant from "../../../constants/admin/dataTableConstant";
+import { useTags } from "../../../hooks/admin/useTags";
+import { parDate, parTexte, useListeAdmin } from "../../../hooks/admin/useListeAdmin";
+import { useSuppressionAdmin } from "../../../hooks/admin/useSuppressionAdmin";
+import { slugifier } from "../../../utils/format";
+
+// ── Les étiquettes : thématique, région, type d'activité… ────────────────
+// Elles filtrent le créateur de circuit, nourrissent les suggestions « même
+// esprit » et les envies des voyageurs.
+
+const emptyStat = { value: 0, trend: "" };
+
+const TRIS = [
+    { cle: "NOM", libelle: "Nom, de A à Z", comparer: parTexte("name") },
+    { cle: "RECENTES", libelle: "Plus récentes", comparer: parDate("createdAt") },
+];
+
+export default function Tags() {
+    const { open, setOpen, actions, fields } = useTags();
+    const [tags, setTags] = useState([]);
+    const [value, setValue] = useState({});
+    const [stats, setStats] = useState({
+        total: emptyStat, used: emptyStat, orphans: emptyStat, grouped: emptyStat,
+    });
+    const [loadingFetch, setLoadingFetch] = useState({ loadingStats: true, loadingTags: true });
+
+    const loadTags = async () => {
+        try {
+            const response = await findAllTags();
+            setTags(response?.data ?? []);
+        } catch (error) {
+            console.error("Erreur lors de la récupération des étiquettes :", error);
+        } finally {
+            setLoadingFetch(prev => ({ ...prev, loadingTags: false }));
+        }
+    };
+
+    const loadStats = async () => {
+        try {
+            const response = await getTagStatsApi();
+            setStats(response.data.data);
+        } catch (error) {
+            console.error("Erreur stats étiquettes :", error);
+        } finally {
+            setLoadingFetch(prev => ({ ...prev, loadingStats: false }));
+        }
+    };
+
+    useEffect(() => {
+        loadTags();
+        loadStats();
+    }, []);
+
+    const recharger = async () => { await loadTags(); await loadStats(); };
+
+    const groupes = [...new Set(tags.map((t) => t.tagGroup?.name).filter(Boolean))];
+    const liste = useListeAdmin(tags, {
+        recherche: (t) => [t.name, t.slug, t.tagGroup?.name],
+        filtres: [{ cle: "TOUS", libelle: "Toutes", garde: () => true },
+            ...groupes.map((g) => ({ cle: g, libelle: g, garde: (t) => t.tagGroup?.name === g }))],
+        tris: TRIS,
+        export: { nom: "etiquettes", colonnes: dataTableConstant.tagColumns },
+    });
+
+    const suppression = useSuppressionAdmin({
+        supprimer: deleteTagApi,
+        apres: recharger,
+        titre: "Supprimer cette étiquette ?",
+        texte: "Une étiquette encore portée par une destination ne peut pas être supprimée.",
+    });
+
+    const kpiItems = [
+        { label: "Total des étiquettes", value: stats.total.value,   hint: stats.total.trend,   accent: "var(--brand-lagune)" },
+        { label: "Utilisées",            value: stats.used.value,    hint: stats.used.trend,    accent: "var(--brand-nature)" },
+        { label: "Orphelines",           value: stats.orphans.value, hint: stats.orphans.trend, accent: "var(--brand-ocre)"   },
+        { label: "Groupées",             value: stats.grouped.value, hint: stats.grouped.trend, accent: "var(--brand-terre)"  },
+    ];
+
+    const handleEdit = async (id) => {
+        const tag = tags.find(t => t.id === id);
+        setValue({ id: tag?.id, name: tag?.name, slug: tag?.slug, idTagGroup: tag?.tagGroup?.id });
+        await actions.edit();
+    };
+
+    const handleSubmit = async (data) => {
+        const payload = { ...data, slug: data.slug?.trim() || slugifier(data.name) };
+        if (value?.id) await updateTagApi(value.id, payload);
+        else await createTagsApi(payload);
+        await recharger();
+        setValue({});
+    };
+
+    return <>
+        <Toolbar liste={liste} placeholder="Rechercher une étiquette…" actions={[
+            { libelle: "Exporter", onClick: liste.exporter },
+            { libelle: "Nouvelle étiquette", onClick: () => { setValue({}); actions.create(); }, primaire: true },
+        ]} />
+
+        <BandeauErreur message={suppression.erreur} onFermer={() => suppression.setErreur(null)} />
+        <KpiCard items={kpiItems} loading={loadingFetch.loadingStats} />
+
+        <DataTable
+            columns={dataTableConstant.tagColumns}
+            data={liste.lignes}
+            loading={loadingFetch.loadingTags}
+            onRowClick={(t) => handleEdit(t.id)}
+            onEdit={handleEdit}
+            onDelete={suppression.demander}
+            aucunResultat={liste.aucunResultat}
+            vide={{ titre: "Aucune étiquette", texte: "Les étiquettes décrivent les destinations : thématique, région, activité." }}
+        />
+
+        <FormModal
+            open={open}
+            onClose={() => { setOpen(false); setValue({}); }}
+            onSubmit={handleSubmit}
+            fields={fields}
+            value={value}
+            title={value?.id ? "Modifier l'étiquette" : "Nouvelle étiquette"}
+        />
+        {suppression.modale}
+    </>;
+}
diff --git a/src/pages/admin/tags/TagsGroup.jsx b/src/pages/admin/tags/TagsGroup.jsx
