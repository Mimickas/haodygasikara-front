+
+// ── Vos paramètres — /mon-compte ──────────────────────────────────────────
+//
+// ── Ce qui a été refait, et pourquoi ────────────────────────────────────
+// Première version : un portrait de 112 px, deux lignes de texte sur le fond
+// clair, puis trois volets. Verdict du client : « c'est ergonomique, c'est de
+// la merde […] regarde dans home un espace très très luxe et premium et riche
+// moderne, là c'est direct un bas de gamme. » Le reproche est juste : un écran
+// de compte composé comme un formulaire EST un formulaire.
+//
+// Ce qui fait la richesse de l'accueil tient à trois choses, et aucune n'était
+// là : de la PHOTOGRAPHIE PLEIN CADRE, un titre en très grand corps, un filet
+// d'un pixel en pied. La page ouvre donc maintenant sur un hero photographique
+// qui porte le nom du voyageur en titre de une — exactement comme l'accueil
+// ouvre sur « Composez votre Madagascar ».
+//
+// Et les réglages reprennent LE RYTHME ÉDITORIAL DE « VOTRE VOYAGE EN TROIS
+// GESTES » : douze colonnes, le numéro en Abhaya clair sur deux colonnes, le
+// titre sur quatre, le propos sur six, un filet d'un pixel entre chaque et un
+// filet de fermeture. Rien d'inventé : c'est la grammaire de l'accueil, posée
+// sur un autre contenu.
+//
+// Un seul volet ouvert à la fois : trois formulaires dépliés ensemble, c'est un
+// écran d'administration, et surtout on ne sait plus lequel des trois boutons
+// « Enregistrer » on vient d'utiliser.
+export default function MonCompte() {
+    const { isAuthenticated } = useAuth();
+
+    const [compte, setCompte] = useState(null);
+    const [etat, setEtat] = useState("chargement");   // chargement | pret | erreur
+    const [ouvert, setOuvert] = useState(null);
+    // Les envies de voyage : null tant qu'elles ne sont pas lues
+    const [envies, setEnvies] = useState(null);
+
+    const charger = useCallback(async () => {
+        if (!isAuthenticated) {
+            setEtat("pret");
+            return;
+        }
+        setEtat("chargement");
+        try {
+            const reponse = await findMonCompteApi();
+            setCompte(reponse?.data ?? null);
+            setEtat("pret");
+            // Secondaires : une panne ne doit pas masquer le reste du compte
+            findPreferencesApi().then((r) => setEnvies(r?.data ?? [])).catch(() => setEnvies([]));
+        } catch (error) {
+            console.error("Chargement du compte impossible", error);
+            setEtat("erreur");
+        }
+    }, [isAuthenticated]);
+
+    useEffect(() => { charger(); }, [charger]);
+
+    const pret = etat === "pret" && Boolean(compte);
+
+    // Le hero s'ouvre au chargement ; les réglages se révèlent au défilement.
+    useCompteHero(pret);
+    useRevelation(
+        [
+            { cible: ".cx-param .cx-tete > *", y: 34, stagger: 0.09 },
+            { cible: ".cx-reglage", y: 34, stagger: 0.09, depart: "top 92%" },
+            { cible: ".cx-param__vide", y: 28 },
+        ],
+        etat === "pret"
+    );
+
+    const basculer = (cle) => setOuvert((actuel) => (actuel === cle ? null : cle));
+
+    // Le compte rendu par le serveur remplace le précédent : les blocs
+    // n'inventent jamais l'état d'après, ils affichent celui que la réponse
+    // leur donne.
+    const majCompte = (frais) => setCompte(frais);
+
+    // ── Le hero est monté DÈS QUE le compte est connecté ────────────────
+    //
+    // Et pas seulement quand ses données arrivent, contrairement à la première
+    // version. La raison est mesurée : `useHeaderTextColor` recense les
+    // sections porteuses de `data-header-text` au changement de route, une fois.
+    // Le hero n'existant pas encore à cet instant, il n'était jamais observé —
+    // et la barre restait encrée en SOMBRE au-dessus de la photographie sombre,
+    // logo compris. Relevé dans le navigateur : « rgb(43, 33, 26) » là où il
+    // fallait du clair.
+    //
+    // Le hero a une hauteur fixe, donc le monter vide ne provoque aucun saut :
+    // la photographie s'affiche tout de suite, le texte apparaît dedans.
+    return (
+        <>
+            {isAuthenticated && <HeroCompte compte={compte} onMaj={majCompte} />}
+
+            <div className={`cx-detail${isAuthenticated ? "" : " cx-sous-entete"}`}>
+                <section className="cx-param" data-header-text="var(--text-primary)">
+
+                    <div className="cx-tete cx-tete--seule">
+                        <span className="cx-tete__mention cx-label cx-label--accent font-body-strong">
+                            {isAuthenticated ? "Votre compte" : "Espace voyageur"}
+                        </span>
+                        <h1 className="cx-tete__titre font-title">
+                            {isAuthenticated ? (
+                                <>Ce que vous pouvez<br />changer ici.</>
+                            ) : (
+                                <>Vos param&egrave;tres</>
+                            )}
+                        </h1>
+                        {isAuthenticated && (
+                            <p className="cx-tete__chapo font-body">
+                                Votre identit&eacute;, votre adresse de connexion, votre mot de
+                                passe et vos envies de voyage. Ce que vous modifiez ici vaut pour
+                                vos demandes de devis comme pour nos messages.
+                            </p>
+                        )}
+                    </div>
+
+                    {!isAuthenticated ? (
+                        <Vide
+                            texte="Connectez-vous pour accéder aux paramètres de votre compte."
+                            lien="/login"
+                            action="Se connecter"
+                        />
+                    ) : etat === "chargement" ? (
+                        <p className="cx-param__vide cx-label cx-label--legende font-body-strong">
+                            Chargement&hellip;
+                        </p>
+                    ) : !pret ? (
+                        <Vide
+                            texte="Vos informations n'ont pas pu être chargées. Réessayez dans un instant."
+                            lien="/circuit"
+                            action="Voir les circuits"
+                        />
+                    ) : (
+                    <ol className="cx-reglages">
+                        <Reglage
+                            numero="01"
+                            titre="Votre identité"
+                            propos="Le nom qui figure sur vos demandes de devis et le numéro auquel nous vous joignons."
+                            valeur={[compte.prenom, compte.nom].filter(Boolean).join(" ")}
+                            ouvert={ouvert === "identite"}
+                            onBasculer={() => basculer("identite")}
+                        >
+                            <BlocIdentite compte={compte} onMaj={majCompte} />
+                        </Reglage>
+
+                        <Reglage
+                            numero="02"
+                            titre="Adresse e-mail"
+                            propos="Celle qui vous connecte, et par laquelle passent toutes nos confirmations de voyage."
+                            valeur={
+                                compte.emailEnAttente
+                                    ? `${compte.email} — changement en cours`
+                                    : compte.email
+                            }
+                            ouvert={ouvert === "email"}
+                            onBasculer={() => basculer("email")}
+                        >
+                            <BlocEmail compte={compte} onMaj={majCompte} />
+                        </Reglage>
+
+                        <Reglage
+                            numero="03"
+                            titre="Mot de passe"
+                            propos="Il vous sera redemandé pour toute modification qui touche l'accès au compte."
+                            valeur={compte.motDePasse === false ? "Aucun : connexion avec Google" : "Modifiable depuis cet écran"}
+                            ouvert={ouvert === "motdepasse"}
+                            onBasculer={() => basculer("motdepasse")}
+                        >
+                            <BlocMotDePasse compte={compte} />
+                        </Reglage>
+
+                        <Reglage
+                            numero="04"
+                            titre="Vos envies de voyage"
+                            propos="Les thèmes qui vous attirent : le créateur de circuit vous propose d'abord les destinations qui leur ressemblent."
+                            valeur={envies == null ? "…" : envies.length ? envies.map((t) => t.nom).join(", ") : "Aucune pour l'instant"}
+                            ouvert={ouvert === "envies"}
+                            onBasculer={() => basculer("envies")}
+                        >
+                            {envies == null
+                                ? <p className="cx-param__texte font-body">Chargement…</p>
+                                : <BlocPreferences envies={envies} onMaj={setEnvies} />}
+                        </Reglage>
+
+                        {/* Le filet de fermeture, comme sous « trois gestes » de
+                            l'accueil : sans lui la liste s'arrête dans le vide. */}
+                        <li aria-hidden style={{ borderTop: "1px solid var(--border)" }} />
+                    </ol>
+                    )}
+
+                    <p className="cx-param__pied font-body">
+                        Une question sur votre compte&nbsp;?{" "}
+                        <a href={`mailto:${CONTACT.email}`} className="cx-param__accent">
+                            {CONTACT.email}
+                        </a>
+                    </p>
+
+                </section>
+            </div>
+        </>
+    );
+}
+
+function Vide({ texte, lien, action }) {
+    return (
+        <div className="cx-param__vide">
+            <p className="cx-param__vide-texte font-body">{texte}</p>
+            <Link
+                to={lien}
+                className="cx-devis__bouton font-body-strong"
+                style={{ marginTop: "clamp(22px,2.4vw,30px)" }}
+            >
+                {action}
+            </Link>
+        </div>
+    );
+}
diff --git a/src/pages/client/monCompte/components/Avis.jsx b/src/pages/client/monCompte/components/Avis.jsx
new file mode 100644
index 0000000..e4a79ef
--- /dev/null
+++ b/src/pages/client/monCompte/components/Avis.jsx
@@ -0,0 +1,18 @@
+/**
+ * Le retour du serveur, sous le formulaire qui l'a provoqué.
+ *
+ * Deux tons seulement, et ils viennent des jetons du site (`--error-*`,
+ * `--success-*`) : aucune couleur inventée sur place.
+ *
+ * `white-space: pre-line` parce que `apiErrorMessage` joint le message et les
+ * détails de validation par des retours à la ligne — sans ça, les trois motifs
+ * d'un refus arrivent collés en une seule phrase illisible.
+ */
+export default function Avis({ ton, children }) {
+    if (!children) return null;
+    return (
+        <p className={`cx-param__avis cx-param__avis--${ton} font-body`} role="status">
+            {children}
+        </p>
+    );
+}
diff --git a/src/pages/client/monCompte/components/BlocEmail.jsx b/src/pages/client/monCompte/components/BlocEmail.jsx
new file mode 100644
index 0000000..d9eaf0c
--- /dev/null
+++ b/src/pages/client/monCompte/components/BlocEmail.jsx
@@ -0,0 +1,195 @@
+import { useState } from "react";
+import {
+    annulerChangementEmailApi,
+    confirmerChangementEmailApi,
+    demanderChangementEmailApi,
+} from "../../../../api/client/compteApi";
+import { apiErrorMessage } from "../../../../utils/apiError";
+import { useAuth } from "../../../../hooks/useAuth";
+import Champ from "./Champ";
+import Avis from "./Avis";
+
+/**
+ * L'adresse e-mail, en deux temps.
+ *
+ * ── Pourquoi deux temps ──────────────────────────────────────────────────
+ * Le code part vers la NOUVELLE adresse, et c'est tout l'intérêt : c'est la
+ * seule façon de savoir que celui qui la saisit la relève vraiment. Une adresse
+ * acceptée sur parole, c'est un compte dont les confirmations de voyage partent
+ * chez un inconnu — et dont le propriétaire ne peut plus rien récupérer, parce
+ * que l'adresse de reprise n'est plus la sienne.
+ *
+ * Tant que le code n'est pas saisi, le compte continue de vivre sur l'ancienne
+ * adresse. L'écran le dit explicitement : une procédure à moitié faite qui ne
+ * s'annonce pas laisse le voyageur persuadé que c'est réglé.
+ *
+ * ── Pourquoi le mot de passe ─────────────────────────────────────────────
+ * Un jeton de session prouve qu'on s'est connecté, pas qu'on est encore devant
+ * l'écran. Changer l'adresse de reprise est la première chose qu'on ferait en
+ * trouvant un portable resté ouvert.
+ *
+ * ── La subtilité de la confirmation ──────────────────────────────────────
+ * L'adresse EST le sujet du JWT : à l'instant où elle change, le jeton en main
+ * et le cookie de renouvellement désignent un compte qui n'existe plus sous ce
+ * nom. Le serveur renvoie donc une paire de jetons neufs, et il faut les
+ * installer — sinon le voyageur est déconnecté au prochain appel, sur une page
+ * qui vient de lui dire « c'est enregistré ».
+ */
+export default function BlocEmail({ compte, onMaj }) {
+    const { setAuth, user } = useAuth();
+
+    const enAttente = Boolean(compte.emailEnAttente);
+
+    const [demande, setDemande] = useState({ email: "", motDePasse: "" });
+    const [code, setCode] = useState("");
+    const [envoi, setEnvoi] = useState(false);
+    const [avis, setAvis] = useState(null);
+
+    const saisir = (champ) => (e) => {
+        setDemande((d) => ({ ...d, [champ]: e.target.value }));
+        setAvis(null);
+    };
+
+    const demander = async (e) => {
+        e.preventDefault();
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const reponse = await demanderChangementEmailApi(demande);
+            onMaj(reponse.data);
+            setDemande({ email: "", motDePasse: "" });
+            setAvis({ ton: "succes", texte: reponse.message });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "Demande impossible.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    const confirmer = async (e) => {
+        e.preventDefault();
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const reponse = await confirmerChangementEmailApi({ code });
+            const { token, email, nom, prenom, role, photoUrl } = reponse.data;
+
+            // Les jetons neufs, installés immédiatement : voir l'en-tête.
+            setAuth(token, { email, nom, prenom, role, photoUrl });
+
+            onMaj({ ...compte, email, emailEnAttente: null });
+            setCode("");
+            setAvis({ ton: "succes", texte: `Votre adresse est maintenant ${email}.` });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "Code refusé.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    const annuler = async () => {
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const reponse = await annulerChangementEmailApi();
+            onMaj(reponse.data);
+            setCode("");
+            setAvis({ ton: "succes", texte: "Demande annulée. Votre adresse n'a pas changé." });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "Annulation impossible.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    // ── Une demande est en cours : on attend le code ─────────────────────
+    if (enAttente) {
+        return (
+            <form onSubmit={confirmer}>
+                <p className="cx-param__texte font-body">
+                    Un code à six chiffres est parti vers{" "}
+                    <strong className="cx-param__accent">{compte.emailEnAttente}</strong>.
+                    Saisissez-le pour confirmer. En attendant, votre compte continue
+                    de fonctionner avec <strong>{compte.email}</strong>.
+                </p>
+
+                <div className="cx-param__champs">
+                    <Champ
+                        id="code-email" label="Le code reçu" value={code}
+                        onChange={(e) => { setCode(e.target.value.replace(/\D/g, "").slice(0, 6)); setAvis(null); }}
+                        inputMode="numeric" maxLength={6} autoComplete="one-time-code" required
+                        aide="Il expire au bout de quinze minutes."
+                    />
+                </div>
+
+                <Avis ton={avis?.ton}>{avis?.texte}</Avis>
+
+                <div className="cx-param__actions">
+                    <button
+                        type="submit"
+                        disabled={envoi || code.length < 6}
+                        className="cx-devis__bouton font-body-strong"
+                    >
+                        {envoi ? "Vérification…" : "Confirmer l'adresse"}
+                    </button>
+                    <button
+                        type="button"
+                        onClick={annuler}
+                        disabled={envoi}
+                        className="cx-param__lien font-body-strong"
+                    >
+                        Annuler la demande
+                    </button>
+                </div>
+            </form>
+        );
+    }
+
+    // ── Compte ouvert avec Google : pas de mot de passe pour garantir ────
+    // le changement. Il faut d'abord en ajouter un (réglage suivant).
+    if (compte.motDePasse === false) {
+        return (
+            <p className="cx-param__texte font-body">
+                Votre compte se connecte avec Google. Changer d'adresse demande un mot de
+                passe, qui prouve que c'est bien vous : ajoutez-en un dans le réglage
+                « Mot de passe » ci-dessous, puis revenez ici.
+            </p>
+        );
+    }
+
+    // ── Cas nominal : on demande le changement ──────────────────────────
+    return (
+        <form onSubmit={demander}>
+            <p className="cx-param__texte font-body">
+                Nous enverrons un code à la nouvelle adresse pour vérifier qu'elle est
+                bien la vôtre. Votre adresse actuelle reste active jusqu'à ce que ce
+                code soit saisi.
+            </p>
+
+            <div className="cx-param__champs">
+                <Champ
+                    id="nouvel-email" label="Nouvelle adresse" type="email"
+                    value={demande.email} onChange={saisir("email")}
+                    autoComplete="email" required
+                />
+                <Champ
+                    id="mdp-email" label="Votre mot de passe" type="password"
+                    value={demande.motDePasse} onChange={saisir("motDePasse")}
+                    autoComplete="current-password" required
+                    aide="Demandé parce que cette adresse sert à reprendre la main sur le compte."
+                />
+            </div>
+
+            <Avis ton={avis?.ton}>{avis?.texte}</Avis>
+
+            <div className="cx-param__actions">
+                <button type="submit" disabled={envoi} className="cx-devis__bouton font-body-strong">
+                    {envoi ? "Envoi du code…" : "Envoyer le code"}
+                </button>
+                <span className="cx-param__note font-body">
+                    Connecté avec {user?.email}
+                </span>
+            </div>
+        </form>
+    );
+}
diff --git a/src/pages/client/monCompte/components/BlocIdentite.jsx b/src/pages/client/monCompte/components/BlocIdentite.jsx
new file mode 100644
index 0000000..353c8b3
--- /dev/null
+++ b/src/pages/client/monCompte/components/BlocIdentite.jsx
@@ -0,0 +1,77 @@
+import { useState } from "react";
+import { changerIdentiteApi } from "../../../../api/client/compteApi";
+import { apiErrorMessage } from "../../../../utils/apiError";
+import { useAuth } from "../../../../hooks/useAuth";
+import Champ from "./Champ";
+import Avis from "./Avis";
+
+/**
+ * Nom, prénom, téléphone.
+ *
+ * Aucun mot de passe demandé, et c'est délibéré : ces trois champs ne donnent
+ * accès à rien. Exiger le mot de passe pour corriger une faute de frappe dans
+ * son prénom, c'est apprendre aux gens à le saisir sans y penser — exactement
+ * ce qu'on ne veut pas le jour où il protège vraiment quelque chose.
+ */
+export default function BlocIdentite({ compte, onMaj }) {
+    const { majUser } = useAuth();
+
+    const [form, setForm] = useState({
+        nom: compte.nom ?? "",
+        prenom: compte.prenom ?? "",
+        telephone: compte.telephone ?? "",
+    });
+    const [envoi, setEnvoi] = useState(false);
+    const [avis, setAvis] = useState(null);
+
+    const saisir = (champ) => (e) => {
+        setForm((f) => ({ ...f, [champ]: e.target.value }));
+        setAvis(null);
+    };
+
+    const soumettre = async (e) => {
+        e.preventDefault();
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const reponse = await changerIdentiteApi(form);
+            onMaj(reponse.data);
+            // La barre d'en-tête affiche le prénom : elle doit suivre tout de
+            // suite, sinon l'écran donne l'impression de n'avoir rien fait.
+            majUser({ nom: reponse.data.nom, prenom: reponse.data.prenom });
+            setAvis({ ton: "succes", texte: "Vos informations sont à jour." });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "Modification impossible.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    return (
+        <form onSubmit={soumettre}>
+            <div className="cx-param__champs">
+                <Champ
+                    id="prenom" label="Prénom" value={form.prenom}
+                    onChange={saisir("prenom")} autoComplete="given-name" required
+                />
+                <Champ
+                    id="nom" label="Nom" value={form.nom}
+                    onChange={saisir("nom")} autoComplete="family-name" required
+                />
+                <Champ
+                    id="telephone" label="Téléphone" type="tel" value={form.telephone}
+                    onChange={saisir("telephone")} autoComplete="tel" large
+                    aide="Utilisé uniquement pour vous joindre au sujet d'un voyage."
+                />
+            </div>
+
+            <Avis ton={avis?.ton}>{avis?.texte}</Avis>
+
+            <div className="cx-param__actions">
+                <button type="submit" disabled={envoi} className="cx-devis__bouton font-body-strong">
+                    {envoi ? "Enregistrement…" : "Enregistrer"}
+                </button>
+            </div>
+        </form>
+    );
+}
diff --git a/src/pages/client/monCompte/components/BlocMotDePasse.jsx b/src/pages/client/monCompte/components/BlocMotDePasse.jsx
new file mode 100644
index 0000000..a4b9503
--- /dev/null
+++ b/src/pages/client/monCompte/components/BlocMotDePasse.jsx
@@ -0,0 +1,142 @@
+import { useState } from "react";
+import { changerMotDePasseApi } from "../../../../api/client/compteApi";
+import { motDePasseOublieApi } from "../../../../api/authApi";
+import { apiErrorMessage } from "../../../../utils/apiError";
+import Champ from "./Champ";
+import Avis from "./Avis";
+
+/** Le minimum imposé par le serveur. Répété ici pour le dire AVANT l'envoi. */
+const LONGUEUR_MINIMALE = 8;
+
+/**
+ * Le mot de passe.
+ *
+ * L'actuel est exigé même si la session est valide : un jeton prouve qu'on
+ * s'est connecté, pas qu'on est encore devant l'écran.
+ *
+ * La confirmation n'existe QUE côté écran, et c'est normal : le serveur n'a pas
+ * à recevoir deux fois la même valeur pour vérifier qu'on n'a pas fait de faute
+ * de frappe. La faute de frappe est un problème d'écran, pas de serveur.
+ *
+ * ── Ce que ce formulaire ne fait pas, et il faut le savoir ───────────────
+ * Changer son mot de passe NE DÉCONNECTE PAS les autres appareils déjà
+ * ouverts. Les jetons de renouvellement sont des JWT sans état : rien en base
+ * ne les recense, on ne peut donc pas en révoquer un en particulier. Les
+ * fermer demanderait une colonne de version de jeton vérifiée à chaque
+ * renouvellement — un chantier en soi. L'écran ne le promet donc pas.
+ */
+export default function BlocMotDePasse({ compte }) {
+    // Un compte ouvert avec Google n'a jamais choisi de mot de passe : on ne
+    // lui demande pas « l'actuel », on lui envoie un lien pour en créer un.
+    if (compte?.motDePasse === false) return <AjouterMotDePasse email={compte.email} />;
+    return <ChangerMotDePasse />;
+}
+
+function AjouterMotDePasse({ email }) {
+    const [envoi, setEnvoi] = useState(false);
+    const [avis, setAvis] = useState(null);
+
+    const envoyer = async () => {
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            await motDePasseOublieApi(email);
+            setAvis({ ton: "succes", texte: `Un lien vient de partir à ${email}. Il est valable 30 minutes.` });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "L'envoi n'a pas abouti. Réessayez dans un instant.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    return (
+        <div>
+            <p className="cx-param__texte font-body">
+                Votre compte se connecte avec Google, sans mot de passe. Pour pouvoir aussi vous
+                connecter avec votre adresse, recevez un lien par e-mail et choisissez-en un.
+            </p>
+            <Avis ton={avis?.ton}>{avis?.texte}</Avis>
+            <div className="cx-param__actions">
+                <button type="button" onClick={envoyer} disabled={envoi} className="cx-devis__bouton font-body-strong">
+                    {envoi ? "Envoi…" : "Recevoir le lien"}
+                </button>
+            </div>
+        </div>
+    );
+}
+
+function ChangerMotDePasse() {
+    const [form, setForm] = useState({ actuel: "", nouveau: "", confirmation: "" });
+    const [envoi, setEnvoi] = useState(false);
+    const [avis, setAvis] = useState(null);
+
+    const saisir = (champ) => (e) => {
+        setForm((f) => ({ ...f, [champ]: e.target.value }));
+        setAvis(null);
+    };
+
+    const soumettre = async (e) => {
+        e.preventDefault();
+
+        // Vérifié ici pour ne pas faire un aller-retour réseau qui dirait la
+        // même chose. Le serveur revérifie de toute façon : un contrôle
+        // d'écran n'est jamais une garantie.
+        if (form.nouveau !== form.confirmation) {
+            setAvis({ ton: "erreur", texte: "Les deux saisies ne correspondent pas." });
+            return;
+        }
+        if (form.nouveau.length < LONGUEUR_MINIMALE) {
+            setAvis({ ton: "erreur", texte: `Minimum ${LONGUEUR_MINIMALE} caractères.` });
+            return;
+        }
+
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            await changerMotDePasseApi({ actuel: form.actuel, nouveau: form.nouveau });
+            setForm({ actuel: "", nouveau: "", confirmation: "" });
+            setAvis({
+                ton: "succes",
+                texte: "Mot de passe modifié. Un e-mail de confirmation vient de partir.",
+            });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "Modification impossible.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    return (
+        <form onSubmit={soumettre}>
+            <div className="cx-param__champs">
+                <Champ
+                    id="mdp-actuel" label="Mot de passe actuel" type="password"
+                    value={form.actuel} onChange={saisir("actuel")}
+                    autoComplete="current-password" required large
+                />
+                <Champ
+                    id="mdp-nouveau" label="Nouveau mot de passe" type="password"
+                    value={form.nouveau} onChange={saisir("nouveau")}
+                    autoComplete="new-password" required
+                    aide={`${LONGUEUR_MINIMALE} caractères au minimum.`}
+                />
+                <Champ
+                    id="mdp-confirmation" label="Confirmez" type="password"
+                    value={form.confirmation} onChange={saisir("confirmation")}
+                    autoComplete="new-password" required
+                />
+            </div>
+
+            <Avis ton={avis?.ton}>{avis?.texte}</Avis>
+
+            <div className="cx-param__actions">
+                <button type="submit" disabled={envoi} className="cx-devis__bouton font-body-strong">
+                    {envoi ? "Modification…" : "Modifier le mot de passe"}
+                </button>
+                <span className="cx-param__note font-body">
+                    Un e-mail vous confirmera le changement.
+                </span>
+            </div>
+        </form>
+    );
+}
diff --git a/src/pages/client/monCompte/components/BlocPreferences.jsx b/src/pages/client/monCompte/components/BlocPreferences.jsx
new file mode 100644
index 0000000..d2a5232
--- /dev/null
+++ b/src/pages/client/monCompte/components/BlocPreferences.jsx
@@ -0,0 +1,126 @@
+import { useEffect, useMemo, useState } from "react";
+import { findAllTagsApiClient } from "../../../../api/client/tagsApi";
+import { enregistrerPreferencesApi } from "../../../../api/client/composerApi";
+import { apiErrorMessage } from "../../../../utils/apiError";
+import Avis from "./Avis";
+
+/**
+ * Vos envies de voyage : les étiquettes de l'agence (thématique, région, type
+ * d'activité…), rangées par groupe, à cocher.
+ *
+ * Elles servent au créateur de circuit : un voyage qui démarre à vide propose
+ * d'abord les destinations qui leur ressemblent (« Selon vos envies »), et le
+ * catalogue les fait remonter. L'ensemble s'enregistre d'un bloc : ce qui est
+ * décoché est retiré.
+ */
+export default function BlocPreferences({ envies, onMaj }) {
+    const [tags, setTags] = useState(null);
+    const [erreurChargement, setErreurChargement] = useState(false);
+    const [choisis, setChoisis] = useState(() => new Set((envies ?? []).map((t) => t.id)));
+    const [envoi, setEnvoi] = useState(false);
+    const [avis, setAvis] = useState(null);
+
+    useEffect(() => {
+        let actif = true;
+        findAllTagsApiClient()
+            .then((r) => actif && setTags(r?.data ?? []))
+            .catch(() => actif && setErreurChargement(true));
+        return () => { actif = false; };
+    }, []);
+
+    // Par groupe, dans l'ordre où l'agence les a créés
+    const groupes = useMemo(() => {
+        const parGroupe = new Map();
+        (tags ?? []).forEach((t) => {
+            const nom = t.tagGroup?.name ?? "Autres";
+            if (!parGroupe.has(nom)) parGroupe.set(nom, []);
+            parGroupe.get(nom).push(t);
+        });
+        return [...parGroupe.entries()];
+    }, [tags]);
+
+    const initiaux = useMemo(() => new Set((envies ?? []).map((t) => t.id)), [envies]);
+    const modifie = choisis.size !== initiaux.size || [...choisis].some((id) => !initiaux.has(id));
+
+    const basculer = (id) => {
+        setAvis(null);
+        setChoisis((actuels) => {
+            const suite = new Set(actuels);
+            if (suite.has(id)) suite.delete(id); else suite.add(id);
+            return suite;
+        });
+    };
+
+    const enregistrer = async (e) => {
+        e.preventDefault();
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const r = await enregistrerPreferencesApi([...choisis]);
+            onMaj(r?.data ?? []);
+            setAvis({
+                ton: "succes",
+                texte: choisis.size
+                    ? "Vos envies sont enregistrées : le créateur de circuit vous proposera d'abord les destinations qui leur ressemblent."
+                    : "Vos envies sont effacées : le créateur de circuit vous proposera les coups de cœur de l'agence.",
+            });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "L'enregistrement n'a pas abouti.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    if (erreurChargement) {
+        return <p className="cx-param__texte font-body">Les thèmes n'ont pas pu être chargés. Réessayez dans un instant.</p>;
+    }
+    if (!tags) {
+        return <p className="cx-param__texte font-body">Chargement des thèmes…</p>;
+    }
+    if (tags.length === 0) {
+        return <p className="cx-param__texte font-body">L'agence n'a pas encore défini de thèmes de voyage.</p>;
+    }
+
+    return (
+        <form onSubmit={enregistrer}>
+            <p className="cx-param__texte font-body">
+                Cochez ce qui vous attire. Le créateur de circuit vous proposera d'abord les destinations
+                qui vous ressemblent ; vous pouvez changer d'avis à tout moment.
+            </p>
+
+            <div className="cx-envies">
+                {groupes.map(([groupe, liste]) => (
+                    <fieldset key={groupe} className="cx-envies__groupe">
+                        <legend className="cx-envies__titre font-body-strong">{groupe}</legend>
+                        <div className="cx-envies__liste">
+                            {liste.map((t) => {
+                                const actif = choisis.has(t.id);
+                                return (
+                                    <button key={t.id} type="button" aria-pressed={actif}
+                                        className={`cx-envie font-body-strong${actif ? " cx-envie--actif" : ""}`}
+                                        onClick={() => basculer(t.id)}>
+                                        {actif && <span aria-hidden="true" className="cx-envie__coche">✓</span>}
+                                        {t.name}
+                                    </button>
+                                );
+                            })}
+                        </div>
+                    </fieldset>
+                ))}
+            </div>
+
+            <Avis ton={avis?.ton}>{avis?.texte}</Avis>
+
+            <div className="cx-param__actions">
+                <button type="submit" disabled={envoi || !modifie} className="cx-devis__bouton font-body-strong">
+                    {envoi ? "Enregistrement…" : "Enregistrer mes envies"}
+                </button>
+                <span className="cx-param__note font-body">
+                    {choisis.size
+                        ? `${choisis.size} thème${choisis.size > 1 ? "s" : ""} choisi${choisis.size > 1 ? "s" : ""}.`
+                        : "Aucun thème choisi."}
+                </span>
+            </div>
+        </form>
+    );
+}
diff --git a/src/pages/client/monCompte/components/Champ.jsx b/src/pages/client/monCompte/components/Champ.jsx
new file mode 100644
index 0000000..6ea2b3f
--- /dev/null
+++ b/src/pages/client/monCompte/components/Champ.jsx
@@ -0,0 +1,46 @@
+/**
+ * Un champ de la page de paramètres.
+ *
+ * Même grammaire qu'à la connexion :
+ * étiquette en petites capitales, champ souligné d'un filet qui passe en Terre
+ * à la saisie (`.field-line`). Aucun champ encadré nulle part sur le site — un
+ * rectangle gris autour d'une saisie, c'est le vocabulaire d'un formulaire
+ * administratif.
+ */
+export default function Champ({
+    id,
+    label,
+    type = "text",
+    value,
+    onChange,
+    autoComplete,
+    required = false,
+    large = false,
+    aide,
+    inputMode,
+    maxLength,
+    placeholder,
+}) {
+    return (
+        <div className={large ? "cx-param__champ--large" : undefined}>
+            <label htmlFor={id} className="cx-label cx-label--legende font-body-strong">
+                {label}
+            </label>
+            <input
+                id={id}
+                name={id}
+                type={type}
+                value={value}
+                onChange={onChange}
+                autoComplete={autoComplete}
+                required={required}
+                inputMode={inputMode}
+                maxLength={maxLength}
+                placeholder={placeholder}
+                className="field-line w-full bg-transparent outline-none pb-3 font-body text-base"
+                style={{ color: "var(--text-primary)", marginTop: "12px" }}
+            />
+            {aide && <span className="cx-param__aide font-body">{aide}</span>}
+        </div>
+    );
+}
diff --git a/src/pages/client/monCompte/components/HeroCompte.jsx b/src/pages/client/monCompte/components/HeroCompte.jsx
new file mode 100644
index 0000000..231e0ef
--- /dev/null
+++ b/src/pages/client/monCompte/components/HeroCompte.jsx
@@ -0,0 +1,282 @@
+import { useRef, useState } from "react";
+import { Camera } from "lucide-react";
+import {
+    changerPhotoApi,
+    retirerPhotoApi,
+    televerserAvatarApi,
+} from "../../../../api/client/compteApi";
+import { apiErrorMessage } from "../../../../utils/apiError";
+import { useAuth } from "../../../../hooks/useAuth";
+import Avatar from "../../../../components/client/compte/Avatar";
+import Avis from "./Avis";
+
+/** Au-delà, ce n'est plus une photo de profil — et Cloudinary refuserait. */
+const POIDS_MAX_MO = 8;
+
+/**
+ * L'image de l'espace voyageur. La même que dans le panneau du compte, et ce
+ * n'est pas un hasard : on entre chez soi, on doit reconnaître l'endroit.
+ */
+const IMAGE =
+    "/img/home/ctaSection/tropical-beach-landscape-with-deckchair-parasol-from-nosy-be-madagascar-vintage-light-filter-1920.webp";
+
+/**
+ * Le hero de la page de paramètres.
+ *
+ * ── Pourquoi un hero, et pas un bandeau ─────────────────────────────────
+ * Première version : un portrait de 112 px et deux lignes de texte sur le fond
+ * clair du site, puis la liste des réglages. Verdict du client, et il avait
+ * raison : « c'est ergonomique, c'est de la merde […] là c'est direct un bas de
+ * gamme ». Un écran de compte construit comme un formulaire EST un formulaire,
+ * même bien composé.
+ *
+ * Ce qui fait la richesse de l'accueil — et de la fiche circuit, et de la liste
+ * — c'est toujours la même chose : de la PHOTOGRAPHIE PLEIN CADRE, un titre en
+ * très grand corps, un filet d'un pixel en pied. Aucune de ces trois choses
+ * n'était là. Elles y sont maintenant, dans le vocabulaire exact de l'accueil :
+ *
+ *   • la photo à 0.75 d'opacité sur du noir, voile en dégradé vers le haut
+ *   • l'accroche en petites capitales ocre à 0,45em
+ *   • le nom du voyageur en `text-8xl`, ligne par ligne sous son masque
+ *   • la barre filetée de pied qui porte le portrait, l'adresse et les gestes
+ *
+ * Le nom du voyageur EST le titre de une. C'est déjà le choix fait dans le
+ * panneau de l'espace voyageur ; le reprendre ici enchaîne les deux écrans.
+ *
+ * ── Pourquoi la photo de profil se change ICI ───────────────────────────
+ * Parce qu'on la regarde ici. Un volet « photo de profil » à déplier pour y
+ * trouver un bouton « parcourir » ajoute deux gestes pour la même chose. Le
+ * portrait est le déclencheur, le voile n'apparaît qu'au survol : une icône
+ * posée en permanence sur un visage, c'est un badge, pas une commande.
+ *
+ * ── Le chemin du fichier ────────────────────────────────────────────────
+ * Il va du navigateur DIRECTEMENT à Cloudinary, avec une signature à durée
+ * limitée délivrée par notre serveur — qui n'a donc ni à le recevoir, ni à le
+ * stocker, ni à le relayer. Le serveur ne retient que l'adresse, et il la
+ * vérifie : une URL libre dans ce champ serait un pixel espion servi depuis nos
+ * pages à chaque affichage.
+ */
+export default function HeroCompte({ compte, onMaj }) {
+    const { majUser } = useAuth();
+    const fichierRef = useRef(null);
+
+    const [envoi, setEnvoi] = useState(false);
+    const [avis, setAvis] = useState(null);
+
+    const membreDepuis = compte?.membreDepuis
+        ? new Date(compte.membreDepuis).toLocaleDateString("fr-FR", {
+            month: "long",
+            year: "numeric",
+        })
+        : null;
+
+    const choisir = () => fichierRef.current?.click();
+
+    const deposer = async (e) => {
+        const fichier = e.target.files?.[0];
+        // Le champ est remis à zéro tout de suite : sans ça, rechoisir le même
+        // fichier après un échec ne déclenche aucun événement.
+        e.target.value = "";
+        if (!fichier) return;
+
+        if (!fichier.type.startsWith("image/")) {
+            setAvis({ ton: "erreur", texte: "Choisissez une image." });
+            return;
+        }
+        if (fichier.size > POIDS_MAX_MO * 1024 * 1024) {
+            setAvis({ ton: "erreur", texte: `L'image dépasse ${POIDS_MAX_MO} Mo.` });
+            return;
+        }
+
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const url = await televerserAvatarApi(fichier);
+            const reponse = await changerPhotoApi(url);
+            onMaj(reponse.data);
+            majUser({ photoUrl: reponse.data.photoUrl });
+            setAvis({ ton: "succes", texte: "Votre photo est à jour." });
+        } catch (error) {
+            setAvis({
+                ton: "erreur",
+                texte: error.response
+                    ? apiErrorMessage(error, "Enregistrement impossible.")
+                    : error.message || "Téléversement impossible.",
+            });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    const retirer = async () => {
+        setEnvoi(true);
+        setAvis(null);
+        try {
+            const reponse = await retirerPhotoApi();
+            onMaj(reponse.data);
+            majUser({ photoUrl: null });
+            setAvis({ ton: "succes", texte: "Photo retirée. Vos initiales reprennent la place." });
+        } catch (error) {
+            setAvis({ ton: "erreur", texte: apiErrorMessage(error, "Suppression impossible.") });
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    return (
+        <section className="cx-param-hero" data-header-text="var(--text-inverse)">
+            <div className="relative w-full h-full overflow-hidden bg-black">
+                <img
+                    data-compte-media
+                    src={IMAGE}
+                    alt=""
+                    className="absolute inset-0 w-full h-full object-cover"
+                    style={{ opacity: 0.75 }}
+                />
+
+                {/* Deux voiles, pas un. Celui du bas porte le nom ; celui du
+                    haut existe parce que l'accroche ocre se perdait dans le
+                    ciel de la photographie. */}
+                {/* Le voile du bas monte HAUT — jusqu'aux deux tiers — et c'est
+                    une correction, pas une preference. Premiere version : il
+                    s'arrêtait à 46 %, et l'accroche ocre comme les légendes
+                    « Connecté avec » tombaient sur le ciel de la photographie.
+                    Elles y étaient illisibles. Le hero d'accueil ne rencontre
+                    pas le problème parce que sa photographie est sombre en
+                    bas ; celle-ci est une plage en plein jour. */}
+                <div
+                    className="absolute inset-0"
+                    style={{
+                        background:
+                            "linear-gradient(to top, rgba(16,14,11,0.94) 0%, rgba(16,14,11,0.86) 26%, rgba(16,14,11,0.68) 48%, rgba(16,14,11,0.36) 70%, rgba(16,14,11,0.06) 90%, rgba(16,14,11,0) 100%)",
+                    }}
+                />
+                <div
+                    className="absolute inset-x-0 top-0"
+                    style={{
+                        height: "34%",
+                        background:
+                            "linear-gradient(to bottom, rgba(16,14,11,0.55) 0%, rgba(16,14,11,0.16) 55%, rgba(16,14,11,0) 100%)",
+                    }}
+                />
+
+                {/* Le contenu attend ses données ; la photographie, non. Le
+                    hero a une hauteur fixe, donc rien ne saute quand le texte
+                    arrive — et la barre d'en-tête a déjà trouvé sa couleur
+                    claire sur cette section dès le premier rendu. */}
+                {!compte ? null : (
+                <div className="cx-param-hero__contenu">
+                    <span data-compte-kicker className="cx-param-hero__accroche font-body-strong">
+                        Espace voyageur
+                    </span>
+
+                    {/* Le nom du voyageur en titre de une, ligne par ligne sous
+                        son masque. Le double span est indispensable : c'est le
+                        parent en overflow hidden qui découpe, l'enfant qui se
+                        déplace. */}
+                    <h1 className="cx-param-hero__nom font-title">
+                        <span className="block overflow-hidden">
+                            <span data-compte-ligne className="block pb-[0.06em]">{compte.prenom}</span>
+                        </span>
+                        <span className="block overflow-hidden">
+                            <span data-compte-ligne className="block pb-[0.06em]">{compte.nom}</span>
+                        </span>
+                    </h1>
+
+                    <div
+                        data-compte-filet
+                        className="cx-param-hero__filet"
+                        style={{ borderTop: "1px solid rgba(245,240,230,0.22)" }}
+                    />
+
+                    <div className="cx-param-hero__pied">
+                        {/* ── Le portrait, et les deux gestes ───────────── */}
+                        <div data-compte-pied className="cx-param-hero__portrait">
+                            <button
+                                type="button"
+                                onClick={choisir}
+                                disabled={envoi}
+                                className="cx-param__declencheur"
+                                aria-label={compte.photoUrl ? "Changer votre photo" : "Ajouter une photo"}
+                            >
+                                <Avatar
+                                    user={compte}
+                                    taille={96}
+                                    bordure="rgba(245,240,230,0.4)"
+                                    fond="rgba(16,14,11,0.35)"
+                                    couleurTexte="var(--text-inverse)"
+                                />
+                                <span aria-hidden className="cx-param__voile">
+                                    <Camera size={20} strokeWidth={1.5} />
+                                </span>
+                            </button>
+
+                            <input
+                                ref={fichierRef}
+                                type="file"
+                                accept="image/*"
+                                onChange={deposer}
+                                hidden
+                            />
+
+                            <div className="cx-param-hero__gestes">
+                                <button
+                                    type="button"
+                                    onClick={choisir}
+                                    disabled={envoi}
+                                    className="cx-param-hero__lien font-body-strong"
+                                >
+                                    {envoi
+                                        ? "Envoi…"
+                                        : compte.photoUrl
+                                            ? "Changer la photo"
+                                            : "Ajouter une photo"}
+                                </button>
+                                {compte.photoUrl && (
+                                    <button
+                                        type="button"
+                                        onClick={retirer}
+                                        disabled={envoi}
+                                        className="cx-param-hero__lien cx-param-hero__lien--discret font-body-strong"
+                                    >
+                                        Retirer
+                                    </button>
+                                )}
+                            </div>
+                        </div>
+
+                        {/* ── Les repères, à droite comme la méta de l'accueil ── */}
+                        <dl data-compte-pied className="cx-param-hero__reperes">
+                            <div>
+                                <dt className="cx-param-hero__legende font-body-strong">Connecté avec</dt>
+                                <dd className="cx-param-hero__valeur font-body">{compte.email}</dd>
+                            </div>
+                            {membreDepuis && (
+                                <div>
+                                    <dt className="cx-param-hero__legende font-body-strong">Membre depuis</dt>
+                                    <dd className="cx-param-hero__valeur font-body">{membreDepuis}</dd>
+                                </div>
+                            )}
+                        </dl>
+                    </div>
+
+                    {compte.emailEnAttente && (
+                        // Une procédure commencée doit se voir au premier coup
+                        // d'œil : sinon le voyageur repart persuadé que son
+                        // changement d'adresse est passé.
+                        <p data-compte-pied className="cx-param-hero__attente font-body-strong">
+                            Changement vers {compte.emailEnAttente} — code à confirmer
+                        </p>
+                    )}
+
+                    {avis && (
+                        <div className="cx-param-hero__avis">
+                            <Avis ton={avis.ton}>{avis.texte}</Avis>
+                        </div>
+                    )}
+                </div>
+                )}
+            </div>
+        </section>
+    );
+}
diff --git a/src/pages/client/monCompte/components/Reglage.jsx b/src/pages/client/monCompte/components/Reglage.jsx
new file mode 100644
index 0000000..0c1d567
--- /dev/null
+++ b/src/pages/client/monCompte/components/Reglage.jsx
@@ -0,0 +1,61 @@
+import { ChevronDown } from "lucide-react";
+
+/**
+ * Un réglage : la rangée fermée, et le formulaire qui se déplie dessous.
+ *
+ * C'est la rangée de « Votre voyage en trois gestes », sur l'accueil, reprise
+ * telle quelle — douze colonnes, le numéro en Abhaya clair sur deux colonnes,
+ * le titre sur quatre qui avance de 2 px au survol, le propos sur six, un filet
+ * d'un pixel entre chaque. Aucun vocabulaire nouveau : c'est déjà la grammaire
+ * de la page d'accueil, posée sur un autre contenu.
+ *
+ * S'y ajoute ce dont un réglage a besoin et qu'une étape n'a pas : la VALEUR
+ * ACTUELLE, en petites capitales sous le propos. Sans elle il faut ouvrir les
+ * trois volets pour savoir ce qui est réglé.
+ *
+ * `grid-template-rows: 0fr → 1fr` : la seule façon d'animer l'ouverture d'une
+ * hauteur inconnue sans aller la mesurer en JavaScript. Le geste est celui de
+ * l'itinéraire.
+ */
+export default function Reglage({
+    numero,
+    titre,
+    propos,
+    valeur,
+    ouvert,
+    onBasculer,
+    children,
+}) {
+    return (
+        <li className={`cx-reglage${ouvert ? " cx-reglage--ouvert" : ""}`}>
+            <span aria-hidden className="cx-reglage__aplat" />
+
+            <button
+                type="button"
+                className="cx-reglage__rangee"
+                onClick={onBasculer}
+                aria-expanded={ouvert}
+            >
+                <span className="cx-reglage__numero font-title tabular-nums">{numero}</span>
+
+                <span className="cx-reglage__titre font-title">{titre}</span>
+
+                <span className="cx-reglage__propos min-w-0">
+                    <span className="cx-reglage__desc font-body">{propos}</span>
+                    <span className="cx-reglage__valeur font-body-strong">{valeur}</span>
+                </span>
+
+                <span className="cx-reglage__bascule font-body-strong">
+                    {ouvert ? "Replier" : "Modifier"}
+                    <ChevronDown size={14} className="cx-reglage__chevron" />
+                </span>
+            </button>
+
+            <div className="cx-reglage__corps">
+                <div>
+                    <div className="cx-reglage__dedans">{children}</div>
+                </div>
+            </div>
+        </li>
+    );
+}
diff --git a/src/pages/client/viewCircuit/ViewCircuit.jsx b/src/pages/client/viewCircuit/ViewCircuit.jsx
new file mode 100644
index 0000000..cd1f322
--- /dev/null
+++ b/src/pages/client/viewCircuit/ViewCircuit.jsx
@@ -0,0 +1,200 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { recalerQuandLaPageSeStabilise } from "../../../hooks/design/recalageScroll";
+import { findAllCircuitClientApi } from "../../../api/client/cricuitApi";
+import CircuitCard from "../../../components/client/cardCircuit/CircuitCard";
+import { DURATIONS } from "../../../constants/client/circuitFilters";
+import { circuitDays, circuitSteps } from "../../../utils/circuit";
+import CircuitFilters from "./components/filters/CircuitFilters";
+import CircuitHero from "./components/hero/CircuitHero";
+
+const PER_PAGE = 6;
+const HEADER_FALLBACK = 84;
+
+// Cherche dans le nom du circuit et dans les lieux traversés
+const matchQuery = (circuit, needle) => {
+    if (!needle) return true;
+    const haystack = [circuit.nom, ...circuitSteps(circuit).map((s) => s.destination?.nom)]
+        .filter(Boolean)
+        .join(" ")
+        .toLowerCase();
+    return haystack.includes(needle);
+};
+
+export default function ViewCircuit() {
+    const [circuits, setCircuits] = useState([]);
+    const [status, setStatus] = useState("loading");
+    const [query, setQuery] = useState("");
+    const [duration, setDuration] = useState("all");
+    const [page, setPage] = useState(1);
+    const [headerHeight, setHeaderHeight] = useState(HEADER_FALLBACK);
+
+    const indexRef = useRef(null);
+
+    const loadCircuits = useCallback(async () => {
+        setStatus("loading");
+        try {
+            const res = await findAllCircuitClientApi();
+            setCircuits(res?.data ?? []);
+            setStatus("ready");
+        } catch (error) {
+            console.error("Chargement des circuits impossible", error);
+            setStatus("error");
+        }
+    }, []);
+
+    useEffect(() => { loadCircuits(); }, [loadCircuits]);
+
+    // Le bandeau se colle juste sous le header — on mesure sa hauteur réelle
+    useEffect(() => {
+        const measure = () => setHeaderHeight(document.querySelector("header")?.offsetHeight ?? HEADER_FALLBACK);
+        measure();
+        window.addEventListener("resize", measure);
+        return () => window.removeEventListener("resize", measure);
+    }, []);
+
+    // Les cartes arrivent après le fetch : les déclencheurs doivent se recaler.
+    //
+    // Un unique recalage à 120 ms ne suffisait pas. À cet instant le squelette
+    // vient de céder la place à la grille et aucune photo n'est arrivée : les
+    // cartes se retrouvaient déclenchées à côté de leur position réelle —
+    // entrée jouée hors champ, ou carte franchie sans qu'elle se révèle. On
+    // recale maintenant à chaque fois que la page change de hauteur, et les
+    // filtres comme « charger la suite » repassent par là (cf. recalageScroll).
+    useEffect(() => {
+        if (status !== "ready") return undefined;
+        return recalerQuandLaPageSeStabilise(indexRef.current ?? undefined);
+    }, [status, page, query, duration]);
+
+    useEffect(() => { setPage(1); }, [query, duration]);
+
+    const filtered = useMemo(() => {
+        const needle = query.trim().toLowerCase();
+        const range = DURATIONS.find((d) => d.id === duration) ?? DURATIONS[0];
+        return circuits.filter((c) => matchQuery(c, needle) && range.match(circuitDays(c)));
+    }, [circuits, query, duration]);
+
+    const visible = filtered.slice(0, page * PER_PAGE);
+    const hasMore = visible.length < filtered.length;
+    const hasFilters = Boolean(query.trim()) || duration !== "all";
+
+    const scrollToIndex = useCallback(() => {
+        indexRef.current?.scrollIntoView({ behavior: "smooth", block: "start" });
+    }, []);
+
+    const resetFilters = useCallback(() => { setQuery(""); setDuration("all"); }, []);
+
+    return (
+        <section className="w-full" style={{ backgroundColor: "var(--bg)" }}>
+            <CircuitHero onBrowse={scrollToIndex} topOffset={headerHeight} />
+            
+            <div ref={indexRef} data-header-text="var(--text-primary)" className="pb-32" style={{ scrollMarginTop: `${headerHeight}px` }}>
+                <CircuitFilters
+                    query={query}
+                    onQuery={setQuery}
+                    duration={duration}
+                    onDuration={setDuration}
+                    shown={visible.length}
+                    total={filtered.length}
+                    top={headerHeight}
+                />
+
+                <div className="px-5 sm:px-16 pt-12 lg:pt-20">
+                    {status === "loading" && <CircuitGridSkeleton />}
+
+                    {status === "error" && (
+                        <EmptyState
+                            title="La sélection est indisponible"
+                            text="Le catalogue ne répond pas pour le moment. Réessayez dans un instant."
+                            actionLabel="Réessayer"
+                            onAction={loadCircuits}
+                        />
+                    )}
+
+                    {status === "ready" && !filtered.length && (
+                        hasFilters ? (
+                            <EmptyState
+                                title="Aucun itinéraire ne correspond"
+                                text={query.trim()
+                                    ? `Rien ne ressort pour « ${query.trim()} ». Élargissez la durée ou tentez un autre nom de lieu.`
+                                    : "Aucun circuit sur cette durée. Essayez une autre fourchette."}
+                                actionLabel="Afficher tout"
+                                onAction={resetFilters}
+                            />
+                        ) : (
+                            <EmptyState
+                                title="La sélection se prépare"
+                                text="Nos itinéraires signature seront publiés ici très prochainement."
+                            />
+                        )
+                    )}
+
+                    {status === "ready" && filtered.length > 0 && (
+                        <div className="grid grid-cols-1 lg:grid-cols-2 gap-10">
+                            {visible.map((circuit, index) => (
+                                <CircuitCard
+                                    key={circuit.id}
+                                    circuit={circuit}
+                                    index={index}
+                                    delay={(index % 2) * 0.12}
+                                />
+                            ))}
+                        </div>
+                    )}
+                </div>
+
+                {/* ── Charger la suite — inutile tant que tout tient sur une page ── */}
+                {status === "ready" && hasMore && (
+                    <div className="px-5 sm:px-16 mt-12 lg:mt-20 flex justify-center">
+                        <button
+                            onClick={() => setPage((p) => p + 1)}
+                            className="px-14 py-5 font-body-strong text-[11px] uppercase tracking-[0.1em] transition-colors duration-300 cursor-pointer"
+                            style={{ backgroundColor: "var(--cta-bg)", color: "var(--cta-text)" }}
+                            onMouseEnter={(e) => (e.currentTarget.style.backgroundColor = "var(--cta-bg-hover)")}
+                            onMouseLeave={(e) => (e.currentTarget.style.backgroundColor = "var(--cta-bg)")}
+                        >
+                            Charger la suite — {String(filtered.length - visible.length).padStart(2, "0")} restants
+                        </button>
+                    </div>
+                )}
+            </div>
+
+        </section>
+    );
+}
+
+function CircuitGridSkeleton() {
+    return (
+        <div className="grid grid-cols-1 lg:grid-cols-2 gap-10">
+            {[0, 1, 2, 3].map((i) => (
+                <div key={i} className="skeleton-box w-full h-[480px] sm:h-[620px]" />
+            ))}
+        </div>
+    );
+}
+
+function EmptyState({ title, text, actionLabel, onAction }) {
+    return (
+        <div className="py-28 flex flex-col items-center text-center">
+            <span className="font-body-strong text-[11px] uppercase tracking-[0.1em] mb-6" style={{ color: "var(--brand-ocre)" }}>
+                Sélection
+            </span>
+            <h3 className="font-title leading-none mb-6" style={{ color: "var(--text-primary)", fontSize: "clamp(2rem, 3.4vw, 3.25rem)" }}>
+                {title}
+            </h3>
+            <p className="font-body text-[15px] leading-[1.8] max-w-md" style={{ color: "var(--text-muted)" }}>
+                {text}
+            </p>
+            {actionLabel && (
+                <button
+                    onClick={onAction}
+                    className="mt-10 px-10 py-4 font-body-strong text-[11px] uppercase tracking-[0.1em] transition-colors duration-300 cursor-pointer"
+                    style={{ backgroundColor: "var(--cta-bg)", color: "var(--cta-text)" }}
+                    onMouseEnter={(e) => (e.currentTarget.style.backgroundColor = "var(--cta-bg-hover)")}
+                    onMouseLeave={(e) => (e.currentTarget.style.backgroundColor = "var(--cta-bg)")}
+                >
+                    {actionLabel}
+                </button>
+            )}
+        </div>
+    );
+}
diff --git a/src/pages/client/viewCircuit/components/filters/CircuitFilters.jsx b/src/pages/client/viewCircuit/components/filters/CircuitFilters.jsx
