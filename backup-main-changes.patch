+import { registerApi } from "../../../../api/authApi";
+
+// « Continuer avec Google » est retiré de cet écran tant que l'identifiant
+// client OAuth n'est pas créé : un bouton qui ne peut qu'échouer n'a rien à
+// faire devant un visiteur. Tout le reste est en place et dort — le hook
+// `useConnexionGoogle`, la route `/api/auth/google`, la colonne `user.google_id`.
+// Pour le remettre : renseigner `app.google.client-id` côté serveur, puis
+// rétablir le bloc du bouton ici (cf. l'historique git de ce fichier).
+
+const IMG = "/img/login/elle-leontiev-Wtv8wbxk-M4-unsplash-1920.webp";
+const LARGEUR_FORMULAIRE = 450;
+
+const TEXTES = {
+    login: {
+        titre: ["Bon retour", "parmi nous."],
+        intro: "Retrouvez vos devis en cours, vos itinéraires favoris et les circuits que vous avez commencé à composer.",
+        action: "Se connecter",
+        bascule: { question: "Pas encore de compte ?", lien: "Créer un compte", vers: "register" },
+    },
+    register: {
+        titre: ["Ouvrez votre", "carnet de voyage."],
+        intro: "Quelques instants suffisent. Vous pourrez ensuite composer vos circuits, les mettre de côté et suivre vos devis.",
+        action: "Créer mon compte",
+        bascule: { question: "Déjà un compte ?", lien: "Se connecter", vers: "login" },
+    },
+};
+
+function Champ({ id, label, type, value, onChange, autoComplete }) {
+    return (
+        <div>
+            <label
+                htmlFor={id}
+                className="block font-body-strong text-[11px] uppercase tracking-[0.1em] mb-4"
+                style={{ color: "var(--text-muted)" }}
+            >
+                {label}
+            </label>
+            <input
+                id={id}
+                name={id}
+                type={type}
+                value={value}
+                onChange={onChange}
+                autoComplete={autoComplete}
+                required
+                className="field-line w-full bg-transparent outline-none pb-3 font-body text-base"
+                style={{ color: "var(--text-primary)" }}
+            />
+        </div>
+    );
+}
+
+export default function LoginClient() {
+    const navigate = useNavigate();
+    const { login } = useAuth();
+    const location = useLocation();
+    const { scopeRef, contenu, basculer, enTransition } = useAuthTransition(
+        modeDepuisUrl(window.location.pathname)
+    );
+
+    const [form, setForm] = useState({
+        prenom: "", nom: "", email: "", password: "",
+        indicatif: INDICATIF_DEFAUT.indicatif, telephone: "",
+        naissance: { jour: "", mois: "", annee: "" },
+    });
+    const clearAuth = useAuthStore((s) => s.clearAuth);
+
+    const [envoi, setEnvoi] = useState(false);
+    const [erreur, setErreur] = useState("");
+    // Un message peut arriver avec la page : e-mail vérifié, mot de passe
+    // changé, session expirée… Il s'affiche à l'ouverture.
+    const [succes, setSucces] = useState(location.state?.ton === "succes" ? location.state.message : "");
+    const [info] = useState(location.state?.ton !== "succes" ? location.state?.message ?? "" : "");
+
+    const handleChange = (e) => setForm((f) => ({ ...f, [e.target.name]: e.target.value }));
+    const majChamp = (cle) => (v) => setForm((f) => ({ ...f, [cle]: v }));
+
+    const handleSubmit = async (e) => {
+        e.preventDefault();
+        setErreur("");
+        setSucces("");
+        setEnvoi(true);
+
+        try {
+            if (inscription) {
+                await registerApi(construirePayloadAuth(contenu, form));
+                // Le compte existe, le code est parti : la suite se joue sur /verification
+                navigate("/verification", {
+                    replace: true,
+                    state: { email: form.email },
+                });
+                return;
+            } else {
+                // login remplit le store puis redirige lui-meme : soit vers la
+                // page d'ou l'utilisateur a ete refoule, soit vers l'accueil.
+                await login(construirePayloadAuth(contenu, form), location.state?.from);
+                return;
+            }
+        } catch (error) {
+            const message = messageErreurApi(error);
+            const redirection = REDIRECTIONS_AUTH[codeErreurApi(error)];
+
+            if (redirection) {
+                if (redirection.purgeSession) clearAuth();
+                // le message voyage avec : la page d'arrivee explique pourquoi
+                // l'utilisateur atterrit la
+                navigate(redirection.vers, {
+                    replace: true,
+                    state: { message, email: form.email },
+                });
+                return;
+            }
+
+            // Code inconnu ou absent : on reste sur place et on affiche
+            setErreur(message);
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    const t = TEXTES[contenu];
+    const inscription = contenu === "register";
+
+    const retour = (
+        <button
+            type="button"
+            onClick={() => navigate(-1)}
+            className="group flex items-center gap-3.5 cursor-pointer"
+        >
+            <FaArrowLeft className="text-[11px] transition-transform duration-500 ease-out group-hover:-translate-x-1.5" />
+            <span className="font-body-strong text-[11px] uppercase tracking-[0.1em]">Retour</span>
+        </button>
+    );
+
+    return (
+        <div ref={scopeRef} className="min-h-screen w-full flex" style={{ backgroundColor: "var(--bg)" }}>
+            {/* ── Volet photographique — il ne bouge pas d'un mode à l'autre ─ */}
+            <div data-volet className="relative hidden lg:block shrink-0 z-0 overflow-hidden" style={{ width: "52%" }}>
+                <img src={IMG} alt="" className="absolute inset-0 w-full h-full object-cover" data-img />
+                <div
+                    className="absolute inset-0"
+                    style={{ background: "linear-gradient(to top, rgba(37,26,18,0.85) 0%, rgba(37,26,18,0.15) 55%, rgba(37,26,18,0.5) 100%)" }}
+                />
+
+                <div data-retour className="absolute top-11 left-12 z-10" style={{ color: "var(--text-inverse)" }}>
+                    {retour}
+                </div>
+
+                <div className="absolute inset-x-0 bottom-0 z-10 px-12 pb-12">
+                    <span className="block overflow-hidden mb-7">
+                        <span data-photo-kicker className="block font-body-strong text-[11px] uppercase tracking-[0.1em]" style={{ color: "var(--brand-ocre)" }}>
+                            Haodygasikara — Madagascar
+                        </span>
+                    </span>
+
+                    <h2 className="font-title leading-[0.95]" style={{ color: "var(--text-inverse)", fontSize: "clamp(2.25rem, 3.3vw, 3.75rem)" }}>
+                        <span className="block overflow-hidden">
+                            <span data-photo-line className="block pb-[0.06em]">Chaque voyage commence</span>
+                        </span>
+                        <span className="block overflow-hidden">
+                            <span data-photo-line className="block pb-[0.06em]">par une conversation.</span>
+                        </span>
+                    </h2>
+
+                    <div className="mt-9">
+                        <div data-photo-rule style={{ borderTop: "1px solid rgba(245,240,230,0.25)" }} />
+                        <p data-photo-foot className="font-body text-[11px] uppercase tracking-[0.1em] pt-6" style={{ color: "rgba(245,240,230,0.7)" }}>
+                            Devis sur mesure sous 48 heures
+                        </p>
+                    </div>
+                </div>
+            </div>
+
+            {/* ── Volet formulaire — c'est lui seul qui bascule ────────────── */}
+            <div className="flex-1 flex items-center justify-center px-8 py-16 z-10">
+                <div className="w-full" style={{ maxWidth: LARGEUR_FORMULAIRE }}>
+                    <div data-swap data-text-item className="lg:hidden mb-12" style={{ color: "var(--text-primary)" }}>
+                        {retour}
+                    </div>
+
+                    <div data-swap>
+                        <span className="block overflow-hidden mb-6">
+                            <span data-form-kicker className="block font-body-strong text-[11px] uppercase tracking-[0.1em]" style={{ color: "var(--brand-terre)" }}>
+                                Espace voyageur
+                            </span>
+                        </span>
+                    </div>
+
+                    <h1
+                        data-swap
+                        className="font-title leading-[0.95]"
+                        style={{ color: "var(--text-primary)", fontSize: "clamp(2.25rem, 3vw, 3.25rem)" }}
+                    >
+                        {t.titre.map((ligne) => (
+                            <span key={ligne} className="block overflow-hidden">
+                                <span data-form-line className="block pb-[0.06em]">{ligne}</span>
+                            </span>
+                        ))}
+                    </h1>
+
+                    <p data-swap data-text-item className="mt-7 font-body text-[15px] leading-[1.85]" style={{ color: "var(--text-secondary)" }}>
+                        {t.intro}
+                    </p>
+
+                    {/* Le séparateur « ou » est parti avec le bouton Google : il ne
+                        séparait plus rien. L'écart qu'il tenait est repris ici. */}
+                    <form onSubmit={handleSubmit} className="mt-12 flex flex-col gap-9">
+                        {inscription && (
+                            <div data-swap data-text-item className="grid grid-cols-2 gap-6">
+                                <Champ id="prenom" label="Prénom" type="text" value={form.prenom} onChange={handleChange} autoComplete="given-name" />
+                                <Champ id="nom" label="Nom" type="text" value={form.nom} onChange={handleChange} autoComplete="family-name" />
+                            </div>
+                        )}
+
+                        {inscription && (
+                            <div data-swap data-text-item>
+                                <ChampDateNaissance
+                                    valeur={form.naissance}
+                                    onChange={majChamp("naissance")}
+                                />
+                            </div>
+                        )}
+
+                        <div data-swap data-text-item>
+                            <Champ
+                                id="email"
+                                label="Adresse e-mail"
+                                type="email"
+                                value={form.email}
+                                onChange={handleChange}
+                                autoComplete="email"
+                            />
+                        </div>
+
+                        {inscription && (
+                            <div data-swap data-text-item>
+                                <ChampTelephone
+                                    indicatif={form.indicatif}
+                                    numero={form.telephone}
+                                    onIndicatif={majChamp("indicatif")}
+                                    onNumero={majChamp("telephone")}
+                                />
+                            </div>
+                        )}
+
+                        <div data-swap data-text-item>
+                            <Champ
+                                id="password"
+                                label="Mot de passe"
+                                type="password"
+                                value={form.password}
+                                onChange={handleChange}
+                                autoComplete={inscription ? "new-password" : "current-password"}
+                            />
+                            {!inscription && (
+                                <div className="flex justify-end mt-4">
+                                    <Link
+                                        to="/mot-de-passe-oublie"
+                                        state={{ email: form.email }}
+                                        className="font-body text-[11px] transition-colors duration-300"
+                                        style={{ color: "var(--text-muted)" }}
+                                        onMouseEnter={(e) => (e.currentTarget.style.color = "var(--brand-terre)")}
+                                        onMouseLeave={(e) => (e.currentTarget.style.color = "var(--text-muted)")}
+                                    >
+                                        Mot de passe oublié ?
+                                    </Link>
+                                </div>
+                            )}
+                        </div>
+
+                        {info && !erreur && !succes && (
+                            <p role="status" className="font-body text-sm leading-relaxed px-5 py-4"
+                                style={{ backgroundColor: "var(--warning-bg)", color: "var(--warning-text)" }}>
+                                {info}
+                            </p>
+                        )}
+
+                        {(erreur || succes) && (
+                            <p
+                                role="status"
+                                className="font-body text-sm leading-relaxed px-5 py-4"
+                                style={
+                                    erreur
+                                        ? { backgroundColor: "var(--error-bg)", color: "var(--error-text)" }
+                                        : { backgroundColor: "var(--success-bg)", color: "var(--success-text)" }
+                                }
+                            >
+                                {erreur || succes}
+                            </p>
+                        )}
+
+                        <button
+                            data-swap
+                            data-text-item
+                            type="submit"
+                            disabled={envoi}
+                            className="w-full py-5 font-body-strong text-[11px] uppercase tracking-[0.1em] transition-colors duration-300 cursor-pointer disabled:cursor-wait"
+                            style={{
+                                backgroundColor: envoi ? "var(--cta-bg-hover)" : "var(--cta-bg)",
+                                color: "var(--cta-text)",
+                            }}
+                            onMouseEnter={(e) => { if (!envoi) e.currentTarget.style.backgroundColor = "var(--cta-bg-hover)"; }}
+                            onMouseLeave={(e) => { if (!envoi) e.currentTarget.style.backgroundColor = "var(--cta-bg)"; }}
+                        >
+                            {envoi ? "Un instant…" : t.action}
+                        </button>
+                    </form>
+
+                    <div data-swap data-text-item className="mt-12 pt-8 flex items-center justify-between gap-6" style={{ borderTop: "1px solid var(--border)" }}>
+                        <span className="font-body text-sm" style={{ color: "var(--text-muted)" }}>
+                            {t.bascule.question}
+                        </span>
+                        <button
+                            type="button"
+                            onClick={() => basculer(t.bascule.vers)}
+                            disabled={enTransition}
+                            className="group flex items-center gap-3 font-body-strong text-[11px] uppercase tracking-[0.1em] transition-colors duration-300 cursor-pointer disabled:cursor-default"
+                            style={{ color: "var(--text-primary)" }}
+                            onMouseEnter={(e) => (e.currentTarget.style.color = "var(--brand-terre)")}
+                            onMouseLeave={(e) => (e.currentTarget.style.color = "var(--text-primary)")}
+                        >
+                            {t.bascule.lien}
+                            <FaArrowRight className="text-[10px] transition-transform duration-500 ease-out group-hover:translate-x-1" />
+                        </button>
+                    </div>
+                </div>
+            </div>
+        </div>
+    );
+}
diff --git a/src/pages/client/auth/motDePasse/MotDePasseOublie.jsx b/src/pages/client/auth/motDePasse/MotDePasseOublie.jsx
new file mode 100644
index 0000000..02da05a
--- /dev/null
+++ b/src/pages/client/auth/motDePasse/MotDePasseOublie.jsx
@@ -0,0 +1,61 @@
+import { useState } from "react";
+import { useLocation } from "react-router-dom";
+import { motDePasseOublieApi } from "../../../../api/authApi";
+import { messageErreurApi } from "../../../../utils/auth";
+import CadreAuthCentre, { BoutonAuth, ChampAuth, MessageAuth } from "../../../../components/client/auth/CadreAuthCentre";
+
+// ── Mot de passe oublié — /mot-de-passe-oublie ─────────────────────────────
+//
+// Une adresse, un lien par e-mail. La réponse du serveur est la même que le
+// compte existe ou non : la page ne peut pas servir à tester qui est inscrit.
+
+export default function MotDePasseOublie() {
+    const { state } = useLocation();
+    const [email, setEmail] = useState(state?.email ?? "");
+    const [envoi, setEnvoi] = useState(false);
+    const [erreur, setErreur] = useState("");
+    const [envoye, setEnvoye] = useState("");
+
+    const envoyer = async (e) => {
+        e.preventDefault();
+        if (envoi) return;
+        setErreur("");
+        setEnvoi(true);
+        try {
+            const reponse = await motDePasseOublieApi(email.trim());
+            setEnvoye(reponse?.message ?? "Si un compte existe pour cette adresse, un lien vient de partir.");
+        } catch (error) {
+            setErreur(messageErreurApi(error, "La demande n'a pas pu partir. Réessayez."));
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    return (
+        <CadreAuthCentre surTitre="Mot de passe oublié" titre={<>Un nouveau<br />mot de passe.</>}>
+            <p className="mt-9 font-body text-[15px] leading-[1.85]" style={{ color: "var(--text-secondary)" }}>
+                Indiquez l'adresse de votre compte : nous vous envoyons un lien, valable 30 minutes, pour en choisir un autre.
+            </p>
+
+            {envoye ? (
+                <div className="mt-12 flex flex-col gap-8">
+                    <MessageAuth ton="succes">{envoye}</MessageAuth>
+                    <button type="button" onClick={() => setEnvoye("")}
+                        className="self-start font-body-strong text-[11px] uppercase tracking-[0.1em] cursor-pointer"
+                        style={{ color: "var(--text-primary)", textDecoration: "underline", textUnderlineOffset: "5px" }}>
+                        Utiliser une autre adresse
+                    </button>
+                </div>
+            ) : (
+                <form onSubmit={envoyer} className="mt-12 flex flex-col gap-9" noValidate>
+                    <ChampAuth id="email" label="Adresse e-mail" type="email" value={email} autoComplete="email" required
+                        onChange={(e) => setEmail(e.target.value)} />
+                    <MessageAuth>{erreur}</MessageAuth>
+                    <BoutonAuth type="submit" actif={/\S+@\S+\.\S+/.test(email)} enCours={envoi}>
+                        Recevoir le lien
+                    </BoutonAuth>
+                </form>
+            )}
+        </CadreAuthCentre>
+    );
+}
diff --git a/src/pages/client/auth/motDePasse/ReinitialiserMotDePasse.jsx b/src/pages/client/auth/motDePasse/ReinitialiserMotDePasse.jsx
new file mode 100644
index 0000000..0de7b5d
--- /dev/null
+++ b/src/pages/client/auth/motDePasse/ReinitialiserMotDePasse.jsx
@@ -0,0 +1,85 @@
+import { useState } from "react";
+import { Link, useNavigate, useSearchParams } from "react-router-dom";
+import { reinitialiserMotDePasseApi } from "../../../../api/authApi";
+import { messageErreurApi } from "../../../../utils/auth";
+import CadreAuthCentre, { BoutonAuth, ChampAuth, MessageAuth } from "../../../../components/client/auth/CadreAuthCentre";
+
+// ── Choisir un nouveau mot de passe — /reinitialiser-mot-de-passe?jeton=… ──
+//
+// On arrive ici depuis le lien de l'e-mail. Deux saisies identiques de 8
+// caractères au moins — la règle de l'inscription —, puis retour à la
+// connexion avec un message qui confirme le changement.
+
+const MINIMUM = 8;
+
+export default function ReinitialiserMotDePasse() {
+    const navigate = useNavigate();
+    const [params] = useSearchParams();
+    const jeton = params.get("jeton") ?? "";
+
+    const [motDePasse, setMotDePasse] = useState("");
+    const [confirmation, setConfirmation] = useState("");
+    const [envoi, setEnvoi] = useState(false);
+    const [erreur, setErreur] = useState("");
+    const [perime, setPerime] = useState(false);
+
+    const tropCourt = motDePasse.length > 0 && motDePasse.length < MINIMUM;
+    const different = confirmation.length > 0 && confirmation !== motDePasse;
+    const valide = motDePasse.length >= MINIMUM && confirmation === motDePasse;
+
+    const envoyer = async (e) => {
+        e.preventDefault();
+        if (!valide || envoi) return;
+        setErreur("");
+        setEnvoi(true);
+        try {
+            const reponse = await reinitialiserMotDePasseApi({ token: jeton, password: motDePasse });
+            navigate("/login", {
+                replace: true,
+                state: { message: reponse?.message ?? "Votre mot de passe est modifié. Vous pouvez vous connecter.", ton: "succes" },
+            });
+        } catch (error) {
+            setPerime(error?.response?.status === 410);
+            setErreur(messageErreurApi(error, "Le mot de passe n'a pas pu être changé. Réessayez."));
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    if (!jeton) {
+        return (
+            <CadreAuthCentre surTitre="Mot de passe" titre={<>Lien<br />incomplet.</>}>
+                <p className="mt-9 font-body text-[15px] leading-[1.85]" style={{ color: "var(--text-secondary)" }}>
+                    Ouvrez le lien reçu par e-mail tel quel, ou demandez-en un nouveau.
+                </p>
+                <Link to="/mot-de-passe-oublie" className="mt-10 inline-block font-body-strong text-[11px] uppercase tracking-[0.1em]"
+                    style={{ color: "var(--brand-terre)", textDecoration: "underline", textUnderlineOffset: "5px" }}>
+                    Recevoir un nouveau lien
+                </Link>
+            </CadreAuthCentre>
+        );
+    }
+
+    return (
+        <CadreAuthCentre surTitre="Mot de passe" titre={<>Choisissez-en<br />un nouveau.</>}>
+            <form onSubmit={envoyer} className="mt-12 flex flex-col gap-9" noValidate>
+                <ChampAuth id="password" label="Nouveau mot de passe" type="password" value={motDePasse}
+                    autoComplete="new-password" onChange={(e) => setMotDePasse(e.target.value)}
+                    aide={tropCourt ? `Encore ${MINIMUM - motDePasse.length} caractère(s) au moins.` : `${MINIMUM} caractères au moins.`} />
+                <ChampAuth id="confirmation" label="Confirmez-le" type="password" value={confirmation}
+                    autoComplete="new-password" onChange={(e) => setConfirmation(e.target.value)}
+                    aide={different ? "Les deux saisies ne sont pas identiques." : undefined} />
+
+                <MessageAuth>{erreur}</MessageAuth>
+                {perime && (
+                    <Link to="/mot-de-passe-oublie" className="self-start font-body-strong text-[11px] uppercase tracking-[0.1em]"
+                        style={{ color: "var(--brand-terre)", textDecoration: "underline", textUnderlineOffset: "5px" }}>
+                        Recevoir un nouveau lien
+                    </Link>
+                )}
+
+                <BoutonAuth type="submit" actif={valide} enCours={envoi}>Enregistrer le mot de passe</BoutonAuth>
+            </form>
+        </CadreAuthCentre>
+    );
+}
diff --git a/src/pages/client/auth/verification/VerificationEmail.jsx b/src/pages/client/auth/verification/VerificationEmail.jsx
new file mode 100644
index 0000000..648d086
--- /dev/null
+++ b/src/pages/client/auth/verification/VerificationEmail.jsx
@@ -0,0 +1,271 @@
+import { useEffect, useRef, useState } from "react";
+import { Link, useLocation, useNavigate } from "react-router-dom";
+import { FaArrowLeft, FaArrowRight } from "react-icons/fa6";
+import { resendCodeApi, verifyCodeApi } from "../../../../api/authApi";
+import { codeErreurApi, messageErreurApi, secondesAvantReessai } from "../../../../utils/auth";
+import { CODES_ERREUR } from "../../../../constants/client/erreursAuth";
+import { formaterAttente, useCompteARebours } from "../../../../hooks/useCompteARebours";
+
+const LONGUEUR_CODE = 6;
+
+// Le back impose 60 s entre deux envois. On lance le decompte des le succes
+// plutot que d'attendre le 429 : l'utilisateur voit pourquoi le lien est
+// eteint au lieu de cliquer dans le vide puis de lire un refus.
+const SECONDES_ENTRE_ENVOIS = 60;
+
+export default function VerificationEmail() {
+    const navigate = useNavigate();
+    const { state } = useLocation();
+
+    const email = state?.email ?? "";
+    const contexte = state?.message;
+
+    const [chiffres, setChiffres] = useState(Array(LONGUEUR_CODE).fill(""));
+    const [envoi, setEnvoi] = useState(false);
+    const [erreur, setErreur] = useState("");
+    const [succes, setSucces] = useState("");
+    const cases = useRef([]);
+
+    // Deux decomptes distincts : le compte peut etre bloque (codes faux)
+    // pendant que le renvoi, lui, est simplement en periode de repos.
+    const blocage = useCompteARebours();
+    const repos = useCompteARebours();
+
+    const code = chiffres.join("");
+    const bloque = blocage.restant > 0;
+    const complet = code.length === LONGUEUR_CODE && !bloque;
+
+    useEffect(() => { cases.current[0]?.focus(); }, []);
+
+    const saisir = (i, valeur) => {
+        if (bloque) return;
+        const chiffre = valeur.replace(/\D/g, "").slice(-1);
+        setChiffres((c) => {
+            const suivant = [...c];
+            suivant[i] = chiffre;
+            return suivant;
+        });
+        if (chiffre && i < LONGUEUR_CODE - 1) cases.current[i + 1]?.focus();
+    };
+
+    // Retour arrière sur une case vide : on remonte à la précédente
+    const clavier = (i, e) => {
+        if (e.key === "Backspace" && !chiffres[i] && i > 0) cases.current[i - 1]?.focus();
+        if (e.key === "ArrowLeft" && i > 0) cases.current[i - 1]?.focus();
+        if (e.key === "ArrowRight" && i < LONGUEUR_CODE - 1) cases.current[i + 1]?.focus();
+    };
+
+    // Coller le code entier depuis le mail doit remplir les six cases
+    const coller = (e) => {
+        const colle = e.clipboardData.getData("text").replace(/\D/g, "").slice(0, LONGUEUR_CODE);
+        if (!colle) return;
+        e.preventDefault();
+        const suivant = Array(LONGUEUR_CODE).fill("");
+        [...colle].forEach((d, i) => { suivant[i] = d; });
+        setChiffres(suivant);
+        cases.current[Math.min(colle.length, LONGUEUR_CODE - 1)]?.focus();
+    };
+
+    const valider = async (e) => {
+        e.preventDefault();
+        if (!complet || envoi) return;
+
+        setErreur("");
+        setSucces("");
+        setEnvoi(true);
+        try {
+            await verifyCodeApi({ email, code });
+            // Un administrateur repart vers la connexion de l'administration
+            navigate(state?.retour ?? "/login", { replace: true, state: { message: "Votre email est vérifié. Vous pouvez vous connecter.", ton: "succes" } });
+        } catch (error) {
+            setErreur(messageErreurApi(error));
+            setChiffres(Array(LONGUEUR_CODE).fill(""));
+
+            // 429 : le back dit combien de temps patienter, on le montre au
+            // lieu de laisser l'utilisateur marteler un bouton qui refusera.
+            const attente = secondesAvantReessai(error);
+            if (attente > 0) {
+                if (codeErreurApi(error) === CODES_ERREUR.TOO_MANY_ATTEMPTS) blocage.lancer(attente);
+                else repos.lancer(attente);
+            } else {
+                cases.current[0]?.focus();
+            }
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    const renvoyer = async () => {
+        if (envoi || repos.restant > 0 || bloque) return;
+        setErreur("");
+        setSucces("");
+        setEnvoi(true);
+        try {
+            await resendCodeApi({ email });
+            setSucces("Un nouveau code vient de partir.");
+            setChiffres(Array(LONGUEUR_CODE).fill(""));
+            repos.lancer(SECONDES_ENTRE_ENVOIS);
+            cases.current[0]?.focus();
+        } catch (error) {
+            setErreur(messageErreurApi(error));
+            const attente = secondesAvantReessai(error);
+            if (attente > 0) {
+                if (codeErreurApi(error) === CODES_ERREUR.TOO_MANY_ATTEMPTS) blocage.lancer(attente);
+                else repos.lancer(attente);
+            }
+        } finally {
+            setEnvoi(false);
+        }
+    };
+
+    return (
+        <div className="min-h-screen w-full flex flex-col" style={{ backgroundColor: "var(--bg-territoires)" }}>
+            {/* ── Barre haute, discrète ───────────────────────────────────── */}
+            <div className="flex items-center justify-between px-12 py-10">
+                <button
+                    type="button"
+                    onClick={() => navigate(-1)}
+                    className="group flex items-center gap-3.5 cursor-pointer"
+                    style={{ color: "var(--text-primary)" }}
+                >
+                    <FaArrowLeft className="text-[11px] transition-transform duration-500 ease-out group-hover:-translate-x-1.5" />
+                    <span className="font-body-strong text-[11px] uppercase tracking-[0.1em]">Retour</span>
+                </button>
+
+                <span className="font-title text-xl" style={{ color: "var(--text-primary)" }}>
+                    HaodyGasikara
+                </span>
+            </div>
+
+            {/* ── Le code, seul au centre ─────────────────────────────────── */}
+            <div className="flex-1 flex items-center justify-center px-8 pb-24">
+                <div className="w-full text-center" style={{ maxWidth: "560px" }}>
+                    <p className="font-body-strong text-[11px] uppercase tracking-[0.1em] mb-8" style={{ color: "var(--brand-terre)" }}>
+                        Vérification
+                    </p>
+
+                    <h1
+                        className="font-title leading-[0.95]"
+                        style={{ color: "var(--text-primary)", fontSize: "clamp(2.5rem, 4.5vw, 4rem)" }}
+                    >
+                        Votre code
+                        <br />
+                        à six chiffres.
+                    </h1>
+
+                    <p className="mt-9 font-body text-[15px] leading-[1.85]" style={{ color: "var(--text-secondary)" }}>
+                        Nous venons de l'envoyer à
+                        {email ? <strong className="font-body-strong"> {email}</strong> : " votre adresse"}.
+                    </p>
+
+                    {contexte && (
+                        <p className="mt-8 font-body text-sm leading-relaxed px-6 py-4" style={{ backgroundColor: "var(--warning-bg)", color: "var(--warning-text)" }}>
+                            {contexte}
+                        </p>
+                    )}
+
+                    <form onSubmit={valider}>
+                        <div className="flex items-center justify-center gap-3 sm:gap-4 mt-14">
+                            {chiffres.map((chiffre, i) => (
+                                <input
+                                    key={i}
+                                    ref={(el) => { cases.current[i] = el; }}
+                                    value={chiffre}
+                                    onChange={(e) => saisir(i, e.target.value)}
+                                    onKeyDown={(e) => clavier(i, e)}
+                                    onPaste={coller}
+                                    onFocus={(e) => e.target.select()}
+                                    inputMode="numeric"
+                                    disabled={bloque}
+                                    autoComplete={i === 0 ? "one-time-code" : "off"}
+                                    aria-label={`Chiffre ${i + 1}`}
+                                    className="field-line bg-transparent outline-none text-center font-title transition-all duration-500 disabled:cursor-not-allowed"
+                                    style={{
+                                        width: "clamp(44px, 7vw, 64px)",
+                                        height: "clamp(64px, 9vw, 88px)",
+                                        fontSize: "clamp(1.75rem, 3vw, 2.5rem)",
+                                        color: "var(--text-primary)",
+                                        borderBottomWidth: "2px",
+                                        opacity: bloque ? 0.35 : 1,
+                                    }}
+                                />
+                            ))}
+                        </div>
+
+                        {(erreur || succes) && (
+                            <p
+                                role="status"
+                                className="mt-10 font-body text-sm leading-relaxed px-6 py-4"
+                                style={
+                                    erreur
+                                        ? { backgroundColor: "var(--error-bg)", color: "var(--error-text)" }
+                                        : { backgroundColor: "var(--success-bg)", color: "var(--success-text)" }
+                                }
+                            >
+                                {erreur || succes}
+                            </p>
+                        )}
+
+                        <button
+                            type="submit"
+                            disabled={!complet || envoi}
+                            className="mt-12 w-full py-5 font-body-strong text-[11px] uppercase tracking-[0.1em] transition-all duration-300 cursor-pointer disabled:cursor-not-allowed"
+                            style={{
+                                backgroundColor: complet && !envoi ? "var(--cta-bg)" : "var(--cta-disabled-bg)",
+                                color: complet && !envoi ? "var(--cta-text)" : "var(--cta-disabled-text)",
+                            }}
+                            onMouseEnter={(e) => { if (complet && !envoi) e.currentTarget.style.backgroundColor = "var(--cta-bg-hover)"; }}
+                            onMouseLeave={(e) => { if (complet && !envoi) e.currentTarget.style.backgroundColor = "var(--cta-bg)"; }}
+                        >
+                            {bloque
+                                ? `Réessayez dans ${formaterAttente(blocage.restant)}`
+                                : envoi
+                                    ? "Un instant…"
+                                    : "Vérifier mon email"}
+                        </button>
+                    </form>
+
+                    <div className="mt-10 flex items-center justify-center gap-3 font-body text-sm" style={{ color: "var(--text-muted)" }}>
+                        <span>Le code expire dans 15 minutes.</span>
+                        {repos.restant > 0 || bloque ? (
+                            <span className="font-body-strong" style={{ color: "var(--text-muted)" }}>
+                                {bloque
+                                    ? "Renvoi indisponible"
+                                    : `Nouveau code dans ${formaterAttente(repos.restant)}`}
+                            </span>
+                        ) : (
+                            <button
+                                type="button"
+                                onClick={renvoyer}
+                                disabled={envoi || !email}
+                                className="font-body-strong transition-colors duration-300 cursor-pointer disabled:cursor-not-allowed"
+                                style={{ color: "var(--text-primary)", textDecoration: "underline", textUnderlineOffset: "4px" }}
+                                onMouseEnter={(e) => (e.currentTarget.style.color = "var(--brand-terre)")}
+                                onMouseLeave={(e) => (e.currentTarget.style.color = "var(--text-primary)")}
+                            >
+                                En recevoir un nouveau
+                            </button>
+                        )}
+                    </div>
+                </div>
+            </div>
+
+            {/* ── Pied ────────────────────────────────────────────────────── */}
+            <div className="flex items-center justify-between px-12 py-8">
+                <span className="font-body text-[11px] uppercase tracking-[0.1em]" style={{ color: "var(--text-muted)" }}>
+                    Devis sur mesure sous 48 heures
+                </span>
+                <Link
+                    to="/login"
+                    className="group flex items-center gap-3 font-body-strong text-[11px] uppercase tracking-[0.1em] transition-colors duration-300"
+                    style={{ color: "var(--text-primary)" }}
+                    onMouseEnter={(e) => (e.currentTarget.style.color = "var(--brand-terre)")}
+                    onMouseLeave={(e) => (e.currentTarget.style.color = "var(--text-primary)")}
+                >
+                    Se connecter
+                    <FaArrowRight className="text-[10px] transition-transform duration-500 ease-out group-hover:translate-x-1" />
+                </Link>
+            </div>
+        </div>
+    );
+}
diff --git a/src/pages/client/circuitDetail/CircuitDetail.jsx b/src/pages/client/circuitDetail/CircuitDetail.jsx
new file mode 100644
index 0000000..2aadb99
--- /dev/null
+++ b/src/pages/client/circuitDetail/CircuitDetail.jsx
@@ -0,0 +1,97 @@
+import { useParams } from "react-router-dom";
+import { useCallback, useEffect, useState } from "react";
+import { findCircuitClientById } from "../../../api/client/cricuitApi";
+import { circuitLegs, circuitMedias, circuitRoute } from "../../../utils/circuit";
+import { useCircuitDetailAnimations } from "../../../hooks/design/animations/circuit/useCircuitDetailAnimations";
+import CircuitDetailHero from "./components/hero/CircuitDetailHero";
+import CircuitApropos from "./components/apropos/CircuitApropos";
+import CircuitRecap from "./components/recap/CircuitRecap";
+import CircuitItineraire from "./components/itineraire/CircuitItineraire";
+
+// ── La page detail d'un circuit ───────────────────────────────────────────
+// Elle ne fait plus que trois choses : charger le circuit, en tirer les deux
+// ou trois lectures partagees, et poser ses sections. Tout le dessin est
+// descendu dans components/ — une section par dossier — et les regles dans
+// index.css (.cx-about, .cx-iti, .cx-depli, .cx-visites).
+//
+//   components/hero/       la photo plein cadre et le nom du circuit
+//   components/apropos/    l'accroche editoriale
+//   components/recap/      ce que comprend le circuit : fiche, decompte, listes
+//   components/itineraire/ la liste des haltes, une halte, une journee,
+//                          ses visites, sa planche photo
+//   components/shared/     la mention (valeur + legende), partagee
+//
+// Ce que le back envoie et qu'on ne recalcule donc pas : `dureeJours` (la
+// duree du circuit), `premierJour` (le jour ou commence une etape) et
+// `jourCircuit` (le jour du voyage, pas celui de l'etape).
+export default function CircuitDetail() {
+    const { id } = useParams();
+    const [circuit, setCircuit] = useState(null);
+
+    const loadCircuit = useCallback(async () => {
+        try {
+            const res = await findCircuitClientById(id);
+            setCircuit(res?.data ?? null);
+        } catch (error) {
+            console.error("Chargement du circuit impossible", error);
+        }
+    }, [id]);
+
+    useEffect(() => { loadCircuit(); }, [loadCircuit]);
+
+    // Les animations de toute la page. Le hook ne touche AUCUN dessin : il se
+    // branche sur les classes existantes et ne fait bouger qu'`opacity` et
+    // `transform`, qu'il retire une fois jouées. Retirer cette ligne retire
+    // toute la chorégraphie, et il ne reste rien.
+    useCircuitDetailAnimations(Boolean(circuit));
+
+    const jours = circuit?.dureeJours ?? 0;
+    const { depart, arrivee } = circuitRoute(circuit) || {};
+    const etapes = circuitLegs(circuit);
+
+    // La planche photo de la section « Le voyage ». circuitMedias ouvre sur la
+    // couverture du circuit : on la saute, elle occupe deja tout le hero et la
+    // reposer trente lignes plus bas ne montrerait rien de neuf. Restent les
+    // visuels des etapes, et le film s'il y en a un.
+    const visuels = circuitMedias(circuit, 4).slice(1);
+
+    return (
+        <>
+            <CircuitDetailHero
+                circuit={circuit}
+                days={jours}
+                depart={depart}
+                arrivee={arrivee}
+            />
+
+            {/* .cx-detail ne dessine rien : il porte --cx-gutter, la gouttiere
+                que l'« A propos » et l'itineraire partagent pour rester
+                alignes a toutes les largeurs. */}
+            <div className="cx-detail">
+                <CircuitApropos notes={circuit?.notes} />
+
+                {/* Avant l'itineraire, et c'est voulu : « est-ce que ce voyage
+                    est pour moi ? » se repond avant qu'on demande au lecteur
+                    d'avaler quinze jours de programme. */}
+                <CircuitRecap
+                    recap={circuit?.recap}
+                    fiche={circuit?.fiche}
+                    tags={circuit?.tags ?? []}
+                    visuels={visuels}
+                    duree={jours}
+                    circuitId={id}
+                    modele={Boolean(circuit?.isTemplate)}
+                />
+
+                <CircuitItineraire
+                    circuit={circuit}
+                    etapes={etapes}
+                    jours={jours}
+                    depart={depart}
+                    arrivee={arrivee}
+                    circuitId={id}
+                />
+            </div>
+        </>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/apropos/CircuitApropos.jsx b/src/pages/client/circuitDetail/components/apropos/CircuitApropos.jsx
new file mode 100644
index 0000000..2f90863
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/apropos/CircuitApropos.jsx
@@ -0,0 +1,44 @@
+import { enParagraphes } from "../../../../../utils/format";
+
+// ── A propos ──────────────────────────────────────────────────────────────
+// L'accroche editoriale, juste sous le hero. Memes elements qu'avant — la
+// mention, le titre, le texte — mais la largeur est occupee au lieu d'etre
+// laissee :
+//
+//   * LA MENTION passe au-dessus, pleine largeur. En rail a gauche, elle
+//     portait un mot et rien d'autre sur toute la hauteur du bloc.
+//   * LE TITRE tient la colonne de gauche, LE TEXTE celle de droite. La
+//     mesure de lecture reste a 62 caracteres — ce qui a change, c'est que
+//     le tiers qui restait blanc porte maintenant le titre.
+//
+// Sous 1024 px les deux colonnes s'empilent : on retombe sur la mise en page
+// d'origine (cf. .cx-tete dans index.css).
+export default function CircuitApropos({ notes }) {
+    const paragraphes = enParagraphes(notes);
+    if (!paragraphes.length) return null;
+
+    return (
+        <section className="cx-about" data-header-text="var(--text-primary)">
+            <div className="cx-tete">
+                <span className="cx-tete__mention cx-label cx-label--accent font-body-strong">
+                    À propos
+                </span>
+
+                <h2 className="cx-tete__titre font-title">
+                    L&rsquo;esprit du voyage
+                </h2>
+
+                <div className="min-w-0">
+                    {paragraphes.map((texte, i) => (
+                        <p
+                            key={i}
+                            className={i === 0 ? "cx-tete__chapo font-body" : "cx-tete__texte font-body"}
+                        >
+                            {texte}
+                        </p>
+                    ))}
+                </div>
+            </div>
+        </section>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/hero/CircuitDetailHero.jsx b/src/pages/client/circuitDetail/components/hero/CircuitDetailHero.jsx
new file mode 100644
index 0000000..3e0e240
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/hero/CircuitDetailHero.jsx
@@ -0,0 +1,212 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { ArrowLeft, ArrowRight, Play } from "lucide-react";
+import { circuitMedias } from "../../../../../utils/circuit";
+import { imageCloudinary } from "../../../../../utils/image";
+
+// Le hero de la page detail : la photo de couverture plein cadre, le nom du
+// circuit et le trace poses dessus.
+//
+// `data-header-text` previent l'entete du site qu'elle passe sur du sombre et
+// doit basculer son encre — c'est le seul lien entre ce bloc et le reste de
+// l'application.
+//
+// ── Ce qui a ete AJOUTE, et rien d'autre ─────────────────────────────────
+// Le dessin d'origine est intact : meme section plein ecran, meme photo en
+// `opacity-75` sur du noir, meme titre en 8xl, meme ligne de meta a droite,
+// meme filet. Pas une classe changee.
+//
+// Ce qui s'ajoute, sous le filet :
+//   * la bande des visuels du circuit, A GAUCHE — trois colonnes au plus, qui
+//     defilent au-dela ;
+//   * les fleches A DROITE, en icone nue : ni cadre, ni fond, ni rayon.
+//
+// Et la photo du haut devient une pile : changer de visuel fait un fondu au
+// lieu d'un remplacement sec. C'est du mouvement, pas un changement de dessin —
+// au repos, l'ecran est exactement celui d'avant.
+
+// Trois colonnes au plus, et elles se suivent. Au-dela, la bande mangeait la
+// largeur du titre ; en-deca, on ne comprend pas qu'il y en a d'autres.
+const VIGNETTES_VISIBLES = 3;
+
+export default function CircuitDetailHero({ circuit, days, depart, arrivee }) {
+    // circuitMedias ouvre sur la couverture — celle que le hero montrait deja
+    // seule — puis le film s'il existe, puis les visuels des etapes.
+    const medias = useMemo(() => circuitMedias(circuit, 8), [circuit]);
+    const [index, setIndex] = useState(0);
+
+    // Un autre circuit, une autre pile : on repart du premier visuel.
+    useEffect(() => { setIndex(0); }, [circuit?.id]);
+
+    const plusieurs = medias.length > 1;
+    const aller = (i) => setIndex((i + medias.length) % medias.length);
+
+    // La bande ne montre que trois vignettes : celle qui devient active doit se
+    // ramener d'elle-meme dans la fenetre, sinon la selection designe un visuel
+    // qu'on ne voit pas. `inline: nearest` fait glisser du minimum necessaire —
+    // `center` recentrerait a chaque pas et donnerait un mouvement permanent.
+    const pisteRef = useRef(null);
+    useEffect(() => {
+        pisteRef.current?.children?.[index]?.scrollIntoView({
+            behavior: "smooth", block: "nearest", inline: "nearest",
+        });
+    }, [index]);
+
+    return (
+        <section className="h-screen relative" data-header-text="var(--text-inverse)">
+            <div className="relative w-full h-full overflow-hidden bg-black">
+
+                {/* La pile. Chaque calque porte EXACTEMENT les classes de
+                    l'image d'origine ; seule l'opacite est pilotee, et celle du
+                    calque actif vaut 0.75 — la valeur de `opacity-75`. Au repos,
+                    rien ne distingue cet ecran du precedent. */}
+                {medias.length > 0 ? (
+                    medias.map((media, i) => (
+                        <div
+                            key={media.cle ?? media.src}
+                            data-hero-calque
+                            aria-hidden={i !== index}
+                            className="absolute inset-0"
+                            style={{
+                                opacity: i === index ? 0.75 : 0,
+                                transition: "opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1)",
+                            }}
+                        >
+                            {media.type === "video" ? (
+                                <video
+                                    data-hero-media
+                                    src={media.src}
+                                    poster={media.poster ?? undefined}
+                                    muted
+                                    loop
+                                    playsInline
+                                    preload={i === 0 ? "auto" : "metadata"}
+                                    autoPlay={i === index}
+                                    className="w-full h-full object-cover absolute inset-0"
+                                />
+                            ) : (
+                                <img
+                                    data-hero-media
+                                    src={imageCloudinary(media.src, 1920)}
+                                    alt=""
+                                    decoding="async"
+                                    fetchPriority={i === 0 ? "high" : "low"}
+                                    className="w-full h-full object-cover absolute inset-0"
+                                />
+                            )}
+                        </div>
+                    ))
+                ) : (
+                    <img
+                        data-hero-media
+                        src={imageCloudinary(circuit?.imageUrl, 1920)}
+                        alt=""
+                        decoding="async"
+                        className="w-full h-full object-cover absolute inset-0 opacity-75"
+                    />
+                )}
+
+                {circuit && (
+                    <div className="z-10 absolute inset-x-5 sm:inset-x-16 bottom-12 lg:bottom-20">
+
+                        <div className="flex flex-col items-start gap-1 lg:flex-row lg:justify-between lg:items-end lg:gap-0 w-full">
+                            <h1 data-hero-titre className="my-2 text-5xl sm:text-7xl lg:text-8xl font-title text-[var(--text-inverse)]">
+                                {circuit.nom}
+                            </h1>
+                            <div data-hero-meta className="flex flex-wrap items-center text-sm sm:text-lg mb-4 lg:mb-6">
+
+                                <span className="font-body-strong text-[var(--text-inverse-secondary)]">{days} jours</span>
+
+                                <span className="font-body-strong pl-6 text-[var(--text-inverse-secondary)]">
+                                    {depart} <span className="text-neutral-400 mx-1">→</span> {arrivee}
+                                </span>
+                            </div>
+                        </div>
+
+                        <div data-hero-filet style={{ borderTop: "1px solid var(--border)" }} />
+
+                        {/* ── SOUS LE FILET : la bande a gauche, les fleches a droite ── */}
+                        {plusieurs && (
+                            <div className="cx-hero__selecteur">
+                                <ul
+                                    ref={pisteRef}
+                                    className="cx-hero__piste scrollbar-none"
+                                    style={{ "--vignettes": VIGNETTES_VISIBLES }}
+                                    aria-label="Choisir un visuel"
+                                >
+                                    {medias.map((media, i) => (
+                                        <li key={media.cle ?? media.src} data-hero-vignette>
+                                            <Vignette
+                                                media={media}
+                                                position={i + 1}
+                                                total={medias.length}
+                                                actif={i === index}
+                                                onClick={() => aller(i)}
+                                            />
+                                        </li>
+                                    ))}
+                                </ul>
+
+                                <div className="cx-hero__fleches">
+                                    <Fleche label="Visuel précédent" onClick={() => aller(index - 1)}>
+                                        <ArrowLeft size={20} strokeWidth={1.25} />
+                                    </Fleche>
+                                    <Fleche label="Visuel suivant" onClick={() => aller(index + 1)}>
+                                        <ArrowRight size={20} strokeWidth={1.25} />
+                                    </Fleche>
+                                </div>
+                            </div>
+                        )}
+                    </div>
+                )}
+
+            </div>
+        </section>
+    );
+}
+
+// Une vignette : l'image, un filet blanc quand elle est a l'ecran. Angle vif,
+// aucun rayon — la forme de tout le circuit.
+function Vignette({ media, position, total, actif, onClick }) {
+    const apercu = media.type === "video" ? media.poster : media.src;
+
+    return (
+        <button
+            type="button"
+            onClick={onClick}
+            aria-pressed={actif}
+            aria-label={`${media.type === "video" ? "Film" : "Visuel"} ${position} sur ${total}`}
+            className={`cx-hero__vignette${actif ? " cx-hero__vignette--active" : ""}`}
+        >
+            {apercu && <img src={imageCloudinary(apercu, 200)} alt="" loading="lazy" decoding="async" />}
+            {media.type === "video" && (
+                <span className="cx-hero__film" aria-hidden>
+                    <Play size={11} fill="currentColor" stroke="currentColor" />
+                </span>
+            )}
+        </button>
+    );
+}
+
+/**
+ * L'icone, et rien d'autre.
+ *
+ * Demande explicite : « pas de bg ni de quoi que ce soit, l'icone fleche, pas
+ * de div ». Le bouton ne peint donc ni bordure, ni fond, ni rayon.
+ *
+ * Il reste un <button> et c'est delibere : c'est lui qui rend la commande
+ * cliquable au clavier et nommable pour un lecteur d'ecran — un <span>
+ * cliquable n'est ni l'un ni l'autre. Mais il ne DESSINE plus rien.
+ */
+function Fleche({ label, onClick, children }) {
+    return (
+        <button
+            type="button"
+            onClick={onClick}
+            aria-label={label}
+            title={label}
+            className="cx-hero__fleche"
+        >
+            {children}
+        </button>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/itineraire/CircuitItineraire.jsx b/src/pages/client/circuitDetail/components/itineraire/CircuitItineraire.jsx
new file mode 100644
index 0000000..aef1bb0
