+        try {
+            navigate(`/admin/haodygasikara/destinations/edit/${id}`, {
+                state: await chargerFormulaireDestination(id),
+            });
+        } catch (error) {
+            console.error("Erreur chargement de la destination :", error);
+        }
+    };
+
+    return { actions: { create: handleCreate, edit: handleEdit } };
+}
