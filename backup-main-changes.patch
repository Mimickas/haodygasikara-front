--- /dev/null
+++ b/src/components/ProtectedRoute.jsx
@@ -0,0 +1,54 @@
+import { Navigate, useLocation } from "react-router-dom";
+import { useAuthStore } from "../store/authStore";
+
+/**
+ * Garde de route.
+ *
+ * Ne tente plus lui-meme de rafraichir la session : AuthProvider s'en charge
+ * une fois pour toutes a la racine. Deux composants qui appelaient
+ * /auth/refresh chacun de leur cote se couraient apres.
+ */
+export default function ProtectedRoute({ children, role }) {
+    const accessToken = useAuthStore((s) => s.accessToken);
+    const user = useAuthStore((s) => s.user);
+    const sessionRestauree = useAuthStore((s) => s.sessionRestauree);
+    const location = useLocation();
+
+    // Chaque espace a son propre login
+    const loginPath = location.pathname.startsWith("/admin")
+        ? "/admin/haodygasikara/login"
+        : "/login";
+
+    // Tant que la tentative de restauration n'a pas eu lieu, on ne sait pas
+    // encore si l'utilisateur est connecte : rediriger ici le ferait sortir
+    // a chaque rechargement.
+    if (!sessionRestauree) {
+        return (
+            <div
+                className="flex items-center justify-center h-screen"
+                style={{ backgroundColor: "var(--bg)" }}
+            >
+                <span
+                    className="font-body-strong text-[11px] uppercase tracking-[0.1em]"
+                    style={{ color: "var(--text-muted)" }}
+                >
+                    Un instant
+                </span>
+            </div>
+        );
+    }
+
+    // On garde d'ou l'on vient : la page de connexion pourra y renvoyer
+    if (!accessToken) {
+        return <Navigate to={loginPath} replace state={{ from: location.pathname }} />;
+    }
+
+    // Un SUPER_ADMIN a tous les droits d'un ADMIN : l'écran de connexion de
+    // l'administration l'accepte, la garde doit l'accepter aussi.
+    const roles = role === "ADMIN" ? ["ADMIN", "SUPER_ADMIN"] : [role];
+    if (role && !roles.includes(user?.role)) {
+        return <Navigate to={loginPath} replace />;
+    }
+
+    return children;
+}
diff --git a/src/components/admin/crud/createModal/ChampProgramme.jsx b/src/components/admin/crud/createModal/ChampProgramme.jsx
new file mode 100644
index 0000000..c4453b5
--- /dev/null
+++ b/src/components/admin/crud/createModal/ChampProgramme.jsx
@@ -0,0 +1,397 @@
+import { useMemo, useState } from "react";
+import { FaPlus, FaXmark, FaChevronDown, FaArrowUp, FaArrowDown } from "react-icons/fa6";
+import ChampRecherche from "../form/ChampRecherche";
+import MultiSelectField from "./MultiSelectField";
+
+// ── Le programme d'un circuit, jour par jour ───────────────────────────────
+//
+// C'est le seul endroit où le parcours se saisit. Avant, il fallait trois
+// écrans : les étapes dans le formulaire du circuit, les journées dans
+// « Jour par jour », les visites dans « Visites et activités » — et chacun
+// redemandait de retrouver à la main le circuit, puis l'étape, puis le jour.
+//
+// Ici : une journée, ses lieux, ce qu'on y fait. Le reste se déduit côté
+// serveur (ProgrammeService) — la durée du circuit, et ses séjours.
+//
+// Une journée traverse PLUSIEURS lieux, dans l'ordre : « Antananarivo →
+// Ampefy → Chute de Lily ». Le dernier est celui où l'on dort, sauf si
+// l'hébergement du soir en désigne un autre.
+
+const JOURS_MAX = 60;
+const LIEUX_MAX = 6;
+const ALTERNATIVES_MAX = 8;
+
+const jourVide = () => ({
+    lieux: [{ destinationId: "", note: "" }],
+    titre: "",
+    description: "",
+    notes: "",
+    transport: "",
+    hebergementId: "",
+    alternativeIds: [],
+    visites: [],
+    petitDejeuner: false,
+    dejeuner: false,
+    diner: false,
+});
+
+export default function ChampProgramme({ value, onChange, destinations = [], pois = [], transports = [] }) {
+    const jours = Array.isArray(value) ? value : [];
+    // La journée ouverte : avec quinze jours, tout déplier rendrait l'écran
+    // illisible. Une seule à la fois, et la dernière ajoutée s'ouvre d'office.
+    const [ouvert, setOuvert] = useState(0);
+
+    const nomDestination = useMemo(
+        () => new Map(destinations.map((d) => [String(d.value), d.label])),
+        [destinations]);
+    const poisParDestination = useMemo(() => {
+        const parId = new Map();
+        pois.forEach((p) => {
+            const cle = String(p.destinationId);
+            if (!parId.has(cle)) parId.set(cle, []);
+            parId.get(cle).push(p);
+        });
+        return parId;
+    }, [pois]);
+
+    const majJours = (suivants) => onChange(suivants);
+    const majJour = (i, patch) => majJours(jours.map((j, k) => (k === i ? { ...j, ...patch } : j)));
+
+    const ajouterJour = () => {
+        if (jours.length >= JOURS_MAX) return;
+        majJours([...jours, jourVide()]);
+        setOuvert(jours.length);
+    };
+
+    const retirerJour = (i) => {
+        majJours(jours.filter((_, k) => k !== i));
+        setOuvert(null);
+    };
+
+    const deplacerJour = (i, vers) => {
+        if (vers < 0 || vers >= jours.length) return;
+        const suivants = [...jours];
+        const [j] = suivants.splice(i, 1);
+        suivants.splice(vers, 0, j);
+        majJours(suivants);
+        setOuvert(vers);
+    };
+
+    // Les POI accessibles une journée donnée : ceux des lieux qu'elle traverse.
+    // Rien à voir avec une liste globale — on ne propose pas un hôtel de Nosy Be
+    // le jour où l'on est à Isalo.
+    const poisDuJour = (jour) => (jour.lieux ?? [])
+        .filter((l) => l.destinationId)
+        .flatMap((l) => poisParDestination.get(String(l.destinationId)) ?? []);
+
+    const optionsHebergement = (jour) => poisDuJour(jour)
+        .filter((p) => p.isHebergement)
+        .map((p) => ({ value: p.id, label: p.nom, sousTitre: p.destinationNom }));
+
+    const optionsVisite = (jour) => poisDuJour(jour)
+        .map((p) => ({
+            value: p.id,
+            label: p.nom,
+            sousTitre: [p.destinationNom, p.isHebergement ? "hébergement" : p.categorie].filter(Boolean).join(" · "),
+        }));
+
+    const trajet = (jour) => (jour.lieux ?? [])
+        .map((l) => nomDestination.get(String(l.destinationId)))
+        .filter(Boolean);
+
+    return (
+        <div className="ad-prog">
+            <div className="ad-prog__tete">
+                <span className="ad-prog__compte font-body-strong">
+                    {jours.length === 0
+                        ? "Aucune journée"
+                        : `${jours.length} journée${jours.length > 1 ? "s" : ""}`}
+                </span>
+                <span className="ad-prog__aide font-body">
+                    La durée du circuit est le nombre de journées. Les séjours — où l'on dort et
+                    combien de nuits — s'en déduisent tout seuls.
+                </span>
+            </div>
+
+            {jours.length === 0 && (
+                <p className="ad-prog__vide font-body">
+                    Le programme est vide. Ajoutez la première journée : ses lieux, ses repas, sa nuit.
+                </p>
+            )}
+
+            <ol className="ad-prog__jours">
+                {jours.map((jour, i) => {
+                    const lieux = jour.lieux ?? [];
+                    const route = trajet(jour);
+                    const deplie = ouvert === i;
+                    const hebergements = optionsHebergement(jour);
+                    const visites = optionsVisite(jour);
+
+                    return (
+                        <li key={i} className={`ad-prog__jour${deplie ? " ad-prog__jour--ouvert" : ""}`}>
+
+                            {/* L'en-tête dit tout ce qu'il faut pour s'y retrouver
+                                sans déplier : le numéro, le trajet, la nuit. */}
+                            <div className="ad-prog__entete">
+                                <button type="button" className="ad-prog__bascule"
+                                    onClick={() => setOuvert(deplie ? null : i)}
+                                    aria-expanded={deplie}>
+                                    <span className="ad-prog__num font-body-strong tabular-nums">
+                                        {String(i + 1).padStart(2, "0")}
+                                    </span>
+                                    <span className="ad-prog__resume">
+                                        <span className="ad-prog__trajet font-body-strong">
+                                            {route.length ? route.join(" → ") : "Journée sans lieu"}
+                                        </span>
+                                        {jour.titre && (
+                                            <span className="ad-prog__titre-jour font-body">{jour.titre}</span>
+                                        )}
+                                    </span>
+                                    <FaChevronDown className={`ad-prog__fleche${deplie ? " ad-prog__fleche--ouverte" : ""}`} aria-hidden="true" />
+                                </button>
+
+                                <div className="ad-prog__gestes">
+                                    <button type="button" onClick={() => deplacerJour(i, i - 1)} disabled={i === 0}
+                                        title="Monter cette journée" aria-label={`Monter le jour ${i + 1}`} className="ad-prog__geste">
+                                        <FaArrowUp className="text-[10px]" aria-hidden="true" />
+                                    </button>
+                                    <button type="button" onClick={() => deplacerJour(i, i + 1)} disabled={i === jours.length - 1}
+                                        title="Descendre cette journée" aria-label={`Descendre le jour ${i + 1}`} className="ad-prog__geste">
+                                        <FaArrowDown className="text-[10px]" aria-hidden="true" />
+                                    </button>
+                                    <button type="button" onClick={() => retirerJour(i)}
+                                        title="Retirer cette journée" aria-label={`Retirer le jour ${i + 1}`} className="ad-retirer">
+                                        <FaXmark className="text-xs" aria-hidden="true" />
+                                    </button>
+                                </div>
+                            </div>
+
+                            {deplie && (
+                                <div className="ad-prog__corps">
+
+                                    {/* ── Les lieux traversés ──────────────── */}
+                                    <fieldset className="ad-prog__bloc">
+                                        <legend className="ad-modale__libelle font-body-strong">
+                                            Lieux traversés, dans l'ordre
+                                        </legend>
+                                        {lieux.map((lieu, k) => (
+                                            <div key={k} className="ad-prog__lieu">
+                                                <span className="ad-prog__rang font-body-strong tabular-nums">{k + 1}</span>
+                                                <div className="ad-prog__lieu-choix">
+                                                    <ChampRecherche
+                                                        id={`jour-${i}-lieu-${k}`}
+                                                        value={lieu.destinationId}
+                                                        onChange={(v) => majJour(i, {
+                                                            lieux: lieux.map((l, m) => (m === k ? { ...l, destinationId: v } : l)),
+                                                            // Changer un lieu peut retirer la destination
+                                                            // de l'hébergement ou d'une visite : on les
+                                                            // remet à zéro plutôt que de garder un choix
+                                                            // qui n'a plus lieu d'être.
+                                                            hebergementId: "",
+                                                            alternativeIds: [],
+                                                            visites: [],
+                                                        })}
+                                                        options={destinations.filter((o) =>
+                                                            !lieux.some((l, m) => m !== k && String(l.destinationId) === String(o.value)))}
+                                                        placeholder="Choisir un lieu"
+                                                        placeholderRecherche="Rechercher une destination…"
+                                                    />
+                                                </div>
+                                                <input type="text" className="ad-champ ad-prog__note font-body"
+                                                    value={lieu.note ?? ""} maxLength={255}
+                                                    onChange={(e) => majJour(i, {
+                                                        lieux: lieux.map((l, m) => (m === k ? { ...l, note: e.target.value } : l)),
+                                                    })}
+                                                    placeholder="Précision (facultatif)"
+                                                    aria-label={`Précision sur le lieu ${k + 1} du jour ${i + 1}`} />
+                                                <button type="button" className="ad-retirer"
+                                                    disabled={lieux.length === 1}
+                                                    onClick={() => majJour(i, { lieux: lieux.filter((_, m) => m !== k) })}
+                                                    title="Retirer ce lieu"
+                                                    aria-label={`Retirer le lieu ${k + 1} du jour ${i + 1}`}>
+                                                    <FaXmark className="text-xs" aria-hidden="true" />
+                                                </button>
+                                            </div>
+                                        ))}
+                                        {lieux.length < LIEUX_MAX && (
+                                            <button type="button" className="ad-bouton ad-prog__ajouter font-body-strong"
+                                                onClick={() => majJour(i, { lieux: [...lieux, { destinationId: "", note: "" }] })}>
+                                                <FaPlus aria-hidden="true" /> Ajouter un lieu
+                                            </button>
+                                        )}
+                                    </fieldset>
+
+                                    {/* ── Ce qu'on en dit ─────────────────── */}
+                                    <div className="ad-modale__rangee">
+                                        <div className="ad-modale__champ">
+                                            <label htmlFor={`jour-${i}-titre`} className="ad-modale__libelle font-body-strong">
+                                                Titre de la journée
+                                            </label>
+                                            <input id={`jour-${i}-titre`} type="text" className="ad-champ font-body"
+                                                value={jour.titre ?? ""} maxLength={255}
+                                                onChange={(e) => majJour(i, { titre: e.target.value })}
+                                                placeholder={route.length > 1 ? route.join(" → ") : "Ex : Canyons et piscines naturelles"} />
+                                        </div>
+                                        <div className="ad-modale__champ">
+                                            <label htmlFor={`jour-${i}-transport`} className="ad-modale__libelle font-body-strong">
+                                                Déplacement
+                                            </label>
+                                            <select id={`jour-${i}-transport`} className="ad-champ font-body"
+                                                value={jour.transport ?? ""}
+                                                onChange={(e) => majJour(i, { transport: e.target.value })}>
+                                                <option value="">Non précisé</option>
+                                                {transports.map((t) => (
+                                                    <option key={t.value} value={t.value}>{t.label}</option>
+                                                ))}
+                                            </select>
+                                        </div>
+                                    </div>
+
+                                    <div className="ad-modale__champ">
+                                        <label htmlFor={`jour-${i}-deroule`} className="ad-modale__libelle font-body-strong">
+                                            Déroulé
+                                        </label>
+                                        <textarea id={`jour-${i}-deroule`} rows={3} className="ad-champ font-body resize-none"
+                                            value={jour.description ?? ""}
+                                            onChange={(e) => majJour(i, { description: e.target.value })}
+                                            placeholder="Racontez la journée au voyageur…" />
+                                    </div>
+
+                                    {/* ── Les repas ───────────────────────── */}
+                                    <fieldset className="ad-prog__bloc">
+                                        <legend className="ad-modale__libelle font-body-strong">Repas compris</legend>
+                                        <div className="ad-prog__repas">
+                                            {[
+                                                ["petitDejeuner", "Petit-déjeuner"],
+                                                ["dejeuner", "Déjeuner"],
+                                                ["diner", "Dîner"],
+                                            ].map(([cle, libelle]) => (
+                                                <label key={cle} className="ad-prog__coche font-body">
+                                                    <input type="checkbox" checked={Boolean(jour[cle])}
+                                                        onChange={(e) => majJour(i, { [cle]: e.target.checked })} />
+                                                    {libelle}
+                                                </label>
+                                            ))}
+                                        </div>
+                                    </fieldset>
+
+                                    {/* ── La nuit ─────────────────────────── */}
+                                    <div className="ad-modale__champ">
+                                        <label htmlFor={`jour-${i}-nuit`} className="ad-modale__libelle font-body-strong">
+                                            Hébergement du soir
+                                        </label>
+                                        <ChampRecherche
+                                            id={`jour-${i}-nuit`}
+                                            value={jour.hebergementId}
+                                            onChange={(v) => majJour(i, { hebergementId: v, alternativeIds: [] })}
+                                            options={hebergements}
+                                            placeholder={hebergements.length
+                                                ? "Aucun (pas de nuit ce jour-là)"
+                                                : "Aucun hébergement dans les lieux de cette journée"}
+                                            placeholderRecherche="Rechercher un hébergement…"
+                                            desactive={hebergements.length === 0}
+                                        />
+                                        <p className="ad-champ__aide font-body">
+                                            Parmi les hébergements des lieux traversés. C'est lui qui dit où l'on dort — et donc
+                                            où commence et finit un séjour.
+                                        </p>
+                                    </div>
+
+                                    {jour.hebergementId && hebergements.length > 1 && (
+                                        <div className="ad-modale__champ">
+                                            <span className="ad-modale__libelle font-body-strong">
+                                                Autres hébergements au choix
+                                            </span>
+                                            <MultiSelectField
+                                                value={jour.alternativeIds ?? []}
+                                                onChange={(v) => majJour(i, { alternativeIds: v.slice(0, ALTERNATIVES_MAX) })}
+                                                options={hebergements.filter((h) => String(h.value) !== String(jour.hebergementId))}
+                                            />
+                                            <p className="ad-champ__aide font-body">
+                                                {ALTERNATIVES_MAX} au plus. Le voyageur choisit parmi eux en demandant son devis.
+                                            </p>
+                                        </div>
+                                    )}
+
+                                    {/* ── Les visites et activités ────────── */}
+                                    <fieldset className="ad-prog__bloc">
+                                        <legend className="ad-modale__libelle font-body-strong">Visites et activités</legend>
+                                        {(jour.visites ?? []).map((v, k) => (
+                                            <div key={k} className="ad-prog__visite">
+                                                <div className="ad-prog__lieu-choix">
+                                                    <ChampRecherche
+                                                        id={`jour-${i}-visite-${k}`}
+                                                        value={v.poiId}
+                                                        onChange={(val) => majJour(i, {
+                                                            visites: jour.visites.map((x, m) => (m === k ? { ...x, poiId: val } : x)),
+                                                        })}
+                                                        options={visites.filter((o) =>
+                                                            !(jour.visites ?? []).some((x, m) => m !== k && String(x.poiId) === String(o.value)))}
+                                                        placeholder="Choisir une visite"
+                                                        placeholderRecherche="Rechercher un point d'intérêt…"
+                                                    />
+                                                </div>
+                                                <select className="ad-champ ad-prog__inclus font-body"
+                                                    value={v.inclus === false ? "false" : "true"}
+                                                    onChange={(e) => majJour(i, {
+                                                        visites: jour.visites.map((x, m) => (m === k ? { ...x, inclus: e.target.value === "true" } : x)),
+                                                    })}
+                                                    aria-label={`La visite ${k + 1} du jour ${i + 1} est-elle incluse`}>
+                                                    <option value="true">Incluse</option>
+                                                    <option value="false">En option</option>
+                                                </select>
+                                                <input type="text" className="ad-champ ad-prog__note font-body"
+                                                    value={v.note ?? ""} maxLength={255}
+                                                    onChange={(e) => majJour(i, {
+                                                        visites: jour.visites.map((x, m) => (m === k ? { ...x, note: e.target.value } : x)),
+                                                    })}
+                                                    placeholder="Précision (facultatif)"
+                                                    aria-label={`Précision sur la visite ${k + 1} du jour ${i + 1}`} />
+                                                <button type="button" className="ad-retirer"
+                                                    onClick={() => majJour(i, { visites: jour.visites.filter((_, m) => m !== k) })}
+                                                    title="Retirer cette visite"
+                                                    aria-label={`Retirer la visite ${k + 1} du jour ${i + 1}`}>
+                                                    <FaXmark className="text-xs" aria-hidden="true" />
+                                                </button>
+                                            </div>
+                                        ))}
+                                        {visites.length === 0 ? (
+                                            <p className="ad-champ__aide font-body">
+                                                Aucun point d'intérêt enregistré dans les lieux de cette journée.
+                                            </p>
+                                        ) : (
+                                            <button type="button" className="ad-bouton ad-prog__ajouter font-body-strong"
+                                                onClick={() => majJour(i, {
+                                                    visites: [...(jour.visites ?? []), { poiId: "", inclus: true, note: "" }],
+                                                })}>
+                                                <FaPlus aria-hidden="true" /> Ajouter une visite
+                                            </button>
+                                        )}
+                                    </fieldset>
+
+                                    {/* ── Les notes internes ──────────────── */}
+                                    <div className="ad-modale__champ">
+                                        <label htmlFor={`jour-${i}-notes`} className="ad-modale__libelle font-body-strong">
+                                            Notes internes
+                                        </label>
+                                        <textarea id={`jour-${i}-notes`} rows={2} className="ad-champ font-body resize-none"
+                                            value={jour.notes ?? ""}
+                                            onChange={(e) => majJour(i, { notes: e.target.value })}
+                                            placeholder="Pour l'agence et le guide — le voyageur ne les voit pas." />
+                                    </div>
+                                </div>
+                            )}
+                        </li>
+                    );
+                })}
+            </ol>
+
+            {jours.length < JOURS_MAX && (
+                <button type="button" className="ad-bouton ad-bouton--plein ad-prog__ajouter-jour font-body-strong"
+                    onClick={ajouterJour}>
+                    <FaPlus aria-hidden="true" /> Ajouter un jour
+                </button>
+            )}
+        </div>
+    );
+}
diff --git a/src/components/admin/crud/createModal/CreateModal.jsx b/src/components/admin/crud/createModal/CreateModal.jsx
new file mode 100644
index 0000000..25e8077
--- /dev/null
+++ b/src/components/admin/crud/createModal/CreateModal.jsx
@@ -0,0 +1,82 @@
+import { useLocation, useNavigate } from "react-router-dom";
+import { useState } from "react";
+import ChampFormulaire from "../form/ChampFormulaire";
+import { useChampsFormulaire } from "../../../../hooks/admin/useChampsFormulaire";
+import { apiErrorMessage } from "../../../../utils/apiError";
+
+// La page de création ou de modification. Champs et valeurs arrivent en props
+// (pages qui se chargent elles-mêmes, cf. useFormulaireAdmin) ou, à défaut,
+// dans l'état de navigation. Sans l'un ni l'autre, on n'affiche rien plutôt que
+// de planter.
+//
+// Le rendu des champs et la validation sont ceux de la fenêtre des listes
+// (ChampFormulaire, useChampsFormulaire) : un champ ajouté à la déclaration
+// arrive dans les deux écrans, avec les mêmes bornes et les mêmes messages.
+export default function CreateModal(props) {
+    const { state } = useLocation();
+    const fields = props.fields ?? state?.fields;
+    if (!fields) return <p className="my-8 font-body text-sm" style={{ color: "var(--text-muted)" }}>Chargement du formulaire…</p>;
+    return <Formulaire {...props} fields={fields} values={props.values ?? state?.values} />;
+}
+
+function Formulaire({ onSubmit, fields, values, uploading = false, coherence }) {
+    const navigate = useNavigate();
+    const { formData, setChamp, erreurs, valider, optionsDe, attenteDe } =
+        useChampsFormulaire(fields, values, coherence);
+
+    // Un enregistrement refusé se dit : il ne finit plus seulement dans la console
+    const [erreur, setErreur] = useState(null);
+    const [envoi, setEnvoi] = useState(false);
+
+    const enregistrer = async () => {
+        setErreur(null);
+        if (!valider()) {
+            setErreur("Quelques champs demandent une correction : ils sont signalés ci-dessus.");
+            return;
+        }
+        setEnvoi(true);
+        try {
+            await onSubmit?.(formData);
+        } catch (e) {
+            setErreur(apiErrorMessage(e, "L'enregistrement n'a pas abouti. Vérifiez les champs puis réessayez."));
+        } finally {
+            setEnvoi(false);
+        }
+    };
+    const occupe = envoi || uploading;
+
+    // Une page, pas une fenêtre : la carte du formulaire, et au pied les deux
+    // gestes — collés en bas de l'écran pendant qu'on remplit.
+    return (
+        <form className="ad-formulaire" onSubmit={(e) => { e.preventDefault(); enregistrer(); }} noValidate>
+            <div className="ad-formulaire__carte">
+                {fields.map((group, index) => (
+                    <div key={index} className="ad-formulaire__rangee">
+                        {group.map(field => (
+                            <div key={field.name} className="ad-formulaire__champ">
+                                <ChampFormulaire
+                                    field={field}
+                                    valeur={formData[field.name]}
+                                    onChange={val => setChamp(field.name, val)}
+                                    erreur={erreurs[field.name]}
+                                    options={optionsDe(field)}
+                                    attente={attenteDe(field)}
+                                />
+                            </div>
+                        ))}
+                    </div>
+                ))}
+            </div>
+
+            <div className="ad-formulaire__pied">
+                {erreur && <p className="ad-erreur ad-formulaire__erreur" role="alert">{erreur}</p>}
+                <div className="ad-formulaire__gestes">
+                    <button type="button" className="ad-bouton font-body-strong" onClick={() => navigate(-1)} disabled={occupe}>Annuler</button>
+                    <button type="submit" className="ad-bouton ad-bouton--plein font-body-strong" disabled={occupe}>
+                        {occupe ? "Enregistrement…" : "Enregistrer"}
+                    </button>
+                </div>
+            </div>
+        </form>
+    );
+}
diff --git a/src/components/admin/crud/createModal/InclusionsField.jsx b/src/components/admin/crud/createModal/InclusionsField.jsx
new file mode 100644
index 0000000..fefa592
--- /dev/null
+++ b/src/components/admin/crud/createModal/InclusionsField.jsx
@@ -0,0 +1,69 @@
+import { FaPlus, FaXmark } from "react-icons/fa6";
+
+// Ce qui est compris dans le prix, et ce qui ne l'est pas.
+//
+// Une seule liste, une colonne « Compris » : c'est le même objet des deux côtés,
+// il change de liste à l'affichage. Saisir deux tableaux séparés aurait forcé à
+// dupliquer le poste et l'ordre.
+//
+// Seules les lignes que le PROGRAMME ne sait pas dire se saisissent ici — les
+// vols, l'assurance, le véhicule privé, les pourboires. Les nuitées, les repas
+// et les visites se déduisent tout seuls du programme jour par jour, et les
+// retaper ici reviendrait à les faire mentir au premier changement d'étape.
+export default function InclusionsField({ value = [], onChange, options = [] }) {
+    const lignes = Array.isArray(value) ? value : [];
+
+    const modifier = (i, champ, v) =>
+        onChange(lignes.map((l, j) => (j === i ? { ...l, [champ]: v } : l)));
+
+    const retirer = (i) => onChange(lignes.filter((_, j) => j !== i));
+
+    const ajouter = () =>
+        onChange([...lignes, { categorie: options[0]?.value ?? "AUTRE", libelle: "", inclus: true }]);
+
+    return (
+        <div className="ad-lignes">
+            {lignes.map((ligne, i) => (
+                <div key={i} className="ad-ligne">
+                    <select
+                        value={ligne.categorie ?? ""}
+                        onChange={(e) => modifier(i, "categorie", e.target.value)}
+                        aria-label="Catégorie"
+                        className="ad-champ font-body w-44 shrink-0"
+                    >
+                        {options.map((opt) => (
+                            <option key={opt.value} value={opt.value}>{opt.label}</option>
+                        ))}
+                    </select>
+
+                    <input
+                        type="text"
+                        value={ligne.libelle ?? ""}
+                        onChange={(e) => modifier(i, "libelle", e.target.value)}
+                        placeholder="Ex : transport privé en 4x4 avec chauffeur"
+                        aria-label="Libellé"
+                        className="ad-champ font-body"
+                    />
+
+                    <select
+                        value={ligne.inclus === false ? "false" : "true"}
+                        onChange={(e) => modifier(i, "inclus", e.target.value === "true")}
+                        aria-label="Compris ou non"
+                        className="ad-champ font-body w-40 shrink-0"
+                    >
+                        <option value="true">Compris</option>
+                        <option value="false">Non compris</option>
+                    </select>
+
+                    <button type="button" onClick={() => retirer(i)} aria-label="Retirer cette ligne" className="ad-retirer">
+                        <FaXmark className="text-xs" aria-hidden="true" />
+                    </button>
+                </div>
+            ))}
+
+            <button type="button" onClick={ajouter} className="ad-bouton font-body-strong self-start">
+                <FaPlus aria-hidden="true" /> Ajouter une ligne
+            </button>
+        </div>
+    );
+}
diff --git a/src/components/admin/crud/createModal/MultiSelectField.jsx b/src/components/admin/crud/createModal/MultiSelectField.jsx
new file mode 100644
index 0000000..96ca7b1
--- /dev/null
+++ b/src/components/admin/crud/createModal/MultiSelectField.jsx
@@ -0,0 +1,33 @@
+// Un choix multiple en étiquettes : le même bouton que les filtres de la
+// barre d'outils (.ad-filtre) — même rôle, même dessin.
+export default function MultiSelectField({ value = [], onChange, options = [] }) {
+    // Comparaison par chaine, des deux cotes : ce champ sert aussi bien des
+    // identifiants numeriques (les tags) que des noms de constantes (les
+    // langues, les transports). L ancienne version comparait via Number(), ce
+    // qui donnait NaN sur une valeur texte — aucune option ne s allumait jamais.
+    const memeValeur = (a, b) => String(a) === String(b);
+
+    function toggle(v) {
+        const deja = value.some(x => memeValeur(x, v));
+        onChange(deja ? value.filter(x => !memeValeur(x, v)) : [...value, v]);
+    }
+
+    return (
+        <div className="ad-filtres">
+            {options.map(opt => {
+                const selected = value.some(v => memeValeur(v, opt.value));
+                return (
+                    <button
+                        key={opt.value}
+                        type="button"
+                        aria-pressed={selected}
+                        onClick={() => toggle(opt.value)}
+                        className={`ad-filtre font-body-strong${selected ? " ad-filtre--actif" : ""}`}
+                    >
+                        {opt.label}
+                    </button>
+                );
+            })}
+        </div>
+    );
+}
diff --git a/src/components/admin/crud/form/ChampFormulaire.jsx b/src/components/admin/crud/form/ChampFormulaire.jsx
new file mode 100644
index 0000000..2ba4e06
--- /dev/null
+++ b/src/components/admin/crud/form/ChampFormulaire.jsx
@@ -0,0 +1,154 @@
+import ImageUploadField from "../../../upload/ImageUploadField";
+import VideoUploadField from "../../../upload/VideoUploadField";
+import MultiSelectField from "../createModal/MultiSelectField";
+import ChampProgramme from "../createModal/ChampProgramme";
+import InclusionsField from "../createModal/InclusionsField";
+import ChampRecherche from "./ChampRecherche";
+
+// ── Un champ de l'administration, quel que soit l'écran ────────────────────
+//
+// Le même rendu dans la page de création et dans la fenêtre des listes : un
+// libellé, le contrôle qui va avec le type déclaré, puis SOUS le champ son
+// message d'erreur — ou son aide s'il n'y a pas d'erreur. Un refus posé au
+// pied de l'écran ne dit pas lequel des quinze champs corriger.
+//
+// Au-delà de ce nombre d'options, un menu déroulant devient une recherche : on
+// ne fait pas défiler mille circuits à l'aveugle. En dessous (« Inclus / Non
+// inclus »), la liste se lit d'un trait et une recherche serait un geste de
+// plus pour rien.
+const SEUIL_RECHERCHE = 8;
+
+export default function ChampFormulaire({
+    field, valeur, onChange, erreur = null, options = [], attente = null,
+}) {
+    const id = `champ-${field.name}`;
+    const faux = Boolean(erreur);
+    const classe = `ad-champ font-body${faux ? " ad-champ--faux" : ""}`;
+    const commun = {
+        id,
+        "aria-invalid": faux || undefined,
+        "aria-describedby": faux ? `erreur-${field.name}` : undefined,
+    };
+    // Le placeholder dit ce qui bloque quand le champ dépend d'un autre
+    const invite = attente ? `Choisissez d'abord « ${attente} »` : field.placeholder;
+
+    const controle = () => {
+        switch (field.type) {
+            case "textarea":
+                return (
+                    <textarea {...commun}
+                        value={valeur}
+                        onChange={e => onChange(e.target.value)}
+                        placeholder={field.placeholder}
+                        maxLength={field.maxLength}
+                        rows={field.rows ?? 4}
+                        className={`${classe} resize-none`} />
+                );
+
+            case "dropdown":
+                return options.length >= SEUIL_RECHERCHE || field.recherche ? (
+                    <ChampRecherche id={id}
+                        value={valeur}
+                        onChange={onChange}
+                        options={options}
+                        placeholder={invite}
+                        placeholderRecherche={field.placeholderRecherche ?? "Rechercher…"}
+                        invalide={faux}
+                        desactive={Boolean(attente)} />
+                ) : (
+                    <select {...commun}
+                        value={valeur}
+                        onChange={e => onChange(e.target.value)}
+                        disabled={Boolean(attente)}
+                        className={classe}>
+                        <option value="">{invite}</option>
+                        {options.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
+                    </select>
+                );
+
+            case "multiselect":
+                return <MultiSelectField value={valeur} onChange={onChange} options={options} />;
+
+            case "radio": {
+                const choix = field.options ?? [
+                    { label: "Oui", value: "true" },
+                    { label: "Non", value: "false" },
+                ];
+                return (
+                    <div className="ad-formulaire__choix" role="radiogroup" aria-labelledby={`libelle-${field.name}`}>
+                        {choix.map(o => (
+                            <label key={o.value} className="ad-formulaire__option font-body">
+                                <input type="radio" name={field.name} value={o.value}
+                                    checked={String(valeur) === String(o.value)}
+                                    onChange={() => onChange(o.value)} />
+                                {o.label}
+                            </label>
+                        ))}
+                    </div>
+                );
+            }
+
+            case "image":
+                return <ImageUploadField value={valeur} onChange={onChange} />;
+
+            case "video":
+                return <VideoUploadField value={valeur || null} onChange={onChange} />;
+
+            case "programme":
+                // Le programme jour par jour. Il ne recoit pas une liste
+                // d'options mais trois referentiels : les lieux, les points
+                // d'interet et les moyens de transport.
+                return (
+                    <ChampProgramme
+                        value={valeur}
+                        onChange={onChange}
+                        destinations={field.destinations ?? []}
+                        pois={field.pois ?? []}
+                        transports={field.transports ?? []}
+                    />
+                );
+
+            case "inclusions":
+                return <InclusionsField value={valeur} onChange={onChange} options={options} />;
+
+            default:
+                return (
+                    <input {...commun}
+                        type={field.type ?? "text"}
+                        value={valeur}
+                        onChange={e => onChange(e.target.value)}
+                        placeholder={field.placeholder}
+                        // Les bornes aussi sur l'input : les flèches d'un champ
+                        // numérique s'arrêtent là où la règle s'arrête.
+                        min={field.min}
+                        max={field.max}
+                        step={field.step}
+                        maxLength={field.maxLength}
+                        className={classe} />
+                );
+        }
+    };
+
+    // Un <label> qui engloberait un champ d'envoi de fichier relaierait les
+    // clics vers son input caché : htmlFor, et seulement pour les champs
+    // simples. Les groupes de boutons radio se rattachent par aria-labelledby.
+    const pourLibelle = !["image", "video", "programme", "inclusions", "multiselect", "radio"].includes(field.type);
+
+    return (
+        <>
+            <label id={`libelle-${field.name}`} htmlFor={pourLibelle ? id : undefined}
+                className="ad-modale__libelle font-body-strong">
+                {field.label}
+                {field.obligatoire && <span className="ad-champ__requis" aria-hidden="true"> *</span>}
+            </label>
+
+            {controle()}
+
+            {erreur ? (
+                <p id={`erreur-${field.name}`} className="ad-champ__erreur font-body" role="alert">{erreur}</p>
+            ) : field.aide ? (
+                <p className="ad-champ__aide font-body">{field.aide}</p>
+            ) : null}
+        </>
+    );
+}
diff --git a/src/components/admin/crud/form/ChampRecherche.jsx b/src/components/admin/crud/form/ChampRecherche.jsx
