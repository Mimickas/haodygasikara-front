diff --git a/src/components/admin/ui/erreur/BandeauMail.jsx b/src/components/admin/ui/erreur/BandeauMail.jsx
new file mode 100644
index 0000000..1144253
--- /dev/null
+++ b/src/components/admin/ui/erreur/BandeauMail.jsx
@@ -0,0 +1,50 @@
+import { useEffect, useState } from "react";
+import { findEtatMailApi, verifierMailApi } from "../../../../api/admin/mailApi";
+import { formatDate } from "../../../../utils/format";
+
+// Les e-mails ne partent plus — mot de passe SMTP révoqué, serveur
+// injoignable : l'agence doit le savoir tout de suite, sur toutes les pages.
+// Sans ce bandeau, elle croyait ses devis envoyés alors que les voyageurs
+// n'en recevaient aucun (l'échec ne se lisait que dans les journaux).
+export default function BandeauMail() {
+    const [etat, setEtat] = useState(null);
+    const [enCours, setEnCours] = useState(false);
+
+    useEffect(() => {
+        let vivant = true;
+        findEtatMailApi()
+            .then((r) => { if (vivant) setEtat(r?.data ?? null); })
+            .catch(() => { /* sans état connu, pas de bandeau */ });
+        return () => { vivant = false; };
+    }, []);
+
+    if (etat?.statut !== "EN_ECHEC") return null;
+
+    const verifier = async () => {
+        setEnCours(true);
+        try {
+            setEtat((await verifierMailApi())?.data ?? null);
+        } catch {
+            /* le dernier état connu reste affiché */
+        } finally {
+            setEnCours(false);
+        }
+    };
+
+    return (
+        <div className="ad-erreur ad-mail" role="alert">
+            <div>
+                <p className="font-body-strong">
+                    Les e-mails ne partent pas{etat.depuis ? ` (constaté le ${formatDate(etat.depuis)})` : ""}.
+                </p>
+                <p className="font-body">
+                    {etat.raison} D'ici là, les voyageurs ne reçoivent ni accusés ni devis, et l'agence ne reçoit plus
+                    les alertes : les demandes restent visibles ici, et chaque dossier peut renvoyer son e-mail.
+                </p>
+            </div>
+            <button type="button" className="ad-bouton font-body-strong" onClick={verifier} disabled={enCours}>
+                {enCours ? "Vérification…" : "Vérifier à nouveau"}
+            </button>
+        </div>
+    );
+}
diff --git a/src/components/admin/ui/tableau/DataTable.jsx b/src/components/admin/ui/tableau/DataTable.jsx
new file mode 100644
index 0000000..f4704e2
--- /dev/null
+++ b/src/components/admin/ui/tableau/DataTable.jsx
@@ -0,0 +1,155 @@
+import { useEffect, useRef, useState } from "react";
+import RowActions from "../../crud/rowActions/RowActions";
+import Pagination from "./Pagination";
+import { useGSAP } from "@gsap/react";
+import gsap from "gsap";
+
+// ── Le tableau de l'administration ────────────────────────────────────────
+//
+// Angle vif et filet d'un pixel : la table se détache par son cadre, pas par
+// une ombre. Paginée ici, une fois pour toutes les pages (`parPage`) ; revenir
+// à la première page quand la liste change (recherche, filtre, tri).
+//
+// Colonnes : { key, label, render?(val, ligne), texte?(val, ligne) pour l'export,
+//              type?: "actions" | "object" }.
+
+export default function DataTable({
+    columns, data, loading = false, skeletonRows = 5, parPage = 10,
+    onRowClick, onEdit, onDelete, aucunResultat = false,
+    vide = { titre: "Aucun élément pour le moment", texte: "Les enregistrements apparaîtront ici dès leur création." },
+}) {
+    const tbodyRef = useRef(null);
+    const lignes = data ?? [];
+    const [page, setPage] = useState(0);
+    const pages = Math.max(1, Math.ceil(lignes.length / parPage));
+
+    useEffect(() => { setPage(0); }, [data]);
+    const pageCourante = Math.min(page, pages - 1);
+    const visibles = lignes.slice(pageCourante * parPage, (pageCourante + 1) * parPage);
+    const isEmpty = !loading && lignes.length === 0;
+
+    useGSAP(() => {
+        if (loading || !tbodyRef.current) return;       // n'anime pas les lignes skeleton
+        gsap.from(tbodyRef.current.children, {
+            opacity: 0,
+            y: -5,
+            duration: 0.25,
+            ease: "power2.out",
+            stagger: 0.04,
+            force3D: true,           // force l'accélération GPU, stabilise le transform
+        });
+    }, { scope: tbodyRef, dependencies: [loading, pageCourante] });
+
+    return (
+        <div className="ad-tableau">
+            <div className="w-full overflow-x-auto scroll-fine">
+                <table className="w-full text-sm">
+
+                    <thead>
+                        <tr style={{ borderBottom: "1px solid var(--border-strong)" }}>
+                            {columns.map((col, i) => (
+                                <th key={i}
+                                    className="px-5 pt-5 pb-3.5 font-body-strong text-[11px] uppercase leading-none whitespace-nowrap"
+                                    style={{
+                                        color: "var(--text-muted)",
+                                        letterSpacing: "0.1em",
+                                        textAlign: col.type === "actions" ? "right" : "left",
+                                    }}>
+                                    {col.label}
+                                </th>
+                            ))}
+                        </tr>
+                    </thead>
+
+                    <tbody ref={tbodyRef}>
+                        {loading
+                            ? Array.from({ length: skeletonRows }).map((_, i) => (
+                                <tr key={i} style={{ borderBottom: "1px solid var(--border-muted)" }}>
+                                    {columns.map((col, j) => (
+                                        <td key={j} className="px-5 py-4">
+                                            <div
+                                                className="skeleton-box h-4"
+                                                style={{
+                                                    borderRadius: 0,
+                                                    width: col.type === "actions" ? "60px" : "70%",
+                                                    marginLeft: col.type === "actions" ? "auto" : 0,
+                                                }}
+                                            />
+                                        </td>
+                                    ))}
+                                </tr>
+                            ))
+                            : isEmpty
+                                ? (
+                                    // ← une table vide le dit, au lieu d'afficher un cadre muet
+                                    <tr>
+                                        <td colSpan={columns.length} className="px-5 py-16 text-center">
+                                            <p className="font-title text-2xl leading-none" style={{ color: "var(--text-secondary)" }}>
+                                                {aucunResultat ? "Aucun résultat" : vide.titre}
+                                            </p>
+                                            <p className="font-body text-sm mt-3" style={{ color: "var(--text-muted)" }}>
+                                                {aucunResultat ? "Rien ne correspond à cette recherche ou à ce filtre." : vide.texte}
+                                            </p>
+                                        </td>
+                                    </tr>
+                                )
+                                : visibles.map((row, i) => (
+                                    <tr
+                                        key={row.id ?? i}
+                                        onClick={() => onRowClick?.(row)}
+                                        className="transition-colors duration-150"
+                                        style={{
+                                            borderBottom: i === visibles.length - 1 ? "none" : "1px solid var(--border-muted)",
+                                            cursor: onRowClick ? "pointer" : "default",
+                                        }}
+                                        onMouseEnter={e => e.currentTarget.style.backgroundColor = "var(--bg-hover)"}
+                                        onMouseLeave={e => e.currentTarget.style.backgroundColor = "transparent"}
+                                    >
+                                        {columns.map((col, j) => {
+                                            if (col.type === "actions") {
+                                                return (
+                                                    <td key={j} className="px-5 py-2">
+                                                        <RowActions id={row.id} onEdit={onEdit} onDelete={onDelete} />
+                                                    </td>
+                                                );
+                                            }
+                                            if (col.type === "object") {
+                                                return (
+                                                    <td key={j} className="px-5 py-4 font-body">
+                                                        {col.objectKeys.map((objKey, k) => (
+                                                            <div
+                                                                key={k}
+                                                                className={k === 0 ? "" : "text-xs mt-0.5"}
+                                                                style={{ color: k === 0 ? "var(--text-primary)" : "var(--text-muted)" }}
+                                                            >
+                                                                {row[col.key]?.[objKey.key] ?? "—"}
+                                                            </div>
+                                                        ))}
+                                                    </td>
+                                                );
+                                            }
+                                            // ← l'identifiant est une méta, pas une donnée : il passe en retrait
+                                            const isId = col.key === "id";
+                                            return (
+                                                <td
+                                                    key={j}
+                                                    className={`px-5 py-4 font-body ${isId ? "text-xs tabular-nums" : ""}`}
+                                                    style={{ color: isId ? "var(--text-muted)" : "var(--text-primary)" }}
+                                                >
+                                                    {col.render ? col.render(row[col.key], row) : row[col.key] ?? "—"}
+                                                </td>
+                                            );
+                                        })}
+                                    </tr>
+                                ))}
+                    </tbody>
+
+                </table>
+            </div>
+
+            {!loading && lignes.length > parPage && (
+                <Pagination page={pageCourante} pages={pages} total={lignes.length} parPage={parPage} onPage={setPage} />
+            )}
+        </div>
+    );
+}
diff --git a/src/components/admin/ui/tableau/Pagination.jsx b/src/components/admin/ui/tableau/Pagination.jsx
new file mode 100644
index 0000000..60a75e5
--- /dev/null
+++ b/src/components/admin/ui/tableau/Pagination.jsx
@@ -0,0 +1,22 @@
+// Le pied d'un tableau paginé : où l'on en est, et les deux seuls gestes utiles.
+export default function Pagination({ page, pages, total, parPage, onPage }) {
+    const debut = page * parPage + 1;
+    const fin = Math.min(total, (page + 1) * parPage);
+
+    return (
+        <nav className="ad-pagination" aria-label="Pagination">
+            <span className="ad-pagination__etat font-body">{debut}–{fin} sur {total}</span>
+            <div className="ad-pagination__gestes">
+                <button type="button" className="ad-pagination__bouton font-body-strong"
+                    disabled={page === 0} onClick={() => onPage(page - 1)}>
+                    ← Précédent
+                </button>
+                <span className="ad-pagination__page font-body">Page {page + 1} / {pages}</span>
+                <button type="button" className="ad-pagination__bouton font-body-strong"
+                    disabled={page >= pages - 1} onClick={() => onPage(page + 1)}>
+                    Suivant →
+                </button>
+            </div>
+        </nav>
+    );
+}
diff --git a/src/components/admin/ui/toolbar/Toolbar.jsx b/src/components/admin/ui/toolbar/Toolbar.jsx
new file mode 100644
index 0000000..696399c
--- /dev/null
+++ b/src/components/admin/ui/toolbar/Toolbar.jsx
@@ -0,0 +1,76 @@
+import { FaMagnifyingGlass, FaArrowDownWideShort } from "react-icons/fa6";
+
+// ── La barre d'un écran d'administration ──────────────────────────────────
+//
+// La même sur toutes les pages : recherche soulignée, tri, filtres en
+// capitales espacées, puis les actions — une seule en aplat (l'action
+// principale), les autres au trait. Branchée sur useListeAdmin :
+//
+//   <Toolbar liste={liste} placeholder="Rechercher une destination…"
+//            actions={[{ libelle: "Exporter", onClick: liste.exporter },
+//                      { libelle: "Nouvelle destination", onClick: creer, primaire: true }]} />
+
+// `enPlus` : un réglage propre à la page (une période, par exemple), rangé
+// avec la recherche et le tri, dans le même style (ad-barre__tri).
+export default function Toolbar({ liste, placeholder = "Rechercher…", actions = [], enPlus = null }) {
+    const avecTri = (liste?.tris?.length ?? 0) > 1;
+    const avecFiltres = (liste?.filtres?.length ?? 0) > 1;
+
+    return (
+        <div className="ad-barre">
+            <div className="ad-barre__ligne">
+                <div className="ad-barre__outils">
+                    {liste?.setRecherche && (
+                        <label className="field-line ad-barre__recherche">
+                            <FaMagnifyingGlass className="text-xs shrink-0" style={{ color: "var(--text-muted)" }} aria-hidden="true" />
+                            <input
+                                type="search"
+                                value={liste.recherche}
+                                onChange={(e) => liste.setRecherche(e.target.value)}
+                                placeholder={placeholder}
+                                aria-label={placeholder}
+                                className="field-input w-full bg-transparent outline-none font-body text-sm"
+                                style={{ color: "var(--text-primary)" }}
+                            />
+                        </label>
+                    )}
+
+                    {avecTri && (
+                        <label className="ad-barre__tri font-body-strong">
+                            <FaArrowDownWideShort className="text-xs shrink-0" aria-hidden="true" />
+                            <span className="sr-only">Trier</span>
+                            <select value={liste.tri ?? ""} onChange={(e) => liste.setTri(e.target.value)} aria-label="Trier">
+                                {liste.tris.map((t) => <option key={t.cle} value={t.cle}>{t.libelle}</option>)}
+                            </select>
+                        </label>
+                    )}
+
+                    {enPlus}
+                </div>
+
+                {actions.length > 0 && (
+                    <div className="ad-barre__actions">
+                        {actions.filter((a) => a.onClick).map((a) => (
+                            <button key={a.libelle} type="button" onClick={a.onClick} disabled={a.disabled}
+                                className={`ad-bouton font-body-strong${a.primaire ? " ad-bouton--plein" : ""}`}>
+                                {a.libelle}
+                            </button>
+                        ))}
+                    </div>
+                )}
+            </div>
+
+            {avecFiltres && (
+                <div className="ad-filtres" role="tablist" aria-label="Filtrer la liste">
+                    {liste.filtres.map((f) => (
+                        <button key={f.cle} type="button" role="tab" aria-selected={liste.filtre === f.cle}
+                            className={`ad-filtre font-body-strong${liste.filtre === f.cle ? " ad-filtre--actif" : ""}`}
+                            onClick={() => liste.setFiltre(f.cle)}>
+                            {f.libelle} <span className="ad-filtre__compte">{f.compte}</span>
+                        </button>
+                    ))}
+                </div>
+            )}
+        </div>
+    );
+}
diff --git a/src/components/client/auth/CadreAuthCentre.jsx b/src/components/client/auth/CadreAuthCentre.jsx
