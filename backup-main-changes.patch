--- /dev/null
+++ b/src/pages/client/circuitDetail/components/recap/BoutonPersonnaliser.jsx
@@ -0,0 +1,39 @@
+import { useState } from "react";
+import { useLocation, useNavigate } from "react-router-dom";
+import { personnaliserModeleApi } from "../../../../../api/client/composerApi";
+import { useAuth } from "../../../../../hooks/useAuth";
+import { messageErreurApi } from "../../../../../utils/auth";
+
+// « Personnaliser ce circuit » : une copie du circuit de l'agence, en
+// brouillon, ouverte dans le créateur. L'original n'est jamais touché. Sans
+// compte, on passe d'abord par la connexion et on revient ici.
+
+export default function BoutonPersonnaliser({ circuitId }) {
+    const { isAuthenticated } = useAuth();
+    const navigate = useNavigate();
+    const location = useLocation();
+    const [etat, setEtat] = useState({ enCours: false, erreur: null });
+
+    const personnaliser = async () => {
+        if (!isAuthenticated) {
+            navigate("/login", { state: { from: location.pathname } });
+            return;
+        }
+        setEtat({ enCours: true, erreur: null });
+        try {
+            const r = await personnaliserModeleApi(circuitId);
+            navigate(`/composer/${r.data.id}`);
+        } catch (e) {
+            setEtat({ enCours: false, erreur: messageErreurApi(e, "La copie n'a pas pu être créée.") });
+        }
+    };
+
+    return (
+        <>
+            <button type="button" className="cx-devis__personnaliser font-body-strong" onClick={personnaliser} disabled={etat.enCours}>
+                {etat.enCours ? "Préparation…" : "Personnaliser ce circuit"}
+            </button>
+            {etat.erreur && <p className="cx-devis__mention font-body" role="alert">{etat.erreur}</p>}
+        </>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/recap/CircuitRecap.jsx b/src/pages/client/circuitDetail/components/recap/CircuitRecap.jsx
new file mode 100644
index 0000000..9d0c68f
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/recap/CircuitRecap.jsx
@@ -0,0 +1,176 @@
+import { Link } from "react-router-dom";
+import BoutonPersonnaliser from "./BoutonPersonnaliser";
+import { imageCloudinary } from "../../../../../utils/image";
+import { useDemandeVivante } from "../../../../../hooks/client/devis/useDemandeVivante";
+import { actionDemandeVivante, libelleStatutDevis } from "../../../../../constants/client/devis";
+import FicheTechnique from "./FicheTechnique";
+import Decompte from "./Decompte";
+import Depliant from "./Depliant";
+import ListeInclusions from "./ListeInclusions";
+
+// ── Ce que comprend le circuit ────────────────────────────────────────────
+// La section répond à « est-ce que ce voyage est pour moi ? », et elle se pose
+// donc AVANT l'itinéraire : on ne demande pas à quelqu'un de lire quinze jours
+// de programme pour découvrir ensuite qu'il y a un âge minimum.
+//
+// ── Pourquoi elle est bâtie comme ça ─────────────────────────────────────
+// Première version : titre, puis six mentions étalées sur toute la largeur,
+// puis quatre chiffres, puis deux listes à plat. Tout y était, et pourtant il
+// manquait quelque chose. Trois raisons, lues sur la page de référence du
+// client (911rennsport.co.uk, une fiche véhicule) :
+//
+//   1. AUCUNE PHOTOGRAPHIE. Entre le héro et l'itinéraire, la page enchaînait
+//      deux sections entièrement typographiques sur ivoire — un tunnel de
+//      texte. Chez Rennsport la photographie arrive AVANT la moindre
+//      caractéristique : on montre l'objet, puis on le décrit. D'où la planche
+//      en tête de section.
+//
+//   2. AUCUN APPEL À L'ACTION. La section se terminait dans le vide, sans rien
+//      à faire. La fiche véhicule se ferme sur un bloc plein « Enquire » — et
+//      c'est lui qui rassure, parce qu'il dit que la suite existe.
+//
+//   3. TROP D'AIR DANS LA FICHE. Six mentions sur 1500 px ne font pas une
+//      fiche technique, elles font une liste espacée. Les caractéristiques se
+//      lisent en bloc, sur deux colonnes serrées : c'est leur densité qui les
+//      rend crédibles.
+//
+// D'où la mise en page : titre → planche → deux moitiés, la fiche et l'appel à
+// gauche, les volets à droite.
+//
+// RIEN N'EST INVENTÉ ICI. Chaque bloc se retire tout seul s'il n'a rien à
+// dire, et la section entière disparaît si tout est vide. Un champ que
+// l'administration n'a pas rempli ne devient jamais une phrase.
+export default function CircuitRecap({
+    recap, fiche, tags = [], visuels = [], duree, circuitId, modele = false,
+}) {
+    const demande = useDemandeVivante(circuitId);
+    const compris = recap?.compris ?? [];
+    const nonCompris = recap?.nonCompris ?? [];
+
+    const aFiche = Boolean(
+        duree > 0 || (fiche && (fiche.style || fiche.niveau || fiche.ages || fiche.groupe
+            || fiche.langues?.length || fiche.transports?.length))
+    );
+    const aDecompte = Boolean(
+        recap && (recap.nuitees || recap.visitesIncluses || recap.visitesEnOption
+            || recap.petitsDejeuners || recap.dejeuners || recap.diners)
+    );
+
+    if (!aFiche && !aDecompte && !compris.length && !nonCompris.length && !tags.length) {
+        return null;
+    }
+
+    const promesse = fiche?.promesse;
+    const planche = visuels.slice(0, 2);
+
+    return (
+        <section className="cx-voyage" data-header-text="var(--text-primary)">
+            <div className={`cx-tete${promesse ? "" : " cx-tete--seule"}`}>
+                <span className="cx-tete__mention cx-label cx-label--accent font-body-strong">
+                    Le voyage
+                </span>
+
+                <h2 className="cx-tete__titre font-title">
+                    Ce que comprend le circuit
+                </h2>
+
+                {promesse && (
+                    <p className="cx-tete__chapo font-body min-w-0">{promesse}</p>
+                )}
+            </div>
+
+            {/* La planche. Les visuels viennent des étapes, jamais la
+                couverture : elle occupe déjà tout le héro. */}
+            {planche.length > 0 && (
+                <div className={`cx-voyage__planche${planche.length === 1 ? " cx-voyage__planche--seule" : ""}`}>
+                    {planche.map((media) => (
+                        <figure key={media.cle ?? media.src} className="cx-voyage__cadre">
+                            {media.type === "video" ? (
+                                <video
+                                    src={imageCloudinary(media.src, 900)}
+                                    poster={media.poster ?? undefined}
+                                    muted loop autoPlay playsInline preload="metadata"
+                                />
+                            ) : (
+                                <img
+                                    src={media.src}
+                                    alt={media.titre ?? ""}
+                                    loading="lazy"
+                                    decoding="async"
+                                />
+                            )}
+                        </figure>
+                    ))}
+                </div>
+            )}
+
+            <div className="cx-voyage__corps">
+
+                <div className="min-w-0">
+                    <FicheTechnique
+                        fiche={fiche}
+                        duree={duree}
+                        nuitees={recap?.nuitees ?? 0}
+                    />
+
+                    {/* Le seul engagement du site : une demande de devis, chiffrée
+                        à la main par un conseiller. */}
+                    {/* Une demande vivante pour ce circuit : on ne propose pas d'en
+                        envoyer une seconde, on mène à celle qui existe. */}
+                    <div className="cx-devis">
+                        <p className="cx-devis__mention font-body">
+                            {demande
+                                ? `Demande ${demande.reference} · ${libelleStatutDevis(demande.statutAffiche)}`
+                                : <>Devis détaillé sous 48&nbsp;heures</>}
+                        </p>
+                        {demande ? (
+                            <Link to="/mes-devis" className="cx-devis__bouton font-body-strong">
+                                {actionDemandeVivante(demande.statutAffiche)}
+                            </Link>
+                        ) : (
+                            <Link to={`/circuit/${circuitId}/devis`} className="cx-devis__bouton font-body-strong">
+                                Demander un devis
+                            </Link>
+                        )}
+                        {modele && <BoutonPersonnaliser circuitId={circuitId} />}
+                    </div>
+                </div>
+
+                <div className="min-w-0">
+                    {(aDecompte || compris.length > 0) && (
+                        <Depliant
+                            titre="Ce qui est compris"
+                            compte={compris.length}
+                            ouvertParDefaut
+                        >
+                            <Decompte recap={recap} />
+                            {compris.length > 0 && aDecompte && <div className="h-7" />}
+                            <ListeInclusions lignes={compris} />
+                        </Depliant>
+                    )}
+
+                    {nonCompris.length > 0 && (
+                        <Depliant titre="Ce qui n'est pas compris" compte={nonCompris.length}>
+                            <ListeInclusions lignes={nonCompris} exclu />
+                        </Depliant>
+                    )}
+
+                    {tags.length > 0 && (
+                        <Depliant titre="Thèmes du voyage" compte={tags.length}>
+                            <ul className="cx-themes">
+                                {tags.map((tag, i) => (
+                                    <li key={tag?.id ?? i}>
+                                        <span className="cx-themes__item cx-label font-body-strong">
+                                            {tag?.nom}
+                                        </span>
+                                    </li>
+                                ))}
+                            </ul>
+                        </Depliant>
+                    )}
+                </div>
+
+            </div>
+        </section>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/recap/Decompte.jsx b/src/pages/client/circuitDetail/components/recap/Decompte.jsx
new file mode 100644
index 0000000..c33ee2c
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/recap/Decompte.jsx
@@ -0,0 +1,58 @@
+// ── Le décompte ───────────────────────────────────────────────────────────
+// Quatre chiffres tirés du programme jour par jour, jamais saisis : une nuit
+// ajoutée à une étape se voit ici sans que personne y pense. C'est la garantie
+// que ces chiffres ne peuvent pas mentir au client — ils SONT le programme.
+//
+// Ce sont les seuls chiffres de la page : ils ont donc le droit d'être grands.
+//
+// Pas de <dl> ici : ce ne sont pas des définitions mais des mesures, et une
+// liste de description n'accepte pas la ligne de détail qui les suit.
+export default function Decompte({ recap }) {
+    if (!recap) return null;
+
+    const repas = (recap.petitsDejeuners ?? 0) + (recap.dejeuners ?? 0) + (recap.diners ?? 0);
+    const pluriel = (n, singulier, pluriel) => (n > 1 ? pluriel : singulier);
+
+    const chiffres = [
+        { cle: "nuitees", valeur: recap.nuitees ?? 0,
+          legende: pluriel(recap.nuitees ?? 0, "Nuitée", "Nuitées") },
+        { cle: "repas", valeur: repas,
+          legende: pluriel(repas, "Repas compris", "Repas compris") },
+        { cle: "incluses", valeur: recap.visitesIncluses ?? 0,
+          legende: pluriel(recap.visitesIncluses ?? 0, "Visite comprise", "Visites comprises") },
+        { cle: "option", valeur: recap.visitesEnOption ?? 0,
+          legende: pluriel(recap.visitesEnOption ?? 0, "Visite en option", "Visites en option") },
+    ].filter((c) => c.valeur > 0);
+
+    if (!chiffres.length) return null;
+
+    // « 3 nuits en hôtel, 1 nuit en écolodge » — déduit des séjours.
+    const hebergements = (recap.hebergements ?? [])
+        .map((h) => `${h.nuitees} nuit${h.nuitees > 1 ? "s" : ""} en ${h.libelle.toLowerCase()}`)
+        .join(", ");
+
+    return (
+        <>
+            {/* La grille crée exactement autant de colonnes qu'il y a de
+                chiffres, et elles se partagent toute la largeur. */}
+            <div className="cx-compte">
+                {chiffres.map((c) => (
+                    <div key={c.cle} className="min-w-0">
+                        <span className="cx-compte__valeur font-body-strong tabular-nums">
+                            {String(c.valeur).padStart(2, "0")}
+                        </span>
+                        <span className="cx-compte__legende cx-label cx-label--legende font-body-strong block">
+                            {c.legende}
+                        </span>
+                    </div>
+                ))}
+            </div>
+
+            {/* Hors de la grille : en flux colonne, une ligne pleine largeur
+                n'existe pas. */}
+            {hebergements && (
+                <p className="cx-compte__detail font-body">{hebergements}</p>
+            )}
+        </>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/recap/Depliant.jsx b/src/pages/client/circuitDetail/components/recap/Depliant.jsx
new file mode 100644
index 0000000..c934c10
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/recap/Depliant.jsx
@@ -0,0 +1,39 @@
+import { useState } from "react";
+
+// Un volet. Titre, compte facultatif, et un signe « + » dont le trait vertical
+// s'efface à l'ouverture — un scaleY, donc rien de repeint.
+//
+// La hauteur s'anime par `grid-template-rows` de 0fr à 1fr : la seule façon
+// d'ouvrir une hauteur inconnue sans aller la mesurer en JavaScript. Le contenu
+// reste donc monté, replié ou non, et le lecteur d'écran le suit par
+// `aria-expanded`.
+export default function Depliant({ titre, compte, ouvertParDefaut = false, children }) {
+    const [ouvert, setOuvert] = useState(ouvertParDefaut);
+
+    return (
+        <section className={`cx-depliant${ouvert ? " cx-depliant--ouvert" : ""}`}>
+            <button
+                type="button"
+                aria-expanded={ouvert}
+                onClick={() => setOuvert((o) => !o)}
+                className="cx-depliant__bouton"
+            >
+                <span className="cx-depliant__titre font-body-strong">
+                    {titre}
+                    {compte > 0 && (
+                        <span className="cx-depliant__compte font-body-strong tabular-nums">
+                            {String(compte).padStart(2, "0")}
+                        </span>
+                    )}
+                </span>
+                <span aria-hidden className="cx-depliant__signe" />
+            </button>
+
+            <div className="cx-depliant__corps">
+                <div>
+                    <div className="cx-depliant__dedans">{children}</div>
+                </div>
+            </div>
+        </section>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/recap/FicheTechnique.jsx b/src/pages/client/circuitDetail/components/recap/FicheTechnique.jsx
new file mode 100644
index 0000000..f555fe9
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/recap/FicheTechnique.jsx
@@ -0,0 +1,87 @@
+import Mention from "../shared/Mention";
+
+// ── La fiche technique ────────────────────────────────────────────────────
+// Durée, style, niveau, âges, groupe, langues, déplacements — ce qu'un
+// voyageur veut savoir avant de lire le programme.
+//
+// Deux colonnes serrées, étiquette au-dessus de la valeur. La version
+// précédente étalait les mêmes mentions sur six colonnes et toute la largeur
+// de la page : aérée au point de ne plus faire fiche du tout. Une fiche
+// technique se lit en bloc — c'est sa densité qui la rend crédible.
+//
+// Chaque mention ne s'affiche que si le back l'a renseignée. On n'écrit jamais
+// « non communiqué » : c'est une ligne à lire pour une information de moins, et
+// une fiche trouée se voit plus qu'une fiche courte.
+//
+// Les libellés viennent tous du back (LibelleDetaille : code + libellé). Le
+// front n'a donc aucune table de traduction à tenir — reformuler « Modéré » se
+// fait dans l'enum, et cet écran suit.
+export default function FicheTechnique({ fiche, duree, nuitees }) {
+    const { style, niveau, ages, groupe, langues = [], transports = [] } = fiche ?? {};
+
+    // La durée ouvre la fiche : c'est la première chose qu'on demande d'un
+    // voyage. Elle se dit ici en jours ET en nuits, ce qu'aucun autre endroit
+    // de la page ne donne d'un coup.
+    const sejour = duree > 0
+        ? `${duree} jour${duree > 1 ? "s" : ""}${nuitees > 0 ? ` · ${nuitees} nuit${nuitees > 1 ? "s" : ""}` : ""}`
+        : null;
+
+    const mentions = [
+        sejour && { legende: "Durée", valeur: sejour },
+        style && { legende: "Style de voyage", valeur: style.libelle },
+        ages && { legende: "Âges", valeur: ages.libelle },
+        groupe && { legende: "Taille du groupe", valeur: groupe.libelle },
+        langues.length > 0 && {
+            legende: langues.length > 1 ? "Langues" : "Langue",
+            valeur: langues.map((l) => l.libelle).join("  ·  "),
+        },
+        transports.length > 0 && {
+            legende: "Déplacements",
+            valeur: transports.map((t) => t.libelle).join("  ·  "),
+        },
+    ].filter(Boolean);
+
+    if (!mentions.length && !niveau) return null;
+
+    return (
+        <dl className="cx-specs">
+            {mentions.slice(0, 2).map((m) => (
+                <Mention key={m.legende} legende={m.legende} valeur={m.valeur} />
+            ))}
+
+            {/* Le niveau a sa propre mention : il porte une échelle que les
+                autres n'ont pas. Il se place en troisième, juste après le
+                style qu'il précise. */}
+            {niveau && (
+                <div className="cx-mention">
+                    <dt className="cx-label cx-label--legende font-body-strong">
+                        Niveau physique
+                    </dt>
+                    <dd>
+                        <span className="cx-mention__valeur font-body-strong block">{niveau.libelle}</span>
+
+                        {/* Quatre traits plats remplis jusqu'à la note. Ce ne sont
+                            pas des étoiles : une étoile note une qualité, ces
+                            barres mesurent une exigence. */}
+                        <span
+                            className="cx-niveau"
+                            role="img"
+                            aria-label={`${niveau.note} sur ${niveau.sur}`}
+                        >
+                            {Array.from({ length: niveau.sur }, (_, i) => (
+                                <span
+                                    key={i}
+                                    className={`cx-niveau__barre${i < niveau.note ? " cx-niveau__barre--on" : ""}`}
+                                />
+                            ))}
+                        </span>
+                    </dd>
+                </div>
+            )}
+
+            {mentions.slice(2).map((m) => (
+                <Mention key={m.legende} legende={m.legende} valeur={m.valeur} />
+            ))}
+        </dl>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/recap/ListeInclusions.jsx b/src/pages/client/circuitDetail/components/recap/ListeInclusions.jsx
new file mode 100644
index 0000000..943d277
--- /dev/null
+++ b/src/pages/client/circuitDetail/components/recap/ListeInclusions.jsx
@@ -0,0 +1,28 @@
+// Une liste d'inclusions — comprises, ou non.
+//
+// Pas de coche verte ni de croix rouge : le volet qui la contient porte deja
+// le titre, et l'encre plus douce suffit pour ce qui n'est pas compris. Une
+// coche verte est le vocabulaire d'un comparateur de prix, pas d'une maison de
+// voyage, et elle oblige a regarder une icone pour lire un mot.
+//
+// Le poste (Transport, Vols, Assurance...) se pose en petites capitales a
+// droite, exactement comme le type d'une visite : un seul registre pour tout le
+// petit texte de la page.
+export default function ListeInclusions({ lignes = [], exclu = false }) {
+    if (!lignes.length) return null;
+
+    return (
+        <ul>
+            {lignes.map((ligne, i) => (
+                <li key={ligne?.id ?? i} className={`cx-ligne${exclu ? " cx-ligne--exclu" : ""}`}>
+                    <span className="cx-ligne__libelle font-body">{ligne?.libelle}</span>
+                    {ligne?.categorie?.libelle && (
+                        <span className="cx-ligne__poste font-body-strong">
+                            {ligne.categorie.libelle}
+                        </span>
+                    )}
+                </li>
+            ))}
+        </ul>
+    );
+}
diff --git a/src/pages/client/circuitDetail/components/shared/Mention.jsx b/src/pages/client/circuitDetail/components/shared/Mention.jsx
