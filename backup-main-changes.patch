@@ -0,0 +1,58 @@
+import { Link } from "react-router-dom";
+import { FaArrowRight } from "react-icons/fa6";
+import { actionDemandeVivante } from "../../../../constants/client/devis";
+
+// Le pied de la colonne : le bouton de marque (celui de « Voir la sélection »
+// sur /circuit) et un lien en capitales. Rien d'autre.
+
+export default function ActionsVoyage({ circuit, sauvegarde, coherence, isAuthenticated, verrouille, onEnregistrer, onDevis, onDupliquer }) {
+    // Un voyage tenu par un devis : le seul geste utile est d'aller au devis,
+    // ou d'en composer une variante. « Demander un devis » n'a plus de sens.
+    if (verrouille) {
+        return (
+            <div className="cx-cp-actions" data-cp-apparait>
+                {sauvegarde.erreur && <p className="cx-cp-actions__erreur" role="alert">{sauvegarde.erreur}</p>}
+                <div className="cx-cp-actions__ligne">
+                    <Link to="/mes-devis" className="cx-cp-cta">
+                        <span>{actionDemandeVivante(circuit.devis?.statut)}</span>
+                        <FaArrowRight size={11} />
+                    </Link>
+                    <button type="button" className="cx-cp-lien-espace" disabled={sauvegarde.enCours} onClick={onDupliquer}>
+                        Dupliquer
+                    </button>
+                </div>
+            </div>
+        );
+    }
+
+    const finalisable = Boolean(coherence?.finalisable);
+    const raison = coherence?.messages?.find((m) => m.niveau === "ERREUR")?.texte
+        ?? "Composez votre voyage pour demander un devis";
+    const rienANouveau = !sauvegarde.modifie && Boolean(circuit.id);
+
+    return (
+        <div className="cx-cp-actions" data-cp-apparait>
+            {sauvegarde.erreur && <p className="cx-cp-actions__erreur" role="alert">{sauvegarde.erreur}</p>}
+            <div className="cx-cp-actions__ligne">
+                <button type="button" className="cx-cp-cta"
+                    disabled={sauvegarde.enCours || !finalisable}
+                    title={finalisable ? undefined : raison}
+                    onClick={onDevis}>
+                    <span>Demander un devis</span>
+                    <FaArrowRight size={11} />
+                </button>
+
+                <button type="button" className="cx-cp-lien-espace"
+                    disabled={sauvegarde.enCours || rienANouveau}
+                    title={isAuthenticated ? undefined : "Connectez-vous pour garder ce voyage dans votre compte"}
+                    onClick={onEnregistrer}>
+                    Enregistrer
+                </button>
+
+                {isAuthenticated && (
+                    <Link to="/mes-circuits" className="cx-cp-lien-espace cx-cp-lien-espace--discret">Mes circuits</Link>
+                )}
+            </div>
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/AlertesCoherence.jsx b/src/pages/client/composer/components/AlertesCoherence.jsx
new file mode 100644
index 0000000..e20e900
--- /dev/null
+++ b/src/pages/client/composer/components/AlertesCoherence.jsx
@@ -0,0 +1,23 @@
+// Le verdict du serveur sur le parcours, UNE phrase à la fois — la plus
+// grave d'abord. Ce que l'écran dit déjà ailleurs n'est pas répété ici :
+// les dates manquantes (le bouton « Choisir les dates »), l'itinéraire vide
+// (la première ligne l'invite), les nuits à répartir (la jauge).
+// Un message lié à une étape la met en évidence au survol.
+
+const DEJA_DIT = new Set(["VIDE", "DATES_MANQUANTES", "NUITS_A_REPARTIR", "NUITS_EN_TROP"]);
+
+export default function AlertesCoherence({ coherence, onSurvolEtape }) {
+    const messages = (coherence?.messages ?? []).filter((m) => !DEJA_DIT.has(m.code));
+    const message = messages.find((m) => m.niveau === "ERREUR") ?? messages[0];
+    if (!message) return null;
+
+    return (
+        <p key={`${message.code}-${message.etape ?? ""}`}
+            className={`cx-cp-alerte${message.niveau === "ERREUR" ? " cx-cp-alerte--erreur" : ""}`}
+            aria-live="polite"
+            onMouseEnter={() => message.etape != null && onSurvolEtape(message.etape)}
+            onMouseLeave={() => onSurvolEtape(null)}>
+            {message.texte}
+        </p>
+    );
+}
diff --git a/src/pages/client/composer/components/Atlas.jsx b/src/pages/client/composer/components/Atlas.jsx
new file mode 100644
index 0000000..f9ec482
--- /dev/null
+++ b/src/pages/client/composer/components/Atlas.jsx
@@ -0,0 +1,80 @@
+import { lazy, Suspense, useState } from "react";
+import Catalogue from "./Catalogue";
+
+// La carte et son moteur — Mapbox GL, 1,8 Mo à lui seul — partent dans leur
+// propre paquet, téléchargé à la première ouverture du volet.
+//
+// Le composant n'était monté qu'à ce moment-là, mais son CODE arrivait avec la
+// page : ouvrir le créateur coûtait Mapbox même sans jamais regarder la carte.
+// C'est ce que le commentaire ci-dessous promettait déjà — c'est maintenant
+// vrai du chargement aussi, et plus seulement de l'instance.
+const CarteParcours = lazy(() => import("./CarteParcours"));
+
+// ── La moitié droite : l'atlas ─────────────────────────────────────────────
+//
+// Deux vues, dont les titres servent d'onglets — « Destinations » et
+// « Carte », écrits en serif comme les liens du menu : le mot actif est à
+// l'encre, l'autre pâlit. La carte se pose PAR-DESSUS la galerie (un volet
+// qui s'ouvre de droite à gauche) : revenir aux destinations retrouve la
+// galerie exactement où on l'avait laissée.
+//
+// La carte n'est créée qu'à sa première ouverture : un voyageur qui ne la
+// regarde pas ne paie pas son chargement.
+
+const deux = (n) => String(n).padStart(2, "0");
+
+export default function Atlas({ vue, onVue, c, pret, carteProps, glisse, onAjouter, onOuvrir, survol, onSurvol }) {
+    const { filtres, setFiltres, catalogue, suggestions, circuit } = c;
+
+    const [carteOuverte, setCarteOuverte] = useState(vue === "carte");
+    if (vue === "carte" && !carteOuverte) setCarteOuverte(true);
+
+    return (
+        <section className="cx-cp-atlas" data-vue={vue} aria-label="Destinations et carte">
+            <div className="cx-cp-atlas__tete">
+                <div className="cx-cp-vues" role="tablist" aria-label="Affichage">
+                    <button type="button" role="tab" aria-selected={vue === "destinations"}
+                        className={`cx-cp-vue${vue === "destinations" ? " cx-cp-vue--active" : ""}`}
+                        onClick={() => onVue("destinations")}>
+                        <span className="cx-cp-masque"><span data-cp-vue className="cx-cp-vue__mot">Destinations</span></span>
+                        <sup className="cx-cp-vue__compte">{catalogue.chargement && !catalogue.total ? "··" : deux(catalogue.total)}</sup>
+                    </button>
+                    <button type="button" role="tab" aria-selected={vue === "carte"}
+                        className={`cx-cp-vue${vue === "carte" ? " cx-cp-vue--active" : ""}`}
+                        onClick={() => onVue("carte")}>
+                        <span className="cx-cp-masque"><span data-cp-vue className="cx-cp-vue__mot">Carte</span></span>
+                    </button>
+                </div>
+            </div>
+
+            <div className="cx-cp-atlas__corps">
+                <Catalogue
+                    filtres={filtres}
+                    setFiltres={setFiltres}
+                    catalogue={catalogue}
+                    suggestions={suggestions}
+                    pret={pret}
+                    carteProps={carteProps}
+                    glisse={glisse}
+                    onAjouter={c.verrouille ? null : onAjouter}
+                    onOuvrir={onOuvrir}
+                />
+                {carteOuverte && (
+                    // `null` en attente : le volet s'ouvre sur son fond, et la
+                    // carte s'y pose quand elle arrive. Un indicateur de
+                    // chargement à cet endroit se verrait plus que l'attente.
+                    <Suspense fallback={null}>
+                        <CarteParcours
+                            visible={vue === "carte"}
+                            etapes={circuit.etapes}
+                            destinations={catalogue.destinations}
+                            survol={survol}
+                            onSurvol={onSurvol}
+                            onOuvrir={onOuvrir}
+                        />
+                    </Suspense>
+                )}
+            </div>
+        </section>
+    );
+}
diff --git a/src/pages/client/composer/components/BandeauAnnuler.jsx b/src/pages/client/composer/components/BandeauAnnuler.jsx
new file mode 100644
index 0000000..cdfb612
--- /dev/null
+++ b/src/pages/client/composer/components/BandeauAnnuler.jsx
@@ -0,0 +1,23 @@
+import { useEffect } from "react";
+
+// « Isalo retirée — Annuler ». Un retrait se rattrape d'un clic (ou Ctrl+Z)
+// pendant six secondes : le voyageur ose manipuler son itinéraire parce
+// qu'aucun geste n'est définitif.
+
+const DUREE_MS = 6000;
+
+export default function BandeauAnnuler({ annulable, onAnnuler, onFermer }) {
+    useEffect(() => {
+        if (!annulable) return undefined;
+        const t = setTimeout(onFermer, DUREE_MS);
+        return () => clearTimeout(t);
+    }, [annulable, onFermer]);
+
+    if (!annulable) return null;
+    return (
+        <div className="cx-cp-bandeau" role="status" key={annulable.le}>
+            <span>{annulable.texte}</span>
+            <button type="button" className="cx-cp-bandeau__annuler" onClick={onAnnuler}>Annuler</button>
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/CarteDestination.jsx b/src/pages/client/composer/components/CarteDestination.jsx
new file mode 100644
index 0000000..bd285c7
--- /dev/null
+++ b/src/pages/client/composer/components/CarteDestination.jsx
@@ -0,0 +1,56 @@
+import { FaCheck, FaPlus } from "react-icons/fa6";
+
+import { imageCloudinary } from "../../../../utils/image";
+// Une destination, en photographie : le cadre des circuits de l'accueil —
+// photo pleine, dégradé par le bas, nom en serif blanc, une ligne en
+// capitales. On la glisse dans le voyage, on clique pour ouvrir sa fiche, ou
+// « + » l'ajoute en fin de voyage (sa photo s'y envole).
+//
+// En haut à gauche, au plus UNE mention : « Suggérée » quand le serveur la
+// trouve souvent associée aux étapes déjà choisies, « Dans votre voyage » une
+// fois choisie. Sinon, rien : la photo parle seule.
+
+export default function CarteDestination({ destination: d, prioritaire, suggestion, avecDistance, glisseProps, glissee, onAjouter, onOuvrir }) {
+    const suggeree = Boolean(suggestion) && !d.dejaChoisie;
+    // Le pourcentage est le score de la suggestion, calculé par le serveur
+    // (association, étiquettes communes, proximité) ; sa raison au survol.
+    const mention = d.dejaChoisie ? "Dans votre voyage" : suggeree ? `Suggérée · ${suggestion.score} %` : null;
+    const meta = [d.tags[0]?.nom, avecDistance && d.distanceKm != null ? `${d.distanceKm} km` : null].filter(Boolean).join(" · ");
+
+    return (
+        <li
+            data-cp-carte
+            data-curseur="Ouvrir"
+            data-flip-id={d.id}
+            className={`cx-cp-carte${d.dejaChoisie ? " cx-cp-carte--choisie" : ""}${suggeree ? " cx-cp-carte--suggeree" : ""}${glissee ? " cx-cp-carte--glissee" : ""}`}
+            title={suggeree ? suggestion.raison : undefined}
+            tabIndex={0}
+            aria-label={`${d.nom} — ouvrir la fiche`}
+            onKeyDown={(e) => { if (e.key === "Enter" && e.target === e.currentTarget) onOuvrir(d); }}
+            {...glisseProps}
+        >
+            <div className="cx-cp-carte__media">
+                {d.image
+                    ? <img data-cp-photo src={imageCloudinary(d.image, 700)} alt="" loading={prioritaire ? "eager" : "lazy"} decoding="async" draggable={false} />
+                    : <span className="cx-cp-carte__initiale">{d.nom.charAt(0)}</span>}
+            </div>
+
+            {mention && <span key={mention} className="cx-cp-carte__mention">{mention}</span>}
+
+            <div className="cx-cp-carte__bas">
+                <div className="cx-cp-carte__texte">
+                    {meta && <span className="cx-cp-carte__meta">{meta}</span>}
+                    <h3 className="cx-cp-carte__nom">{d.nom}</h3>
+                </div>
+                {onAjouter && (
+                    <button type="button" className="cx-cp-carte__ajout"
+                        onClick={(e) => onAjouter(d, e.currentTarget.closest("[data-cp-carte]")?.querySelector("[data-cp-photo]"))}
+                        aria-label={`Ajouter ${d.nom} au voyage`}
+                        title={d.dejaChoisie ? "Déjà dans votre voyage — l'ajouter à nouveau" : "Ajouter au voyage"}>
+                        {d.dejaChoisie ? <FaCheck size={11} /> : <FaPlus size={11} />}
+                    </button>
+                )}
+            </div>
+        </li>
+    );
+}
diff --git a/src/pages/client/composer/components/CarteParcours.jsx b/src/pages/client/composer/components/CarteParcours.jsx
new file mode 100644
index 0000000..5e091f1
--- /dev/null
+++ b/src/pages/client/composer/components/CarteParcours.jsx
@@ -0,0 +1,228 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import gsap from "gsap";
+import mapboxgl from "mapbox-gl";
+import "mapbox-gl/dist/mapbox-gl.css";
+import { distanceKm } from "../../../../utils/geo";
+
+mapboxgl.accessToken = import.meta.env.VITE_MAPBOX_TOKEN;
+
+// ── La carte du tracé ──────────────────────────────────────────────────────
+//
+// Une carte de papier : terres sable, mers ivoire, noms en encre pâle — les
+// couleurs du site, pas celles de Mapbox. Dessus, trois couches :
+//   * les destinations encore libres, en petits points : un clic ouvre la fiche ;
+//   * le tracé, en pointillé fin, dans l'ordre des étapes ;
+//   * les étapes, en carrés numérotés à l'encre, qui passent en terre cuite
+//     quand on survole la ligne correspondante de l'itinéraire.
+//
+// Elle s'ouvre en volet par-dessus la galerie (clip-path, power4) et ne se
+// recadre que quand l'itinéraire change — pas quand le catalogue est filtré.
+
+const CENTRE_MADAGASCAR = [46.8, -19.2];
+const SOBRE = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+const PAPIER = {
+    terre: "#EBE3D4",
+    mer: "#F7F3EA",
+    texte: "#8B7C6D",
+    halo: "#F7F3EA",
+    frontiere: "#CFC3AF",
+};
+
+// Repeint le style clair de Mapbox aux couleurs du site. Chaque couche est
+// essayée séparément : un nom de couche absent d'une version du style ne
+// doit pas empêcher les autres d'être repeintes.
+function habiller(m) {
+    const peindre = (id, prop, valeur) => { try { m.setPaintProperty(id, prop, valeur); } catch { /* couche absente */ } };
+    for (const couche of m.getStyle()?.layers ?? []) {
+        const { id, type } = couche;
+        if (type === "background") peindre(id, "background-color", PAPIER.terre);
+        else if (id === "water" || id.startsWith("water-")) {
+            if (type === "fill") peindre(id, "fill-color", PAPIER.mer);
+            if (type === "line") peindre(id, "line-color", PAPIER.mer);
+        } else if (type === "fill" && /landuse|landcover|park|national|building|wetland|glacier|sand/.test(id)) {
+            peindre(id, "fill-opacity", 0);
+        } else if (type === "hillshade") {
+            peindre(id, "hillshade-exaggeration", 0);
+        } else if (type === "line" && /admin|boundary/.test(id)) {
+            peindre(id, "line-color", PAPIER.frontiere);
+        } else if (type === "line" && /road|bridge|tunnel|rail|ferry/.test(id)) {
+            peindre(id, "line-opacity", 0.35);
+        } else if (type === "symbol") {
+            peindre(id, "text-color", PAPIER.texte);
+            peindre(id, "text-halo-color", PAPIER.halo);
+            peindre(id, "icon-opacity", 0);
+        }
+    }
+}
+
+const geojsonCatalogue = (destinations) => ({
+    type: "FeatureCollection",
+    features: destinations
+        .filter((d) => d.lat != null && d.lng != null && !d.dejaChoisie)
+        .map((d) => ({ type: "Feature", properties: { id: d.id, nom: d.nom }, geometry: { type: "Point", coordinates: [d.lng, d.lat] } })),
+});
+
+export default function CarteParcours({ visible, etapes, destinations, survol, onSurvol, onOuvrir }) {
+    const volet = useRef(null);
+    const conteneur = useRef(null);
+    const carte = useRef(null);
+    const reperes = useRef([]);
+    const [prete, setPrete] = useState(false);
+    const sansJeton = !import.meta.env.VITE_MAPBOX_TOKEN;
+
+    const rappels = useRef({ onSurvol, onOuvrir, destinations });
+    useEffect(() => { rappels.current = { onSurvol, onOuvrir, destinations }; }, [onSurvol, onOuvrir, destinations]);
+
+    // ── Le volet : s'ouvre de droite à gauche, se referme vers la gauche ───
+    const premiere = useRef(true);
+    useLayoutEffect(() => {
+        const el = volet.current;
+        if (!el) return undefined;
+        const instantane = SOBRE();
+        let tween;
+        if (visible) {
+            gsap.set(el, { visibility: "visible" });
+            tween = gsap.fromTo(el,
+                { clipPath: "inset(0% 0% 0% 100%)" },
+                { clipPath: "inset(0% 0% 0% 0%)", duration: instantane ? 0 : 1.1, ease: "power4.inOut" });
+        } else if (!premiere.current) {
+            tween = gsap.to(el, {
+                clipPath: "inset(0% 100% 0% 0%)",
+                duration: instantane ? 0 : 0.9,
+                ease: "power4.inOut",
+                onComplete: () => gsap.set(el, { visibility: "hidden" }),
+            });
+        }
+        premiere.current = false;
+        return () => tween?.kill();
+    }, [visible]);
+
+    // ── Création, une seule fois ───────────────────────────────────────────
+    useEffect(() => {
+        if (sansJeton || carte.current) return undefined;
+        const m = new mapboxgl.Map({
+            container: conteneur.current,
+            style: "mapbox://styles/mapbox/light-v11",
+            center: CENTRE_MADAGASCAR,
+            zoom: 4.8,
+            // À plat : le globe ajoute un halo d'atmosphère blanc sur les bords.
+            projection: "mercator",
+            attributionControl: false,
+            cooperativeGestures: false,
+        });
+        m.addControl(new mapboxgl.NavigationControl({ showCompass: false }), "bottom-right");
+        m.addControl(new mapboxgl.AttributionControl({ compact: true }), "bottom-left");
+        carte.current = m;
+
+        m.on("load", () => {
+            habiller(m);
+            m.addSource("catalogue", { type: "geojson", data: geojsonCatalogue([]) });
+            m.addLayer({
+                id: "catalogue-points", type: "circle", source: "catalogue",
+                paint: {
+                    "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 3, 9, 6],
+                    "circle-color": "#8B7C6D", "circle-opacity": 0.55,
+                    "circle-stroke-color": "#F7F3EA", "circle-stroke-width": 1.5,
+                },
+            });
+            m.addSource("trace", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
+            m.addLayer({
+                id: "trace-ligne", type: "line", source: "trace",
+                layout: { "line-join": "round", "line-cap": "round" },
+                paint: { "line-color": "#2B211A", "line-width": 1.4, "line-dasharray": [2, 2.5] },
+            }, "catalogue-points");
+
+            m.on("click", "catalogue-points", (e) => {
+                const id = e.features?.[0]?.properties?.id;
+                const d = rappels.current.destinations.find((x) => x.id === id);
+                if (d) rappels.current.onOuvrir(d);
+            });
+            m.on("mouseenter", "catalogue-points", () => { m.getCanvas().style.cursor = "pointer"; });
+            m.on("mouseleave", "catalogue-points", () => { m.getCanvas().style.cursor = ""; });
+            setPrete(true);
+        });
+
+        // Le conteneur change de taille avec la fenêtre et à l'ouverture du volet.
+        const observateur = new ResizeObserver(() => m.resize());
+        observateur.observe(conteneur.current);
+
+        return () => {
+            observateur.disconnect();
+            m.remove();
+            carte.current = null;
+        };
+    }, [sansJeton]);
+
+    // ── Le catalogue ───────────────────────────────────────────────────────
+    useEffect(() => {
+        if (!prete) return;
+        carte.current.getSource("catalogue")?.setData(geojsonCatalogue(destinations));
+    }, [destinations, prete]);
+
+    // ── L'itinéraire : tracé, repères, cadrage ─────────────────────────────
+    const cleItineraire = etapes.map((e) => `${e.cle}:${e.destination.id}`).join("|");
+    useEffect(() => {
+        if (!prete) return;
+        const m = carte.current;
+        const points = etapes
+            .map((e, i) => ({ ...e.destination, index: i }))
+            .filter((d) => d.lat != null && d.lng != null);
+
+        m.getSource("trace")?.setData({
+            type: "Feature",
+            geometry: { type: "LineString", coordinates: points.map((p) => [p.lng, p.lat]) },
+        });
+
+        // Le transform de l'élément appartient à Mapbox (il le positionne) :
+        // l'effet de survol agit donc sur la pastille intérieure.
+        reperes.current.forEach((r) => r.remove());
+        reperes.current = points.map((p) => {
+            const el = document.createElement("button");
+            el.type = "button";
+            el.className = "cx-cp-repere";
+            el.setAttribute("aria-label", `Étape ${p.index + 1} : ${p.nom}`);
+            const pastille = document.createElement("span");
+            pastille.className = "cx-cp-repere__pastille";
+            pastille.textContent = String(p.index + 1);
+            el.appendChild(pastille);
+            el.addEventListener("mouseenter", () => rappels.current.onSurvol(p.index));
+            el.addEventListener("mouseleave", () => rappels.current.onSurvol(null));
+            return new mapboxgl.Marker({ element: el, anchor: "center" }).setLngLat([p.lng, p.lat]).addTo(m);
+        });
+
+        if (points.length === 1) {
+            m.easeTo({ center: [points[0].lng, points[0].lat], zoom: 6.2, duration: 1200 });
+        } else if (points.length > 1) {
+            const cadre = new mapboxgl.LngLatBounds();
+            points.forEach((p) => cadre.extend([p.lng, p.lat]));
+            m.fitBounds(cadre, { padding: { top: 120, bottom: 80, left: 90, right: 90 }, maxZoom: 6.8, duration: 1200 });
+        }
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [cleItineraire, prete]);
+
+    // ── L'étape survolée, dans l'itinéraire ou sur la carte ────────────────
+    useEffect(() => {
+        reperes.current.forEach((r, i) => r.getElement().classList.toggle("cx-cp-repere--survol", i === survol));
+    }, [survol, cleItineraire]);
+
+    const km = Math.round(etapes.reduce((s, e, i) => s + (i ? distanceKm(etapes[i - 1].destination, e.destination) ?? 0 : 0), 0));
+
+    return (
+        <div ref={volet} className="cx-cp-carte-parcours" aria-label="Carte du tracé" aria-hidden={!visible}>
+            {sansJeton ? (
+                <div className="cx-cp-carte-parcours__absente">La carte n'est pas configurée (jeton Mapbox manquant).</div>
+            ) : (
+                <div ref={conteneur} className="cx-cp-carte-parcours__fond" />
+            )}
+            <p className="cx-cp-carte-parcours__legende">
+                {etapes.length ? (
+                    <>
+                        {String(etapes.length).padStart(2, "0")} étape{etapes.length > 1 ? "s" : ""}
+                        {km > 0 && <><span className="cx-cp-carte-parcours__sep" aria-hidden="true" />{km} km</>}
+                    </>
+                ) : "Aucune étape"}
+            </p>
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/Catalogue.jsx b/src/pages/client/composer/components/Catalogue.jsx
new file mode 100644
index 0000000..ca3ddf6
--- /dev/null
+++ b/src/pages/client/composer/components/Catalogue.jsx
@@ -0,0 +1,113 @@
+import { useMemo, useRef, useState } from "react";
+import { FaMagnifyingGlass, FaXmark } from "react-icons/fa6";
+import CarteDestination from "./CarteDestination";
+import FiltresEtiquettes from "./FiltresEtiquettes";
+import TriCatalogue from "./TriCatalogue";
+import { useGalerieVivante } from "../../../../hooks/design/animations/composer/useGalerieVivante";
+
+// La galerie des destinations : une barre d'outils (chercher, filtrer, trier)
+// qui reste en haut pendant qu'on fait défiler, puis les photographies.
+//
+// Les suggestions du serveur (« souvent associées à vos étapes ») ne forment
+// pas un bloc à part : la carte concernée porte la mention « Suggérée », et
+// la raison s'affiche au survol.
+//
+// L'ORDRE ATTEND QUE LA SOURIS PARTE. La pertinence dépend de la dernière
+// étape : chaque ajout réordonne la galerie. Réordonnée sous le curseur, la
+// carte visée par un second clic ne serait plus la même. Tant que la souris
+// est sur la galerie, les cartes gardent donc leur place (leurs états, eux,
+// se mettent à jour) ; le nouvel ordre se joue, animé, dès qu'elle en sort.
+// Un filtre ou une recherche, gestes du voyageur, s'appliquent tout de suite.
+
+// Les premières photos sont chargées tout de suite (le rideau les attend),
+// les suivantes à l'approche du défilement.
+const PHOTOS_PRIORITAIRES = 6;
+
+const memeEnsemble = (a, b) => a.length === b.length && b.every((id) => a.includes(id));
+
+export default function Catalogue({
+    filtres, setFiltres, catalogue, suggestions, pret,
+    carteProps, glisse, onAjouter, onOuvrir,
+}) {
+    const defileRef = useRef(null);
+    const grilleRef = useRef(null);
+
+    const destinations = catalogue.destinations;
+    const ids = destinations.map((d) => d.id);
+    const cleServeur = ids.join(",");
+    const cleFiltres = `${filtres.q}|${filtres.tags.join(",")}|${filtres.tri}`;
+
+    // L'ordre affiché, et les filtres qui l'ont produit : un nouvel ordre venu
+    // d'un changement de filtre est un geste du voyageur, il passe toujours.
+    const [survolee, setSurvolee] = useState(false);
+    const [vue, setVue] = useState({ cle: cleServeur, filtres: cleFiltres, ordre: ids });
+    if (cleServeur !== vue.cle) {
+        const geste = cleFiltres !== vue.filtres;
+        const figer = survolee && !geste && memeEnsemble(vue.ordre, ids);
+        setVue({ cle: cleServeur, filtres: cleFiltres, ordre: figer ? vue.ordre : ids });
+    }
+
+    const affichees = useMemo(() => {
+        const parId = new Map(destinations.map((d) => [d.id, d]));
+        return memeEnsemble(vue.ordre, [...parId.keys()]) ? vue.ordre.map((id) => parId.get(id)) : destinations;
+    }, [destinations, vue.ordre]);
+
+    const suggerees = useMemo(() => new Map(suggestions.map((s) => [s.destination.id, s])), [suggestions]);
+    useGalerieVivante({ defileRef, grilleRef, cle: affichees.map((d) => d.id).join(","), pret });
+
+    const basculerTag = (id) => setFiltres((f) => ({
+        ...f, tags: f.tags.includes(id) ? f.tags.filter((t) => t !== id) : [...f.tags, id],
+    }));
+    const effacer = () => setFiltres((f) => ({ ...f, q: "", tags: [] }));
+    const vide = !catalogue.chargement && catalogue.total === 0;
+
+    return (
+        <div ref={defileRef} className="cx-cp-catalogue" data-lenis-prevent
+            onPointerEnter={(e) => { if (e.pointerType === "mouse") setSurvolee(true); }}
+            onPointerLeave={() => { setSurvolee(false); setVue((v) => ({ ...v, ordre: ids })); }}>
+            <div className="cx-cp-outils" data-cp-apparait>
+                <label className="cx-cp-recherche">
+                    <FaMagnifyingGlass size={11} className="cx-cp-recherche__icone" />
+                    <input type="search" value={filtres.q}
+                        onChange={(e) => setFiltres((f) => ({ ...f, q: e.target.value }))}
+                        placeholder="Rechercher" className="cx-cp-recherche__champ"
+                        aria-label="Rechercher une destination" />
+                    {filtres.q && (
+                        <button type="button" className="cx-cp-recherche__effacer" aria-label="Effacer la recherche"
+                            onClick={() => setFiltres((f) => ({ ...f, q: "" }))}>
+                            <FaXmark size={11} />
+                        </button>
+                    )}
+                </label>
+
+                <FiltresEtiquettes facettes={catalogue.facettes} actifs={filtres.tags}
+                    onBasculer={basculerTag} onEffacer={() => setFiltres((f) => ({ ...f, tags: [] }))} />
+
+                <TriCatalogue tri={filtres.tri} onChange={(tri) => setFiltres((f) => ({ ...f, tri }))} />
+            </div>
+
+            {vide ? (
+                <div className="cx-cp-catalogue__vide">
+                    <p className="cx-cp-catalogue__vide-titre">Aucune destination ne correspond.</p>
+                    <button type="button" className="cx-cp-lien-espace" onClick={effacer}>Tout afficher</button>
+                </div>
+            ) : (
+                <ul ref={grilleRef} className={`cx-cp-grille${catalogue.chargement ? " cx-cp-grille--attente" : ""}`}>
+                    {affichees.map((d, i) => (
+                        <CarteDestination
+                            key={d.id}
+                            destination={d}
+                            prioritaire={i < PHOTOS_PRIORITAIRES}
+                            suggestion={suggerees.get(d.id)}
+                            avecDistance={filtres.tri === "PROXIMITE"}
+                            glisseProps={carteProps(d)}
+                            glissee={glisse?.id === d.id}
+                            onAjouter={onAjouter}
+                            onOuvrir={onOuvrir}
+                        />
+                    ))}
+                </ul>
+            )}
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/ChampDates.jsx b/src/pages/client/composer/components/ChampDates.jsx
new file mode 100644
index 0000000..edc74c7
--- /dev/null
+++ b/src/pages/client/composer/components/ChampDates.jsx
@@ -0,0 +1,117 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import { DayPicker } from "react-day-picker";
+import { fr } from "react-day-picker/locale";
+import "react-day-picker/style.css";
+import { FaArrowRight } from "react-icons/fa6";
+import { nuitsEntre, versDate, versIso } from "../../../../functions/composer/itineraire";
+
+// Les dates du voyage, écrites comme la ligne de méta des circuits de
+// l'accueil : « 2 NOV. → 10 NOV. 2026 | 8 NUITS ». Un clic ouvre le
+// calendrier : deux mois côte à côte, les jours passés grisés.
+//
+// Le calendrier sort de la colonne (portail) : il est plus large qu'elle, et
+// la colonne défile — il y serait rogné.
+
+const court = (iso) => versDate(iso)?.toLocaleDateString("fr-FR", { day: "numeric", month: "short" }) ?? "";
+const long = (iso) => versDate(iso)?.toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" }) ?? "";
+
+const MARGE = 16;
+
+export default function ChampDates({ arrivee, depart, onChange, desactive = false }) {
+    const [ouvert, setOuvert] = useState(false);
+    const [position, setPosition] = useState(null);
+    const declencheur = useRef(null);
+    const panneau = useRef(null);
+    const nuits = nuitsEntre(arrivee, depart);
+
+    const aujourdhui = new Date();
+    aujourdhui.setHours(0, 0, 0, 0);
+
+    const fermer = useCallback(() => setOuvert(false), []);
+
+    // Posé sous le déclencheur, ramené dans l'écran s'il en débordait.
+    useLayoutEffect(() => {
+        if (!ouvert) return;
+        const cadre = declencheur.current?.getBoundingClientRect();
+        const largeur = panneau.current?.offsetWidth ?? 0;
+        if (!cadre) return;
+        setPosition({
+            top: cadre.bottom + 14,
+            left: Math.max(MARGE, Math.min(cadre.left, window.innerWidth - largeur - MARGE)),
+        });
+    }, [ouvert]);
+
+    useEffect(() => {
+        if (!ouvert) return undefined;
+        const dehors = (e) => {
+            if (panneau.current?.contains(e.target) || declencheur.current?.contains(e.target)) return;
+            fermer();
+        };
+        const echap = (e) => { if (e.key === "Escape") fermer(); };
+        // Défiler ou redimensionner déplacerait le déclencheur sous le calendrier
+        const defilement = (e) => { if (!panneau.current?.contains(e.target)) fermer(); };
+        document.addEventListener("pointerdown", dehors);
+        document.addEventListener("keydown", echap);
+        window.addEventListener("resize", fermer);
+        window.addEventListener("scroll", defilement, true);
+        return () => {
+            document.removeEventListener("pointerdown", dehors);
+            document.removeEventListener("keydown", echap);
+            window.removeEventListener("resize", fermer);
+            window.removeEventListener("scroll", defilement, true);
+        };
+    }, [ouvert, fermer]);
+
+    const choisir = (plage) => {
+        onChange(versIso(plage?.from) ?? null, versIso(plage?.to) ?? null);
+        if (plage?.from && plage?.to && plage.to > plage.from) fermer();
+    };
+
+    return (
+        <div className="cx-cp-dates">
+            <button ref={declencheur} type="button" className="cx-cp-dates__declencheur" disabled={desactive}
+                onClick={() => setOuvert((o) => !o)} aria-expanded={ouvert} aria-haspopup="dialog">
+                {arrivee || depart ? (
+                    <>
+                        <span>{arrivee ? court(arrivee) : "Arrivée"}</span>
+                        <FaArrowRight size={9} className="cx-cp-dates__fleche" />
+                        <span>{depart ? long(depart) : "Départ"}</span>
+                        {nuits && (
+                            <>
+                                <span className="cx-cp-dates__sep" aria-hidden="true" />
+                                <span>{nuits} nuit{nuits > 1 ? "s" : ""}</span>
+                            </>
+                        )}
+                    </>
+                ) : (
+                    <span className="cx-cp-dates__vide">Choisir les dates</span>
+                )}
+            </button>
+
+            {ouvert && createPortal(
+                <div ref={panneau} className="cx-cp-dates__panneau" role="dialog" aria-label="Dates du voyage"
+                    style={position ?? { visibility: "hidden" }}>
+                    <DayPicker
+                        mode="range"
+                        locale={fr}
+                        numberOfMonths={window.innerWidth < 720 ? 1 : 2}
+                        selected={{ from: versDate(arrivee) ?? undefined, to: versDate(depart) ?? undefined }}
+                        onSelect={choisir}
+                        disabled={{ before: aujourdhui }}
+                        defaultMonth={versDate(arrivee) ?? aujourdhui}
+                        min={1}
+                        className="cx-cp-calendrier"
+                    />
+                    <div className="cx-cp-dates__pied">
+                        <span>{nuits ? `${nuits} nuit${nuits > 1 ? "s" : ""} sur place` : arrivee ? "Choisissez le départ" : "Choisissez l'arrivée"}</span>
+                        {(arrivee || depart) && (
+                            <button type="button" className="cx-cp-lien-espace" onClick={() => onChange(null, null)}>Effacer</button>
+                        )}
+                    </div>
+                </div>,
+                document.body,
+            )}
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/EtapeItineraire.jsx b/src/pages/client/composer/components/EtapeItineraire.jsx
new file mode 100644
index 0000000..f7eb500
--- /dev/null
+++ b/src/pages/client/composer/components/EtapeItineraire.jsx
@@ -0,0 +1,88 @@
+import { useState } from "react";
+import { FaMinus, FaPlus, FaXmark } from "react-icons/fa6";
+import { NUITS_MAX_ETAPE, NUITS_MIN_ETAPE } from "../../../../constants/client/composer";
+
+// Une étape, au format des « trois gestes » de l'accueil : un grand numéro
+// pâle, le nom en serif, une ligne en capitales. Le numéro est la poignée
+// (glisser, ou flèches du clavier) ; les nuits se règlent à droite ; retirer
+// et « + Note » n'apparaissent qu'au survol — au doigt, toujours.
+
+const court = (date) => date?.toLocaleDateString("fr-FR", { day: "numeric", month: "short" });
+const deux = (n) => String(n).padStart(2, "0");
+
+export default function EtapeItineraire({
+    etape, index, plage, poigneeProps, saisie, enEvidence,
+    onNuits, onRetirer, onNotes, onSurvol, verrouille,
+}) {
+    const [noteOuverte, setNoteOuverte] = useState(Boolean(etape.notes));
+    const d = etape.destination;
+
+    return (
+        <li
+            data-reorder-row
+            data-cp-etape
+            data-cle={etape.cle}
+            className={`cx-cp-etape${saisie ? " cx-cp-etape--saisie" : ""}${enEvidence ? " cx-cp-etape--evidence" : ""}`}
+            onMouseEnter={() => onSurvol(index)}
+            onMouseLeave={() => onSurvol(null)}
+        >
+            <div className="cx-cp-etape__rangee">
+                <button type="button" data-cp-numero className="cx-cp-etape__numero"
+                    aria-label={`Déplacer ${d.nom} (flèches haut et bas)`} {...poigneeProps}>
+                    {deux(index + 1)}
+                </button>
+
+                <div className="cx-cp-etape__texte">
+                    <span className="cx-cp-etape__nom">{d.nom}</span>
+                    <span className="cx-cp-etape__quand">
+                        <span>J{plage.jourDebut} → J{plage.jourFin}</span>
+                        {plage.dateDebut && <span>{court(plage.dateDebut)} – {court(plage.dateFin)}</span>}
+                        {!noteOuverte && !verrouille && (
+                            <button type="button" className="cx-cp-etape__note-lien" onClick={() => setNoteOuverte(true)}>
+                                + Note
+                            </button>
+                        )}
+                    </span>
+                </div>
+
+                <div className="cx-cp-etape__nuits" role="group" aria-label={`Nuits à ${d.nom}`}>
+                    <button type="button" className="cx-cp-etape__pas" disabled={verrouille || etape.nuits <= NUITS_MIN_ETAPE}
+                        onClick={() => onNuits(etape.cle, etape.nuits - 1)} aria-label="Une nuit de moins">
+                        <FaMinus size={9} />
+                    </button>
+                    <span className="cx-cp-etape__valeur" aria-live="polite">
+                        <span className="cx-cp-roule-cadre">
+                            <span key={etape.nuits} className="cx-cp-roule cx-cp-etape__chiffre">{etape.nuits}</span>
+                        </span>
+                        <span className="cx-cp-etape__unite">nuit{etape.nuits > 1 ? "s" : ""}</span>
+                    </span>
+                    <button type="button" className="cx-cp-etape__pas" disabled={verrouille || etape.nuits >= NUITS_MAX_ETAPE}
+                        onClick={() => onNuits(etape.cle, etape.nuits + 1)} aria-label="Une nuit de plus">
+                        <FaPlus size={9} />
+                    </button>
+                </div>
+
+                {verrouille ? <span /> : (
+                    <button type="button" className="cx-cp-etape__retirer" onClick={() => onRetirer(etape)} aria-label={`Retirer ${d.nom}`}>
+                        <FaXmark size={12} />
+                    </button>
+                )}
+            </div>
+
+            {noteOuverte && (
+                <div className="cx-cp-etape__note">
+                    <input
+                        className="cx-cp-etape__note-champ"
+                        readOnly={verrouille}
+                        value={etape.notes}
+                        onChange={(e) => onNotes(etape.cle, e.target.value)}
+                        onBlur={() => { if (!etape.notes.trim()) setNoteOuverte(false); }}
+                        maxLength={500}
+                        placeholder="Une envie pour cette étape : lodge avec vue, sortie de nuit…"
+                        autoFocus={!etape.notes}
+                    />
+                </div>
+            )}
+        </li>
+    );
+}
diff --git a/src/pages/client/composer/components/FicheDestination.jsx b/src/pages/client/composer/components/FicheDestination.jsx
new file mode 100644
index 0000000..154ddbf
--- /dev/null
+++ b/src/pages/client/composer/components/FicheDestination.jsx
@@ -0,0 +1,113 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from "react";
+import gsap from "gsap";
+import { FaArrowLeft, FaArrowRight, FaXmark } from "react-icons/fa6";
+
+import { imageCloudinary } from "../../../../utils/image";
+// La fiche d'une destination, ouverte sur le côté sans quitter le créateur.
+// Elle s'ouvre comme le panneau du menu : le volet glisse, la photo se pose
+// en zoom arrière, le nom monte de sous son cadre, le reste suit. Elle se
+// referme de la même façon, en sens inverse.
+
+const SOBRE = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+export default function FicheDestination({ destination: d, onFermer, onAjouter }) {
+    const [image, setImage] = useState(0);
+    const images = d.images?.length ? d.images : d.image ? [d.image] : [];
+    const voile = useRef(null);
+    const panneau = useRef(null);
+    const fermeture = useRef(false);
+
+    useLayoutEffect(() => {
+        if (SOBRE()) return undefined;
+        const p = panneau.current;
+        const tl = gsap.timeline();
+        tl.fromTo(voile.current, { backgroundColor: "rgba(37, 26, 18, 0)" }, { backgroundColor: "rgba(37, 26, 18, 0.45)", duration: 0.6, ease: "power2.out" }, 0)
+            .fromTo(p, { xPercent: 100 }, { xPercent: 0, duration: 0.95, ease: "power4.inOut", clearProps: "transform" }, 0)
+            .fromTo(p.querySelectorAll("[data-fiche-media]"), { scale: 1.25 }, { scale: 1, duration: 1.8, ease: "power2.out", clearProps: "transform" }, 0.25)
+            .from(p.querySelectorAll("[data-fiche-ligne]"), { yPercent: 110, duration: 1.1, ease: "expo.out", stagger: 0.08, clearProps: "transform" }, 0.55)
+            .from(p.querySelectorAll("[data-fiche-apparait]"), { y: 24, opacity: 0, duration: 0.8, ease: "power3.out", stagger: 0.06, clearProps: "transform,opacity" }, 0.7);
+        return () => tl.kill();
+    }, []);
+
+    const fermer = useCallback((apres) => {
+        if (fermeture.current) return;
+        fermeture.current = true;
+        const finir = () => { apres?.(); onFermer(); };
+        if (SOBRE()) { finir(); return; }
+        gsap.timeline({ onComplete: finir })
+            .to(panneau.current, { xPercent: 100, duration: 0.75, ease: "power4.inOut" }, 0)
+            .to(voile.current, { backgroundColor: "rgba(37, 26, 18, 0)", duration: 0.5, ease: "power2.in" }, 0.25);
+    }, [onFermer]);
+
+    useEffect(() => {
+        const touche = (e) => {
+            if (e.key === "Escape") fermer();
+            if (e.key === "ArrowRight") setImage((i) => Math.min(i + 1, images.length - 1));
+            if (e.key === "ArrowLeft") setImage((i) => Math.max(i - 1, 0));
+        };
+        window.addEventListener("keydown", touche);
+        return () => window.removeEventListener("keydown", touche);
+    }, [fermer, images.length]);
+
+    const groupes = d.tags.reduce((acc, t) => {
+        (acc[t.groupe ?? "Autres"] ??= []).push(t.nom);
+        return acc;
+    }, {});
+
+    return (
+        <div ref={voile} className="cx-cp-fiche-voile" onClick={() => fermer()}>
+            <aside ref={panneau} className="cx-cp-fiche" onClick={(e) => e.stopPropagation()} aria-label={d.nom} data-lenis-prevent>
+                <div className="cx-cp-fiche__media">
+                    <div data-fiche-media className="cx-cp-fiche__media-cadre">
+                        {images.length > 0 && <img key={images[image]} src={imageCloudinary(images[image], 1200)} alt={d.nom} decoding="async" className="cx-cp-fiche__image" />}
+                    </div>
+                    <button type="button" className="cx-cp-fiche__fermer" onClick={() => fermer()} aria-label="Fermer">
+                        <FaXmark size={13} />
+                    </button>
+                    {images.length > 1 && (
+                        <div className="cx-cp-fiche__navigation">
+                            <button type="button" onClick={() => setImage((i) => Math.max(i - 1, 0))} disabled={image === 0} aria-label="Photo précédente"><FaArrowLeft size={11} /></button>
+                            <span>{String(image + 1).padStart(2, "0")} / {String(images.length).padStart(2, "0")}</span>
+                            <button type="button" onClick={() => setImage((i) => Math.min(i + 1, images.length - 1))} disabled={image === images.length - 1} aria-label="Photo suivante"><FaArrowRight size={11} /></button>
+                        </div>
+                    )}
+                </div>
+
+                <div className="cx-cp-fiche__corps">
+                    <span className="cx-cp-masque"><span data-fiche-ligne className="cx-cp-surtitre">Destination</span></span>
+                    <h2 className="cx-cp-fiche__nom">
+                        <span className="cx-cp-masque"><span data-fiche-ligne className="cx-cp-fiche__nom-ligne">{d.nom}</span></span>
+                    </h2>
+                    {d.description && <p data-fiche-apparait className="cx-cp-fiche__description">{d.description}</p>}
+
+                    {Object.keys(groupes).length > 0 && (
+                        <dl data-fiche-apparait className="cx-cp-fiche__tags">
+                            {Object.entries(groupes).map(([g, noms]) => (
+                                <div key={g} className="cx-cp-fiche__tag-ligne">
+                                    <dt className="cx-cp-fiche__groupe">{g}</dt>
+                                    <dd className="cx-cp-fiche__valeurs">{noms.join(" · ")}</dd>
+                                </div>
+                            ))}
+                        </dl>
+                    )}
+
+                    {d.videoUrl && (
+                        <a data-fiche-apparait href={d.videoUrl} target="_blank" rel="noreferrer" className="cx-cp-lien-espace cx-cp-fiche__video">
+                            Voir la vidéo
+                        </a>
+                    )}
+                </div>
+
+                {onAjouter && (
+                    <div className="cx-cp-fiche__pied" data-fiche-apparait>
+                        <button type="button" className="cx-cp-cta cx-cp-cta--large"
+                            onClick={() => fermer(() => onAjouter(d))}>
+                            <span>{d.dejaChoisie ? "L'ajouter à nouveau" : "Ajouter à mon voyage"}</span>
+                            <FaArrowRight size={11} />
+                        </button>
+                    </div>
+                )}
+            </aside>
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/FiltresEtiquettes.jsx b/src/pages/client/composer/components/FiltresEtiquettes.jsx
new file mode 100644
index 0000000..9679d21
--- /dev/null
+++ b/src/pages/client/composer/components/FiltresEtiquettes.jsx
@@ -0,0 +1,34 @@
+import { Fragment } from "react";
+
+// Les filtres par étiquette, écrits comme les durées de /circuit : des mots
+// en capitales espacées, le choisi souligné. Le petit chiffre en exposant est
+// le nombre de destinations que donnerait l'étiquette, calculé par le serveur
+// avec les autres filtres déjà posés ; une étiquette à zéro n'est pas
+// renvoyée. Un filet vertical sépare les groupes (Thématique, Saison…) — le
+// nom du groupe s'affiche au survol.
+
+export default function FiltresEtiquettes({ facettes, actifs, onBasculer, onEffacer }) {
+    if (!facettes.length) return <div className="cx-cp-filtres" />;
+
+    return (
+        <div className="cx-cp-filtres" role="group" aria-label="Filtrer par étiquette">
+            {facettes.map((f, i) => (
+                <Fragment key={f.groupe}>
+                    {i > 0 && <span className="cx-cp-filtres__sep" aria-hidden="true" />}
+                    {f.tags.map((t) => (
+                        <button key={t.id} type="button" title={f.groupe}
+                            className={`cx-cp-filtre${t.actif ? " cx-cp-filtre--actif" : ""}`}
+                            onClick={() => onBasculer(t.id)} aria-pressed={t.actif}>
+                            {t.nom}<sup>{t.compte}</sup>
+                        </button>
+                    ))}
+                </Fragment>
+            ))}
+            {actifs.length > 0 && (
+                <button type="button" className="cx-cp-filtres__effacer" onClick={onEffacer} aria-label="Effacer les filtres">
+                    Effacer
+                </button>
+            )}
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/Itineraire.jsx b/src/pages/client/composer/components/Itineraire.jsx
new file mode 100644
index 0000000..03dbfe9
--- /dev/null
+++ b/src/pages/client/composer/components/Itineraire.jsx
@@ -0,0 +1,164 @@
+import { useEffect, useLayoutEffect, useMemo, useRef } from "react";
+import gsap from "gsap";
+import { Flip } from "gsap/Flip";
+import EtapeItineraire from "./EtapeItineraire";
+import { useReorderDrag } from "../../../../hooks/useReorderDrag";
+import { plagesDesEtapes } from "../../../../functions/composer/itineraire";
+
+gsap.registerPlugin(Flip);
+
+// ── Les étapes du voyage ───────────────────────────────────────────────────
+//
+// Des lignes numérotées, comme les « trois gestes » de l'accueil. Deux gestes,
+// deux mécaniques :
+//   * RÉORDONNER : useReorderDrag, en saisissant le numéro de l'étape. La
+//     ligne suit le curseur, les voisines s'écartent.
+//   * AJOUTER / RETIRER : GSAP Flip. Avant chaque rendu, on photographie la
+//     place de chaque ligne ; après, chacune glisse de l'ancienne place vers
+//     la nouvelle. Une étape ajoutée par « + » reçoit la photo qui s'envole de
+//     sa carte (useEnvolEtape), puis apparaît quand elle s'y pose.
+//
+// Flip est COUPÉ pour un réordonnancement : useReorderDrag a déjà amené la
+// ligne sous le doigt, la ré-animer depuis son ancienne place la ferait
+// revenir en arrière avant de repartir.
+
+const SOBRE = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+export default function Itineraire({ circuit, actions, pret, zoneRef, listeRef, insertion, glisse, survol, onSurvol, envol, verrouille }) {
+    const etapes = circuit.etapes;
+    const plages = useMemo(() => plagesDesEtapes(etapes, circuit.dateArrivee), [etapes, circuit.dateArrivee]);
+
+    const sansFlip = useRef(false);
+    const { listRef, dragIndex, poigneeProps } = useReorderDrag({
+        count: etapes.length,
+        scrollerSelector: "[data-composer-scroller]",
+        onReorder: (depuis, vers) => {
+            sansFlip.current = true;
+            actions.deplacer(depuis, vers);
+        },
+    });
+
+    // Une seule ref pour deux usages : le glisser-réordonner et le calcul
+    // d'insertion du glisser depuis la galerie.
+    const attacherListe = (el) => {
+        listRef.current = el;
+        if (listeRef) listeRef.current = el;
+    };
+
+    const etatPrecedent = useRef(null);
+
+    // La photographie des places suit le défilement de la colonne : prise
+    // avant, elle ferait partir les lignes de là où elles étaient AVANT.
+    useEffect(() => {
+        const defile = zoneRef.current?.closest("[data-composer-scroller]");
+        if (!defile) return undefined;
+        let raf = null;
+        const capturer = () => {
+            raf = null;
+            const lignes = listRef.current?.querySelectorAll("[data-reorder-row]");
+            if (lignes?.length) etatPrecedent.current = Flip.getState(lignes);
+        };
+        const programmer = () => { if (!raf) raf = requestAnimationFrame(capturer); };
+        defile.addEventListener("scroll", programmer, { passive: true });
+        return () => {
+            defile.removeEventListener("scroll", programmer);
+            if (raf) cancelAnimationFrame(raf);
+        };
+    }, [zoneRef, listRef]);
+
+    const cles = etapes.map((e) => e.cle).join("|");
+    useLayoutEffect(() => {
+        const liste = listRef.current;
+        if (!liste) {
+            etatPrecedent.current = null;
+            return;
+        }
+        const lignes = liste.querySelectorAll("[data-reorder-row]");
+
+        // Une ligne qui entre : l'envol part d'abord, la ligne apparaît quand il se pose.
+        const entrer = (entrees) => {
+            const vol = entrees.length === 1 && envol?.lancer(entrees[0].querySelector("[data-cp-numero]"));
+            gsap.fromTo(entrees,
+                { opacity: 0, y: 18 },
+                { opacity: 1, y: 0, duration: 0.8, delay: vol ? 0.6 : 0, ease: "power3.out", stagger: 0.05, clearProps: "transform,opacity" });
+        };
+
+        if (pret && !sansFlip.current && !SOBRE()) {
+            if (etatPrecedent.current) {
+                Flip.from(etatPrecedent.current, {
+                    targets: lignes,
+                    duration: 0.7,
+                    ease: "power3.inOut",
+                    absolute: false,
+                    clearProps: "transform",
+                    onEnter: entrer,
+                });
+            } else if (lignes.length) {
+                // La liste était vide : pas de photographie précédente, tout est nouveau.
+                entrer([...lignes]);
+            }
+        }
+        sansFlip.current = false;
+        etatPrecedent.current = lignes.length ? Flip.getState(lignes) : null;
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [cles]);
+
+    const survolZone = insertion != null;
+
+    return (
+        <div ref={zoneRef}
+            className={`cx-cp-etapes-zone${glisse ? " cx-cp-etapes-zone--active" : ""}${survolZone ? " cx-cp-etapes-zone--survol" : ""}`}>
+            {etapes.length === 0 ? (
+                <div className="cx-cp-vide" data-cp-etape>
+                    <span className="cx-cp-vide__numero">01</span>
+                    <div>
+                        <p className="cx-cp-vide__titre">{survolZone ? "Déposez-la ici." : "Votre première étape."}</p>
+                        <p className="cx-cp-vide__texte">Glissez une destination ici, ou « + » sur sa photo.</p>
+                    </div>
+                </div>
+            ) : (
+                <ol ref={attacherListe} className="cx-cp-etapes">
+                    {etapes.map((e, i) => (
+                        <FragmentEtape key={e.cle} insertionIci={insertion === i} glisse={glisse}>
+                            <EtapeItineraire
+                                etape={e}
+                                index={i}
+                                plage={plages[i]}
+                                poigneeProps={verrouille ? {} : poigneeProps(i)}
+                                verrouille={verrouille}
+                                saisie={dragIndex === i}
+                                enEvidence={survol === i}
+                                onNuits={actions.nuits}
+                                onRetirer={actions.retirer}
+                                onNotes={actions.notes}
+                                onSurvol={onSurvol}
+                            />
+                        </FragmentEtape>
+                    ))}
+                    {insertion === etapes.length && <IndicateurInsertion nom={glisse?.nom} />}
+                </ol>
+            )}
+        </div>
+    );
+}
+
+// La ligne d'insertion s'affiche AVANT l'étape visée. Elle n'est pas une
+// ligne du réordonnancement (pas de data-reorder-row) : les calculs de
+// useReorderDrag l'ignorent.
+function FragmentEtape({ insertionIci, glisse, children }) {
+    return (
+        <>
+            {insertionIci && <IndicateurInsertion nom={glisse?.nom} />}
+            {children}
+        </>
+    );
+}
+
+function IndicateurInsertion({ nom }) {
+    return (
+        <li className="cx-cp-insertion" aria-hidden="true">
+            <span className="cx-cp-insertion__ligne" />
+            <span className="cx-cp-insertion__texte">{nom ?? "Déposer ici"}</span>
+        </li>
+    );
+}
diff --git a/src/pages/client/composer/components/JaugeNuits.jsx b/src/pages/client/composer/components/JaugeNuits.jsx
new file mode 100644
index 0000000..80a5dc5
--- /dev/null
+++ b/src/pages/client/composer/components/JaugeNuits.jsx
@@ -0,0 +1,38 @@
+// Les nuits du voyage : un filet et une ligne en capitales, comme la barre
+// du bas du héro de l'accueil. Chaque étape est un segment du filet, à la
+// largeur de ses nuits ; le vide à droite, ce sont les nuits qui restent.
+
+const deux = (n) => String(n).padStart(2, "0");
+
+export default function JaugeNuits({ etapes, prevues, planifiees, onRepartir }) {
+    const reference = Math.max(prevues ?? 0, planifiees, 1);
+    const reste = prevues == null ? null : prevues - planifiees;
+    const peutRepartir = Boolean(onRepartir) && reste != null && reste !== 0 && etapes.length > 0 && prevues >= etapes.length;
+
+    return (
+        <div className={`cx-cp-jauge${reste === 0 ? " cx-cp-jauge--complete" : ""}${reste < 0 ? " cx-cp-jauge--depasse" : ""}`}>
+            {prevues != null && (
+                <div className="cx-cp-jauge__filet" role="img"
+                    aria-label={`${planifiees} nuits placées sur ${prevues}`}>
+                    {etapes.map((e) => (
+                        <span key={e.cle} className="cx-cp-jauge__segment"
+                            style={{ width: `${(e.nuits / reference) * 100}%` }} />
+                    ))}
+                    {reste < 0 && <span className="cx-cp-jauge__repere" style={{ left: `${(prevues / reference) * 100}%` }} />}
+                </div>
+            )}
+
+            <div className="cx-cp-jauge__ligne">
+                <span className="cx-cp-jauge__compte">
+                    <span className="cx-cp-roule-cadre"><strong key={planifiees} className="cx-cp-roule">{deux(planifiees)}</strong></span>
+                    {prevues != null && <> / {deux(prevues)}</>}
+                    {" "}nuit{Math.max(planifiees, prevues ?? 0) > 1 ? "s" : ""}
+                    {reste < 0 && <em> · {-reste} de trop</em>}
+                </span>
+                {peutRepartir && (
+                    <button type="button" className="cx-cp-lien-espace" onClick={onRepartir}>Répartir</button>
+                )}
+            </div>
+        </div>
+    );
+}
diff --git a/src/pages/client/composer/components/PanneauVoyage.jsx b/src/pages/client/composer/components/PanneauVoyage.jsx
new file mode 100644
index 0000000..f57bbdb
--- /dev/null
+++ b/src/pages/client/composer/components/PanneauVoyage.jsx
@@ -0,0 +1,155 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import ChampDates from "./ChampDates";
+import JaugeNuits from "./JaugeNuits";
+import Itineraire from "./Itineraire";
+import AlertesCoherence from "./AlertesCoherence";
+import ActionsVoyage from "./ActionsVoyage";
+import { STATUTS_CIRCUIT } from "../../../../constants/client/composer";
+import { libelleStatutDevis } from "../../../../constants/client/devis";
+
+// ── La colonne de sable : votre voyage ─────────────────────────────────────
+//
+// Construite comme la colonne « Territoires » de l'accueil : un sur-titre
+// espacé, un titre au format d'affiche (ici, le nom du voyage, qu'on écrit
+// directement), puis ce qui s'y rattache — dates, nuits, étapes. Les deux
+// gestes qui comptent (devis, enregistrer) restent posés en pied.
+
+export default function PanneauVoyage({ c, pret, zoneRef, listeRef, insertion, glisse, survol, onSurvol, envol }) {
+    const { circuit, actions, sauvegarde, coherence, nuitsPrevues, planifiees, isAuthenticated, verrouille } = c;
+
+    return (
+        <aside className="cx-cp-voyage" aria-label="Votre voyage">
+            <div className="cx-cp-voyage__defile" data-composer-scroller data-lenis-prevent>
+                <div className="cx-cp-voyage__surtitres">
+                    <span className="cx-cp-masque">
+                        <span data-cp-kicker className="cx-cp-surtitre">Votre voyage</span>
+                    </span>
+                    <span className="cx-cp-masque">
+                        <span data-cp-kicker className="cx-cp-surtitre cx-cp-surtitre--discret" aria-live="polite">
+                            {verrouille
+                                ? libelleStatutDevis(circuit.devis.statut)
+                                : <EtatSauvegarde circuit={circuit} sauvegarde={sauvegarde} isAuthenticated={isAuthenticated} />}
+                        </span>
+                    </span>
+                </div>
+
+                <TitreVoyage valeur={circuit.nom} onChange={actions.nom} lectureSeule={verrouille} />
+
+                <div data-cp-apparait className="cx-cp-voyage__dates">
+                    <ChampDates arrivee={circuit.dateArrivee} depart={circuit.dateDepart} onChange={actions.dates}
+                        desactive={verrouille} />
+                </div>
+
+                <div data-cp-apparait>
+                    <JaugeNuits etapes={circuit.etapes} prevues={nuitsPrevues} planifiees={planifiees}
+                        onRepartir={verrouille ? null : actions.repartir} />
+                </div>
+
+                {verrouille && circuit.devis?.raison && (
+                    <p data-cp-apparait className="cx-cp-verrou">{circuit.devis.raison}</p>
+                )}
+
+                <Itineraire
+                    circuit={circuit}
+                    actions={actions}
+                    pret={pret}
+                    zoneRef={zoneRef}
+                    listeRef={listeRef}
+                    insertion={insertion}
+                    glisse={glisse}
+                    survol={survol}
+                    onSurvol={onSurvol}
+                    envol={envol}
+                    verrouille={verrouille}
+                />
+
+                {!verrouille && <AlertesCoherence coherence={coherence} onSurvolEtape={onSurvol} />}
+            </div>
+
+            <ActionsVoyage
+                circuit={circuit}
+                sauvegarde={sauvegarde}
+                coherence={coherence}
+                isAuthenticated={isAuthenticated}
+                verrouille={verrouille}
+                onEnregistrer={() => c.enregistrer()}
+                onDevis={c.demanderDevis}
+                onDupliquer={c.dupliquer}
+            />
+        </aside>
+    );
+}
+
+// Le nom du voyage, au format d'affiche. Un <textarea> et non un <input> :
+// un nom long passe à la ligne comme un titre, au lieu de fuir hors du cadre.
+// Entrée valide, sans jamais insérer de retour à la ligne.
+function ajusterHauteur(el) {
+    if (!el) return;
+    el.style.height = "auto";
+    el.style.height = `${el.scrollHeight}px`;
+}
+
+function TitreVoyage({ valeur, onChange, lectureSeule }) {
+    const ref = useRef(null);
+
+    useLayoutEffect(() => ajusterHauteur(ref.current), [valeur]);
+
+    // Mesuré pendant que sa colonne est masquée (onglets du téléphone), le
+    // champ aurait une hauteur nulle : on le remesure dès que sa largeur change.
+    useEffect(() => {
+        const el = ref.current;
+        if (!el) return undefined;
+        let largeur = el.offsetWidth;
+        const observateur = new ResizeObserver(() => {
+            if (el.offsetWidth === largeur) return;
+            largeur = el.offsetWidth;
+            ajusterHauteur(el);
+        });
+        observateur.observe(el);
+        return () => observateur.disconnect();
+    }, []);
+
+    return (
+        <div className="cx-cp-masque cx-cp-voyage__titre-cadre">
+            <textarea
+                ref={ref}
+                data-cp-titre
+                rows={1}
+                className="cx-cp-voyage__titre"
+                value={valeur}
+                readOnly={lectureSeule}
+                onChange={(e) => onChange(e.target.value.replace(/\s*\n\s*/g, " "))}
+                onKeyDown={(e) => {
+                    if (e.key === "Enter") {
+                        e.preventDefault();
+                        e.currentTarget.blur();
+                    }
+                }}
+                placeholder="Nommez votre voyage"
+                maxLength={120}
+                aria-label="Nom du voyage"
+                spellCheck={false}
+            />
+        </div>
+    );
+}
+
+// Une ligne, dans le sur-titre : l'état du circuit ou de son enregistrement.
+function EtatSauvegarde({ circuit, sauvegarde, isAuthenticated }) {
+    // Rafraîchit l'heure affichée sans rien demander au serveur.
+    const [, setTic] = useState(0);
+    useEffect(() => {
+        if (!sauvegarde.derniere) return undefined;
+        const t = setInterval(() => setTic((n) => n + 1), 60000);
+        return () => clearInterval(t);
+    }, [sauvegarde.derniere]);
+
+    if (sauvegarde.enCours) return "Enregistrement…";
+    if (sauvegarde.erreur) return "Non enregistré";
+    if (sauvegarde.modifie && isAuthenticated && circuit.id) return "Modifié";
+    if (sauvegarde.derniere) {
+        const heure = new Date(sauvegarde.derniere).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" });
+        return `Enregistré à ${heure}`;
+    }
+    return (STATUTS_CIRCUIT[circuit.statut] ?? STATUTS_CIRCUIT.BROUILLON).libelle;
+}
