@@ -0,0 +1,11 @@
+// Distance à vol d'oiseau entre deux points { lat, lng }, en kilomètres
+// (formule de haversine). Null si un point manque : une distance inconnue
+// n'est pas une distance nulle.
+export function distanceKm(a, b) {
+    if (a?.lat == null || a?.lng == null || b?.lat == null || b?.lng == null) return null;
+    const rad = (d) => (d * Math.PI) / 180;
+    const dLat = rad(b.lat - a.lat);
+    const dLng = rad(b.lng - a.lng);
+    const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
+    return 2 * 6371 * Math.asin(Math.min(1, Math.sqrt(h)));
+}
diff --git a/src/utils/image.js b/src/utils/image.js
new file mode 100644
index 0000000..0415035
--- /dev/null
+++ b/src/utils/image.js
@@ -0,0 +1,64 @@
+// ── Les images, à la taille où on les regarde ──────────────────────────────
+//
+// Une photo est stockée chez Cloudinary à la taille où l'agence l'a déposée :
+// 1920 × 1280 pour nos visuels actuels, trois à quatre fois plus pour une
+// photo sortie d'un téléphone. Le navigateur la télécharge telle quelle, puis
+// il la DÉCODE en mémoire à quatre octets par pixel.
+//
+// C'est ce décodage qui coûte, et il ne se voit dans aucun poids de fichier :
+// 1920 × 1280, ce sont 2,5 millions de pixels, donc ~10 Mo de RAM — pour une
+// carte qui en affiche 600 de large. La page des circuits garde neuf visuels
+// à l'écran entre son héros et sa grille : ~90 Mo de bitmap pour montrer
+// l'équivalent de 9 Mo. La mémoire ne part pas dans le JavaScript, elle part
+// là.
+//
+//
+// Cloudinary sait servir la bonne taille, il suffit de la demander dans
+// l'URL : `f_auto` choisit le format que le navigateur préfère (AVIF, WebP),
+// `q_auto` la compression, `w_` la largeur, `c_limit` interdit d'agrandir une
+// petite photo. Rien à changer au dépôt ni au serveur — et aucune animation
+// touchée : on change l'adresse de l'image, pas ce qu'on en fait.
+
+const MARQUEUR = "/image/upload/";
+
+/** Une URL déjà transformée ne se transforme pas deux fois. */
+const dejaTransformee = (suite) => /(^|,)[a-z]{1,3}_/.test(suite.split("/")[0]);
+
+/**
+ * @param {string} url      l'URL Cloudinary d'origine ; tout le reste (photo
+ *                          locale, avatar Google, autre hôte) revient intact
+ * @param {number} [largeur] largeur voulue en pixels RÉELS (pensez au retina)
+ * @param {{hauteur?: number}} [options] hauteur : recadre au centre d'intérêt
+ */
+export function imageCloudinary(url, largeur, options = {}) {
+    if (!url || typeof url !== "string") return url;
+    const i = url.indexOf(MARQUEUR);
+    if (i === -1) return url;
+
+    const suite = url.slice(i + MARQUEUR.length);
+    if (dejaTransformee(suite)) return url;
+
+    const transformations = ["f_auto", "q_auto"];
+    if (largeur) transformations.push(`w_${Math.round(largeur)}`);
+    if (options.hauteur) {
+        transformations.push(`h_${Math.round(options.hauteur)}`, "c_fill", "g_auto");
+    } else {
+        transformations.push("c_limit");
+    }
+
+    return url.slice(0, i + MARQUEUR.length) + transformations.join(",") + "/" + suite;
+}
+
+/**
+ * Le même visuel en plusieurs largeurs, à donner à `srcset`.
+ *
+ * C'est le navigateur qui choisit, et il choisit mieux que nous : il connaît
+ * la densité de l'écran et la largeur réelle du cadre. Un écran ordinaire
+ * télécharge deux fois moins de pixels qu'un retina — et n'en garde deux fois
+ * moins en mémoire. Rend `undefined` pour une image non Cloudinary, ce qui
+ * laisse l'attribut absent plutôt que vide.
+ */
+export function srcSetCloudinary(url, largeurs) {
+    if (!url || typeof url !== "string" || url.indexOf(MARQUEUR) === -1) return undefined;
+    return largeurs.map((l) => `${imageCloudinary(url, l)} ${l}w`).join(", ");
+}
diff --git a/src/utils/telecharger.js b/src/utils/telecharger.js
new file mode 100644
index 0000000..e6e7df0
--- /dev/null
+++ b/src/utils/telecharger.js
@@ -0,0 +1,29 @@
+// Enregistre un fichier reçu de l'API (réponse axios en `responseType: "blob"`).
+//
+// Le lien <a download> plutôt qu'un nouvel onglet : ouvert après un appel
+// réseau, un onglet serait bloqué par le navigateur comme une fenêtre
+// surgissante. Le nom vient de l'en-tête Content-Disposition du serveur.
+export const enregistrerFichier = (reponse, nomParDefaut = "document.pdf") => {
+    const disposition = reponse.headers?.["content-disposition"] ?? "";
+    const nom = disposition.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i)?.[1] ?? nomParDefaut;
+    const url = URL.createObjectURL(reponse.data);
+    const lien = document.createElement("a");
+    lien.href = url;
+    lien.download = decodeURIComponent(nom);
+    document.body.appendChild(lien);
+    lien.click();
+    lien.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 10_000);
+};
+
+// Une erreur d'API arrive, elle aussi, en Blob : on la relit en JSON pour que
+// `apiErrorMessage` retrouve le message du serveur.
+export const relireErreurBlob = async (error) => {
+    const donnees = error.response?.data;
+    if (donnees instanceof Blob) {
+        try {
+            error.response.data = JSON.parse(await donnees.text());
+        } catch { /* ce n'était pas du JSON : on garde l'erreur telle quelle */ }
+    }
+    return error;
+};
diff --git a/src/utils/validationChamps.js b/src/utils/validationChamps.js
new file mode 100644
index 0000000..2202319
--- /dev/null
+++ b/src/utils/validationChamps.js
@@ -0,0 +1,107 @@
+// ── Les limites d'un champ, en un seul endroit ─────────────────────────────
+//
+// Les deux formulaires de l'administration — la page (CreateModal) et la
+// fenêtre (FormModal) — partaient tous les deux en `noValidate` sans une seule
+// borne : on pouvait enregistrer un circuit de 110 jours, une note de 47
+// étoiles, un jour n° 0. Le serveur refusait parfois, jamais toujours, et son
+// refus arrivait après l'envoi, en une phrase au pied de l'écran, sans dire
+// QUEL champ.
+//
+// Les bornes se déclarent donc avec le champ (createConstant.js) et se
+// vérifient ici, pour les deux formulaires à la fois : une borne ajoutée vaut
+// partout, et le message se pose sous le champ fautif.
+//
+// Un champ facultatif laissé vide n'est pas une erreur : c'est un blanc voulu,
+// que le serveur lit comme « non renseigné ». Seul `obligatoire` le refuse.
+
+const estVide = (v) =>
+    v === "" || v === null || v === undefined || (Array.isArray(v) && v.length === 0);
+
+const pluriel = (n, mot) => (mot ? ` ${mot}${Math.abs(n) > 1 ? "s" : ""}` : "");
+
+/** « 12/03/2026 » plutôt que « 2026-03-12 » dans un message lu par un humain. */
+const jour = (iso) => {
+    const d = new Date(iso);
+    return Number.isNaN(d.getTime()) ? iso : d.toLocaleDateString("fr-FR");
+};
+
+function erreurNombre(field, valeur) {
+    const n = Number(valeur);
+    if (!Number.isFinite(n)) return "Indiquez un nombre.";
+    if (field.entier !== false && !Number.isInteger(n)) return "Indiquez un nombre entier.";
+    if (field.min != null && n < field.min) {
+        return `Le minimum est ${field.min}${pluriel(field.min, field.unite)}.`;
+    }
+    if (field.max != null && n > field.max) {
+        return `Le maximum est ${field.max}${pluriel(field.max, field.unite)}.`;
+    }
+    return null;
+}
+
+function erreurDate(field, valeur) {
+    if (field.min && valeur < field.min) return `La date doit être au plus tôt le ${jour(field.min)}.`;
+    if (field.max && valeur > field.max) return `La date doit être au plus tard le ${jour(field.max)}.`;
+    return null;
+}
+
+function erreurTexte(field, valeur) {
+    const texte = String(valeur);
+    if (field.maxLength && texte.length > field.maxLength) {
+        return `${field.maxLength} caractères au plus (actuellement ${texte.length}).`;
+    }
+    if (field.minLength && texte.trim().length < field.minLength) {
+        return `${field.minLength} caractères au moins.`;
+    }
+    return null;
+}
+
+function erreurListe(field, valeur) {
+    if (field.maxItems && valeur.length > field.maxItems) {
+        return `${field.maxItems} au plus (actuellement ${valeur.length}).`;
+    }
+    if (field.minItems && valeur.length < field.minItems) {
+        return `${field.minItems} au moins.`;
+    }
+    return null;
+}
+
+/** L'erreur d'un champ, ou null. */
+export function erreurChamp(field, valeur) {
+    if (estVide(valeur)) {
+        return field.obligatoire ? (field.messageVide ?? "Ce champ est obligatoire.") : null;
+    }
+    if (Array.isArray(valeur)) return erreurListe(field, valeur);
+    // Un nombre peut aussi arriver dans un champ « texte » borné : on se fie
+    // aux bornes declarees, pas au seul type de l'input.
+    if (field.type === "number" || field.min != null || field.max != null) {
+        if (field.type === "date") return erreurDate(field, valeur);
+        return erreurNombre(field, valeur);
+    }
+    if (field.type === "date") return erreurDate(field, valeur);
+    if (typeof valeur === "string") return erreurTexte(field, valeur);
+    return null;
+}
+
+/**
+ * Toutes les erreurs d'un formulaire : { nomDuChamp: message }.
+ *
+ * `coherence` vérifie ce qu'un champ seul ne peut pas savoir — un âge maximum
+ * plus petit que le minimum, par exemple. Elle reçoit toutes les valeurs et
+ * renvoie la même forme.
+ */
+export function validerChamps(fields, formData, coherence) {
+    const erreurs = {};
+    for (const field of fields.flat()) {
+        // Les champs d'envoi de fichiers et les listes composites ont leur
+        // propre garde-fou dans leur composant.
+        if (["image", "video", "programme", "inclusions"].includes(field.type)) continue;
+        const message = erreurChamp(field, formData[field.name]);
+        if (message) erreurs[field.name] = message;
+    }
+    return { ...erreurs, ...(coherence ? coherence(formData) : null) };
+}
+
+/** Le premier champ fautif, dans l'ordre du formulaire : celui où poser le focus. */
+export function premierChampFautif(fields, erreurs) {
+    return fields.flat().find((f) => erreurs[f.name])?.name ?? null;
+}
