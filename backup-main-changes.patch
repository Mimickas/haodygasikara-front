+        { key: "nombreVoyageurs", label: "Voyageurs", render: val => val ? `${val} pers.` : "—", texte: val => val ?? "" },
+        { key: "montantPropose", label: "Devis",      render: (val, row) => val == null ? "—" : `${formatPrice(val)} ${row?.deviseProposee ?? ""}`,
