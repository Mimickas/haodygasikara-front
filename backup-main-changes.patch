diff --git a/src/hooks/admin/useChampsFormulaire.js b/src/hooks/admin/useChampsFormulaire.js
new file mode 100644
index 0000000..a1eebb5
--- /dev/null
+++ b/src/hooks/admin/useChampsFormulaire.js
@@ -0,0 +1,85 @@
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { premierChampFautif, validerChamps } from "../../utils/validationChamps";
+
+// ── La logique commune aux deux formulaires de l'administration ────────────
+//
+// Il y en a deux : la PAGE (CreateModal, pour créer ou modifier un circuit,
+// une destination) et la FENÊTRE (FormModal, pour les listes). Ils lisaient la
+// même déclaration de champs (createConstant.js) mais chacun avait son propre
+// rendu, et ils avaient divergé :
+//
+//   * `radio`, `steps` et `inclusions` n'existaient que dans la page ;
+//   * `dependsOn` — un champ dont les options dépendent d'un autre — n'existait
+//     que dans la fenêtre ;
+//   * aucun des deux ne vérifiait quoi que ce soit avant d'envoyer.
+//
+// Tout est ici, une fois : les valeurs, les dépendances, la validation. Les
+// deux écrans ne gardent que leur habillage — une page a un pied collant, une
+// fenêtre a une croix.
+
+export function useChampsFormulaire(fields, values, coherence) {
+    const plats = useMemo(() => fields.flat(), [fields]);
+
+    const initiales = useCallback(() => plats.reduce((acc, field) => {
+        acc[field.name] = values?.[field.name] ?? field.defaultValue ?? "";
+        return acc;
+    }, {}), [plats, values]);
+
+    const [formData, setFormData] = useState(initiales);
+    const [erreurs, setErreurs] = useState({});
+
+    // Les valeurs relues arrivent après coup (la fenêtre rouvre sur une autre
+    // ligne, la page charge sa fiche) : le formulaire les reprend.
+    useEffect(() => {
+        setFormData(initiales());
+        setErreurs({});
+    }, [initiales]);
+
+    const setChamp = useCallback((name, val) => {
+        // Corriger un champ efface son message : l'erreur ne survit pas à sa cause.
+        setErreurs(prev => (prev[name] ? { ...prev, [name]: undefined } : prev));
+        setFormData(prev => {
+            const next = { ...prev, [name]: val };
+            // Changer un champ vide ceux qui en dépendent, et leurs propres
+            // dépendants : un hébergement d'une autre destination ne doit pas
+            // rester sélectionné sous une étape qu'on vient de changer.
+            let parents = [name];
+            while (parents.length) {
+                const enfants = plats.filter(f => parents.includes(f.dependsOn));
+                enfants.forEach(f => { next[f.name] = f.defaultValue ?? ""; });
+                parents = enfants.map(f => f.name);
+            }
+            return next;
+        });
+    }, [plats]);
+
+    /** Les options d'un champ, filtrées par son parent s'il en a un. */
+    const optionsDe = useCallback((field) => (field.dependsOn
+        ? (field.options ?? []).filter(o => String(o.parent) === String(formData[field.dependsOn]))
+        : (field.options ?? [])), [formData]);
+
+    /**
+     * Le libellé du champ parent tant qu'il n'est pas rempli, sinon null.
+     * Un champ dépendant s'ouvrait jusqu'ici sur une liste vide, ce qui se lit
+     * comme une panne : il reste fermé et dit de quoi il dépend.
+     */
+    const attenteDe = useCallback((field) => {
+        if (!field.dependsOn || formData[field.dependsOn]) return null;
+        return plats.find(f => f.name === field.dependsOn)?.label ?? null;
+    }, [formData, plats]);
+
+    /**
+     * Vérifie tout. Renvoie true si c'est bon ; sinon pose les messages et met
+     * le focus sur le premier champ fautif.
+     */
+    const valider = useCallback(() => {
+        const fautes = Object.fromEntries(
+            Object.entries(validerChamps(fields, formData, coherence)).filter(([, m]) => m));
+        setErreurs(fautes);
+        const premier = premierChampFautif(fields, fautes);
+        if (premier) document.getElementById(`champ-${premier}`)?.focus();
+        return !premier;
+    }, [fields, formData, coherence]);
+
+    return { formData, setFormData, setChamp, erreurs, valider, optionsDe, attenteDe };
+}
diff --git a/src/hooks/admin/useCircuitActionToolbar.js b/src/hooks/admin/useCircuitActionToolbar.js
new file mode 100644
index 0000000..0c0337d
--- /dev/null
+++ b/src/hooks/admin/useCircuitActionToolbar.js
@@ -0,0 +1,155 @@
+import { useNavigate } from "react-router-dom";
+import createConstant from "../../constants/admin/createConstant";
+import { getDestinationsApi } from "../../api/admin/destinations";
+import { findByIdCircuitApi, findCircuitEnumsApi } from "../../api/admin/circuit";
+import { findAllTags } from "../../api/admin/tag";
+import { findAllPoisApi } from "../../api/admin/poiApi";
+
+// Chaque champ à options va chercher les siennes ici, par son nom. Les
+// référentiels de la fiche technique viennent des enums du back : le
+// formulaire n'en recopie aucun, et ajouter une langue ou un moyen de
+// transport ne se fait donc qu'à un seul endroit.
+const buildFields = (destinationOptions, enums, tagOptions, poiOptions) => {
+    const optionsParChamp = {
+        styleVoyage:    enums?.styles ?? [],
+        niveauPhysique: enums?.niveaux ?? [],
+        langues:        enums?.langues ?? [],
+        transports:     enums?.transports ?? [],
+        tagIds:         tagOptions,
+        inclusions:     enums?.categoriesInclusion ?? [],
+    };
+
+    return createConstant.circuits.map(group =>
+        group.map(field => {
+            // Le programme ne prend pas une liste d'options : il lui faut les
+            // lieux, les points d'interet et les moyens de transport.
+            if (field.type === "programme") {
+                return {
+                    ...field,
+                    destinations: destinationOptions,
+                    pois: poiOptions,
+                    transports: enums?.transports ?? [],
+                };
+            }
+            return optionsParChamp[field.name]
+                ? { ...field, options: optionsParChamp[field.name] }
+                : field;
+        })
+    );
+};
+
+// `sousTitre` : la ligne grise de la recherche. Deux lieux peuvent porter des
+// noms proches — ses etiquettes et sa note disent lequel on regarde.
+const toDestinationOptions = (destinations) =>
+    (destinations ?? []).map(p => ({
+        label: p.name || p.nom,
+        value: p.id,
+        sousTitre: [
+            (p.tags ?? []).slice(0, 3).join(", "),
+            p.stars ? "\u2605".repeat(p.stars) : null,
+        ].filter(Boolean).join(" \u00b7 "),
+    }));
+
+const toTagOptions = (tags) =>
+    (tags ?? []).map(t => ({ label: t.name || t.nom, value: t.id }));
+
+// Les POI, a plat : le champ du programme les range lui-meme par destination
+// pour ne proposer, chaque journee, que ceux des lieux qu'elle traverse.
+const toPoiOptions = (pois) =>
+    (pois ?? []).map(p => ({
+        id: p.id,
+        nom: p.nom,
+        destinationId: p.destinationId,
+        destinationNom: p.destinationNom,
+        categorie: p.categoryPoi?.name ?? null,
+        isHebergement: Boolean(p.categoryPoi?.isHebergement),
+    }));
+
+// Les trois référentiels arrivent ensemble : en série, le bouton « créer »
+// resterait sans réponse le temps de trois allers-retours.
+export const chargerReferentielsCircuit = async () => {
+    const [destinationRes, enumsRes, tagsRes, poisRes] = await Promise.all([
+        getDestinationsApi(),
+        findCircuitEnumsApi(),
+        findAllTags(),
+        findAllPoisApi(),
+    ]);
+    return buildFields(
+        toDestinationOptions(destinationRes?.data),
+        enumsRes?.data,
+        toTagOptions(tagsRes?.data),
+        toPoiOptions(poisRes?.data),
+    );
+};
+
+// Le formulaire d'un circuit existant : champs et valeurs, en un appel.
+export const chargerFormulaireCircuit = async (id) => {
+    const [fields, circuitRes] = await Promise.all([
+        chargerReferentielsCircuit(),
+        findByIdCircuitApi(id),
+    ]);
+    const circuit = circuitRes.data.data;
+
+    // La réponse porte déjà les noms de champs du formulaire
+    // (styleVoyage, ageMin, langues, tagIds, inclusions…) : le spread
+    // suffit, et seules les valeurs d'une autre forme sont reprises.
+    const values = {
+        ...circuit,
+        imageUrls: circuit.imageUrls ?? [],   // ← URLs déjà en ligne : le champ image les affiche telles quelles
+        videoUrl: circuit.videoUrl ?? "",
+        // Le programme, relu tel que l'ecran va le reposer. Les noms de champs
+        // sont ceux de la requete : rien a traduire.
+        days: (circuit.days ?? []).map(j => ({
+            lieux: (j.lieux ?? []).map(l => ({
+                destinationId: l.destinationId ?? "",
+                note: l.note ?? "",
+            })),
+            titre: j.titre ?? "",
+            description: j.description ?? "",
+            notes: j.notes ?? "",
+            transport: j.transport ?? "",
+            hebergementId: j.hebergementId ?? "",
+            alternativeIds: j.alternativeIds ?? [],
+            visites: (j.visites ?? []).map(v => ({
+                poiId: v.poiId ?? "",
+                inclus: v.inclus !== false,
+                note: v.note ?? "",
+            })),
+            petitDejeuner: Boolean(j.petitDejeuner),
+            dejeuner: Boolean(j.dejeuner),
+            diner: Boolean(j.diner),
+        })),
+    };
+    return { fields, values };
+};
+
+export function useCircuitActionToolbar() {
+    const navigate = useNavigate();
+
+    const handleCreate = async () => {
+        try {
+            navigate("/admin/haodygasikara/circuits/create", {
+                state: { fields: await chargerReferentielsCircuit() },
+            });
+        } catch (error) {
+            console.error("Erreur chargement des référentiels du circuit :", error);
+        }
+    };
+
+    const handleEdit = async (id) => {
+        try {
+            navigate(`/admin/haodygasikara/circuits/edit/${id}`, {
+                state: await chargerFormulaireCircuit(id),
+            });
+        } catch (error) {
+            console.error("Erreur chargement du circuit :", error);
+        }
+    };
+
+    const actions = {
+        create: handleCreate,
+        edit: handleEdit,
+    };
+
+    return { actions };
+}
