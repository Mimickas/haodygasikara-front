--- /dev/null
+++ b/src/hooks/client/devis/useDemandeVivante.js
@@ -0,0 +1,29 @@
+import { useEffect, useState } from "react";
+import { findMesDevisApi } from "../../../api/client/devisApi";
+import { useAuth } from "../../useAuth";
+import { estDemandeVivante } from "../../../constants/client/devis";
+
+// La demande de devis « vivante » du voyageur pour un circuit, s'il en a une :
+// à l'étude, devis reçu ou accepté. La fiche du circuit et la page de demande
+// s'en servent pour ne pas proposer « Demander un devis » une seconde fois.
+// Null pour un visiteur, ou tant que la liste n'est pas arrivée.
+
+export function useDemandeVivante(circuitId) {
+    const { isAuthenticated } = useAuth();
+    const [demande, setDemande] = useState(null);
+
+    useEffect(() => {
+        if (!isAuthenticated || !circuitId) { setDemande(null); return undefined; }
+        let vivant = true;
+        findMesDevisApi()
+            .then((r) => {
+                if (!vivant) return;
+                const liste = r?.data ?? [];
+                setDemande(liste.find((d) => String(d.circuit?.id) === String(circuitId) && estDemandeVivante(d.statutAffiche)) ?? null);
+            })
+            .catch(() => { if (vivant) setDemande(null); });
+        return () => { vivant = false; };
+    }, [isAuthenticated, circuitId]);
+
+    return demande;
+}
diff --git a/src/hooks/design/animations/circuit/useCircuitDetailAnimations.js b/src/hooks/design/animations/circuit/useCircuitDetailAnimations.js
new file mode 100644
index 0000000..d498a25
--- /dev/null
+++ b/src/hooks/design/animations/circuit/useCircuitDetailAnimations.js
@@ -0,0 +1,191 @@
+import { useEffect } from "react";
+import gsap from "gsap";
+import { ScrollTrigger } from "gsap/ScrollTrigger";
+
+gsap.registerPlugin(ScrollTrigger);
+
+// ── Les animations de la fiche circuit ────────────────────────────────────
+//
+// ── La règle qui tient tout le fichier ───────────────────────────────────
+// CE HOOK NE CHANGE AUCUN DESSIN. Il n'ajoute pas un élément, n'en déplace
+// aucun, ne touche ni une couleur ni une taille. Il ne fait bouger que deux
+// propriétés — `opacity` et `transform` — celles que le compositeur traite
+// seul, sans refaire la mise en page.
+//
+// Et il se branche sur les classes QUI EXISTENT DÉJÀ. Aucun `data-` à semer
+// dans les composants, donc aucun fichier de section modifié : le jour où on
+// veut retirer toute la chorégraphie, on retire cet appel et il ne reste rien.
+//
+// `clearProps` à la fin de chaque entrée est ce qui garantit la promesse : une
+// fois l'animation jouée, GSAP retire ses styles en ligne et l'élément revient
+// exactement à ce que la feuille de style dit de lui.
+//
+// ── Le parti pris ────────────────────────────────────────────────────────
+// Rien ne clignote, rien ne rebondit, rien ne tourne. Tout monte de quelques
+// dizaines de pixels en se révélant, sur une courbe qui décélère franchement
+// (expo/power3). C'est le seul geste, décliné : c'est ce qui fait qu'une page
+// paraît chère plutôt qu'animée.
+//
+// Deux temps :
+//   1. L'OUVERTURE du héro, au chargement — le nom, la ligne de méta, le
+//      filet qui se tire, la bande qui se pose.
+//   2. LA RÉVÉLATION au défilement, section par section, une seule fois.
+//
+// Plus une parallaxe très courte sur le héro : la photo descend moins vite que
+// la page. C'est ce qui donne la profondeur, et ça ne coûte qu'un transform.
+
+/** Les gens qui ont demandé moins de mouvement en reçoivent zéro. */
+const SOBRE = () =>
+    window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+export function useCircuitDetailAnimations(pret) {
+    useEffect(() => {
+        // Le circuit arrive après un aller-retour réseau : avant lui, la page
+        // est vide et il n'y a rien à animer.
+        if (!pret || SOBRE()) return;
+
+        // Un cran de retard sur la peinture : sans lui, ScrollTrigger mesure
+        // des sections dont les images n'ont pas encore de hauteur, et place
+        // ses déclencheurs au mauvais endroit.
+        const contexte = gsap.context(() => {
+            const vise = (selecteur) => {
+                const trouves = gsap.utils.toArray(selecteur);
+                return trouves.length ? trouves : null;
+            };
+
+            // ── 1. L'ouverture du héro ──────────────────────────────────
+            const titre = vise("[data-hero-titre]");
+            const meta = vise("[data-hero-meta]");
+            const filet = vise("[data-hero-filet]");
+            const vignettes = vise("[data-hero-vignette]");
+            const media = vise("[data-hero-media]");
+
+            const ouverture = gsap.timeline();
+
+            // La photo entre plus large que son cadre et se pose. Le mouvement
+            // se lit sans qu'on voie jamais de bord vide.
+            if (media) {
+                ouverture.from(media, {
+                    scale: 1.08,
+                    duration: 1.9,
+                    ease: "expo.out",
+                    clearProps: "transform",
+                }, 0);
+            }
+
+            if (titre) {
+                ouverture.from(titre, {
+                    yPercent: 18,
+                    opacity: 0,
+                    duration: 1.25,
+                    ease: "expo.out",
+                    clearProps: "transform,opacity",
+                }, 0.15);
+            }
+
+            if (meta) {
+                ouverture.from(meta, {
+                    y: 24,
+                    opacity: 0,
+                    duration: 1,
+                    ease: "power3.out",
+                    clearProps: "transform,opacity",
+                }, 0.32);
+            }
+
+            // Le filet se tire de la gauche : il ne s'allume pas, il se trace.
+            if (filet) {
+                ouverture.from(filet, {
+                    scaleX: 0,
+                    transformOrigin: "left center",
+                    duration: 1.1,
+                    ease: "expo.out",
+                    clearProps: "transform",
+                }, 0.38);
+            }
+
+            if (vignettes) {
+                ouverture.from(vignettes, {
+                    y: 26,
+                    opacity: 0,
+                    duration: 0.85,
+                    stagger: 0.07,
+                    ease: "power3.out",
+                    clearProps: "transform,opacity",
+                }, 0.55);
+            }
+
+            // ── La parallaxe du héro ────────────────────────────────────
+            // La photo descend moins vite que la page. Court — 8 % — parce
+            // qu'au-delà on voit le bord du cadre arriver.
+            const hero = document.querySelector("[data-header-text] .relative");
+            if (media && hero) {
+                gsap.to(media, {
+                    yPercent: 8,
+                    ease: "none",
+                    scrollTrigger: {
+                        trigger: hero,
+                        start: "top top",
+                        end: "bottom top",
+                        scrub: true,
+                    },
+                });
+            }
+
+            // ── 2. La révélation au défilement ──────────────────────────
+            // Une seule fois : une section qui rejoue son entrée à chaque
+            // passage donne le mal de mer et fait bon marché.
+            const monte = (selecteur, options = {}) => {
+                const cibles = vise(selecteur);
+                if (!cibles) return;
+                gsap.from(cibles, {
+                    y: options.y ?? 34,
+                    opacity: 0,
+                    duration: options.duration ?? 1,
+                    stagger: options.stagger ?? 0.08,
+                    ease: "power3.out",
+                    clearProps: "transform,opacity",
+                    scrollTrigger: {
+                        trigger: options.trigger ?? cibles[0],
+                        start: options.start ?? "top 88%",
+                        once: true,
+                    },
+                });
+            };
+
+            // Chaque section monte D'UN BLOC quand le déclencheur est sa
+            // propre en-tête : sinon le titre s'anime, puis le texte se
+            // redéclenche trois lignes plus bas, et la page tressaute.
+            document.querySelectorAll(".cx-tete").forEach((tete) => {
+                gsap.from(tete.children, {
+                    y: 34,
+                    opacity: 0,
+                    duration: 1,
+                    stagger: 0.09,
+                    ease: "power3.out",
+                    clearProps: "transform,opacity",
+                    scrollTrigger: { trigger: tete, start: "top 88%", once: true },
+                });
+            });
+
+            // « Le voyage » — la planche photo, la fiche, les volets
+            monte(".cx-voyage__cadre", { y: 44, duration: 1.2, stagger: 0.12 });
+            monte(".cx-specs .cx-mention", { y: 28, stagger: 0.06 });
+            monte(".cx-compte > div", { y: 26, stagger: 0.07 });
+            monte(".cx-depliant", { y: 24, stagger: 0.07 });
+            monte(".cx-devis", { y: 24 });
+            monte(".cx-themes", { y: 20 });
+
+            // L'itinéraire — son en-tête est une .cx-tete (animée plus haut),
+            // puis les haltes une à une
+            monte(".cx-leg", { y: 36, stagger: 0.09, start: "top 92%" });
+
+            // Les images arrivent après coup et changent les hauteurs : sans
+            // ce recalage, les déclencheurs des sections basses sont posés sur
+            // des positions périmées et se jouent trop tôt — ou jamais.
+            ScrollTrigger.refresh();
+        });
+
+        return () => contexte.revert();
+    }, [pret]);
+}
diff --git a/src/hooks/design/animations/circuit/useCircuitHero.js b/src/hooks/design/animations/circuit/useCircuitHero.js
new file mode 100644
index 0000000..eb26cda
--- /dev/null
+++ b/src/hooks/design/animations/circuit/useCircuitHero.js
@@ -0,0 +1,62 @@
+import { useRef } from "react";
+import gsap from "gsap";
+import { useGSAP } from "@gsap/react";
+import { ScrollTrigger } from "gsap/ScrollTrigger";
+
+gsap.registerPlugin(useGSAP, ScrollTrigger);
+
+// Ouverture de la page circuits, commune aux deux variantes d'accroche.
+// 1. un rideau se lève panneau par panneau
+// 2. l'image se pose en zoom arrière, le titre monte ligne par ligne,
+//    le texte apparait mot par mot, la flèche suit
+// 3. au scroll, image et contenu partent à des vitesses différentes
+export function useCircuitHero() {
+    const scopeRef = useRef(null);
+
+    useGSAP(() => {
+        const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
+
+        tl.to("[data-curtain]", {
+            yPercent: -101,
+            duration: 1.15,
+            stagger: 0.075,
+            ease: "power4.inOut",
+        }, 0.15)
+            .set("[data-curtain-wrap]", { display: "none" })
+
+            .fromTo("[data-hero-media]",
+                { scale: 1.25 },
+                { scale: 1, duration: 2.6, ease: "power2.out" },
+                0.35
+            )
+
+            .from("[data-hero-kicker]", { yPercent: 110, duration: 1 }, 0.95)
+            .from("[data-hero-line]", { yPercent: 115, duration: 1.25, stagger: 0.1 }, 1.05)
+            .from("[data-hero-word]", { opacity: 0, y: 22, duration: 0.75, stagger: 0.022 }, 1.55)
+            .from("[data-hero-cue]", { opacity: 0, y: 20, duration: 0.9 }, 1.95);
+
+        // Variante claire seulement : le panneau image s'ouvre depuis la droite
+        const panel = scopeRef.current?.querySelector("[data-hero-panel]");
+        if (panel) {
+            tl.fromTo(panel,
+                { clipPath: "inset(0% 0% 0% 100%)" },
+                { clipPath: "inset(0% 0% 0% 0%)", duration: 1.5, ease: "expo.out" },
+                0.5
+            );
+        }
+
+        // Parallaxe de sortie : l'image traine, le contenu s'efface
+        const drift = {
+            trigger: scopeRef.current,
+            start: "top top",
+            end: "bottom top",
+            scrub: 0.8,
+            invalidateOnRefresh: true,
+        };
+
+        gsap.to("[data-hero-media]", { yPercent: 16, ease: "none", scrollTrigger: drift });
+        gsap.to("[data-hero-content]", { yPercent: -12, opacity: 0, ease: "none", scrollTrigger: { ...drift } });
+    }, { scope: scopeRef });
+
+    return scopeRef;
+}
diff --git a/src/hooks/design/animations/composer/useComposerIntro.js b/src/hooks/design/animations/composer/useComposerIntro.js
new file mode 100644
index 0000000..68553e6
--- /dev/null
+++ b/src/hooks/design/animations/composer/useComposerIntro.js
@@ -0,0 +1,71 @@
+import { useRef } from "react";
+import gsap from "gsap";
+import { useGSAP } from "@gsap/react";
+
+gsap.registerPlugin(useGSAP);
+
+const SOBRE = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+// Ouverture du créateur, dans la grammaire de l'accueil et de /circuit :
+//   1. le rideau de sable se lève, panneau par panneau ;
+//   2. les sur-titres et le nom du voyage montent de sous leur cadre, comme
+//      les lignes du titre de l'accueil ;
+//   3. les réglages, puis les étapes, se posent l'un après l'autre.
+// Les photographies du catalogue ont leur propre révélation (useGalerieVivante),
+// calée sur le même tempo.
+//
+// La timeline ne part qu'une fois le circuit ET le catalogue chargés : lancée
+// plus tôt, elle se jouerait derrière le rideau et personne ne la verrait.
+// Elle ne se rejoue pas ensuite — un enregistrement qui fait passer de
+// /composer à /composer/12 garde le même écran.
+export function useComposerIntro(pret) {
+    const scopeRef = useRef(null);
+    const jouee = useRef(false);
+
+    useGSAP(() => {
+        const scope = scopeRef.current;
+        if (!pret || jouee.current || !scope) return;
+        jouee.current = true;
+
+        const rideau = scope.querySelector("[data-cp-rideau]");
+        if (SOBRE()) {
+            if (rideau) rideau.style.display = "none";
+            return;
+        }
+
+        // Viser un sélecteur vide ferait crier GSAP dans la console.
+        const cibles = (selecteur) => {
+            const trouves = scope.querySelectorAll(selecteur);
+            return trouves.length ? trouves : null;
+        };
+
+        const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
+
+        // Comme le voile de l'accueil : le mot d'attente s'efface vers le
+        // haut, puis les panneaux se lèvent l'un après l'autre.
+        if (rideau) {
+            const attente = rideau.querySelector("[data-cp-attente]");
+            if (attente) tl.to(attente, { y: -22, opacity: 0, duration: 0.45, ease: "power2.in" }, 0);
+            tl.to(rideau.querySelectorAll("[data-cp-panneau]"), { yPercent: -101, duration: 1, stagger: 0.06, ease: "power4.inOut" }, 0.2)
+                .set(rideau, { display: "none" });
+        }
+
+        const surtitres = cibles("[data-cp-kicker]");
+        const titre = cibles("[data-cp-titre]");
+        const vues = cibles("[data-cp-vue]");
+        const reglages = cibles("[data-cp-apparait]");
+        const etapes = cibles("[data-cp-etape]");
+
+        if (surtitres) tl.from(surtitres, { yPercent: 110, duration: 1, stagger: 0.06, clearProps: "transform" }, 0.7);
+        if (titre) tl.from(titre, { yPercent: 105, duration: 1.3, clearProps: "transform" }, 0.78);
+        if (vues) tl.from(vues, { yPercent: 110, duration: 1.2, stagger: 0.08, clearProps: "transform" }, 0.82);
+        if (reglages) {
+            tl.from(reglages, { y: 24, opacity: 0, duration: 0.9, stagger: 0.07, ease: "power3.out", clearProps: "transform,opacity" }, 1.05);
+        }
+        if (etapes) {
+            tl.from(etapes, { y: 28, opacity: 0, duration: 0.9, stagger: 0.06, ease: "power3.out", clearProps: "transform,opacity" }, 1.15);
+        }
+    }, { scope: scopeRef, dependencies: [pret] });
+
+    return scopeRef;
+}
diff --git a/src/hooks/design/animations/composer/useEnvolEtape.js b/src/hooks/design/animations/composer/useEnvolEtape.js
new file mode 100644
index 0000000..7dbb895
--- /dev/null
+++ b/src/hooks/design/animations/composer/useEnvolEtape.js
@@ -0,0 +1,62 @@
+import { useCallback, useMemo, useRef } from "react";
+import gsap from "gsap";
+
+// Ajout par « + » : la photo de la destination quitte sa carte et vole
+// jusqu'au numéro de la nouvelle étape, où elle se fond. Le geste relie les
+// deux moitiés de l'écran — on voit OÙ l'étape est allée, sans le lire.
+//
+// Deux temps, parce que la cible n'existe pas encore au moment du clic :
+//   * preparer(photo) note le cadre de départ au clic ;
+//   * lancer(numero) part quand la ligne de l'itinéraire est dans le DOM
+//     (appelé par l'itinéraire à l'entrée de la ligne).
+// Une préparation vieille de plus d'une seconde et demie est oubliée : elle
+// ne correspond plus à rien de ce que l'on voit.
+
+const PEREMPTION_MS = 1500;
+const SOBRE = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+export function useEnvolEtape() {
+    const enAttente = useRef(null);
+
+    const preparer = useCallback((photo, image) => {
+        enAttente.current = photo && image
+            ? { cadre: photo.getBoundingClientRect(), image, le: Date.now() }
+            : null;
+    }, []);
+
+    /** @returns {boolean} vrai si un envol a été lancé (la ligne peut alors attendre qu'il arrive). */
+    const lancer = useCallback((cible) => {
+        const depart = enAttente.current;
+        enAttente.current = null;
+        if (!depart || !cible || Date.now() - depart.le > PEREMPTION_MS || SOBRE()) return false;
+
+        const arrivee = cible.getBoundingClientRect();
+        // Itinéraire masqué (onglets du téléphone) : rien vers où voler.
+        if (!arrivee.width || !arrivee.height) return false;
+
+        const vol = document.createElement("div");
+        vol.className = "cx-cp-envol";
+        vol.style.backgroundImage = `url("${encodeURI(depart.image)}")`;
+        Object.assign(vol.style, {
+            left: `${depart.cadre.left}px`,
+            top: `${depart.cadre.top}px`,
+            width: `${depart.cadre.width}px`,
+            height: `${depart.cadre.height}px`,
+        });
+        document.body.appendChild(vol);
+
+        gsap.timeline({ onComplete: () => vol.remove() })
+            .to(vol, {
+                left: arrivee.left,
+                top: arrivee.top,
+                width: arrivee.width,
+                height: arrivee.height,
+                duration: 0.9,
+                ease: "power3.inOut",
+            })
+            .to(vol, { opacity: 0, duration: 0.35, ease: "power2.out" }, "-=0.12");
+        return true;
+    }, []);
+
+    return useMemo(() => ({ preparer, lancer }), [preparer, lancer]);
+}
diff --git a/src/hooks/design/animations/composer/useGalerieVivante.js b/src/hooks/design/animations/composer/useGalerieVivante.js
new file mode 100644
index 0000000..6328c2a
--- /dev/null
+++ b/src/hooks/design/animations/composer/useGalerieVivante.js
@@ -0,0 +1,83 @@
+import { useEffect, useLayoutEffect, useRef } from "react";
+import gsap from "gsap";
+import { Flip } from "gsap/Flip";
+
+gsap.registerPlugin(Flip);
+
+const SOBRE = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+// ── La galerie des destinations, en mouvement ──────────────────────────────
+//
+//   * PREMIÈRE APPARITION : chaque photo se découvre de bas en haut
+//     (clip-path) pendant qu'elle se pose en zoom arrière — les cadres de
+//     l'accueil, en plus court. Le départ attend la levée du rideau.
+//   * ENSUITE : l'ordre change souvent (la pertinence dépend de la dernière
+//     étape, un filtre retire des cartes). GSAP Flip fait glisser chaque carte
+//     de son ancienne place à la nouvelle ; celles qui arrivent montent en
+//     fondu. Rien ne saute.
+//
+// Flip compare deux photographies des positions. La précédente est reprise à
+// chaque défilement de la galerie : prise avant, elle ferait partir les cartes
+// de là où elles étaient AVANT que l'on fasse défiler.
+
+export function useGalerieVivante({ defileRef, grilleRef, cle, pret }) {
+    const etat = useRef(null);
+    const premiere = useRef(true);
+
+    useEffect(() => {
+        const defile = defileRef.current;
+        if (!defile) return undefined;
+        let raf = null;
+        const capturer = () => {
+            raf = null;
+            const cartes = grilleRef.current?.querySelectorAll("[data-cp-carte]");
+            if (cartes?.length) etat.current = Flip.getState(cartes);
+        };
+        const programmer = () => { if (!raf) raf = requestAnimationFrame(capturer); };
+        defile.addEventListener("scroll", programmer, { passive: true });
+        window.addEventListener("resize", programmer);
+        return () => {
+            defile.removeEventListener("scroll", programmer);
+            window.removeEventListener("resize", programmer);
+            if (raf) cancelAnimationFrame(raf);
+        };
+    }, [defileRef, grilleRef]);
+
+    useLayoutEffect(() => {
+        const grille = grilleRef.current;
+        if (!pret || !grille) return;
+        const cartes = grille.querySelectorAll("[data-cp-carte]");
+        if (!cartes.length) {
+            etat.current = null;
+            return;
+        }
+
+        if (!SOBRE()) {
+            if (premiere.current) {
+                const photos = grille.querySelectorAll("[data-cp-carte] img");
+                gsap.fromTo(cartes,
+                    { clipPath: "inset(100% 0% 0% 0%)" },
+                    { clipPath: "inset(0% 0% 0% 0%)", duration: 1.3, ease: "power4.out", stagger: 0.08, delay: 0.7, clearProps: "clipPath" });
+                if (photos.length) {
+                    gsap.fromTo(photos,
+                        { scale: 1.3 },
+                        { scale: 1, duration: 2, ease: "power2.out", stagger: 0.08, delay: 0.7, clearProps: "transform" });
+                }
+            } else if (etat.current) {
+                Flip.from(etat.current, {
+                    targets: cartes,
+                    duration: 0.85,
+                    ease: "power3.inOut",
+                    absolute: false,
+                    clearProps: "transform",
+                    onEnter: (entrees) => gsap.fromTo(entrees,
+                        { opacity: 0, y: 36 },
+                        { opacity: 1, y: 0, duration: 0.9, ease: "power3.out", stagger: 0.05, clearProps: "transform,opacity" }),
+                });
+            }
+        }
+        premiere.current = false;
+        etat.current = Flip.getState(cartes);
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [cle, pret]);
+}
diff --git a/src/hooks/design/animations/compte/useCompteHero.js b/src/hooks/design/animations/compte/useCompteHero.js
new file mode 100644
index 0000000..d0d1ed0
--- /dev/null
+++ b/src/hooks/design/animations/compte/useCompteHero.js
@@ -0,0 +1,98 @@
+import { useEffect } from "react";
+import gsap from "gsap";
+
+// ── L'ouverture du hero de l'espace voyageur ──────────────────────────────
+//
+// Le même geste que l'accueil et que la fiche circuit, décliné : la photo se
+// pose depuis une échelle légèrement supérieure, l'accroche et le nom montent
+// de sous leur masque, le filet se TRACE depuis la gauche — il ne s'allume pas
+// — puis le pied se pose.
+//
+// Deux règles, comme partout ailleurs dans le projet :
+//   • on ne fait bouger qu'`opacity` et `transform`, les deux propriétés que le
+//     compositeur traite seul, sans refaire la mise en page ;
+//   • `clearProps` à la fin, donc l'écran au repos est exactement celui que la
+//     feuille de style décrit. Retirer cet appel retire toute la chorégraphie,
+//     et il ne reste rien.
+//
+// Pas de ScrollTrigger ici : ce hero est au-dessus de la ligne de flottaison,
+// il se joue au chargement. Un déclencheur au défilement ne partirait jamais.
+
+const SOBRE = () =>
+    window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+
+/** @param {boolean} pret false tant que le compte n'est pas chargé. */
+export function useCompteHero(pret) {
+    useEffect(() => {
+        if (!pret || SOBRE()) return;
+
+        const contexte = gsap.context(() => {
+            const vise = (s) => {
+                const trouves = gsap.utils.toArray(s);
+                return trouves.length ? trouves : null;
+            };
+
+            const media = vise("[data-compte-media]");
+            const kicker = vise("[data-compte-kicker]");
+            const lignes = vise("[data-compte-ligne]");
+            const filet = vise("[data-compte-filet]");
+            const pied = vise("[data-compte-pied]");
+
+            const ouverture = gsap.timeline();
+
+            if (media) {
+                ouverture.from(media, {
+                    scale: 1.08,
+                    duration: 1.9,
+                    ease: "expo.out",
+                    clearProps: "transform",
+                }, 0);
+            }
+
+            if (kicker) {
+                ouverture.from(kicker, {
+                    y: 18,
+                    opacity: 0,
+                    duration: 0.9,
+                    ease: "power3.out",
+                    clearProps: "transform,opacity",
+                }, 0.15);
+            }
+
+            // yPercent et non y : chaque ligne monte de SA propre hauteur,
+            // quelle que soit la taille du corps à cette largeur d'écran.
+            if (lignes) {
+                ouverture.from(lignes, {
+                    yPercent: 105,
+                    duration: 1.15,
+                    stagger: 0.08,
+                    ease: "expo.out",
+                    clearProps: "transform",
+                }, 0.22);
+            }
+
+            if (filet) {
+                ouverture.from(filet, {
+                    scaleX: 0,
+                    transformOrigin: "left center",
+                    duration: 1.1,
+                    ease: "expo.out",
+                    clearProps: "transform",
+                }, 0.5);
+            }
+
+            if (pied) {
+                ouverture.from(pied, {
+                    y: 24,
+                    opacity: 0,
+                    duration: 0.95,
+                    stagger: 0.1,
+                    ease: "power3.out",
+                    clearProps: "transform,opacity",
+                }, 0.62);
+            }
+        });
+
+        return () => contexte.revert();
+    }, [pret]);
+}
diff --git a/src/hooks/design/animations/home/firstHero.js b/src/hooks/design/animations/home/firstHero.js
