index 0000000..891b51c
--- /dev/null
+++ b/src/pages/admin/circuitsVoyageurs/CircuitsVoyageurs.jsx
@@ -0,0 +1,291 @@
+import { useEffect, useMemo, useState } from "react";
+import { Link, useSearchParams } from "react-router-dom";
+import { findCircuitsVoyageursApi, findCircuitVoyageurApi } from "../../../api/admin/circuitsVoyageursApi";
+import KpiCard from "../../../components/admin/shared/kpiCard/KpiCard";
+import DataTable from "../../../components/admin/ui/tableau/DataTable";
+import Toolbar from "../../../components/admin/ui/toolbar/Toolbar";
+import BandeauErreur from "../../../components/admin/ui/erreur/BandeauErreur";
+import { parDate, parNombre, parTexte, useListeAdmin } from "../../../hooks/admin/useListeAdmin";
+import { FaCalendarDays } from "react-icons/fa6";
+import { formatDate, formatDateCourte } from "../../../utils/format";
+import { apiErrorMessage } from "../../../utils/apiError";
+import { libelleStatutDevis } from "../../../constants/client/devis";
+
+// ── Les circuits des voyageurs — /admin/haodygasikara/circuits-voyageurs ──
+//
+// Ce que les voyageurs composent dans le créateur, en LECTURE SEULE : le
+// voyage appartient à son auteur. L'agence y lit l'itinéraire avant de
+// chiffrer un devis, et ce qui se compose le plus.
+//
+// Filtres : l'état du voyage (brouillon, finalisé, devis en cours), la
+// période (à venir, passé, dates libres) et une recherche sur le voyageur,
+// le nom du voyage ou une destination. ?voyageur=ID restreint à un compte,
+// ?circuit=ID ouvre directement un voyage.
+
+const B = "/admin/haodygasikara";
+
+const ETATS = [
+    { cle: "TOUS",       libelle: "Tous",               garde: () => true },
+    { cle: "BROUILLON",  libelle: "Brouillons",         garde: (c) => c.statut === "BROUILLON" },
+    { cle: "FINALISE",   libelle: "Finalisés",          garde: (c) => c.statut === "FINALISE" },
+    { cle: "DEVIS",      libelle: "Devis en cours",     garde: (c) => Boolean(c.devis?.vivant) },
+];
+
+const PERIODES = [
+    { cle: "TOUTES",   libelle: "Toutes les dates" },
+    { cle: "AVENIR",   libelle: "Départ à venir" },
+    { cle: "PASSE",    libelle: "Voyage passé" },
+    { cle: "LIBRES",   libelle: "Dates non fixées" },
+];
+
+const aujourdhui = () => new Date().toISOString().slice(0, 10);
+
+const dansPeriode = (c, periode) => {
+    if (periode === "LIBRES") return !c.dateArrivee;
+    if (periode === "AVENIR") return Boolean(c.dateArrivee) && c.dateArrivee >= aujourdhui();
+    if (periode === "PASSE") return Boolean(c.dateDepart ?? c.dateArrivee) && (c.dateDepart ?? c.dateArrivee) < aujourdhui();
+    return true;
+};
+
+const nomVoyageur = (v) => [v?.prenom, v?.nom].filter(Boolean).join(" ") || v?.email || "Voyageur";
+
+const dates = (arrivee, depart) => (arrivee
+    ? `${formatDateCourte(arrivee)}${depart ? ` → ${formatDateCourte(depart)}` : ""}`
+    : "Dates non fixées");
+
+const STATUT_VOYAGE = { BROUILLON: "Brouillon", FINALISE: "Finalisé" };
+
+const colonnes = [
+    { key: "nom", label: "Voyage", render: (val, row) => (
+        <span className="ad-cv-voyage">
+            <span className="font-body-strong">{val}</span>
+            <span className="ad-tb-muet">{row.destinations.join(" → ") || "Aucune étape"}</span>
+        </span>
+    ) },
+    { key: "voyageur",   label: "Voyageur", render: (val) => nomVoyageur(val), texte: (val) => nomVoyageur(val) },
+    { key: "etapes",     label: "Parcours", render: (val, row) => `${val} étape${val > 1 ? "s" : ""} · ${row.nuits} nuit${row.nuits > 1 ? "s" : ""}` },
+    { key: "dateArrivee", label: "Dates",   render: (val, row) => dates(val, row.dateDepart), texte: (val, row) => dates(val, row.dateDepart) },
+    { key: "statut",     label: "État",     render: (val) => (
+        <span className={`ad-dv-pastille ad-cv-pastille--${val}`}>{STATUT_VOYAGE[val] ?? val}</span>
+    ), texte: (val) => STATUT_VOYAGE[val] ?? val },
+    { key: "devis",      label: "Devis",    render: (val) => val
+        ? <span className={`ad-dv-pastille ad-dv-pastille--${val.statut}`}>{val.reference} · {libelleStatutDevis(val.statut)}</span>
+        : "—", texte: (val) => val ? `${val.reference} · ${libelleStatutDevis(val.statut)}` : "" },
+    { key: "updatedAt",  label: "Modifié le", render: (val) => formatDate(val) },
+];
+
+const TRIS = [
+    { cle: "RECENTS", libelle: "Modifiés récemment", comparer: parDate("updatedAt") },
+    { cle: "DEPART", libelle: "Départ le plus proche", comparer: parDate("dateArrivee", 1) },
+    { cle: "LONGS", libelle: "Plus longs", comparer: parNombre("nuits") },
+    { cle: "NOM", libelle: "Nom, de A à Z", comparer: parTexte("nom") },
+];
+
+export default function CircuitsVoyageurs() {
+    const [params, setParams] = useSearchParams();
+    const [circuits, setCircuits] = useState([]);
+    const [chargement, setChargement] = useState(true);
+    const [erreur, setErreur] = useState("");
+    const [periode, setPeriode] = useState("TOUTES");
+
+    const voyageurId = Number(params.get("voyageur")) || null;
+    const ouvertId = Number(params.get("circuit")) || null;
+
+    const majParam = (cle, valeur) => setParams((p) => {
+        const suite = new URLSearchParams(p);
+        if (valeur) suite.set(cle, valeur); else suite.delete(cle);
+        return suite;
+    }, { replace: true });
+
+    useEffect(() => {
+        findCircuitsVoyageursApi()
+            .then((r) => setCircuits(r?.data ?? []))
+            .catch((error) => setErreur(apiErrorMessage(error, "Les circuits des voyageurs n'ont pas pu être chargés.")))
+            .finally(() => setChargement(false));
+    }, []);
+
+    const kpiItems = useMemo(() => {
+        const voyageurs = new Set(circuits.map((c) => c.voyageur?.id)).size;
+        const finalises = circuits.filter((c) => c.statut === "FINALISE").length;
+        const avecDevis = circuits.filter((c) => c.devis).length;
+        const nuits = circuits.length ? Math.round(circuits.reduce((s, c) => s + c.nuits, 0) / circuits.length) : null;
+        return [
+            { label: "Voyages composés", value: circuits.length,
+                hint: `par ${voyageurs} voyageur${voyageurs > 1 ? "s" : ""}`, accent: "var(--brand-terre)" },
+            { label: "Finalisés", value: finalises,
+                hint: `${circuits.length - finalises} encore en brouillon`, accent: "var(--brand-nature)" },
+            { label: "Avec un devis", value: avecDevis,
+                hint: circuits.length ? `${Math.round(avecDevis * 100 / circuits.length)} % des voyages composés` : "aucun voyage composé",
+                accent: "var(--brand-ocre)" },
+            { label: "Durée moyenne", value: nuits == null ? "—" : `${nuits} nuit${nuits > 1 ? "s" : ""}`,
+                hint: "par voyage composé", accent: "var(--brand-lagune)" },
+        ];
+    }, [circuits]);
+
+    const voyageur = voyageurId ? circuits.find((c) => c.voyageur?.id === voyageurId)?.voyageur : null;
+    // Le compte (?voyageur=) et la période restreignent d'abord ; la barre fait le reste
+    const perimetre = useMemo(() => circuits
+        .filter((c) => !voyageurId || c.voyageur?.id === voyageurId)
+        .filter((c) => dansPeriode(c, periode)), [circuits, voyageurId, periode]);
+    const liste = useListeAdmin(perimetre, {
+        recherche: (c) => [c.nom, c.voyageur?.prenom, c.voyageur?.nom, c.voyageur?.email, ...c.destinations],
+        filtres: ETATS,
+        tris: TRIS,
+        export: { nom: "circuits-des-voyageurs", colonnes },
+    });
+
+    return <>
+        <Toolbar liste={liste} placeholder="Voyageur, voyage, destination…"
+            actions={[{ libelle: "Exporter", onClick: liste.exporter }]}
+            enPlus={
+                <label className="ad-barre__tri font-body-strong">
+                    <FaCalendarDays className="text-xs shrink-0" aria-hidden="true" />
+                    <select value={periode} onChange={(e) => setPeriode(e.target.value)} aria-label="Période du voyage">
+                        {PERIODES.map((p) => <option key={p.cle} value={p.cle}>{p.libelle}</option>)}
+                    </select>
+                </label>
+            } />
+
+        <BandeauErreur message={erreur} onFermer={() => setErreur("")} />
+        <KpiCard items={kpiItems} loading={chargement} />
+
+        {voyageurId && (
+            <p className="ad-cv-puce font-body">
+                Voyages de <span className="font-body-strong">{voyageur ? nomVoyageur(voyageur) : `compte n° ${voyageurId}`}</span>
+                <button type="button" onClick={() => majParam("voyageur", null)} aria-label="Retirer ce filtre">✕</button>
+            </p>
+        )}
+
+        <DataTable columns={colonnes} data={liste.lignes} loading={chargement} onRowClick={(c) => majParam("circuit", c.id)}
+            aucunResultat={liste.aucunResultat}
+            vide={{ titre: "Aucun voyage composé", texte: "Les voyages que les voyageurs composent dans le créateur apparaîtront ici." }} />
+
+        {ouvertId && <Voyage id={ouvertId} onFermer={() => majParam("circuit", null)} />}
+    </>;
+}
+
+// ── Le voyage ouvert sur le côté ──────────────────────────────────────────
+
+function Voyage({ id, onFermer }) {
+    const [detail, setDetail] = useState(null);
+    const [erreur, setErreur] = useState("");
+
+    useEffect(() => {
+        let actif = true;
+        setDetail(null);
+        setErreur("");
+        findCircuitVoyageurApi(id)
+            .then((r) => actif && setDetail(r?.data ?? null))
+            .catch((error) => actif && setErreur(apiErrorMessage(error, "Ce voyage n'a pas pu être chargé.")));
+        return () => { actif = false; };
+    }, [id]);
+
+    useEffect(() => {
+        const echap = (e) => { if (e.key === "Escape") onFermer(); };
+        window.addEventListener("keydown", echap);
+        return () => window.removeEventListener("keydown", echap);
+    }, [onFermer]);
+
+    const c = detail?.circuit;
+    const v = detail?.voyageur;
+    const nuits = c?.etapes?.reduce((s, e) => s + e.nuits, 0) ?? 0;
+    const messages = c?.coherence?.messages ?? [];
+
+    return (
+        <div className="ad-dv-voile" onClick={onFermer}>
+            <aside className="ad-dv-dossier" onClick={(e) => e.stopPropagation()} aria-label="Voyage du voyageur">
+                <header className="ad-dv-dossier__entete">
+                    <div>
+                        <p className="ad-dv-surtitre font-body-strong">
+                            {c ? `Voyage n° ${c.id} · modifié le ${formatDate(c.updatedAt)}` : "Chargement…"}
+                        </p>
+                        <h2 className="font-title ad-dv-dossier__titre">{c?.nom ?? " "}</h2>
+                        {c && <span className={`ad-dv-pastille ad-cv-pastille--${c.statut}`}>{STATUT_VOYAGE[c.statut] ?? c.statut}</span>}
+                    </div>
+                    <button type="button" className="ad-dv-fermer" onClick={onFermer} aria-label="Fermer">✕</button>
+                </header>
+
+                <div className="ad-dv-dossier__corps">
+                    {erreur && <p className="ad-erreur">{erreur}</p>}
+                    {!c && !erreur && <p className="ad-dv-muet font-body" style={{ padding: "20px 0" }}>Chargement du voyage…</p>}
+
+                    {c && <>
+                        <Bloc titre="Le voyageur">
+                            <p className="font-body-strong">{nomVoyageur(v)}</p>
+                            <p className="font-body"><a href={`mailto:${v?.email}`}>{v?.email}</a></p>
+                            {v?.telephone && <p className="font-body"><a href={`tel:${v.telephone}`}>{v.telephone}</a></p>}
+                            <Link to={`${B}/circuits-voyageurs?voyageur=${v?.id}`} className="ad-tb-lien font-body-strong" onClick={onFermer}>
+                                Tous ses voyages →
+                            </Link>
+                        </Bloc>
+
+                        <Bloc titre="Le voyage">
+                            <Ligne g="Arrivée" d={c.dateArrivee ? formatDateCourte(c.dateArrivee) : "Non fixée"} />
+                            <Ligne g="Départ" d={c.dateDepart ? formatDateCourte(c.dateDepart) : "Non fixé"} />
+                            <Ligne g="Durée" d={`${c.etapes.length} étape${c.etapes.length > 1 ? "s" : ""} · ${nuits} nuit${nuits > 1 ? "s" : ""}`} />
+                        </Bloc>
+
+                        <Bloc titre="L'itinéraire">
+                            {c.etapes.length === 0 ? <p className="ad-dv-muet font-body">Aucune étape pour l'instant.</p> : (
+                                <ol className="ad-cv-etapes">
+                                    {c.etapes.map((e) => (
+                                        <li key={e.position} className="ad-cv-etape">
+                                            <span className="ad-cv-etape__jours font-body-strong">J{e.jourDebut} → J{e.jourFin}</span>
+                                            <span className="ad-cv-etape__corps">
+                                                <span className="font-body-strong">{e.destination?.nom}</span>
+                                                <span className="ad-dv-muet font-body">
+                                                    {e.nuits} nuit{e.nuits > 1 ? "s" : ""}
+                                                    {e.kmDepuisPrecedente != null && ` · à ${Math.round(e.kmDepuisPrecedente)} km de l'étape précédente`}
+                                                </span>
+                                                {e.notes && <span className="font-body ad-dv-texte">« {e.notes} »</span>}
+                                            </span>
+                                        </li>
+                                    ))}
+                                </ol>
+                            )}
+                        </Bloc>
+
+                        {messages.length > 0 && (
+                            <Bloc titre="Cohérence">
+                                {messages.map((m, i) => (
+                                    <p key={i} className={`font-body ad-cv-message ad-cv-message--${m.niveau}`}>{m.texte}</p>
+                                ))}
+                            </Bloc>
+                        )}
+
+                        <Bloc titre="Demande de devis">
+                            {c.devis ? <>
+                                <Ligne g={c.devis.reference} d={libelleStatutDevis(c.devis.statut)} />
+                                <Link to={`${B}/devis?dossier=${c.devis.id}`} className="ad-tb-lien font-body-strong">Ouvrir le dossier →</Link>
+                            </> : (
+                                <p className="ad-dv-muet font-body">
+                                    {c.statut === "FINALISE"
+                                        ? "Voyage finalisé, pas encore de demande de devis."
+                                        : "Brouillon : le voyageur doit finaliser son voyage avant de demander un devis."}
+                                </p>
+                            )}
+                        </Bloc>
+                    </>}
+                </div>
+            </aside>
+        </div>
+    );
+}
+
+function Bloc({ titre, children }) {
+    return (
+        <section className="ad-dv-bloc">
+            <p className="ad-dv-surtitre font-body-strong">{titre}</p>
+            {children}
+        </section>
+    );
+}
+
+function Ligne({ g, d }) {
+    return (
+        <div className="ad-dv-ligne font-body">
+            <span>{g}</span>
+            <span>{d}</span>
+        </div>
+    );
+}
diff --git a/src/pages/admin/dashboard/Dashboard.jsx b/src/pages/admin/dashboard/Dashboard.jsx
new file mode 100644
index 0000000..8ff5fd5
--- /dev/null
+++ b/src/pages/admin/dashboard/Dashboard.jsx
@@ -0,0 +1,327 @@
+import { useEffect, useMemo, useState } from "react";
+import { Link } from "react-router-dom";
+import { findAllDemandesDevisApi, findStatsDevisApi } from "../../../api/admin/demandeDevisApi";
+import { findEfficaciteSuggestionsApi, recalculerAssociationsApi } from "../../../api/admin/suggestionsApi";
+import KpiCard from "../../../components/admin/shared/kpiCard/KpiCard";
+import { useAuthStore } from "../../../store/authStore";
+import { formatDate } from "../../../utils/format";
+import { apiErrorMessage } from "../../../utils/apiError";
+
+// ── Le tableau de bord — /admin/haodygasikara ─────────────────────────────
+//
+// Deux questions, dans cet ordre :
+//
+//   1. QUI ATTEND UNE RÉPONSE ? Les demandes de devis non traitées, les plus
+//      anciennes d'abord — la promesse faite au voyageur est de 48 h.
+//   2. LES SUGGESTIONS DU CRÉATEUR SERVENT-ELLES ? Sur ce que l'écran a
+//      montré, combien de destinations le voyageur a ajoutées, par source et
+//      par destination ; et les paires « souvent associées » du moment.
+
+const B = "/admin/haodygasikara";
+const HEURES_PROMESSE = 48;
+const A_TRAITER = ["ENVOYE", "EN_COURS"];
+
+// « il y a 3 h », « il y a 2 j » : l'âge d'une demande se lit mieux qu'une date.
+const depuis = (date) => {
+    const heures = Math.max(0, Math.floor((Date.now() - new Date(date).getTime()) / 3_600_000));
+    if (heures < 1) return "à l'instant";
+    if (heures < 48) return `il y a ${heures} h`;
+    return `il y a ${Math.floor(heures / 24)} j`;
+};
+
+const heuresDepuis = (date) => (Date.now() - new Date(date).getTime()) / 3_600_000;
+
+const pourcent = (taux) => (taux == null ? "—" : `${taux} %`);
+
+// « Bonjour », « Bonsoir » : l'écran s'ouvre sur la même phrase que la personne
+// qui entre dans le bureau.
+const salutation = () => {
+    const h = new Date().getHours();
+    if (h < 6) return "Bonne nuit";
+    if (h < 18) return "Bonjour";
+    return "Bonsoir";
+};
+
+export default function Dashboard() {
+    const { user } = useAuthStore();
+    const [stats, setStats] = useState(null);
+    const [devis, setDevis] = useState([]);
+    const [efficacite, setEfficacite] = useState(null);
+    const [chargement, setChargement] = useState(true);
+    const [erreur, setErreur] = useState("");
+
+    useEffect(() => {
+        let actif = true;
+        // Chaque bloc vit sa vie : une panne des suggestions ne doit pas
+        // masquer les devis à traiter.
+        Promise.allSettled([findStatsDevisApi(), findAllDemandesDevisApi(), findEfficaciteSuggestionsApi()])
+            .then(([s, d, e]) => {
+                if (!actif) return;
+                if (s.status === "fulfilled") setStats(s.value?.data ?? null);
+                if (d.status === "fulfilled") setDevis(d.value?.data ?? []);
+                if (e.status === "fulfilled") setEfficacite(e.value?.data ?? null);
+                const echec = [s, d, e].find((r) => r.status === "rejected");
+                if (echec) setErreur(apiErrorMessage(echec.reason, "Une partie du tableau de bord n'a pas pu être chargée."));
+            })
+            .finally(() => actif && setChargement(false));
+        return () => { actif = false; };
+    }, []);
+
+    const kpiItems = useMemo(() => [
+        {
+            label: "À traiter",
+            value: (stats?.aTraiter ?? 0) + (stats?.enCours ?? 0),
+            hint: `${stats?.aTraiter ?? 0} nouvelle${(stats?.aTraiter ?? 0) > 1 ? "s" : ""}, ${stats?.enCours ?? 0} à l'étude`,
+            accent: "var(--brand-terre)",
+        },
+        {
+            label: "Délai de réponse",
+            value: stats?.delaiMoyenHeures == null ? "—" : `${stats.delaiMoyenHeures} h`,
+            hint: stats?.delaiMoyenHeures == null ? "aucun devis encore proposé"
+                : stats.delaiMoyenHeures <= HEURES_PROMESSE ? "dans la promesse des 48 h" : "au-delà de la promesse des 48 h",
+            accent: "var(--brand-ocre)",
+        },
+        {
+            label: "Taux d'acceptation",
+            value: pourcent(stats?.tauxAcceptation),
+            hint: `${stats?.acceptes ?? 0} accepté${(stats?.acceptes ?? 0) > 1 ? "s" : ""} sur ${stats?.total ?? 0} demande${(stats?.total ?? 0) > 1 ? "s" : ""}`,
+            accent: "var(--brand-nature)",
+        },
+        {
+            label: "Suggestions ajoutées",
+            value: pourcent(efficacite?.taux),
+            hint: efficacite?.vues
+                ? `${efficacite.ajouts} ajout${efficacite.ajouts > 1 ? "s" : ""} sur ${efficacite.vues} suggestion${efficacite.vues > 1 ? "s" : ""} montrée${efficacite.vues > 1 ? "s" : ""}`
+                : "aucune suggestion encore montrée",
+            accent: "var(--brand-lagune)",
+        },
+    ], [stats, efficacite]);
+
+    // Les plus anciennes d'abord : c'est l'ordre de la promesse
+    const attente = useMemo(() => devis
+        .filter((d) => A_TRAITER.includes(d.statutAffiche))
+        .sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt))
+        .slice(0, 6), [devis]);
+
+    const enAttente = (stats?.aTraiter ?? 0) + (stats?.enCours ?? 0);
+
+    return <>
+        {/* L'écran s'ouvrait sur quatre chiffres, sans un mot pour dire ce
+            qu'on regarde. Une phrase d'abord : qui arrive, et ce qui l'attend. */}
+        <section className="ad-tb-accueil">
+            <h2 className="ad-tb-accueil__titre font-title">
+                {salutation()}{user?.prenom ? ` ${user.prenom}` : ""}.
+            </h2>
+            <p className="ad-tb-accueil__texte font-body">
+                {chargement
+                    ? "Lecture des demandes en cours…"
+                    : enAttente > 0
+                        ? `${enAttente} demande${enAttente > 1 ? "s" : ""} de devis attend${enAttente > 1 ? "ent" : ""} une réponse. La promesse faite au voyageur est de ${HEURES_PROMESSE} h.`
+                        : "Aucune demande en attente : les voyageurs ont tous eu leur réponse."}
+            </p>
+        </section>
+
+        <KpiCard items={kpiItems} loading={chargement} />
+
+        {erreur && <p className="ad-erreur" style={{ marginTop: 0, marginBottom: 24 }}>{erreur}</p>}
+
+        <div className="ad-tb-grille">
+            <section className="ad-tb-bloc">
+                <header className="ad-tb-entete">
+                    <div>
+                        <p className="ad-dv-surtitre font-body-strong">La question du matin</p>
+                        <h2 className="ad-tb-titre font-title">Qui attend une réponse ?</h2>
+                    </div>
+                    <Link to={`${B}/devis`} className="ad-tb-lien font-body-strong">Toutes les demandes →</Link>
+                </header>
+
+                {chargement ? <Squelette lignes={4} /> : attente.length === 0 ? (
+                    <p className="ad-tb-vide font-body">Aucune demande en attente : tout est à jour.</p>
+                ) : (
+                    <ul className="ad-tb-liste">
+                        {attente.map((d) => {
+                            const enRetard = heuresDepuis(d.createdAt) > HEURES_PROMESSE;
+                            const voyageur = [d.client?.prenom, d.client?.nom].filter(Boolean).join(" ") || d.client?.email || "Voyageur";
+                            return (
+                                <li key={d.id}>
+                                    <Link to={`${B}/devis?dossier=${d.id}`} className="ad-tb-demande">
+                                        <span className="ad-tb-demande__ref font-body-strong">{d.reference}</span>
+                                        <span className="ad-tb-demande__corps">
+                                            <span className="font-body-strong">{voyageur}</span>
+                                            <span className="ad-tb-muet font-body">{d.circuit?.nom ?? "Circuit"} · {d.nombreVoyageurs ?? "?"} pers.</span>
+                                        </span>
+                                        <span className={`ad-tb-age font-body-strong${enRetard ? " ad-tb-age--retard" : ""}`}
+                                            title={`Reçue le ${formatDate(d.createdAt)}`}>
+                                            {depuis(d.createdAt)}
+                                        </span>
+                                        <span className={`ad-dv-pastille ad-dv-pastille--${d.statutAffiche}`}>{d.statutLibelle ?? d.statutAffiche}</span>
+                                    </Link>
+                                </li>
+                            );
+                        })}
+                    </ul>
+                )}
+            </section>
+
+            <EfficaciteSources efficacite={efficacite} chargement={chargement} />
+        </div>
+
+        <div className="ad-tb-grille">
+            <Destinations efficacite={efficacite} chargement={chargement} />
+            <Associations efficacite={efficacite} chargement={chargement} onRecalcul={setEfficacite} />
+        </div>
+    </>;
+}
+
+// ── Par source : association, étiquettes, proximité, préférences, agence ──
+
+function EfficaciteSources({ efficacite, chargement }) {
+    const sources = efficacite?.parSource ?? [];
+    return (
+        <section className="ad-tb-bloc">
+            <header className="ad-tb-entete">
+                <div>
+                    <p className="ad-dv-surtitre font-body-strong">Créateur de circuit</p>
+                    <h2 className="ad-tb-titre font-title">Les suggestions servent-elles ?</h2>
+                </div>
+            </header>
+            {chargement ? <Squelette lignes={4} /> : sources.length === 0 ? (
+                <p className="ad-tb-vide font-body">
+                    Aucune suggestion n'a encore été montrée. Les chiffres apparaîtront dès que des voyageurs composeront un circuit.
+                </p>
+            ) : (
+                <>
+                    <p className="ad-tb-aide font-body">
+                        Part des suggestions montrées que le voyageur a ajoutées à son circuit, selon ce qui les a fait proposer.
+                    </p>
+                    <ul className="ad-tb-barres">
+                        {sources.map((s) => (
+                            <li key={s.cle} className="ad-tb-barre">
+                                <div className="ad-tb-barre__ligne">
+                                    <span className="font-body-strong">{s.libelle}</span>
+                                    <span className="ad-tb-barre__chiffre font-body-strong">{pourcent(s.taux)}</span>
+                                </div>
+                                <div className="ad-tb-barre__piste" aria-hidden="true">
+                                    <span className="ad-tb-barre__jauge" style={{ width: `${Math.max(s.taux ?? 0, 1)}%` }} />
+                                </div>
+                                <span className="ad-tb-muet font-body">{s.ajouts} ajout{s.ajouts > 1 ? "s" : ""} · {s.vues} vue{s.vues > 1 ? "s" : ""}</span>
+                            </li>
+                        ))}
+                    </ul>
+                </>
+            )}
+        </section>
+    );
+}
+
+// ── Par destination : ce qui convainc le plus ──────────────────────────────
+
+function Destinations({ efficacite, chargement }) {
+    const lignes = efficacite?.parDestination ?? [];
+    return (
+        <section className="ad-tb-bloc">
+            <header className="ad-tb-entete">
+                <div>
+                    <p className="ad-dv-surtitre font-body-strong">Par destination</p>
+                    <h2 className="ad-tb-titre font-title">Les suggestions qui convainquent</h2>
+                </div>
+            </header>
+            {chargement ? <Squelette lignes={5} /> : lignes.length === 0 ? (
+                <p className="ad-tb-vide font-body">Pas encore de mesure par destination.</p>
+            ) : (
+                <table className="ad-tb-table font-body">
+                    <thead>
+                        <tr>
+                            <th>Destination</th>
+                            <th>Vues</th>
+                            <th>Ajouts</th>
+                            <th>Taux</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        {lignes.map((l) => (
+                            <tr key={l.cle}>
+                                <td className="font-body-strong">{l.libelle}</td>
+                                <td>{l.vues}</td>
+                                <td>{l.ajouts}</td>
+                                <td className="ad-tb-table__taux font-body-strong">{pourcent(l.taux)}</td>
+                            </tr>
+                        ))}
+                    </tbody>
+                </table>
+            )}
+        </section>
+    );
+}
+
+// ── Les paires « souvent associées » et leur recalcul ─────────────────────
+
+function Associations({ efficacite, chargement, onRecalcul }) {
+    const [enCours, setEnCours] = useState(false);
+    const [message, setMessage] = useState(null);
+    const paires = efficacite?.associations ?? [];
+
+    const recalculer = async () => {
+        setEnCours(true);
+        setMessage(null);
+        try {
+            const r = await recalculerAssociationsApi();
+            onRecalcul(r?.data ?? null);
+            setMessage({ ton: "succes", texte: "Associations recalculées sur l'ensemble des circuits." });
+        } catch (error) {
+            setMessage({ ton: "erreur", texte: apiErrorMessage(error, "Le recalcul a échoué. Réessayez dans un instant.") });
+        } finally {
+            setEnCours(false);
+        }
+    };
+
+    return (
+        <section className="ad-tb-bloc">
+            <header className="ad-tb-entete">
+                <div>
+                    <p className="ad-dv-surtitre font-body-strong">Souvent associées</p>
+                    <h2 className="ad-tb-titre font-title">Les destinations qui vont ensemble</h2>
+                </div>
+            </header>
+            <p className="ad-tb-aide font-body">
+                Calculées sur tous les circuits, ceux de l'agence comme ceux des voyageurs : chaque nuit à 3 h,
+                et autour d'un circuit dès qu'il est enregistré.
+            </p>
+            {chargement ? <Squelette lignes={4} /> : paires.length === 0 ? (
+                <p className="ad-tb-vide font-body">Pas encore assez de circuits pour dégager des paires.</p>
+            ) : (
+                <ul className="ad-tb-paires">
+                    {paires.map((p) => (
+                        <li key={`${p.a}-${p.b}`} className="ad-tb-paire">
+                            <span className="font-body-strong">{p.a} <span className="ad-tb-muet">+</span> {p.b}</span>
+                            <span className="ad-tb-muet font-body">
+                                ensemble dans {p.circuits} circuit{p.circuits > 1 ? "s" : ""} · confiance {p.confiance} % · lift {String(p.lift).replace(".", ",")}
+                            </span>
+                        </li>
+                    ))}
+                </ul>
+            )}
+            <div className="ad-tb-pied">
+                <span className="ad-tb-muet font-body">
+                    Dernier calcul : {efficacite?.dernierCalcul ? formatDate(efficacite.dernierCalcul) : "jamais"}
+                </span>
+                <button type="button" className="ad-bouton font-body-strong" onClick={recalculer} disabled={enCours || chargement}>
+                    {enCours ? "Calcul en cours…" : "Recalculer maintenant"}
+                </button>
+            </div>
+            {message && (
+                <p className={message.ton === "erreur" ? "ad-erreur" : "ad-tb-succes font-body"} role="status">{message.texte}</p>
+            )}
+        </section>
+    );
+}
+
+function Squelette({ lignes }) {
+    return (
+        <div className="ad-tb-squelette" aria-hidden="true">
+            {Array.from({ length: lignes }, (_, i) => (
+                <div key={i} className="skeleton-box h-4" style={{ borderRadius: 0, width: `${90 - i * 9}%` }} />
+            ))}
+        </div>
+    );
+}
