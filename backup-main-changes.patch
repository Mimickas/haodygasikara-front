diff --git a/src/components/client/layout/header/AccountPanel.jsx b/src/components/client/layout/header/AccountPanel.jsx
new file mode 100644
index 0000000..f4dfa1e
--- /dev/null
+++ b/src/components/client/layout/header/AccountPanel.jsx
@@ -0,0 +1,204 @@
+import { useEffect, useState } from "react";
+import LienPanneau from "./LienPanneau";
+import { FaArrowRight } from "react-icons/fa6";
+import { useAuth } from "../../../../hooks/useAuth";
+import Avatar from "../../compte/Avatar";
+import { findMesDevisApi } from "../../../../api/client/devisApi";
+import { findMesCircuitsApi } from "../../../../api/client/composerApi";
+import { CONTACT } from "../../../../constants/client/contact";
+
+/**
+ * Espace voyageur.
+ *
+ * La grammaire de l'accueil, sans photographie : à gauche la colonne de sable
+ * (le prénom composé comme un titre de une), à droite les lignes filetées des
+ * « trois gestes ». Aucune image ni voile : c'est le texte qui porte.
+ */
+
+const ATOUTS = [
+    { titre: "Vos devis", desc: "Suivez chaque demande, de l'envoi à la réponse de votre conseiller." },
+    { titre: "Vos circuits", desc: "Composez votre voyage, enregistrez-le, reprenez-le quand vous voulez." },
+    { titre: "Vos envies", desc: "Dites ce qui vous attire : le créateur vous propose ce qui vous ressemble." },
+];
+
+/* ── Titre masqué : chaque ligne monte de sous son propre cadre ───────────
+   Le double span est indispensable — c'est le parent en overflow hidden qui
+   découpe, l'enfant qui se déplace. Même mécanique que le titre de l'accueil. */
+function LigneMasquee({ children }) {
+    return (
+        <span className="block overflow-hidden">
+            <span data-panel-mask className="block">{children}</span>
+        </span>
+    );
+}
+
+/* ── Une ligne du carnet : le compte est la donnée, pas un ornement ─────── */
+function Rangee({ compte, titre, texte, action, vers, onNaviguer }) {
+    return (
+        <LienPanneau to={vers} onNaviguer={onNaviguer} className="cx-compte-rangee">
+            <span className="cx-compte-rangee__compte font-body-strong tabular-nums">{String(compte).padStart(2, "0")}</span>
+            <span className="cx-compte-rangee__titre font-title">{titre}</span>
+            <span className="cx-compte-rangee__texte">
+                <span className="font-body">{texte}</span>
+                <span className="cx-compte-rangee__action cx-label font-body-strong">
+                    {action} <FaArrowRight aria-hidden="true" />
+                </span>
+            </span>
+        </LienPanneau>
+    );
+}
+
+export default function AccountPanel({ onClose, onNaviguer }) {
+    const { isAuthenticated, user, logout } = useAuth();
+
+    // Les devis et les circuits se lisent à l'ouverture du panneau, et
+    // seulement connecté : un panneau d'en-tête ne doit rien charger d'autre.
+    const [devis, setDevis] = useState([]);
+    const [circuits, setCircuits] = useState([]);
+    useEffect(() => {
+        if (!isAuthenticated) return;
+        let vivant = true;
+        findMesDevisApi()
+            .then((r) => { if (vivant) setDevis(r?.data ?? []); })
+            .catch(() => { /* un compteur absent vaut mieux qu'un panneau cassé */ });
+        findMesCircuitsApi()
+            .then((r) => { if (vivant) setCircuits(r?.data ?? []); })
+            .catch(() => { /* idem */ });
+        return () => { vivant = false; };
+    }, [isAuthenticated]);
+
+    const brouillons = circuits.filter((c) => c.statut === "BROUILLON").length;
+    const aRepondre = devis.filter((d) => d.statutAffiche === "PROPOSE").length;
+    const enCours = devis.filter((d) => ["ENVOYE", "EN_COURS", "PROPOSE"].includes(d.statutAffiche)).length;
+
+    return (
+        <div className="cx-compte-panneau">
+            {/* ══ La colonne de sable ══════════════════════════════════════ */}
+            <aside className="cx-compte-panneau__sable">
+                <div data-panel-item className="flex items-center justify-between gap-6">
+                    <p className="cx-label cx-label--accent font-body-strong">Espace voyageur</p>
+                    {isAuthenticated && <Avatar user={user} taille={40} />}
+                </div>
+
+                <div>
+                    <h2 className="cx-compte-panneau__titre font-title">
+                        {isAuthenticated ? (
+                            <>
+                                <LigneMasquee>{user?.prenom}</LigneMasquee>
+                                <LigneMasquee>{user?.nom}</LigneMasquee>
+                            </>
+                        ) : (
+                            <>
+                                <LigneMasquee>Votre</LigneMasquee>
+                                <LigneMasquee>Madagascar,</LigneMasquee>
+                                <LigneMasquee>retrouvé.</LigneMasquee>
+                            </>
+                        )}
+                    </h2>
+
+                    <div data-panel-item className="cx-compte-panneau__pied">
+                        {isAuthenticated ? (
+                            <>
+                                <div className="min-w-0">
+                                    <p className="cx-label cx-label--legende font-body-strong">Connecté</p>
+                                    <p className="cx-compte-panneau__email font-body">{user?.email}</p>
+                                </div>
+                                <div className="cx-compte-panneau__gestes">
+                                    <LienPanneau to="/mon-compte" onNaviguer={onNaviguer} className="cx-compte-panneau__geste cx-label font-body-strong">
+                                        Paramètres
+                                    </LienPanneau>
+                                    {/* La déconnexion change de page, elle aussi : elle passe
+                                        donc par la même file que les liens — le panneau se
+                                        referme d'abord, on quitte ensuite. */}
+                                    <button type="button" onClick={() => onClose(logout)} className="cx-compte-panneau__geste cx-label font-body-strong">
+                                        Déconnexion
+                                    </button>
+                                </div>
+                            </>
+                        ) : (
+                            <p className="cx-compte-panneau__invite font-body">
+                                Vos devis, vos voyages en cours et vos envies, réunis au même endroit.
+                            </p>
+                        )}
+                    </div>
+                </div>
+            </aside>
+
+            {/* ══ Le carnet ════════════════════════════════════════════════ */}
+            <div className="cx-compte-panneau__carnet">
+                {isAuthenticated ? (
+                    <>
+                        <div data-panel-item className="cx-compte-panneau__tete">
+                            <p className="cx-label cx-label--accent font-body-strong">Votre carnet</p>
+                            <h3 className="cx-compte-panneau__soustitre font-title">Où en sont vos voyages.</h3>
+                        </div>
+
+                        <div data-panel-item>
+                            <Rangee
+                                compte={devis.length}
+                                titre="Mes devis"
+                                texte={aRepondre > 0
+                                    ? `${aRepondre} devis ${aRepondre > 1 ? "attendent" : "attend"} votre réponse.`
+                                    : enCours > 0
+                                        ? `${enCours} demande${enCours > 1 ? "s" : ""} en cours : suivez chaque étape.`
+                                        : devis.length > 0
+                                            ? "Retrouvez vos demandes passées et leurs réponses."
+                                            : "Aucune demande en cours. Ouvrez un circuit pour en demander le devis."}
+                                action={devis.length > 0 ? "Voir mes devis" : "Voir les circuits"}
+                                vers={devis.length > 0 ? "/mes-devis" : "/circuit"}
+                                onNaviguer={onNaviguer}
+                            />
+                        </div>
+
+                        <div data-panel-item>
+                            <Rangee
+                                compte={circuits.length}
+                                titre="Mes circuits"
+                                texte={brouillons > 0
+                                    ? `${brouillons} brouillon${brouillons > 1 ? "s" : ""} à reprendre là où vous l'avez laissé.`
+                                    : circuits.length > 0
+                                        ? "Retrouvez les voyages que vous avez composés."
+                                        : "Composez votre propre voyage, étape par étape."}
+                                action={circuits.length > 0 ? "Voir mes circuits" : "Composer un circuit"}
+                                vers={circuits.length > 0 ? "/mes-circuits" : "/composer"}
+                                onNaviguer={onNaviguer}
+                            />
+                        </div>
+
+                        <div data-panel-item className="cx-compte-rangee cx-compte-rangee--fixe">
+                            <span className="cx-label cx-label--accent font-body-strong">À vos côtés</span>
+                            <span className="cx-compte-rangee__titre font-title">Votre conseiller</span>
+                            <span className="cx-compte-rangee__texte">
+                                <a href={`mailto:${CONTACT.email}`} className="cx-menu__contact font-body">{CONTACT.email}</a>
+                                <a href={`tel:${CONTACT.telHref}`} className="cx-menu__contact cx-menu__contact--pale font-body">{CONTACT.tel}</a>
+                            </span>
+                        </div>
+
+                        <LienPanneau data-panel-item to="/composer" onNaviguer={onNaviguer} className="cx-compte-panneau__cta cx-devis__bouton font-body-strong">
+                            Composer mon circuit <FaArrowRight aria-hidden="true" />
+                        </LienPanneau>
+                    </>
+                ) : (
+                    <>
+                        <div data-panel-item className="cx-compte-panneau__tete">
+                            <p className="cx-label cx-label--accent font-body-strong">Ce que vous y trouverez</p>
+                            <h3 className="cx-compte-panneau__soustitre font-title">Un carnet, pas un compte.</h3>
+                        </div>
+
+                        {ATOUTS.map((a) => (
+                            <div key={a.titre} data-panel-item className="cx-compte-rangee cx-compte-rangee--fixe">
+                                <span className="cx-compte-rangee__titre font-title">{a.titre}</span>
+                                <span className="cx-compte-rangee__texte font-body">{a.desc}</span>
+                            </div>
+                        ))}
+
+                        <div data-panel-item className="cx-compte-panneau__gestes-invite">
+                            <LienPanneau to="/login" onNaviguer={onNaviguer} className="cx-devis__bouton font-body-strong">Se connecter</LienPanneau>
+                            <LienPanneau to="/register" onNaviguer={onNaviguer} className="cx-dv-lien font-body-strong">Créer un compte</LienPanneau>
+                        </div>
+                    </>
+                )}
+            </div>
+        </div>
+    );
+}
diff --git a/src/components/client/layout/header/HeaderClient.jsx b/src/components/client/layout/header/HeaderClient.jsx
new file mode 100644
index 0000000..a8362e9
--- /dev/null
+++ b/src/components/client/layout/header/HeaderClient.jsx
@@ -0,0 +1,295 @@
+import { Link, useNavigate } from "react-router-dom";
+import { FaUser } from "react-icons/fa6";
+import { useState, useRef, useEffect, useCallback } from "react";
+import gsap from "gsap";
+import { useHeaderTextColor } from "../../../../hooks/design/animations/useHeaderTextColor";
+import { useAuth } from "../../../../hooks/useAuth";
+import Avatar from "../../compte/Avatar";
+import MenuPanel from "./MenuPanel";
+import AccountPanel from "./AccountPanel";
+import LienPanneau from "./LienPanneau";
+
+const PANEL_EASE = "expo.inOut";
+const OPEN_DURATION = 0.85;
+const CLOSE_DURATION = 0.7;
+
+export default function HeaderClient() {
+    // Un seul panneau à la fois : "menu" | "compte" | null.
+    // Deux états booléens séparés menaient à un panneau ouvert sans contenu
+    // et à un bouton qui ne se refermait jamais.
+    const { isAuthenticated, user } = useAuth();
+    const navigate = useNavigate();
+
+    const [panneau, setPanneau] = useState(null);
+    const [headerHeight, setHeaderHeight] = useState(84);
+
+    const scopeRef = useRef(null);
+    const panelRef = useRef(null);
+    const textColor = useHeaderTextColor(scopeRef);
+
+    const ouvert = panneau !== null;
+
+    // Panneau ouvert = fond clair plein écran : toute la barre repasse en sombre,
+    // sinon le X et le bouton compte restent blancs sur blanc.
+    const barColor = ouvert ? "var(--text-primary)" : textColor;
+
+    // La hauteur mesuree sert a DEUX endroits : ici (le panneau se pose
+    // dessous) et dans la mise en page (le contenu demarre dessous). Elle
+    // descend donc dans une variable CSS plutot que d'etre recopiee en dur —
+    // un changement de padding sur la barre suivrait sinon a un seul endroit.
+    //
+    // ResizeObserver, et pas seulement `resize` sur la fenetre : la barre
+    // change de hauteur SANS que la fenetre bouge. A la connexion, le bouton
+    // compte passe de « Se connecter » au monogramme et au prenom, et la barre
+    // gagne 8 px — mesure : 85 → 93. Avec un simple ecouteur de
+    // redimensionnement, la variable restait a 85 et le contenu des pages sans
+    // hero repassait sous la barre.
+    useEffect(() => {
+        const barre = scopeRef.current;
+        if (!barre) return;
+
+        const measure = () => {
+            const hauteur = barre.offsetHeight || 84;
+            setHeaderHeight(hauteur);
+            document.documentElement.style.setProperty("--entete-hauteur", `${hauteur}px`);
+        };
+
+        measure();
+
+        const observateur = new ResizeObserver(measure);
+        observateur.observe(barre);
+        return () => observateur.disconnect();
+    }, []);
+
+    // Déploiement : le panneau gagne en hauteur et pousse la page vers le bas.
+    // Ne dépend que de `ouvert` — basculer menu ↔ compte ne rejoue pas l'ouverture.
+    useEffect(() => {
+        if (!ouvert) return;
+
+        const panel = panelRef.current;
+        const main = document.querySelector("main");
+        const hauteur = window.innerHeight - (scopeRef.current?.offsetHeight ?? 84);
+
+        // ── Bloquer le defilement SANS decaler la page ─────────────────
+        // A l'ouverture, la barre de defilement disparaissait et la page
+        // s'elargissait de 12 px : tout sautait vers la droite.
+        //
+        // `scrollbar-gutter: stable` (index.css) est cense l'eviter, et ne le
+        // fait pas ici : il ne garde la gouttiere que tant qu'une barre peut
+        // s'afficher. Des que `overflow` passe a `hidden`, plus de barre, plus
+        // de gouttiere. Mesure a l'appui : clientWidth 1588 → 1600.
+        //
+        // On compense donc la largeur reprise par un padding de meme valeur,
+        // mesuree juste avant le blocage plutot que codee en dur — elle depend
+        // du systeme et du navigateur.
+        const racine = document.documentElement;
+        const largeurBarre = window.innerWidth - racine.clientWidth;
+
+        const overflowAvant = racine.style.overflow;
+        const paddingAvant = racine.style.paddingRight;
+
+        racine.style.overflow = "hidden";
+        if (largeurBarre > 0) racine.style.paddingRight = `${largeurBarre}px`;
+
+        const tl = gsap.timeline();
+        tl.fromTo(panel, { height: 0 }, { height: hauteur, duration: OPEN_DURATION, ease: PANEL_EASE });
+        if (main) tl.fromTo(main, { y: 0 }, { y: hauteur, duration: OPEN_DURATION, ease: PANEL_EASE }, 0);
+
+        return () => {
+            tl.kill();
+            racine.style.overflow = overflowAvant;
+            racine.style.paddingRight = paddingAvant;
+        };
+    }, [ouvert]);
+
+    // Entrée du contenu, rejouée quand on bascule d'un panneau à l'autre.
+    //
+    // Deux temps qui se chevauchent, dans l'esprit du hero d'accueil : les
+    // lignes de titre montent de sous leur cadre, puis le reste se pose,
+    // discrètement. clearProps : aucun transform inline ne doit traîner.
+    useEffect(() => {
+        if (!panneau) return;
+
+        // Chaque panneau n'a pas tous ces éléments : viser un sélecteur vide
+        // ferait crier GSAP dans la console à chaque ouverture du menu.
+        const cible = (selecteur) => {
+            const trouves = gsap.utils.toArray(selecteur);
+            return trouves.length ? trouves : null;
+        };
+
+        const lignes = cible("[data-panel-mask]");
+        const blocs = cible("[data-panel-item]");
+
+        const tl = gsap.timeline({ delay: OPEN_DURATION * 0.4 });
+
+        // Le prénom monte ligne par ligne, chacune découpée par son parent
+        if (lignes) {
+            tl.from(lignes, {
+                yPercent: 115,
+                duration: 1.05,
+                stagger: 0.08,
+                ease: "expo.out",
+                clearProps: "transform",
+            }, 0.12);
+        }
+
+        if (blocs) {
+            tl.from(blocs, {
+                y: 18,
+                opacity: 0,
+                duration: 0.6,
+                stagger: 0.05,
+                ease: "power3.out",
+                clearProps: "transform",
+            }, 0.22);
+        }
+
+        return () => tl.kill();
+    }, [panneau]);
+
+    // `apres` s'execute une fois le panneau REFERME, pas avant. C'est ce qui
+    // met la navigation en file derriere l'animation au lieu de la lancer en
+    // meme temps (cf. LienPanneau). Appele comme gestionnaire d'evenement,
+    // le premier argument est un Event : le test sur le type l'ecarte.
+    const closePanel = useCallback((apres) => {
+        const suite = typeof apres === "function" ? apres : null;
+        const panel = panelRef.current;
+        const main = document.querySelector("main");
+
+        if (!panel) {
+            setPanneau(null);
+            suite?.();
+            return;
+        }
+
+        const tl = gsap.timeline({
+            onComplete: () => {
+                if (main) gsap.set(main, { clearProps: "transform" });
+                setPanneau(null);
+                suite?.();
+            },
+        });
+        tl.to(panel, { height: 0, duration: CLOSE_DURATION, ease: PANEL_EASE });
+        if (main) tl.to(main, { y: 0, duration: CLOSE_DURATION, ease: PANEL_EASE }, 0);
+    }, []);
+
+    // L'ordre voulu, en une ligne : le menu finit de se fermer, PUIS on
+    // navigue. L'attente du module s'annonce alors toute seule, par la barre
+    // de chargement du gabarit — elle ne peut pas apparaitre avant, puisque
+    // la navigation n'a pas encore commence.
+    const naviguerDepuisLePanneau = useCallback(
+        (vers) => closePanel(() => navigate(vers)),
+        [closePanel, navigate]
+    );
+
+    // Même bouton : ferme si son panneau est déjà là, bascule sinon
+    const togglePanel = useCallback(
+        (nom) => (panneau === nom ? closePanel() : setPanneau(nom)),
+        [panneau, closePanel]
+    );
+
+    useEffect(() => {
+        if (!ouvert) return;
+        const onKey = (e) => e.key === "Escape" && closePanel();
+        window.addEventListener("keydown", onKey);
+        return () => window.removeEventListener("keydown", onKey);
+    }, [ouvert, closePanel]);
+
+    const menuOuvert = panneau === "menu";
+    const compteOuvert = panneau === "compte";
+
+    return (
+        <>
+            <header
+                ref={scopeRef}
+                className="fixed top-0 left-0 right-0 z-50 grid grid-cols-3 items-center py-5 px-5 sm:py-6 sm:px-16 uppercase text-sm transition-colors duration-300 backdrop-blur-sm"
+                style={{ borderBottom: "1px solid var(--border)" }}
+            >
+                <button
+                    data-header-menu
+                    type="button"
+                    className="flex items-center gap-2 font-body-strong uppercase text-sm duration-200 hover:opacity-80 cursor-pointer w-fit"
+                    style={{ color: barColor }}
+                    onClick={() => togglePanel("menu")}
+                    aria-expanded={menuOuvert}
+                >
+                    <span className="flex flex-col gap-1">
+                        <span
+                            className={`block w-10 transition-all duration-300 ease-in-out ${menuOuvert ? "rotate-[15deg] translate-y-[3px]" : ""}`}
+                            style={{ borderColor: barColor, borderTopWidth: "1.5px", borderTopStyle: "solid" }}
+                        />
+                        <span
+                            className={`block w-10 transition-all duration-300 ease-in-out ${menuOuvert ? "-rotate-[15deg] -translate-y-[3px]" : ""}`}
+                            style={{ borderColor: barColor, borderTopWidth: "1.5px", borderTopStyle: "solid" }}
+                        />
+                    </span>
+                    {/* Sur téléphone, les deux traits suffisent : le mot poussait le logo hors de sa colonne */}
+                    <span className="hidden sm:inline">{menuOuvert ? "Fermer" : "Menu"}</span>
+                </button>
+
+                <div data-header-logo className="flex justify-center">
+                    {/* Panneau ouvert, le logo ramène à l'accueil : il suit alors la
+                        même file que les liens du menu — fermeture, puis navigation.
+                        Panneau fermé, c'est un lien ordinaire. */}
+                    {ouvert ? (
+                        <LienPanneau to="/" onNaviguer={naviguerDepuisLePanneau}>
+                            <span className="font-title text-xl sm:text-2xl whitespace-nowrap transition-colors duration-300" style={{ color: barColor }}>
+                                HaodyGasikara
+                            </span>
+                        </LienPanneau>
+                    ) : (
+                        <Link to="/">
+                            <span className="font-title text-xl sm:text-2xl whitespace-nowrap transition-colors duration-300" style={{ color: barColor }}>
+                                HaodyGasikara
+                            </span>
+                        </Link>
+                    )}
+                </div>
+
+                <div data-header-cta className="flex justify-end items-center gap-6 font-body">
+                    <button
+                        data-header-compte
+                        type="button"
+                        className="flex items-center gap-3 py-2 cursor-pointer transition-opacity duration-200 hover:opacity-80 font-body-strong uppercase text-sm"
+                        style={{ color: barColor }}
+                        onClick={() => togglePanel("compte")}
+                        aria-expanded={compteOuvert}
+                    >
+                        {isAuthenticated ? (
+                            <>
+                                {/* La photo si le compte en a une, le monogramme
+                                    sinon — un seul composant decide, ici comme
+                                    dans l'espace voyageur. */}
+                                <Avatar user={user} taille={28} bordure={barColor} />
+                                <span className="hidden sm:inline">{compteOuvert ? "Fermer" : user?.prenom}</span>
+                            </>
+                        ) : (
+                            <>
+                                <FaUser />
+                                <span className="hidden sm:inline">{compteOuvert ? "Fermer" : "Se connecter"}</span>
+                            </>
+                        )}
+                    </button>
+                </div>
+            </header>
+
+            {/* ── Panneau : sa hauteur passe de 0 à plein écran et repousse la page ── */}
+            {ouvert && (
+                <div
+                    ref={panelRef}
+                    className="fixed left-0 right-0 z-40 overflow-hidden"
+                    style={{ top: `${headerHeight}px`, height: 0, backgroundColor: "var(--bg-card)" }}
+                >
+                    {/* hauteur figée : le contenu se dévoile, il ne s'écrase pas.
+                        Le padding est laissé à chaque panneau : l'espace compte a
+                        besoin de saigner jusqu'aux bords. */}
+                    <div style={{ height: `${window.innerHeight - headerHeight}px` }}>
+                        {menuOuvert
+                            ? <MenuPanel onNaviguer={naviguerDepuisLePanneau} />
+                            : <AccountPanel onClose={closePanel} onNaviguer={naviguerDepuisLePanneau} />}
+                    </div>
+                </div>
+            )}
+        </>
+    );
+}
diff --git a/src/components/client/layout/header/LienPanneau.jsx b/src/components/client/layout/header/LienPanneau.jsx
new file mode 100644
index 0000000..536b287
--- /dev/null
+++ b/src/components/client/layout/header/LienPanneau.jsx
@@ -0,0 +1,29 @@
+import { Link } from "react-router-dom";
+
+// ── Un lien de panneau ────────────────────────────────────────────────────
+//
+// Il referme le panneau AVANT de changer de page, au lieu des deux à la fois.
+//
+// Un `<Link>` ordinaire navigue à l'instant du clic : la page basculait donc
+// pendant que le menu se repliait encore, et depuis que chaque page arrive
+// dans son propre module, l'attente du téléchargement tombait par-dessus,
+// sans rien à l'écran. Trois gestes se marchaient dessus. Ici l'ordre est
+// écrit : le menu finit de se fermer, l'attente s'annonce, la page arrive.
+//
+// Reste un vrai `<a href>` : clic milieu, Ctrl/⌘ + clic, « ouvrir dans un
+// nouvel onglet » continuent de fonctionner — on n'intercepte que le clic
+// gauche simple, celui qu'on a le droit de séquencer.
+export default function LienPanneau({ to, onNaviguer, children, ...reste }) {
+    const auClic = (e) => {
+        if (e.defaultPrevented) return;
+        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        e.preventDefault();
+        onNaviguer(to);
+    };
+
+    return (
+        <Link to={to} onClick={auClic} {...reste}>
+            {children}
+        </Link>
+    );
+}
diff --git a/src/components/client/layout/header/MenuPanel.jsx b/src/components/client/layout/header/MenuPanel.jsx
